{
	"name": "bober",
	"publisher": "bober",
	"version": "0.0.1",
	"description": "bober's language server, build/bober lsp, run in the workspace's root",
	"repository": "none",
	"license": "UNLICENSED",
	"engines": { "vscode": "^1.82.0" },
	"main": "extension.js",
	"activationEvents": [],
	"contributes": {
		"languages": [{ "id": "bober", "extensions": [".bob"], "configuration": "./language.json", "icon": { "light": "./icon.svg", "dark": "./icon.svg" } }],
		"grammars": [{ "language": "bober", "scopeName": "source.bober", "path": "./bober.tmLanguage.json" }]
	},
	"dependencies": { "vscode-languageclient": "^9.0.1" }
}
