import { arg, report } from "./util"

function fannkuch(n: i32): [i32, i32] {
	const perm = new i32[](n)
	const perm1 = new i32[](n)
	const count = new i32[](n)
	for (const i of 0 ... n - 1) {
		perm1[i] = i
	}
	let maxFlips = 0
	let checksum = 0
	let r = n
	let permCount = 0
	while (true) {
		while (r != 1) {
			count[r - 1] = r
			r--
		}
		for (const i of 0 ... n - 1) {
			perm[i] = perm1[i]
		}
		let flips = 0
		let k = perm[0]
		while (k != 0) {
			let i = 0
			let j = k
			while (i < j) {
				const t = perm[i]
				perm[i] = perm[j]
				perm[j] = t
				i++
				j--
			}
			flips++
			k = perm[0]
		}
		if (flips > maxFlips) {
			maxFlips = flips
		}
		checksum += if (permCount % 2 == 0) flips else -flips
		while (true) {
			if (r == n) {
				return [checksum, maxFlips]
			}
			const p0 = perm1[0]
			for (const i of 0 ... r - 1) {
				perm1[i] = perm1[i + 1]
			}
			perm1[r] = p0
			count[r]--
			if (count[r] > 0) {
				break
			}
			r++
		}
		permCount++
	}
}

function main(): i32 {
	const n = arg(0, 11) as i32
	const t0 = now()
	const [checksum, maxFlips] = fannkuch(n)
	report("fannkuch", t0, (checksum as i64) * 1000 + maxFlips)
	return 0
}
