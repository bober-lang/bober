import { ParseError, parseInt } from "../std/string"
import { millisecond } from "../std/time"

/// Argument i as an integer, or d if absent or malformed.
export function arg(i: i32, d: i64): i64 {
	const a = args()
	if (a.length <= i) {
		return d
	}
	try {
		return parseInt[i64](a[i])
	} catch (e: ParseError) {
		return d
	}
}

/// Prints a benchmark line: name, ms, and a checksum.
export function report(name: string, t0: i64, check: i64) {
	print(`${name} ${(now() - t0) / millisecond} ms check=${check}`)
}
