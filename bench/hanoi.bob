import { arg, report } from "./util"

function hanoi(n: i32, from: i32, to: i32, via: i32): i64 {
	if (n == 0) {
		return 0
	}
	return hanoi(n - 1, from, via, to) + 1 + hanoi(n - 1, via, to, from)
}

/// Pegs as stacks, every move a pop and a push.
function moves(n: i32, from: i32[], to: i32[], via: i32[]): i64 {
	if (n == 0) {
		return 0
	}
	const a = moves(n - 1, from, via, to)
	to.push(from.pop())
	return a + 1 + moves(n - 1, via, to, from)
}

function main(): i32 {
	const n = arg(0, 27) as i32
	let t0 = now()
	report("hanoi-count", t0, hanoi(n, 0, 2, 1))
	const m = n - 3
	const pegs = [new i32[](0), new i32[](0), new i32[](0)]
	for (const i of 0 ... m - 1) {
		pegs[0].push(m - i)
	}
	t0 = now()
	const c = moves(m, pegs[0], pegs[2], pegs[1])
	report("hanoi-stacks", t0, c + pegs[2].length)
	return 0
}
