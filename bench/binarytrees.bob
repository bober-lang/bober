import { arg, report } from "./util"

class Node {
	left: Node | null
	right: Node | null

	constructor(left: Node | null, right: Node | null) {
		this.left = left
		this.right = right
	}
}

function make(depth: i32): Node {
	return if (depth == 0) new Node(null, null) else new Node(make(depth - 1), make(depth - 1))
}

function check(n: Node): i32 {
	const l = n.left
	return if (l == null) 1 else 1 + check(l) + check(n.right!)
}

function main(): i32 {
	const n = arg(0, 18) as i32
	const t0 = now()
	const min: i32 = 4
	const max = if (n > min + 2) n else min + 2
	const stretch = make(max + 1)
	let sum: i64 = check(stretch)
	const long = make(max)
	let d = min
	while (d <= max) {
		const iters: i32 = 1 << (max - d + min)
		let c = 0
		for (const i of 1 ... iters) {
			c += check(make(d))
		}
		sum += c
		d += 2
	}
	sum += check(long)
	report("binarytrees", t0, sum)
	return 0
}
