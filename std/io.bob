//! Streams of bytes, after Deno's std/io: a Reader gives the bytes that come next, a Writer takes them, and a File
//! does both on a handle of the system's. A call that fails throws an IoError.

import { Handle } from "../builtin/sys"

export interface Reader {
	/// Up to n > 0 bytes, or null at the end.
	read(n: i32): string | null throws IoError
}

export interface Writer {
	/// Writes all of s.
	write(s: string) throws IoError
}

export interface Closer {
	/// Frees what it holds; again, nothing.
	close() throws IoError
}

export interface ReadWriter { ...Reader, ...Writer }
export interface ReadCloser { ...Reader, ...Closer }
export interface ReadWriteCloser { ...ReadWriter, ...Closer }

/// A connection, as net.Conn and tls.Conn are.
export interface Stream {
	...ReadWriteCloser
	/// For each read and write, in ns; 0 for none.
	timeout: i64
}

/// An open file.
export class File implements ReadWriteCloser {
	private h: Handle

	constructor(h: Handle) { this.h = h }

	read(n: i32): string | null throws IoError { return this.h.read(n) }
	write(s: string) throws IoError { this.h.write(s) }
	/// Its bytes, mapped: they must not change while they are reached.
	map(): string throws IoError { return this.h.map() }
	/// A new file at path, open to read and write, of its first n bytes, zeros past its end: which the kernel copies,
	/// sharing their blocks where the file system can, else its data only, its holes kept.
	copy(path: string, n: u64): File throws IoError { return new File(this.h.copy(path, n)) }
	/// Writes s at offset at.
	writeAt(at: u64, s: string) throws IoError { this.h.writeAt(at, s) }
	/// Whether it locks the file, shared or for this File alone, as flock does, waiting if wait for others' locks to go,
	/// else false at once if one stands in the way; closing it unlocks it.
	lock(shared: bool, wait: bool): bool throws IoError { return this.h.lock(shared, wait) }
	/// Waits until what was written is on the device.
	sync() throws IoError { this.h.sync() }
	/// Closes it; again, nothing.
	close() throws IoError { this.h.close() }
}

export const stdin = new File(Handle.stdio(0))
export const stdout = new File(Handle.stdio(1))
export const stderr = new File(Handle.stdio(2))
/// How many bytes readAll and copy ask for at a time.
const chunk: i32 = 1 << 16

/// The bytes of r to its end.
export function readAll(r: Reader): string throws IoError {
	let s = ""
	while (true) {
		const c = r.read(chunk)
		if (c == null) {
			break
		}
		s += c
	}
	return s
}

/// Writes the bytes of r to w until r's end; how many.
export function copy(r: Reader, w: Writer): i64 throws IoError {
	let n: i64 = 0
	while (true) {
		const c = r.read(chunk)
		if (c == null) {
			break
		}
		w.write(c)
		n += c.length
	}
	return n
}
