import { Integral, Numeric, Ordered } from "./types"

export function coalesce[T](a: T | null, b: T): T { return a ?? b }
export function or(a: bool, b: bool): bool { return a || b }
export function and(a: bool, b: bool): bool { return a && b }
export function equal[T](a: T, b: T): bool { return a == b }
export function notEqual[T](a: T, b: T): bool { return a != b }
export function less[T extends Ordered](a: T, b: T): bool { return a < b }
export function greater[T extends Ordered](a: T, b: T): bool { return a > b }
export function lessOrEqual[T extends Ordered](a: T, b: T): bool { return a <= b }
export function greaterOrEqual[T extends Ordered](a: T, b: T): bool { return a >= b }
export function bitOr[T extends Integral](a: T, b: T): T { return a | b }
export function bitXor[T extends Integral](a: T, b: T): T { return a ^ b }
export function bitAnd[T extends Integral](a: T, b: T): T { return a & b }
export function shiftLeft[T extends Integral](a: T, b: T): T { return a << b }
export function shiftRight[T extends Integral](a: T, b: T): T { return a >> b }
export function add[T extends Numeric](a: T, b: T): T { return a + b }
export function subtract[T extends Numeric](a: T, b: T): T { return a - b }
export function multiply[T extends Numeric](a: T, b: T): T { return a * b }
export function divide[T extends Numeric](a: T, b: T): T { return a / b }
export function remainder[T extends Numeric](a: T, b: T): T { return a % b }
export function power[T extends Numeric](a: T, b: T): T { return a ** b }
export function not(a: bool): bool { return !a }
export function negate[T extends Numeric](a: T): T { return -a }
export function bitNot[T extends Integral](a: T): T { return ~a }
export function unwrap[T](a: T | null): T { return a! }
