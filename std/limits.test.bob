import { maxOf, minOf } from "./limits"
import { inf } from "./math"

test "wrap" {
	assert maxOf[i8]() + 1 == minOf[i8]() && maxOf[i16]() + 1 == minOf[i16]() && maxOf[i32]() + 1 == minOf[i32]()
		&& maxOf[i64]() + 1 == minOf[i64]()
	assert maxOf[u8]() + 1 == 0 && maxOf[u16]() + 1 == 0 && maxOf[u32]() + 1 == 0 && maxOf[u64]() + 1 == 0
	assert minOf[u8]() == 0 && minOf[u64]() == 0
	assert maxOf[f32]() * 2.0 == (inf as f32) && maxOf[f64]() * 2.0 == inf && minOf[f64]() == -maxOf[f64]()
	assert maxOf[f32]() == 3.40282346638528859811704183484516925440e+38 && maxOf[f64]() == 1.79769313486231570814527423731704356798070e+308
}
