import { Set } from "./set"

test "add keeps order and drops repeats" {
	const s = new Set(["b", "a", "b"])
	s.add("c")
	s.add("a")
	assert s.items == ["b", "a", "c"]
	assert s.has("a") && !s.has("d")
}

test "union and intersection" {
	const a = new Set(["x", "y"])
	const b = new Set(["y", "z"])
	assert a.union(b).items == ["x", "y", "z"]
	assert a.intersection(b).items == ["y"]
	assert a.items == ["x", "y"]
}
