//! Sets of strings.

import { HashMap } from "./hashmap"

export class Set {
	/// In the order they were added; read-only.
	items: string[] = []
	private index = new HashMap[string, bool]()

	constructor(items: string[] = []) {
		for (const s of items) {
			this.add(s)
		}
	}

	has(s: string): bool { return this.index.has(s) }

	add(s: string) {
		if (!this.has(s)) {
			this.index.set(s, true)
			this.items.push(s)
		}
	}

	/// The items in this or other.
	union(other: Set): Set {
		const out = new Set(this.items)
		for (const s of other.items) {
			out.add(s)
		}
		return out
	}

	/// The items in both this and other.
	intersection(other: Set): Set {
		const out = new Set()
		for (const s of this.items) {
			if (other.has(s)) {
				out.add(s)
			}
		}
		return out
	}
}
