//! The ASCII code units by name, for comparing and switching on bytes.

export const nul = "\0" as u8
export const tab = "\t" as u8
export const lf = "\n" as u8
export const cr = "\r" as u8
export const space = " " as u8
export const exclamation = "!" as u8
export const quote = "\"" as u8
export const hash = "#" as u8
export const dollar = "$" as u8
export const percent = "%" as u8
export const ampersand = "&" as u8
export const apostrophe = "'" as u8
export const lparen = "(" as u8
export const rparen = ")" as u8
export const star = "*" as u8
export const plus = "+" as u8
export const comma = "," as u8
export const minus = "-" as u8
export const dot = "." as u8
export const slash = "/" as u8
export const zero = "0" as u8
export const one = "1" as u8
export const two = "2" as u8
export const three = "3" as u8
export const four = "4" as u8
export const five = "5" as u8
export const six = "6" as u8
export const seven = "7" as u8
export const eight = "8" as u8
export const nine = "9" as u8
export const colon = ":" as u8
export const semicolon = ";" as u8
export const less = "<" as u8
export const equal = "=" as u8
export const greater = ">" as u8
export const question = "?" as u8
export const at = "@" as u8
export const A = "A" as u8
export const B = "B" as u8
export const C = "C" as u8
export const D = "D" as u8
export const E = "E" as u8
export const F = "F" as u8
export const G = "G" as u8
export const H = "H" as u8
export const I = "I" as u8
export const J = "J" as u8
export const K = "K" as u8
export const L = "L" as u8
export const M = "M" as u8
export const N = "N" as u8
export const O = "O" as u8
export const P = "P" as u8
export const Q = "Q" as u8
export const R = "R" as u8
export const S = "S" as u8
export const T = "T" as u8
export const U = "U" as u8
export const V = "V" as u8
export const W = "W" as u8
export const X = "X" as u8
export const Y = "Y" as u8
export const Z = "Z" as u8
export const lbracket = "[" as u8
export const backslash = "\\" as u8
export const rbracket = "]" as u8
export const caret = "^" as u8
export const underscore = "_" as u8
export const backtick = "`" as u8
export const a = "a" as u8
export const b = "b" as u8
export const c = "c" as u8
export const d = "d" as u8
export const e = "e" as u8
export const f = "f" as u8
export const g = "g" as u8
export const h = "h" as u8
export const i = "i" as u8
export const j = "j" as u8
export const k = "k" as u8
export const l = "l" as u8
export const m = "m" as u8
export const n = "n" as u8
export const o = "o" as u8
export const p = "p" as u8
export const q = "q" as u8
export const r = "r" as u8
export const s = "s" as u8
export const t = "t" as u8
export const u = "u" as u8
export const v = "v" as u8
export const w = "w" as u8
export const x = "x" as u8
export const y = "y" as u8
export const z = "z" as u8
export const lbrace = "{" as u8
export const pipe = "|" as u8
export const rbrace = "}" as u8
export const tilde = "~" as u8
export const del = "\x7f" as u8

export function isControl(ch: u8): bool { return ch < space || ch == del }
export function isPrint(ch: u8): bool { return ch >= space && ch < del }
export function isGraphic(ch: u8): bool { return ch > space && ch < del }
export function isBlank(ch: u8): bool { return ch == space || ch == tab }
export function isSpace(ch: u8): bool { return ch == space || ch >= tab && ch <= cr }
export function isDigit(ch: u8): bool { return ch >= zero && ch <= nine }
export function isHexDigit(ch: u8): bool { return isDigit(ch) || ch >= a && ch <= f || ch >= A && ch <= F }
export function isLower(ch: u8): bool { return ch >= a && ch <= z }
export function isUpper(ch: u8): bool { return ch >= A && ch <= Z }
export function isAlphabetic(ch: u8): bool { return isLower(ch) || isUpper(ch) }
export function isAlphanumeric(ch: u8): bool { return isAlphabetic(ch) || isDigit(ch) }
export function isPunctuation(ch: u8): bool { return isGraphic(ch) && !isAlphanumeric(ch) }
export function toLower(ch: u8): u8 { return if (isUpper(ch)) ch - A + a else ch }
export function toUpper(ch: u8): u8 { return if (isLower(ch)) ch - a + A else ch }

export function digit(ch: u8): u8 | null {
	const c = toLower(ch)
	return if (isDigit(c)) c - zero else if (isLower(c)) c - a + 10 else null
}
