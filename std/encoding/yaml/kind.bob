//! The kinds of ./cst's tokens, and of the nodes of its tree after them, as eemeli/yaml names them.

export const byteOrderMark: u8 = 0
/// Where a document without --- starts.
export const docMode: u8 = 1
export const docStart: u8 = 2
export const docEnd: u8 = 3
export const space: u8 = 4
export const comment: u8 = 5
export const newline: u8 = 6
export const directive: u8 = 7
export const anchor: u8 = 8
export const tag: u8 = 9
export const seqItemInd: u8 = 10
export const explicitKeyInd: u8 = 11
export const mapValueInd: u8 = 12
export const flowMapStart: u8 = 13
export const flowMapEnd: u8 = 14
export const flowSeqStart: u8 = 15
export const flowSeqEnd: u8 = 16
/// Where a flow collection ends without its closing bracket, at a line too little indented.
export const flowErrorEnd: u8 = 17
export const comma: u8 = 18
export const blockScalarHeader: u8 = 19
export const alias: u8 = 20
export const scalar: u8 = 21
export const singleQuotedScalar: u8 = 22
export const doubleQuotedScalar: u8 = 23

export const blockScalar: u8 = 24
export const blockMap: u8 = 25
export const blockSeq: u8 = 26
export const flowCollection: u8 = 27
export const document: u8 = 28
