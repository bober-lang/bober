//! Values as JSON: a class, object or interface as an object of its fields in declaration order, an array, fixed
//! array or tuple as an array, and a union's value untagged, which decoding reads as a member that fits, an integer
//! if one does, with a range error once the members that failed have read 16 times the input for each member.
//! Decoding is strict: no unknown keys, a class it makes takes no arguments, and fields left out keep their initial
//! values. Tags on a field (spec 5.3) change its key, leave it out, take the unknown keys, or hold an object as its
//! entries; ../encoding's count too.

import { backslash, colon, comma, cr, digit, dot, isControl, isDigit, lbrace, lbracket, lf, minus, nul, plus, quote,
	rbrace, rbracket, slash, space, tab, zero } from "../ascii"

import * as ascii from "../ascii"
import * as encoding from "../encoding"
import { parseFloat } from "../float"
import { isFinite } from "../math"
import { ParseError, parseInt, utf8 } from "../string"
import { Decodable, Float, has, Integral, tag } from "../types"

/// Tags a field to encode and decode under the key K instead of its name.
export class Name[K extends string] {}
/// Tags a field to leave out of encoding and decoding.
export class Skip {}
/// Tags a field to leave out of encoding when it is empty: null, false, zero, "" or [].
export class OmitEmpty {}
/// Tags an Unknown[] field to take the keys no other field takes, and to encode them back.
export class Rest {}
/// Tags a [K, V][] field to hold an object as its entries, in order; a key twice fails decoding. A key not a string is
/// its JSON, quoted, so a string key spelling another member's JSON, as "1" in i32 | string, reads back as that member.
export class Mapping {}

/// A key and its value's text, as a Rest field holds them.
export type Unknown = [string, string]

/// A NaN or infinite float, which JSON cannot hold.
export class EncodeError {
	value: f64

	constructor(value: f64) { this.value = value }
}

export function encode[T](v: T): string throws EncodeError {
	const t = typeof v
	const items: string[] = []
	switch (t.kind) {
		case "null", "bool", "int": return `${v}`
		case "float":
			if (!isFinite(v)) {
				throw new EncodeError(v)
			}
			return `${v}`
		case "string": return quoted(v)
		case "literal": return encode[string | bool | null](t.value)
		case "union":
			for (const M of t.members) {
				if (v instanceof M) {
					return encode(v)
				}
			}
			return ""
		case "array", "fixed":
			for (const x of v) {
				items.push(encode(x))
			}
			return `[${items.join(",")}]`
		case "tuple":
			for (const f of t.fields) {
				items.push(encode(v[f.name]))
			}
			return `[${items.join(",")}]`
		case "class", "object", "interface":
			for (const f of t.fields) {
				const x = v[f.name]
				if (has(f.tags, Rest) && f.type == Unknown[]) {
					for (const [k, text] of x) {
						items.push(`${quoted(k)}:${text}`)
					}
				} else if (!encoding.omits(f.tags, Skip, OmitEmpty, x)) {
					const k = quoted(encoding.key(f.tags, Name, f.name))
					items.push(`${k}:${if (has(f.tags, Mapping)) entries(x) else encode(x)}`)
				}
			}
			return `{${items.join(",")}}`
		default: return quoted(t.name)
	}
}

/// k's JSON as an object's key: quoted, unless a string's already is.
function keyOf[K](k: K): string throws EncodeError {
	const s = encode(k)
	return if (s[0] == quote) s else quoted(s)
}

/// A Mapping field's entries as an object.
function entries[T](xs: T): string throws EncodeError {
	const items: string[] = []
	switch (T.kind) {
		case "array": for (const e of xs) {
			const kv: string[] = []
			for (const f of T.elem.fields) {
				kv.push(if (kv.length == 0) keyOf(e[f.name]) else encode(e[f.name]))
			}
			items.push(kv.join(":"))
		}
	}
	return `{${items.join(",")}}`
}

export function decode[T extends Decodable](s: string): T throws ParseError {
	const d = new Decoder(s)
	const v = d.value[T]()
	d.space()
	if (d.i != s.length) {
		throw d.error()
	}
	return v
}

/// Whether the JSON of a T may start with byte c.
function starts[T](c: u8): bool {
	switch (T.kind) {
		case "null": return c == ascii.n
		case "bool": return c == ascii.t || c == ascii.f
		case "int", "float": return c == minus || isDigit(c)
		case "string": return c == quote
		case "literal": return starts[string](c) || starts[bool](c)
		case "array", "fixed", "tuple": return c == lbracket
		case "class": return c == lbrace
		default: return false
	}
}

const hex = "0123456789abcdef"
/// The most arrays and objects decoding nests, as each takes a few KiB of a fiber's 1 MiB stack in a debug build.
const maxDepth = 128
/// How many times the input, for each of a union's members, the members that fail may read in all, so decoding
/// reads it at most that many times more, however deep they nest.
const retries: i64 = 16 // i64, as the bound it makes passes 2^31

/// s as a JSON string.
export function quoted(s: string): string {
	let q = ""
	for (const ch of s) {
		q += switch (ch) {
			case quote: "\\\""
			case backslash: "\\\\"
			case lf: "\\n"
			case cr: "\\r"
			case tab: "\\t"
			default: if (isControl(ch)) `\\u00${chr(hex[ch >> 4])}${chr(hex[ch & 15])}` else chr(ch)
		}
	}
	return `"${q}"`
}

/// An object of any keys, each with its value's text for decode to read.
export class Keys {
	all: Unknown[] @Rest = []
}

class Decoder {
	s: string
	i = 0
	depth = 0 // arrays and objects open
	failed: i64 = 0 // bytes read by union members that failed

	constructor(s: string) { this.s = s }

	value[T extends Decodable](): T throws ParseError {
		this.space()
		const at = this.i
		switch (T.kind) {
			case "null":
				this.word("null")
				return null
			case "bool": return this.bool()
			case "int": return this.int[T]()
			case "float": return this.float[T]()
			case "string": return this.string()
			case "literal":
				if (this.value[string | bool | null]() != T.value) {
					throw new ParseError("syntax", at)
				}
				return T.value
			case "union":
				// The members the next byte may start, integers first, as 1 fits a float too and the members are in
				// canonical order (§4.4), not as written; if none decodes, the last one's error.
				const c = this.peek()
				const depth = this.depth
				let last: ParseError | null = null
				for (const ints of [true, false]) {
					for (const M of T.members) {
						if ((M.kind == "int") == ints && starts[M](c)) {
							try {
								return this.value[M]()
							} catch (e: ParseError) {
								this.failed += this.i - at
								if (this.failed > retries * T.members.length * this.s.length) {
									throw new ParseError("range", at)
								}
								last = e
								this.i = at
								this.depth = depth
							}
						}
					}
				}
				throw last ?? this.error()
			case "array":
				const xs: T = []
				this.open(lbracket)
				while (this.more(rbracket, xs.length)) {
					xs.push(this.value[T.elem]())
				}
				return xs
			case "fixed":
				let fixed: T
				this.open(lbracket)
				for (const i of 0 ... T.length - 1) {
					this.comma(i)
					fixed[i] = this.value[T.elem]()
				}
				this.close(rbracket)
				this.depth--
				return fixed
			case "tuple":
				const tuple = new T()
				this.open(lbracket)
				let i = 0
				for (const f of T.fields) {
					this.comma(i)
					tuple[f.name] = this.value[f.type]()
					i++
				}
				this.close(rbracket)
				this.depth--
				return tuple
			case "class":
				const r = new T()
				this.open(lbrace)
				let n = 0
				while (this.more(rbrace, n)) {
					const k = this.i
					const name = this.string()
					this.close(colon)
					let known = false
					for (const f of T.fields) {
						if (!encoding.skips(f.tags, Skip) && !has(f.tags, Rest)
								&& name == encoding.key(f.tags, Name, f.name)) {
							r[f.name] = if (has(f.tags, Mapping)) this.entries[f.type]() else this.value[f.type]()
							known = true
						}
					}
					for (const f of T.fields) {
						if (!known && has(f.tags, Rest) && f.type == Unknown[]) {
							this.space()
							const at = this.i
							this.skip()
							const rest: Unknown[] = r[f.name]
							rest.push([name, this.s.slice(at, this.i).copy()]) // not keeping all of s alive
							known = true
						}
					}
					if (!known) {
						throw new ParseError("syntax", k)
					}
					n++
				}
				return r
			default: throw this.error()
		}
	}

	/// An object as a Mapping field's entries.
	entries[T extends Decodable](): T throws ParseError {
		switch (T.kind) {
			case "array":
				const xs: T = []
				const keys: [string, i32][] = [] // each key and where it starts
				this.space()
				this.open(lbrace)
				while (this.more(rbrace, xs.length)) {
					const at = this.i
					keys.push([this.string(), at])
					this.i = at
					xs.push(this.entry[T.elem]())
				}
				// Sorted, stably, a key twice is next to itself, the later after.
				sortBy(keys, (a, b) => a[0] < b[0])
				for (const i of 1 ... keys.length - 1) {
					if (keys[i][0] == keys[i - 1][0]) {
						throw new ParseError("syntax", keys[i][1])
					}
				}
				return xs
			default: throw this.error()
		}
	}

	/// A key and its value as a tuple.
	entry[T extends Decodable](): T throws ParseError {
		switch (T.kind) {
			case "tuple":
				const e = new T()
				let i = 0
				for (const f of T.fields) {
					if (i == 1) {
						this.close(colon)
					}
					e[f.name] = if (i == 0) this.key[f.type]() else this.value[f.type]()
					i++
				}
				return e
			default: throw this.error()
		}
	}

	/// A key as keyOf writes it: a non-string's JSON, quoted and canonical so a key twice is the same text; else a
	/// string.
	key[T extends Decodable](): T throws ParseError {
		const at = this.i
		const s = this.string()
		if (T.kind == "string") {
			return s
		}
		try {
			const k = decode[T](s)
			if (keyOf(k) == quoted(s)) {
				return k
			}
		} catch (e: ParseError | EncodeError) {}
		this.i = at
		return this.value[T]()
	}

	/// Moves past a value of any type.
	skip() {
		switch (this.peek()) {
			case lbracket:
				this.open(lbracket)
				let n = 0
				while (this.more(rbracket, n)) {
					this.skip()
					n++
				}
			case lbrace:
				this.open(lbrace)
				let n = 0
				while (this.more(rbrace, n)) {
					this.string()
					this.close(colon)
					this.space()
					this.skip()
					n++
				}
			case quote: this.string()
			case ascii.t, ascii.f: this.bool()
			case ascii.n: this.word("null")
			default: this.number()
		}
	}

	bool(): bool {
		const v = this.peek() == ascii.t
		this.word(if (v) "true" else "false")
		return v
	}

	int[T extends Integral](): T {
		const at = this.i
		const text = this.number()
		try {
			return parseInt[T](text)
		} catch (e: ParseError) {
			throw new ParseError(e.kind, at + e.at)
		}
	}

	float[T extends Float](): T {
		const at = this.i
		const text = this.number()
		try {
			return parseFloat[T](text)
		} catch (e: ParseError) {
			throw new ParseError(e.kind, at + e.at)
		}
	}

	number(): string {
		const at = this.i
		this.eat(minus)
		if (!this.eat(zero)) {
			this.digits()
		}
		if (this.eat(dot)) {
			this.digits()
		}
		if (this.eat(ascii.e) || this.eat(ascii.E)) {
			if (!this.eat(plus)) {
				this.eat(minus)
			}
			this.digits()
		}
		return this.s.slice(at, this.i)
	}

	digits() {
		const at = this.i
		while (this.i < this.s.length && isDigit(this.s[this.i])) {
			this.i++
		}
		if (this.i == at) {
			throw this.error()
		}
	}

	string(): string {
		this.expect(quote)
		let out = ""
		while (!this.eat(quote)) {
			const ch = this.next()
			if (ch < space) {
				throw new ParseError("syntax", this.i - 1)
			}
			out += if (ch == backslash) this.escape() else chr(ch)
		}
		return out
	}

	escape(): string {
		const ch = this.next()
		switch (ch) {
			case quote, backslash, slash: return chr(ch)
			case ascii.b: return "\x08"
			case ascii.f: return "\x0c"
			case ascii.n: return "\n"
			case ascii.r: return "\r"
			case ascii.t: return "\t"
			case ascii.u: return utf8(this.unicode())
			default: throw new ParseError("syntax", this.i - 1)
		}
	}

	/// The code point of a \u escape, joining a surrogate pair.
	unicode(): i64 {
		const at = this.i
		const hi = this.hex4()
		if (hi < 0xd800 || hi >= 0xe000) {
			return hi
		}
		if (hi < 0xdc00 && this.eat(backslash) && this.eat(ascii.u)) {
			const lo = this.hex4()
			if (0xdc00 <= lo < 0xe000) {
				return 0x10000 + (hi - 0xd800 << 10) + lo - 0xdc00
			}
		}
		throw new ParseError("syntax", at)
	}

	hex4(): i64 {
		let v: i64 = 0
		for (const _ of 1 ... 4) {
			const d = digit(this.next())
			if (d == null || d >= 16) {
				throw new ParseError("syntax", this.i - 1)
			}
			v = v << 4 | d
		}
		return v
	}

	/// Moves past ch, which opens an array or object, unless maxDepth are open.
	open(ch: u8) {
		if (this.depth == maxDepth) {
			throw new ParseError("range", this.i)
		}
		this.expect(ch)
		this.depth++
	}

	/// Whether another item comes before close, past the comma that follows the nth.
	more(close: u8, n: i32): bool {
		this.space()
		if (this.eat(close)) {
			this.depth--
			return false
		}
		this.comma(n)
		this.space()
		return true
	}

	close(ch: u8) {
		this.space()
		this.expect(ch)
	}

	comma(n: i32) {
		if (n > 0) {
			this.space()
			this.expect(comma)
		}
	}

	space() {
		while (this.peek() == space || this.peek() == tab || this.peek() == lf || this.peek() == cr) {
			this.i++
		}
	}

	word(w: string) {
		for (const ch of w) {
			this.expect(ch)
		}
	}

	peek(): u8 { return if (this.i < this.s.length) this.s[this.i] else nul }

	next(): u8 {
		if (this.i == this.s.length) {
			throw this.error()
		}
		this.i++
		return this.s[this.i - 1]
	}

	eat(ch: u8): bool {
		if (this.peek() != ch) {
			return false
		}
		this.i++
		return true
	}

	expect(ch: u8) {
		if (!this.eat(ch)) {
			throw this.error()
		}
	}

	error(): ParseError { return new ParseError("syntax", this.i) }
}
