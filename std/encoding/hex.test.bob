import { decode, encode } from "./hex"
import { ParseError } from "../parse"

test "encode" {
	assert encode("") == ""
	assert encode("\0\xff") == "00ff"
	assert encode("hello") == "68656c6c6f"
	assert encode("\x01\x23\x45\x67\x89\xab\xcd\xef") == "0123456789abcdef"
}

test "decode" {
	assert decode("") == ""
	assert decode("00ff") == "\0\xff"
	assert decode("68656C6c6f") == "hello"
}

test "decode errors" {
	assert decode("zz") throws new ParseError("syntax", 0)
	assert decode("0") throws new ParseError("syntax", 1)
	assert decode("0g") throws new ParseError("syntax", 1)
	assert decode("00 1") throws new ParseError("syntax", 2)
	assert decode("abc") throws new ParseError("syntax", 3)
}
