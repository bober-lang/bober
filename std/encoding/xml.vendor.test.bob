//! xml.bob against libxml2's tests in vendor/xml-tests/libxml2: each document of test must parse to the tree that
//! libxml2 writes for it in noent, with its entities expanded, or both fail; each of errors must fail where libxml2
//! reports an error.

import { indexOf, stableSort } from "../algo"
import { glob, readFile } from "../fs"
import { base } from "../fs/path"
import { ParseError } from "../string"
import { Node, parse, serialize, xmlnsNS } from "./xml"

const root = "vendor/xml-tests/libxml2"

/// xml.bob does not read external DTDs and entities, whose declarations these need; and where libxml2 differs:
/// it writes a carriage return of a character reference raw, which reads back as a line feed, and resolves the
/// prefixes in an entity's text where the entity is declared rather than used.
const skipped = ["ent2", "xhtml1", "xhtmlcomp", "ent11", "errors/ns-ent.xml"]

test "libxml2" {
	for (const f of glob(`${root}/test/*`)) {
		if (!skipped.includes(base(f))) {
			test `${base(f)}` {
				assert canonical(f) == canonical(`${root}/noent/${base(f)}`)
			}
		}
	}
	for (const f of glob(`${root}/errors/*.xml`)) {
		if (!skipped.includes(`errors/${base(f)}`)) {
			test `errors/${base(f)}` {
				assert (canonical(f) == "error") == (indexOf(readFile(f + ".err"), " error :") >= 0)
			}
		}
	}
}

/// The document at path as XML with its namespace declarations first, as libxml2 writes them, or "error"; under a
/// limit that quadratic-defattr exceeds.
function canonical(path: string): string {
	try {
		const doc = parse(readFile(path), 1 << 16)
		for (const el of doc.elements()) {
			stableSort(el.attrs, (a, b) => a.ns == xmlnsNS && b.ns != xmlnsNS)
		}
		return serialize(doc)
	} catch (e: ParseError) {
		return "error"
	}
}
