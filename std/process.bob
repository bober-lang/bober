//! Running other programs, as Go's os/exec does: with arguments, never through a shell.

import { toCString } from "./c"
import { IoError, checked } from "./io"
import { bober_free, bober_io_run } from "../src/rt.h"

/// Runs the program argv[0], found in PATH unless it is a path, with the arguments after it, and waits for it: its exit
/// status, or 128 + the signal that ended it. Its output and errors go to the file out, if given.
export function run(argv: string[], out: string | null = null): i32 throws IoError {
	const ps = [...argv.map(a => toCString(a)), 0]
	const r = bober_io_run(argv[0], ps, out ?? (0 as u64))
	for (const p of ps) {
		bober_free(p)
	}
	return checked(r, "run", argv[0]) as i32
}
