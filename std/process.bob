//! Running other programs, as Go's os/exec does: with arguments, never through a shell.

import * as sys from "../builtin/sys"

/// The path of the running program's file, as Go's os.Executable.
export function executable(): string throws IoError { return sys.exe() }

/// Runs the program argv[0], found in PATH unless it is a path, with the arguments after it, and waits for it: its exit
/// status, or 128 + the signal that ended it. Its output and errors go to the file out, if given.
export function run(argv: string[], out: string | null = null): i32 throws IoError { return sys.run(argv, out) }

/// The value of the environment variable name, null if it is unset, as Go's os.LookupEnv.
export function env(name: string): string | null { return sys.env(name) }
