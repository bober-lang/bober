import { IoError, Reader } from "../io"
import { ParseError } from "../parse"
import { Inflater, Once, deflate, inflate } from "./deflate"

const repz = "\xed\xca\xdb\x11\x82\x30\x14\x40\xc1\x56\x6e\x05\xf4\xa4\x10\x04\x51\xa2\x21\xc1\x47\xf5\x3a\x76\xe1\xcc\x7e\x9e\x39\x5b\xa7\x14\xf7\x36\xf7\x4b\x1c\x4b\x7e\xac\x31\xe6\x67\x9c\xdb\xf5\xb6\x45\xde\x53\x89\xfa\xdd\x97\xc3\xfb\x15\x43\x3e\x75\xbf\x82\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61"
	+ "\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61"
	+ "\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61"
	+ "\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\x86\x61\x18\xfe\x53\xfc\x01"

const rndz = "\x0d\xce\x4b\x16\x44\x11\x0c\x00\xd1\xad\xd8\x1a\x41\x78\xc4\x3f\x82\xd5\x77\x0f\x6b\x72\x4f\x8d\xd0\x96\xc9\xb8\xe9\x93\x43\xb3\x32\x36\x7d\x39\xc1\xd5\x76\x9f\xe4\x2b\x8f\x9e\x7d\xea\xba\x71\xfd\xc8\x78\x9d\x79\x23\xc8\xb8\x65\x86\x68\x42\x29\x58\xee\x8e\x47\x8a\xe3\x96\xee\x4b\x42\xc3\x1a\x5b\xfa\x2a\xc8\x0c\xd6\x76\x51\x13\xc2\x9c\x7f\x3f\x9f\x1a\x57\x22\x0e\xd4\xbb\x3c\xfd\x2f"
	+ "\x1a\x7f\xa4\x99\x35\x9c\xc7\xe3\x03\x56\x67\x32\x19\xf7\x29\x73\x08\x66\x81\xb4\xec\x30\x03\x6d\x71\x02\xa5\x3a\x9c\x61\x24\x51\x72\xa2\x57\x88\x63\x3c\x3f\x88\x92\x88\xb1\x47\xfb\xa2\x71\xe9\x32\xb7\xcd\x69\x3a\x38\xa9\x0a\xc9\x08\xf8\x1e\xd0\x67\x47\xf7\x2b\xaf\x0d\x72\x2d\xf1\x1f\x9c\x05\xa9\x5c\xc5\x79\x9d\x90\xe0\xc4\x77\xc7\xab\xf5\x3f\x17\x1a\xda\xa1\xaa\xea\xea\xd4\x9d\x8d"
	+ "\x6c\xcf\x7b\x9e\xd9\x59\xca\xd7\x67\x3f\x8d\xe1\x55\x2e\x1b\x42\xf4\x66\x5d\x97\xce\xb2\xdf\x6d\x99\x93\xbf\x3a\x00\xe3\x10\x98\x91\x55\x5a\xdb\xd1\x87\xc5\xb0\x71\xa9\x81\xec\x50\x21\x91\x46\xa6\x58\x45\x87\xa8\x6c\x6e\xdd\x81\x9a\xaf\x7b\xe3\x61\xed\xd8\xdc\x6e\x88\xbd\xd1\x0f"

/// 100 KiB of a sentence.
function sentences(): string {
	let t = ""
	while (t.length < 102400) {
		t += "the quick brown fox jumps over the lazy dog. "
	}
	return t.slice(0, 102400)
}

/// n bytes of lowercase letters and spaces from a linear congruential generator, as the fixtures were made.
function noise(n: i32): string {
	let x: i64 = 1
	let s = ""
	for (const i of 1 ... n) {
		x = (x * 1103515245 + 12345) & 0x7fffffff
		const k = ((x >> 16) % 27) as i32
		s += chr((if (k == 26) 32 else 97 + k) as u8)
	}
	return s
}

/// Hands out one byte per read.
class Drip implements Reader {
	private s: string
	private at = 0

	constructor(s: string) { this.s = s }

	read(n: i32): string | null throws IoError {
		if (this.at >= this.s.length) {
			return null
		}
		this.at += 1
		return this.s.slice(this.at - 1, this.at)
	}
}

test "zlib's streams inflate" {
	assert inflate("\x03\x00") == ""
	assert inflate("\xcb\x48\xcd\xc9\xc9\x07\x00") == "hello"
	assert inflate(repz) == sentences()
	assert inflate(rndz) == noise(400)
	const z = new Inflater(new Drip("\x78\x9c\xab\xca\xc9\x4c\x52\x28\x2f\x4a\x2c\x28\x48\x4d\x51\x48\x49\x4d\xcb\x49\x2c\x49\x05\x00\x51\x64\x07\xba"),
		true)
	assert z.read(100) == "zlib wrapped deflate" && z.read(100) == null
	const bad = new Inflater(new Once("\x78\x9c\xcb\x48\xcd\xc9\xc9\x07\x00\x06\x2c\x02\x16"), true)
	assert bad.read(100) == "hello"
	assert bad.read(100) throws new IoError("Protocol", "inflate", "byte 13")
	// Not deflate, a 64 KiB window, a preset dictionary, a wrong check.
	for (const h of ["\x79\x18", "\x88\x1c", "\x78\x20", "\x78\x9d"]) {
		const z = new Inflater(new Once(h + "\xcb\x48\xcd\xc9\xc9\x07\x00\x06\x2c\x02\x15"), true)
		assert z.read(100) throws new IoError("Protocol", "inflate", "byte 2")
	}
}

test "deflate round trips" {
	const big = sentences() + noise(1 << 20) + sentences()
	for (const s of ["", "hello",
		"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", noise(400),
		sentences(), big]) {
		for (const level of [0, 1, 6, 9]) {
			assert inflate(deflate(s, level)) == s
		}
	}
	assert deflate(sentences()).length < 1024 && deflate(noise(1 << 16)).length < 63000
	assert deflate("hello", 0) == "\x01\x05\x00\xfa\xffhello"
}

test "an Inflater streams in the sizes asked" {
	const r = new Inflater(new Drip(repz))
	let out = ""
	while (true) {
		const c = r.read(7)
		if (c == null) {
			break
		}
		assert c.length <= 7
		out += c
	}
	assert out == sentences()
}

test "errors are placed" {
	assert inflate("") throws new ParseError("syntax", 0)
	assert inflate("\x07") throws new ParseError("syntax", 1)
	assert inflate("\xcb\x48\xcd") throws new ParseError("syntax", 3)
	assert inflate("\xcb\x48\xcd\xc9\xc9\x07\x00".slice(0, 5)) throws new ParseError("syntax", 5)
	assert new Inflater(new Drip("\x07")).read(1) throws new IoError("Protocol", "inflate", "byte 1")
}

/// Throws once, after its first byte, then hands out the rest.
class Hiccup implements Reader {
	private s: string
	private at = 0

	constructor(s: string) { this.s = s }

	read(n: i32): string | null throws IoError {
		this.at += 1
		if (this.at == 2) {
			throw new IoError("Protocol", "read", "hiccup")
		}
		return if (this.at == 1) this.s.slice(0, 1) else if (this.at == 3) this.s.slice(1, this.s.length) else null
	}
}

test "an Inflater whose source threw stays broken" {
	const r = new Inflater(new Hiccup("\xcb\x48\xcd\xc9\xc9\x07\x00"))
	assert r.read(100) throws new IoError("Protocol", "read", "hiccup")
	assert r.read(100) throws new IoError("Protocol", "read", "hiccup")
}
