import { bits, fromBits } from "../builtin/math"
import { e, isDigit, zero } from "./ascii"
import { compose, formatFloat, parseFloat, scanFloat } from "./float"
import { ParseError } from "./string"
import { strtod } from "stdlib.h"

/// From Go's strconv ftoa tests: value, format, precision, text.
const formats: [f64, "e" | "f" | "g", i32, string][] = [[1.0, "e", 5, "1.00000e+0"], [1.0, "f", 5, "1.00000"],
	[1.0, "g", 5, "1"], [1.0, "g", -1, "1"], [20.0, "g", -1, "20"], [1234567.8, "g", -1, "1234567.8"],
	[200000.0, "g", -1, "200000"], [2000000.0, "g", -1, "2000000"], [1e10, "g", -1, "10000000000"],
	[400.0, "g", 2, "4e+2"], [40.0, "g", 2, "40"], [4.0, "g", 2, "4"], [0.4, "g", 2, "0.4"],
	[0.0004, "g", 2, "0.0004"], [0.00004, "g", 2, "4e-5"], [0.0, "e", 5, "0.00000e+0"], [0.0, "f", 5, "0.00000"],
	[0.0, "g", 5, "0"], [0.0, "g", -1, "0"], [0.0, "e", -1, "0e+0"], [-1.0, "e", 5, "-1.00000e+0"],
	[-1.0, "f", 5, "-1.00000"], [-1.0, "g", -1, "-1"], [12.0, "e", 5, "1.20000e+1"], [12.0, "f", 5, "12.00000"],
	[12.0, "g", 5, "12"], [123456700.0, "e", 5, "1.23457e+8"], [123456700.0, "f", 5, "123456700.00000"],
	[123456700.0, "g", 5, "1.2346e+8"], [123456700.0, "g", -1, "123456700"], [1.2345e6, "e", 3, "1.234e+6"],
	[1.2355e6, "e", 3, "1.236e+6"], [1.2345, "f", 3, "1.234"], [1.2355, "f", 3, "1.236"],
	[1234567890123456.5, "e", 15, "1.234567890123456e+15"], [1234567890123457.5, "e", 15, "1.234567890123458e+15"],
	[108678236358137.625, "g", -1, "108678236358137.62"], [1e23, "e", 17, "9.99999999999999916e+22"],
	[1e23, "f", 17, "99999999999999991611392.00000000000000000"], [1e23, "g", 17, "9.9999999999999992e+22"],
	[1e23, "e", -1, "1e+23"], [1e23, "f", -1, "100000000000000000000000"], [1e23, "g", -1, "1e+23"],
	[99999999999999974834176.0, "e", 17, "9.99999999999999748e+22"],
	[99999999999999974834176.0, "g", -1, "9.999999999999997e+22"],
	[100000000000000008388608.0, "f", -1, "100000000000000010000000"],
	[100000000000000008388608.0, "g", -1, "1.0000000000000001e+23"], [5e-324, "g", -1, "5e-324"],
	[-5e-324, "g", -1, "-5e-324"], [32.0, "g", 0, "3e+1"], [0.9, "f", 1, "0.9"], [0.09, "f", 1, "0.1"],
	[0.0999, "f", 1, "0.1"], [0.05, "f", 1, "0.1"], [0.05, "f", 0, "0"], [0.5, "f", 0, "0"], [1.5, "f", 0, "2"],
	[2.2250738585072012e-308, "g", -1, "2.2250738585072014e-308"],
	[2.2250738585072011e-308, "g", -1, "2.225073858507201e-308"], [383260575764816448.0, "f", 0, "383260575764816448"],
	[383260575764816448.0, "g", -1, "383260575764816450"], [498484681984085570.0, "f", -1, "498484681984085570"],
	[-5.8339553793802237e+23, "g", -1, "-5.8339553793802237e+23"],
	[1.7976931348623157e308, "g", -1, "1.7976931348623157e+308"], [0.1, "g", -1, "0.1"], [0.3, "g", -1, "0.3"],
	[1e-7, "g", -1, "1e-7"], [0.000001, "g", -1, "0.000001"], [1e21, "g", -1, "1e+21"],
	[1e20, "g", -1, "100000000000000000000"], [123456.0, "g", -1, "123456"],
	[1e21, "f", 2, "1000000000000000000000.00"]]

/// From Go's strconv atof tests: text and the shortest text of the float it reads as.
const parses: [string, string][] = [["1", "1"], ["1e23", "1e+23"], ["1E23", "1e+23"],
	["100000000000000000000000", "1e+23"], ["1e-100", "1e-100"], ["123456700", "123456700"],
	["99999999999999974834176", "9.999999999999997e+22"], ["100000000000000000000001", "1.0000000000000001e+23"],
	["100000000000000008388608", "1.0000000000000001e+23"], ["100000000000000016777215", "1.0000000000000001e+23"],
	["100000000000000016777216", "1.0000000000000003e+23"], ["-1", "-1"], ["-0.1", "-0.1"], ["-0", "-0"],
	["1e-20", "1e-20"], ["625e-3", "0.625"], ["0", "0"], ["0e0", "0"], ["-0e0", "-0"], ["0e-0", "0"],
	["0e+01234567890123456789", "0"], ["0.00e-01234567890123456789", "0"], ["0e348", "0"],
	["1.7976931348623157e308", "1.7976931348623157e+308"], ["-1.7976931348623157e308", "-1.7976931348623157e+308"],
	["1.7976931348623158e308", "1.7976931348623157e+308"], ["1e308", "1e+308"], ["1e-305", "1e-305"],
	["1e-308", "1e-308"], ["1e-309", "1e-309"], ["1e-310", "1e-310"], ["1e-322", "1e-322"], ["5e-324", "5e-324"],
	["4e-324", "5e-324"], ["3e-324", "5e-324"], ["2e-324", "0"], ["1e-350", "0"], ["1e-400000", "0"],
	["1e-4294967296", "0"], ["2.2250738585072012e-308", "2.2250738585072014e-308"],
	["2.2250738585072011e-308", "2.225073858507201e-308"], ["4.630813248087435e+307", "4.630813248087435e+307"],
	["22.222222222222222", "22.22222222222222"], ["1.00000000000000011102230246251565404236316680908203125", "1"],
	["1.00000000000000011102230246251565404236316680908203124", "1"],
	["1.00000000000000011102230246251565404236316680908203126", "1.0000000000000002"],
	["1.00000000000000033306690738754696212708950042724609375", "1.0000000000000004"],
	["1090544144181609348671888949248", "1.0905441441816093e+30"],
	["1090544144181609348835077142190", "1.0905441441816094e+30"], ["0.000001", "0.000001"], ["1e-7", "1e-7"],
	["123.456", "123.456"]]

function repeat(s: string, n: i32): string {
	let out = ""
	for (const _ of 1 ... n) {
		out += s
	}
	return out
}

test "format table" {
	for (const [x, fmt, prec, want] of formats) {
		test `${want} ${fmt} ${prec}` {
			assert formatFloat(x, fmt, prec) == want
		}
	}
	const zero: f64 = 0.0
	const third: f64 = 1.0 / 3.0
	assert formatFloat(zero / zero) == "NaN" && formatFloat(1.0 / zero) == "Infinity"
		&& formatFloat(-1.0 / zero) == "-Infinity"
	assert formatFloat(-zero) == "-0" && formatFloat(third) == "0.3333333333333333"
	assert formatFloat(1.1 as f32) == "1.1" && formatFloat(16777216.0 as f32) == "16777216"
		&& formatFloat(1e-45 as f32) == "1e-45" && formatFloat(3.4028235e38 as f32) == "3.4028235e+38"
}

test "parse table" {
	for (const [s, want] of parses) {
		test `${s}` {
			assert formatFloat(parseFloat(s)) == want
		}
	}
	assert parseFloat("2." + repeat("2", 4000) + "e+1") == 22.22222222222222
	assert parseFloat("1.00000000000000011102230246251565404236316680908203125" + repeat("0", 10000) + "1")
		== 1.0000000000000002
	assert parseFloat[f32]("1.000000059604644775390625") == (1.0 as f32)
		&& parseFloat[f32]("1.000000059604644775390626") == (1.0000001 as f32)
		&& parseFloat[f32]("340282346638528859811704183484516925440") == (3.4028235e38 as f32)
		&& parseFloat[f32]("5e-45") == (6e-45 as f32) && parseFloat[f32]("1e-46") == (0.0 as f32)
	assert parseFloat[f32]("3.4028236e38") throws new ParseError("range", 0)
	assert parseFloat[f32]("1e39") throws new ParseError("range", 0)
	assert parseFloat[f32]("3.4028235e38") == (3.4028235e38 as f32)
}

test "rejects" {
	assert parseFloat("") throws new ParseError("syntax", 0)
	assert parseFloat("+1") throws new ParseError("syntax", 0)
	assert parseFloat("1x") throws new ParseError("syntax", 1)
	assert parseFloat("1.1.") throws new ParseError("syntax", 3)
	assert parseFloat(".5") throws new ParseError("syntax", 0)
	assert parseFloat("1.") throws new ParseError("syntax", 2)
	assert parseFloat("1.e5") throws new ParseError("syntax", 2)
	assert parseFloat("1e") throws new ParseError("syntax", 2)
	assert parseFloat("1e-") throws new ParseError("syntax", 3)
	assert parseFloat("1e+") throws new ParseError("syntax", 3)
	assert parseFloat(" 1") throws new ParseError("syntax", 0)
	assert parseFloat("1_0") throws new ParseError("syntax", 1)
	assert parseFloat("-") throws new ParseError("syntax", 1)
	assert parseFloat("--1") throws new ParseError("syntax", 1)
	assert parseFloat("0x1p3") throws new ParseError("syntax", 1)
	assert parseFloat("inf") throws new ParseError("syntax", 0)
	assert parseFloat("1.7976931348623159e308") throws new ParseError("range", 0)
	assert parseFloat("2e308") throws new ParseError("range", 0)
	assert parseFloat("1e400000") throws new ParseError("range", 0)
	assert parseFloat("-1e310") throws new ParseError("range", 0)
	assert parseFloat("1e+4294967296") throws new ParseError("range", 0)
	const [v, end] = scanFloat("x=-1.5e3;", 2)
	assert v == -1500.0 && end == 8
}

/// The significant digits of s, a decimal.
function digits(s: string): string {
	let out = ""
	for (const ch of s) {
		if (ch == e) {
			break
		}
		if (isDigit(ch) && (out.length > 0 || ch != zero)) {
			out += chr(ch)
		}
	}
	while (out.length > 0 && out[out.length - 1] == zero) {
		out = out.slice(0, out.length - 1)
	}
	return out
}

/// On floats of all sizes, the digits are the runtime's, which tries each length in turn, and C's strtod reads
/// back every text.
test "round trips" {
	let seed: u64 = 1
	for (const _ of 1 ... 300) {
		seed = seed * 6364136223846793005 + 1442695040888963407
		const m = (seed >> 11) as f64
		let x = m
		for (const _ of 1 ... ((seed % 40) as i32)) {
			x = if (seed & 1024 != 0) x * 977.0 else x / 977.0
		}
		if (seed & 512 != 0) {
			x = -x
		}
		test `${x}` {
			const s = formatFloat(x)
			assert digits(s) == digits(`${x}`)
			assert parseFloat(s) == x
			assert strtod(s, 0) == x
		}
	}
}

/// Random bit patterns, as floats of both sizes, read back from their shortest digits, which are the fewest: one
/// digit fewer, rounded, reads as another float. 18 fixed digits, by Ryū, round down as 19 by the big decimal say.
test "random bits" {
	let x: u64 = 88172645463325252
	for (const _ of 1 ... 4000) {
		x ^= x << 13
		x ^= x >> 7
		x ^= x << 17
		const bexp = ((x >> 52) & 0x7ff) as i32
		const frac = x & 0xfffffffffffff
		if (bexp != 0x7ff) {
			const v = if (bexp == 0) compose(frac, -1074) else compose(frac | 0x10000000000000, bexp - 1075)
			const y = if (x >> 63 != 0) -v else v
			const s = formatFloat(y)
			test `${s}` {
				assert parseFloat(s) == y
				const nd = digits(s).length
				assert nd <= 1 || parseFloat(formatFloat(y, "e", nd - 2)) != y
				const e18 = formatFloat(v, "e", 18)
				assert e18[19] >= zero + 5 || formatFloat(v, "e", 17) == e18.slice(0, 19) + e18.slice(20, e18.length)
			}
		}
		const bexp32 = ((x >> 23) & 0xff) as i32
		const frac32 = x & 0x7fffff
		if (bexp32 != 0xff) {
			const v = (if (bexp32 == 0) compose(frac32, -149) else compose(frac32 | 0x800000, bexp32 - 150)) as f32
			const y = if (x & 0x80000000 != 0) -v else v
			const s = formatFloat(y)
			test `${s}` {
				assert parseFloat[f32](s) == y
				const nd = digits(s).length
				assert nd <= 1 || parseFloat[f32](formatFloat(y, "e", nd - 2)) != y
			}
		}
	}
}

test "bits" {
	assert bits(0.0) == 0
	assert bits(-0.0) == 0x8000000000000000
	assert bits(1.0) == 0x3ff0000000000000
	assert bits(0.1) == 0x3fb999999999999a
	assert bits(5e-324) == 1
	assert bits[f64](1.0 / 0.0) == 0x7ff0000000000000
	const patterns: u64[] = [0, 1, 0x3ff0000000000000, 0x8000000000000000, 0x7ff0000000000000, 0x7ff8000000000001,
		0xfff4000000000abc, 0xffffffffffffffff]
	for (const b of patterns) {
		assert bits(fromBits[f64](b)) == b
	}
	assert fromBits[f64](0xc000000000000000) == -2.0
}
