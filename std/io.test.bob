import { makeTempDir, open, removeAll } from "./fs"
import { copy, readAll } from "./io"

test "a file reads back what was written" {
	const dir = makeTempDir("bober-io-")
	const path = `${dir}/f`
	const w = open(path, "w")
	w.write("abc")
	w.write("")
	w.write("def\n")
	w.close()
	const r = open(path)
	assert r.read(2) == "ab"
	assert readAll(r) == "cdef\n"
	assert r.read(1) == null
	// Many reads at the end, of 64 KiB each, which share a buffer.
	for (const _ of 1 ... 30000) {
		assert r.read(1 << 16) == null
	}
	r.close()
	const a = open(path)
	const b = open(`${path}.copy`, "w")
	b.write("> ")
	assert copy(a, b) == 7
	a.close()
	b.close()
	const c = open(`${path}.copy`)
	assert readAll(c) == "> abcdef\n"
	c.close()
	removeAll(dir)
}

test "errors name the call and their kind" {
	assert open("none/x") throws new IoError("NotFound", "open", "none/x")
	const e = new IoError("NotFound", "open", "/x")
	assert e.kind == "NotFound" && e.message() == "open /x: NotFound"
}
