import * as ascii from "./ascii"

test "spacing and control" {
	assert " \t\n\x0b\x0c\r".every(ascii.isSpace)
	assert !"a0_\x00\x7f".some(ascii.isSpace)
	assert " \t".every(ascii.isBlank)
	assert !"\n\ra".some(ascii.isBlank)
	assert "\x00\t\x1f\x7f".every(ascii.isControl)
	assert !" a~\x80".some(ascii.isControl)
}

test "printing" {
	assert " a~".every(ascii.isPrint)
	assert !"\x1f\x7f\x80".some(ascii.isPrint)
	assert "!a~".every(ascii.isGraphic)
	assert !" \x7f".some(ascii.isGraphic)
	assert "!/:@[`{~".every(ascii.isPunctuation)
	assert !" 09azAZ\x7f".some(ascii.isPunctuation)
}

test "letters and digits" {
	assert "0123456789".every(ascii.isDigit)
	assert !"/:a".some(ascii.isDigit)
	assert "09afAF".every(ascii.isHexDigit)
	assert !"gG/:@`".some(ascii.isHexDigit)
	assert "az".every(ascii.isLower)
	assert !"`{AZ".some(ascii.isLower)
	assert "AZ".every(ascii.isUpper)
	assert !"@[az".some(ascii.isUpper)
	assert "azAZ".every(ascii.isAlphabetic)
	assert !"@[`{0".some(ascii.isAlphabetic)
	assert "azAZ09".every(ascii.isAlphanumeric)
	assert !"_ $\x80".some(ascii.isAlphanumeric)
}

test "case" {
	assert ascii.toLower(ascii.A) == ascii.a && ascii.toLower(ascii.z) == ascii.z && ascii.toLower(ascii.at) == ascii.at
	assert ascii.toUpper(ascii.z) == ascii.Z && ascii.toUpper(ascii.A) == ascii.A
		&& ascii.toUpper(ascii.lbrace) == ascii.lbrace
}

test "digit values" {
	assert ascii.digit(ascii.zero) == 0 && ascii.digit(ascii.nine) == 9
	assert ascii.digit(ascii.a) == 10 && ascii.digit(ascii.F) == 15 && ascii.digit(ascii.z) == 35
		&& ascii.digit(ascii.Z) == 35
	assert ascii.digit(ascii.slash) == null && ascii.digit(ascii.colon) == null && ascii.digit(ascii.at) == null
	assert ascii.digit(ascii.lbracket) == null && ascii.digit(ascii.backtick) == null
		&& ascii.digit(ascii.lbrace) == null && ascii.digit(0xC3) == null
}
