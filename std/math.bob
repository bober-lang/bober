/// The bits of 1 - 2^-4 and 1 + 0x1.09p-4, about 1 where log takes log(1 + r) directly.
const near1lo = asU64(0.9375)
const near1hi = asU64(1.064697265625)

function logF64(x: f64): f64 {
	let ix = asU64(x)
	const top = (ix >> 48) as u32
	if (ix - near1lo < near1hi - near1lo) {
		if (ix == 0x3ff0000000000000) {
			return 0.0
		}
		const r = x - 1.0
		const r2 = r * r
		const r3 = r * r2
		let y = r3
			* (logB[1] + r * logB[2] + r2 * logB[3]
			+ r3 * (logB[4] + r * logB[5] + r2 * logB[6] + r3 * (logB[7] + r * logB[8] + r2 * logB[9] + r3 * logB[10])))
		// r - r^2/2 to more than f64: r split so that rhi^2 is exact
		let w = r * 134217728.0
		const rhi = r + w - w
		const rlo = r - rhi
		w = rhi * rhi * logB[0]
		const hi = r + w
		let lo = r - hi + w
		lo += logB[0] * rlo * (rhi + r)
		y += lo
		y += hi
		return y
	}
	if (top - 0x0010 >= 0x7ff0 - 0x0010) {
		// below 2^-1022, or inf, or NaN
		if (ix * 2 == 0) {
			return -1.0 / 0.0
		}
		if (ix == 0x7ff0000000000000) {
			return x
		}
		if ((top & 0x8000) != 0 || (top & 0x7ff0) == 0x7ff0) {
			return (x - x) / (x - x)
		}
		ix = asU64(x * two52) - (52 << 52)
	}
	// log(x) = k ln2 + log(c) + log(z/c), r = z/c - 1
	const [k, iz, i] = reduce(ix, 0x3fe6000000000000, 7)
	const invc = logTab[2 * i]
	const logc = logTab[2 * i + 1]
	const z = asF64(iz)
	const r = (z - logTab2[2 * i] - logTab2[2 * i + 1]) * invc
	const kd = k as f64
	// hi + lo = r + log(c) + k ln2
	const w = kd * logLn2hi + logc
	const hi = w + r
	const lo = w - hi + r + kd * logLn2lo
	const r2 = r * r
	return lo + r2 * logA[0] + r * r2 * (logA[1] + r * logA[2] + r2 * (logA[3] + r * logA[4])) + hi
}

/// 1/ln2 in two parts, the first with 32 trailing zero bits.
const invln2hi = 1.4426950407214463
const invln2lo = 1.6751713164886512e-10

/// log2(1 + r) - r/ln2 for |r| < 1/(2 N), from r^2.
const log2A: f64[] = [-0.7213475204444882, 0.4808983469629985, -0.36067375954075914, 0.2885390073180969,
	-0.2404693555628422, 0.2061202382173603]

