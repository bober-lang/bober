	if (i >= 0x3f800000 - (1 << 23)) {
		y = 0.5 * log1pF32(2.0 * (ax / (1.0 - ax)))
	} else if (i >= 0x3f800000 - (32 << 23)) {
		y = 0.5 * log1pF32(2.0 * ax + 2.0 * ax * ax / (1.0 - ax))
	}
	return if (asU32(x) >> 31 != 0) -y else y
}

