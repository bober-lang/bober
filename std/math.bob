		q = 1.0 + s * (sa1 + s * (sa2 + s * (sa3 + s * (sa4 + s * (sa5 + s * (sa6 + s * (sa7 + s * sa8)))))))
	} else {
		r = rb0 + s * (rb1 + s * (rb2 + s * (rb3 + s * (rb4 + s * (rb5 + s * rb6)))))
		q = 1.0 + s * (sb1 + s * (sb2 + s * (sb3 + s * (sb4 + s * (sb5 + s * (sb6 + s * sb7))))))
	}
	const z = asF64(asU64(x) & 0xffffffff00000000) // so that z² is exact, and -x² = -z² + (z - x)(z + x)
	return expF64(-z * z - 0.5625) * expF64((z - x) * (z + x) + r / q) / x
