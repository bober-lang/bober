/// pp(z)/qq(z).
function pq(z: f64): f64 {
	return (pp0 + z * (pp1 + z * (pp2 + z * (pp3 + z * pp4))))
		/ (1.0 + z * (qq1 + z * (qq2 + z * (qq3 + z * (qq4 + z * qq5)))))
