const t13f: f32 = -0.00031275415676645935
const t14f: f32 = 0.00033552918466739357
const u0f: f32 = -0.07721566408872604
const u1f: f32 = 0.6328270435333252
const u2f: f32 = 1.4549225568771362
const u3f: f32 = 0.9777175188064575
const u4f: f32 = 0.2289637327194214
const u5f: f32 = 0.013381091877818108
const v1f: f32 = 2.4559779167175293
const v2f: f32 = 2.1284897327423096
const v3f: f32 = 0.7692851424217224
const v4f: f32 = 0.10422264784574509
const v5f: f32 = 0.0032170924823731184
const s0f: f32 = -0.07721566408872604
const s1f: f32 = 0.21498242020606995
const s2f: f32 = 0.3257787823677063
const s3f: f32 = 0.14635047316551208
const s4f: f32 = 0.026642270386219025
const s5f: f32 = 0.0018402845598757267
const s6f: f32 = 3.194753298885189e-05
const r1f: f32 = 1.3920053243637085
const r2f: f32 = 0.7219355702400208
const r3f: f32 = 0.1719338595867157
const r4f: f32 = 0.018645919859409332
const r5f: f32 = 0.0007779424777254462
const r6f: f32 = 7.32668422642746e-06
const w0f: f32 = 0.418938547372818
const w1f: f32 = 0.0833333358168602
const w2f: f32 = -0.0027777778450399637
const w3f: f32 = 0.0007936505717225373
const w4f: f32 = -0.0005951875355094671
const w5f: f32 = 0.0008363398956134915
const w6f: f32 = -0.0016309292986989021

/// sinpi in f32 to |x| mod 2's reduction, then in f64.
function sinpif(x0: f32): f32 {
	const x = 2.0 * (x0 * 0.5 - floorF32(x0 * 0.5))
	const n = (((x * 4.0) as i32) + 1) / 2
	const y = ((x - (n as f32) * 0.5) as f64) * 3.141592653589793
	return switch (n) {
		case 1: kCosf(y)
		case 2: kSinf(-y)
		case 3: -kCosf(y)
		default: kSinf(y)
	}
}

function lgammaF32(x0: f32): [f32, i32] {
	const sign = asU32(x0) >> 31 != 0
	const ix = asU32(x0) & 0x7fffffff
	const x = if (sign) -x0 else x0
	if (ix >= 0x7f800000) {
		return [x0 * x0, 1]
	}
	if (ix < 0x35000000) {
		return [-logF32(x), if (sign) -1 else 1] // |x| < 2^-21
	}
	let s = 1
	let nadj: f32 = 0.0
	if (sign) {
		let t = sinpif(x)
		if (t == 0.0) {
			return [1.0 / (x - x), 1]
		}
		if (t > 0.0) {
			s = -1
		} else {
			t = -t
		}
		nadj = logF32(pif / (t * x))
	}
	let r: f32 = 0.0
	if (ix == 0x3f800000 || ix == 0x40000000) {
		r = 0.0
	} else if (ix < 0x40000000) {
		let y: f32 = 0.0
		let i = 0
		if (ix <= 0x3f666666) {
			r = -logF32(x)
			if (ix >= 0x3f3b4a20) {
				y = 1.0 - x
			} else if (ix >= 0x3e6d3308) {
				y = x - (tcf - 1.0)
				i = 1
			} else {
				y = x
				i = 2
			}
		} else if (ix >= 0x3fdda618) {
			y = 2.0 - x
		} else if (ix >= 0x3f9da620) {
			y = x - tcf
			i = 1
		} else {
			y = x - 1.0
			i = 2
		}
		if (i == 0) {
			const z = y * y
			const p1 = a0f + z * (a2f + z * (a4f + z * (a6f + z * (a8f + z * a10f))))
			const p2 = z * (a1f + z * (a3f + z * (a5f + z * (a7f + z * (a9f + z * a11f)))))
			r += y * p1 + p2 - 0.5 * y
		} else if (i == 1) {
			const z = y * y
			const w = z * y
			const p1 = t0f + w * (t3f + w * (t6f + w * (t9f + w * t12f)))
			const p2 = t1f + w * (t4f + w * (t7f + w * (t10f + w * t13f)))
			const p3 = t2f + w * (t5f + w * (t8f + w * (t11f + w * t14f)))
			r += tff + (z * p1 - (ttf - w * (p2 + y * p3)))
		} else {
			const p1 = y * (u0f + y * (u1f + y * (u2f + y * (u3f + y * (u4f + y * u5f)))))
			const p2 = 1.0 + y * (v1f + y * (v2f + y * (v3f + y * (v4f + y * v5f))))
			r += -0.5 * y + p1 / p2
		}
	} else if (ix < 0x41000000) {
		const i = x as i32
		const y = x - (i as f32)
		const p = y * (s0f + y * (s1f + y * (s2f + y * (s3f + y * (s4f + y * (s5f + y * s6f))))))
		const q = 1.0 + y * (r1f + y * (r2f + y * (r3f + y * (r4f + y * (r5f + y * r6f)))))
		r = 0.5 * y + p / q
		if (i >= 3) {
			let z: f32 = 1.0
			for (const k of 0 ... (i - 3)) {
				z *= y + ((i - 1 - k) as f32)
			}
			r += logF32(z)
		}
	} else if (ix < 0x5c800000) {
		const t = logF32(x)
		const z = 1.0 / x
		const y = z * z
		const w = w0f + z * (w1f + y * (w2f + y * (w3f + y * (w4f + y * (w5f + y * w6f)))))
		r = (x - 0.5) * (t - 1.0) + w
	} else {
		r = x * (logF32(x) - 1.0)
	}
	return [if (sign) nadj - r else r, s]
}

// # Bessel functions
//
// Bessel functions of the first and second kinds, j and y, of order 0, 1 and n.
//
// j0 and j1 are rational functions of x^2 below 2; y0 and y1 add (2/pi) j(x) log(x) to one. From 2 on, all four are
// sqrt(2/(pi x)) (p(x) cos(x0) -+ q(x) sin(x0)), x0 = x - pi/4 or x - 3pi/4, p and q rational functions of 1/x^2 in
// four bands of x, and sin(x0), cos(x0) by sin(x) +- cos(x) = -cos(2x)/(sin(x) -+ cos(x)) where that cancels. jn
// recurs forward from j0 and j1 where n < x, else backward from a continued fraction, normalized by j0 or j1; yn
// recurs forward from y0 and y1. Past 2^302, jn and yn take the asymptotic form alone.
//
// Ported from musl 1.2.5, MIT, Copyright © 2005-2020 Rich Felker, et al. (vendor/musl/COPYRIGHT), from FreeBSD:
// Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved. Developed at SunSoft, a Sun Microsystems, Inc.
// business. Permission to use, copy, modify, and distribute this software is freely granted, provided that this notice
// is preserved. f32 versions by Ian Lance Taylor, Cygnus Support.
/// 1/sqrt(pi) and 2/pi.
const invsqrtpi = 5.64189583547756279280e-01
const tpi = 6.36619772367581382433e-01
const invsqrtpif: f32 = 5.6418961287e-01
const tpif: f32 = 6.3661974669e-01

/// x's high 32 bits.
function high(x: f64): u32 { return (asU64(x) >> 32) as u32 }

/// p[0] + z (p[1] + z (p[2] + ...)), as musl writes it out.
function poly(p: f64[], z: f64): f64 {
	let i = p.length - 1
	let r = p[i]
	while (i > 0) {
		i--
		r = p[i] + z * r
	}
	return r
}

function polyf(p: f32[], z: f32): f32 {
	let i = p.length - 1
	let r = p[i]
	while (i > 0) {
		i--
		r = p[i] + z * r
	}
	return r
}

/// The band of p's and q's tables for x >= 2 of high word ix: [8, inf), [4.5454, 8), [2.8571, 4.5454) or [2, 2.8571).
function band(ix: u32): i32 {
	return if (ix >= 0x40200000) 0 else if (ix >= 0x40122e8b) 1 else if (ix >= 0x4006db6d) 2 else 3
}

function bandf(ix: u32): i32 {
	return if (ix >= 0x41000000) 0 else if (ix >= 0x409173eb) 1 else if (ix >= 0x4036d917) 2 else 3
}

