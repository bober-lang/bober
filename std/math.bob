function erfF64(x: f64): f64 {
	const sign = (asU64(x) >> 63) as i32
	const ix = ((asU64(x) >> 32) as u32) & 0x7fffffff
	if (ix >= 0x7ff00000) {
		return ((1 - 2 * sign) as f64) + 1.0 / x // ±1, or NaN
	}
	if (ix < 0x3feb0000) {
		// |x| < 0.84375
		if (ix < 0x3e300000) {
			return 0.125 * (8.0 * x + efx8 * x) // |x| < 2^-28
		}
		return x + x * pq(x * x)
	}
	const y = if (ix < 0x40180000) 1.0 - erfc2(ix, x) else 1.0 // |x| < 6
	return if (sign != 0) -y else y
}

function erfcF64(x: f64): f64 {
	const sign = (asU64(x) >> 63) as i32
	const ix = ((asU64(x) >> 32) as u32) & 0x7fffffff
	if (ix >= 0x7ff00000) {
		return ((2 * sign) as f64) + 1.0 / x // 0 or 2, or NaN
	}
	if (ix < 0x3feb0000) {
		// |x| < 0.84375
		if (ix < 0x3c700000) {
			return 1.0 - x // |x| < 2^-56
		}
		const y = pq(x * x)
		if (sign != 0 || ix < 0x3fd00000) {
			return 1.0 - (x + x * y) // x < 1/4
		}
		return 0.5 - (x - 0.5 + x * y)
	}
	if (ix < 0x403c0000) {
