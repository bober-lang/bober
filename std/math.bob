//! Numeric helpers, and C's libm for f32 and f64 alike: each float function dispatches to its f64 or f32 version,
//! suffixed F64 or F32 below, musl's libm ported bit for bit. Floats round to nearest and raise no exceptions, so
//! nearbyint is rint and errno is never set.

import { bits, fromBits } from "../builtin/math"
import { Float, Integral, Numeric } from "./types"

export const inf: f64 = 1.0 / 0.0
export const nan: f64 = 0.0 / 0.0
export const pi = 3.141592653589793
export const ln2 = 0.6931471805599453
export const ln10 = 2.302585092994046
export const log2e = 1.4426950408889634
export const log10e = 0.4342944819032518
export const sqrt2 = 1.4142135623730951
export const sqrtHalf = 0.7071067811865476

export function isEven[T extends Integral](n: T): bool { return (n & 1) == 0 }
export function isOdd[T extends Integral](n: T): bool { return !isEven(n) }
export function max[T extends Numeric](a: T, b: T): T { return if (a > b) a else b }
export function min[T extends Numeric](a: T, b: T): T { return if (a < b) a else b }

/// |n|; of a float, its sign bit cleared, so that abs(-0.0) is +0 and a NaN is positive.
export function abs[T extends Numeric](n: T): T {
	if (T == f32) {
		return fabsf(n as f32) as T
	}
	if (T == f64) {
		return fabs(n as f64) as T
	}
	return if (n < (0 as T)) -n else n
}

export function sign[T extends Numeric](n: T): T { return (if (n > (0 as T)) 1 else if (n < (0 as T)) -1 else 0) as T }
export function clamp[T extends Numeric](n: T, lo: T, hi: T): T { return min(max(n, lo), hi) }
export function isNaN[T extends Float](x: T): bool { return x != x }
/// Neither infinite nor NaN.
export function isFinite[T extends Float](x: T): bool { return abs(x as f64) < inf }

/// The greatest common divisor of a and b, never negative; gcd(0, 0) is 0.
export function gcd[T extends Integral](a: T, b: T): T {
	let x = a
	let y = b
	while (y != 0) {
		const r = x % y
		x = y
		y = r
	}
	return abs(x)
}

/// The smallest multiple of align that is at least n, for n >= 0 and align > 0.
export function alignUp[T extends Integral](n: T, align: T): T { return (n + align - 1) / align * align }

// Rounding and the bits of floats.
/// Whether x's sign bit is set, as for -0 and a negative NaN.
export function signbit[T extends Float](x: T): bool {
	return if (T == f32) signbitF32(x as f32) else signbitF64(x as f64)
}

/// x's magnitude with y's sign.
export function copysign[T extends Float](x: T, y: T): T {
	return (if (T == f32) copysignF32(x as f32, y as f32) else copysignF64(x as f64, y as f64)) as T
}

export function floor[T extends Float](x: T): T {
	return (if (T == f32) floorF32(x as f32) else floorF64(x as f64)) as T
}

export function ceil[T extends Float](x: T): T { return (if (T == f32) ceilF32(x as f32) else ceilF64(x as f64)) as T }

export function trunc[T extends Float](x: T): T {
	return (if (T == f32) truncF32(x as f32) else truncF64(x as f64)) as T
}

/// x rounded to the nearest integer, halfway away from zero.
export function round[T extends Float](x: T): T {
	return (if (T == f32) roundF32(x as f32) else roundF64(x as f64)) as T
}

/// x rounded to the nearest integer, halfway to even.
export function rint[T extends Float](x: T): T { return (if (T == f32) rintF32(x as f32) else rintF64(x as f64)) as T }

/// x - n*y, n = x/y rounded toward zero, so of x's sign.
export function fmod[T extends Float](x: T, y: T): T {
	return (if (T == f32) fmodF32(x as f32, y as f32) else fmodF64(x as f64, y as f64)) as T
}

/// x - n*y, n = x/y rounded to the nearest integer, halfway to even.
export function remainder[T extends Float](x: T, y: T): T {
	return (if (T == f32) remainderF32(x as f32, y as f32) else remainderF64(x as f64, y as f64)) as T
}

/// remainder(x, y), and the last 3 bits of n at least, with n's sign.
export function remquo[T extends Float](x: T, y: T): [T, i32] {
	if (T == f32) {
		const [r, q] = remquoF32(x as f32, y as f32)
		return [r as T, q]
	}
	const [r, q] = remquoF64(x as f64, y as f64)
	return [r as T, q]
}

/// x's fractional and integral parts, each with x's sign.
export function modf[T extends Float](x: T): [T, T] {
	if (T == f32) {
		const [f, i] = modfF32(x as f32)
		return [f as T, i as T]
	}
	const [f, i] = modfF64(x as f64)
	return [f as T, i as T]
}

/// x as m 2^e, |m| in [1/2, 1), or m = x and e = 0 for 0, infinities and NaN.
export function frexp[T extends Float](x: T): [T, i32] {
	if (T == f32) {
		const [m, e] = frexpF32(x as f32)
		return [m as T, e]
	}
	const [m, e] = frexpF64(x as f64)
	return [m as T, e]
}

/// x 2^n.
export function ldexp[T extends Float](x: T, n: i32): T {
	return (if (T == f32) scalbnf(x as f32, n) else scalbn(x as f64, n)) as T
}

/// The exponent of x: e where |x| is in [2^e, 2^(e+1)); the least i32 for 0 and NaN, the greatest for infinities.
export function ilogb[T extends Float](x: T): i32 { return if (T == f32) ilogbF32(x as f32) else ilogbF64(x as f64) }
/// ilogb(x) as a float: -infinity for 0, infinity for infinities, NaN for NaN.
export function logb[T extends Float](x: T): T { return (if (T == f32) logbF32(x as f32) else logbF64(x as f64)) as T }

/// The float after x toward y, or y if they are equal.
export function nextafter[T extends Float](x: T, y: T): T {
	return (if (T == f32) nextafterF32(x as f32, y as f32) else nextafterF64(x as f64, y as f64)) as T
}

/// x - y if x > y, else +0.
export function fdim[T extends Float](x: T, y: T): T {
	return (if (T == f32) fdimF32(x as f32, y as f32) else fdimF64(x as f64, y as f64)) as T
}

/// The greater of x and y, unless one is NaN, then the other; +0 over -0.
export function fmax[T extends Float](x: T, y: T): T {
	return (if (T == f32) fmaxF32(x as f32, y as f32) else fmaxF64(x as f64, y as f64)) as T
}

/// The lesser of x and y, unless one is NaN, then the other; -0 under +0.
export function fmin[T extends Float](x: T, y: T): T {
	return (if (T == f32) fminF32(x as f32, y as f32) else fminF64(x as f64, y as f64)) as T
}

// Roots and fma.
export function sqrt[T extends Float](x: T): T { return (if (T == f32) sqrtF32(x as f32) else sqrtF64(x as f64)) as T }
export function cbrt[T extends Float](x: T): T { return (if (T == f32) cbrtF32(x as f32) else cbrtF64(x as f64)) as T }

/// sqrt(x*x + y*y), without undue overflow or underflow; infinity if either is, though the other be NaN.
export function hypot[T extends Float](x: T, y: T): T {
	return (if (T == f32) hypotF32(x as f32, y as f32) else hypotF64(x as f64, y as f64)) as T
}

/// x*y + z, rounded once.
export function fma[T extends Float](x: T, y: T, z: T): T {
	return (if (T == f32) fmaF32(x as f32, y as f32, z as f32) else fmaF64(x as f64, y as f64, z as f64)) as T
}

// Trigonometry, in radians.
export function sin[T extends Float](x: T): T { return (if (T == f32) sinF32(x as f32) else sinF64(x as f64)) as T }
export function cos[T extends Float](x: T): T { return (if (T == f32) cosF32(x as f32) else cosF64(x as f64)) as T }
export function tan[T extends Float](x: T): T { return (if (T == f32) tanF32(x as f32) else tanF64(x as f64)) as T }

/// [sin(x), cos(x)], at the cost of about one.
export function sincos[T extends Float](x: T): [T, T] {
	if (T == f32) {
		const [s, c] = sincosF32(x as f32)
		return [s as T, c as T]
	}
	const [s, c] = sincosF64(x as f64)
	return [s as T, c as T]
}

/// In [-pi/2, pi/2]; NaN outside [-1, 1].
export function asin[T extends Float](x: T): T { return (if (T == f32) asinF32(x as f32) else asinF64(x as f64)) as T }
/// In [0, pi]; NaN outside [-1, 1].
export function acos[T extends Float](x: T): T { return (if (T == f32) acosF32(x as f32) else acosF64(x as f64)) as T }
/// In [-pi/2, pi/2].
export function atan[T extends Float](x: T): T { return (if (T == f32) atanF32(x as f32) else atanF64(x as f64)) as T }

/// The angle of the point (x, y) from the positive x axis, in [-pi, pi].
export function atan2[T extends Float](y: T, x: T): T {
	return (if (T == f32) atan2F32(y as f32, x as f32) else atan2F64(y as f64, x as f64)) as T
}

// Exponentials and logarithms.
export function exp[T extends Float](x: T): T { return (if (T == f32) expF32(x as f32) else expF64(x as f64)) as T }
export function exp2[T extends Float](x: T): T { return (if (T == f32) exp2F32(x as f32) else exp2F64(x as f64)) as T }

export function exp10[T extends Float](x: T): T {
	return (if (T == f32) exp10F32(x as f32) else exp10F64(x as f64)) as T
}

/// e^x - 1, accurate also near x = 0.
export function expm1[T extends Float](x: T): T {
	return (if (T == f32) expm1F32(x as f32) else expm1F64(x as f64)) as T
}

/// The natural logarithm; -infinity at 0, NaN below.
export function log[T extends Float](x: T): T { return (if (T == f32) logF32(x as f32) else logF64(x as f64)) as T }
export function log2[T extends Float](x: T): T { return (if (T == f32) log2F32(x as f32) else log2F64(x as f64)) as T }

export function log10[T extends Float](x: T): T {
	return (if (T == f32) log10F32(x as f32) else log10F64(x as f64)) as T
}

/// log(1 + x), accurate also near x = 0.
export function log1p[T extends Float](x: T): T {
	return (if (T == f32) log1pF32(x as f32) else log1pF64(x as f64)) as T
}

/// x to the power y, as C's pow: 1 if y is 0 or x is 1, even for NaN; NaN for x < 0 and y no integer.
export function pow[T extends Float](x: T, y: T): T {
	return (if (T == f32) powF32(x as f32, y as f32) else powF64(x as f64, y as f64)) as T
}

// Hyperbolic functions.
export function sinh[T extends Float](x: T): T { return (if (T == f32) sinhF32(x as f32) else sinhF64(x as f64)) as T }
export function cosh[T extends Float](x: T): T { return (if (T == f32) coshF32(x as f32) else coshF64(x as f64)) as T }
export function tanh[T extends Float](x: T): T { return (if (T == f32) tanhF32(x as f32) else tanhF64(x as f64)) as T }

export function asinh[T extends Float](x: T): T {
	return (if (T == f32) asinhF32(x as f32) else asinhF64(x as f64)) as T
}

/// NaN for x < 1.
export function acosh[T extends Float](x: T): T {
	return (if (T == f32) acoshF32(x as f32) else acoshF64(x as f64)) as T
}

/// Infinite at ±1, NaN beyond.
export function atanh[T extends Float](x: T): T {
	return (if (T == f32) atanhF32(x as f32) else atanhF64(x as f64)) as T
}

// Special functions.
/// The error function, 2/sqrt(pi) times the integral of e^(-t^2) from 0 to x.
export function erf[T extends Float](x: T): T { return (if (T == f32) erfF32(x as f32) else erfF64(x as f64)) as T }
/// 1 - erf(x), accurate also where erf(x) is near 1.
export function erfc[T extends Float](x: T): T { return (if (T == f32) erfcF32(x as f32) else erfcF64(x as f64)) as T }

/// The gamma function, (x-1)! at the positive integers; infinite at ±0, NaN at the negative integers.
export function tgamma[T extends Float](x: T): T {
	return (if (T == f32) tgammaF32(x as f32) else tgammaF64(x as f64)) as T
}

/// log|Γ(x)|, and the sign of Γ(x), as C's lgamma_r; infinite at the integers up to 0.
export function lgamma[T extends Float](x: T): [T, i32] {
	if (T == f32) {
		const [l, s] = lgammaF32(x as f32)
		return [l as T, s]
	}
	const [l, s] = lgammaF64(x as f64)
	return [l as T, s]
}

// Bessel functions.
/// The Bessel function of the first kind of order 0.
export function j0[T extends Float](x: T): T { return (if (T == f32) j0F32(x as f32) else j0F64(x as f64)) as T }
/// Of the first kind of order 1.
export function j1[T extends Float](x: T): T { return (if (T == f32) j1F32(x as f32) else j1F64(x as f64)) as T }

/// Of the first kind of order n.
export function jn[T extends Float](n: i32, x: T): T {
	return (if (T == f32) jnF32(n, x as f32) else jnF64(n, x as f64)) as T
}

/// Of the second kind of order 0: -infinity at 0, NaN below.
export function y0[T extends Float](x: T): T { return (if (T == f32) y0F32(x as f32) else y0F64(x as f64)) as T }
/// Of the second kind of order 1: -infinity at 0, NaN below.
export function y1[T extends Float](x: T): T { return (if (T == f32) y1F32(x as f32) else y1F64(x as f64)) as T }

/// Of the second kind of order n: -infinity at 0 for n >= 0, NaN below 0.
export function yn[T extends Float](n: i32, x: T): T {
	return (if (T == f32) ynF32(n, x as f32) else ynF64(n, x as f64)) as T
}

// # The bits of floats
//
// The bits of floats, as the functions below read and build them, musl's asuint64, asdouble, asuint and asfloat; and
// the constants they share.
/// x's IEEE 754 bits.
function asU64(x: f64): u64 { return bits(x) }
/// The f64 of the bits b.
function asF64(b: u64): f64 { return fromBits[f64](b) }
/// x's IEEE 754 bits.
function asU32(x: f32): u32 { return bits(x) as u32 }
/// The f32 of the bits b.
function asF32(b: u32): f32 { return fromBits[f32](b as u64) }

const inff: f32 = 1.0 / 0.0
const nanf: f32 = 0.0 / 0.0
/// ln2 in two parts, the first with 32 trailing zero bits; and to f32, the first with 9.
const ln2hi = 6.93147180369123816490e-01
const ln2lo = 1.90821492927058770002e-10
const ln2hif: f32 = 0.69313812255859375
const ln2lof: f32 = 9.0580006144591607e-06
/// 1.5 2^52: adding then subtracting it rounds an f64 below 2^51 to an integer, whose bits are then its low bits.
const toint = 6755399441055744.0
/// 2^52 and 2^23: an f64 or f32 at least it is an integer; adding then subtracting it rounds one below it to one.
const two52 = 4503599627370496.0
const two23: f32 = 8388608.0

/// The leading zero bits of x, not 0, as musl's portable a_clz_64.
function clz64(x: u64): i32 {
	let y = (if (x >> 32 != 0) x >> 32 else x) as u32
	let r = if (x >> 32 != 0) 0 else 32
	for (const k of [16, 8, 4, 2]) {
		if (y >> (k as u32) != 0) {
			y >>= k as u32
		} else {
			r |= k
		}
	}
	return r | (if (y >> 1 != 0) 0 else 1)
}

// # Sign, rounding, remainders and exponents
//
// The operations on a float's representation: its sign, rounding to an integer, remainders, scaling by powers of
// two, its exponent, its neighbors, and comparisons that order NaN and signed zeros.
//
// Results are musl's bit for bit in round-to-nearest, which bober always rounds in, and raise no floating-point
// exceptions.
//
// Ported from musl 1.2.5, MIT, Copyright © 2005-2020 Rich Felker, et al. (vendor/musl/COPYRIGHT).
function fabs(x: f64): f64 { return asF64(asU64(x) & 0x7fffffffffffffff) }
function fabsf(x: f32): f32 { return asF32(asU32(x) & 0x7fffffff) }

/// x's magnitude with y's sign.
function copysignF64(x: f64, y: f64): f64 {
	return asF64(asU64(x) & 0x7fffffffffffffff | asU64(y) & 0x8000000000000000)
}

function copysignF32(x: f32, y: f32): f32 { return asF32(asU32(x) & 0x7fffffff | asU32(y) & 0x80000000) }
/// Whether x's sign bit is set, as for -0 and a negative NaN.
function signbitF64(x: f64): bool { return asU64(x) >> 63 != 0 }
function signbitF32(x: f32): bool { return asU32(x) >> 31 != 0 }

function floorF64(x: f64): f64 {
	const i = asU64(x)
	const e = (i >> 52 & 0x7ff) as i32
	if (e >= 0x3ff + 52 || x == 0.0) {
		return x
	}
	if (e <= 0x3ff - 1) {
		return if (i >> 63 != 0) -1.0 else 0.0
	}
	// y = int(x) - x, where int(x) is an integer neighbor of x
	const y = if (i >> 63 != 0) x - two52 + two52 - x else x + two52 - two52 - x
	return if (y > 0.0) x + y - 1.0 else x + y
}

function floorF32(x: f32): f32 {
	let u = asU32(x)
	const e = ((u >> 23 & 0xff) as i32) - 0x7f
	if (e >= 23) {
		return x
	}
	if (e >= 0) {
		const m: u32 = 0x007fffff >> (e as u32)
		if ((u & m) == 0) {
			return x
		}
		if (u >> 31 != 0) {
			u += m
		}
		u &= ~m
	} else if (u >> 31 == 0) {
		u = 0
	} else if (u << 1 != 0) {
		return -1.0
	}
	return asF32(u)
}

function ceilF64(x: f64): f64 {
	const i = asU64(x)
	const e = (i >> 52 & 0x7ff) as i32
	if (e >= 0x3ff + 52 || x == 0.0) {
		return x
	}
	if (e <= 0x3ff - 1) {
		return if (i >> 63 != 0) -0.0 else 1.0
	}
	const y = if (i >> 63 != 0) x - two52 + two52 - x else x + two52 - two52 - x
	return if (y < 0.0) x + y + 1.0 else x + y
}

function ceilF32(x: f32): f32 {
	let u = asU32(x)
	const e = ((u >> 23 & 0xff) as i32) - 0x7f
	if (e >= 23) {
		return x
	}
	if (e >= 0) {
		const m: u32 = 0x007fffff >> (e as u32)
		if ((u & m) == 0) {
			return x
		}
		if (u >> 31 == 0) {
			u += m
		}
		u &= ~m
	} else if (u >> 31 != 0) {
		return -0.0
	} else if (u << 1 != 0) {
		return 1.0
	}
	return asF32(u)
}

/// x rounded toward zero.
function truncF64(x: f64): f64 {
	const i = asU64(x)
	let e = ((i >> 52 & 0x7ff) as i32) - 0x3ff + 12
	if (e >= 52 + 12) {
		return x
	}
	if (e < 12) {
		e = 1
	}
	const m = ~(0 as u64) >> (e as u64)
	return asF64(i & ~m)
}

function truncF32(x: f32): f32 {
	const i = asU32(x)
	let e = ((i >> 23 & 0xff) as i32) - 0x7f + 9
	if (e >= 23 + 9) {
		return x
	}
	if (e < 9) {
		e = 1
	}
	const m = ~(0 as u32) >> (e as u32)
	return asF32(i & ~m)
}

/// x rounded to the nearest integer, halves away from zero.
function roundF64(x: f64): f64 {
	const i = asU64(x)
	const e = (i >> 52 & 0x7ff) as i32
	if (e >= 0x3ff + 52) {
		return x
	}
	const a = if (i >> 63 != 0) -x else x
	if (e < 0x3ff - 1) {
		return 0.0 * x
	}
	let y = a + two52 - two52 - a
	if (y > 0.5) {
		y = y + a - 1.0
	} else if (y <= -0.5) {
		y = y + a + 1.0
	} else {
		y = y + a
	}
	return if (i >> 63 != 0) -y else y
}

function roundF32(x: f32): f32 {
	const i = asU32(x)
	const e = (i >> 23 & 0xff) as i32
	if (e >= 0x7f + 23) {
		return x
	}
	const a = if (i >> 31 != 0) -x else x
	if (e < 0x7f - 1) {
		return 0.0 * x
	}
	let y = a + two23 - two23 - a
	if (y > 0.5) {
		y = y + a - 1.0
	} else if (y <= -0.5) {
		y = y + a + 1.0
	} else {
		y = y + a
	}
	return if (i >> 31 != 0) -y else y
}

/// x rounded to the nearest integer, halves to even, as is nearbyint without a rounding mode to follow.
function rintF64(x: f64): f64 {
	const i = asU64(x)
	if ((i >> 52 & 0x7ff) >= 0x3ff + 52) {
		return x
	}
	const s = i >> 63 != 0
	const y = if (s) x - two52 + two52 else x + two52 - two52
	return if (y != 0.0) y else if (s) -0.0 else 0.0
}

function rintF32(x: f32): f32 {
	const i = asU32(x)
	if ((i >> 23 & 0xff) >= 0x7f + 23) {
		return x
	}
	const s = i >> 31 != 0
	const y = if (s) x - two23 + two23 else x + two23 - two23
	return if (y != 0.0) y else if (s) -0.0 else 0.0
}

/// x - n*y, n the integer x/y truncates to: of x's sign and less than y in magnitude, and exact.
function fmodF64(x: f64, y: f64): f64 {
	let ux = asU64(x)
	let uy = asU64(y)
	let ex = (ux >> 52 & 0x7ff) as i32
	let ey = (uy >> 52 & 0x7ff) as i32
	const sx = ux >> 63
	if (uy << 1 == 0 || y != y || ex == 0x7ff) {
		return x * y / (x * y)
	}
	if (ux << 1 <= uy << 1) {
		return if (ux << 1 == uy << 1) 0.0 * x else x
	}
	// normalize x and y
	[ux, ex] = normalize(ux, ex)
	[uy, ey] = normalize(uy, ey)
	// x mod y
	while (ex > ey) {
		const i = ux - uy
		if (i >> 63 == 0) {
			if (i == 0) {
				return 0.0 * x
			}
			ux = i
		}
		ux <<= 1
		ex--
	}
	const i = ux - uy
	if (i >> 63 == 0) {
		if (i == 0) {
			return 0.0 * x
		}
		ux = i
	}
	while (ux >> 52 == 0) {
		ux <<= 1
		ex--
	}
	return asF64(scaled(ux, ex) | sx << 63)
}

function fmodF32(x: f32, y: f32): f32 {
	let ux = asU32(x)
	let uy = asU32(y)
	let ex = (ux >> 23 & 0xff) as i32
	let ey = (uy >> 23 & 0xff) as i32
	const sx = ux & 0x80000000
	if (uy << 1 == 0 || y != y || ex == 0xff) {
		return x * y / (x * y)
	}
	if (ux << 1 <= uy << 1) {
		return if (ux << 1 == uy << 1) 0.0 * x else x
	}
	[ux, ex] = normalizef(ux, ex)
	[uy, ey] = normalizef(uy, ey)
	while (ex > ey) {
		const i = ux - uy
		if (i >> 31 == 0) {
			if (i == 0) {
				return 0.0 * x
			}
			ux = i
		}
		ux <<= 1
		ex--
	}
	const i = ux - uy
	if (i >> 31 == 0) {
		if (i == 0) {
			return 0.0 * x
		}
		ux = i
	}
	while (ux >> 23 == 0) {
		ux <<= 1
		ex--
	}
	return asF32(scaledf(ux, ex) | sx)
}

/// The significand of the bits u of a finite nonzero f64 of biased exponent e, with its leading 1 at bit 52, and the
/// exponent, below 1 for a subnormal.
function normalize(u: u64, e: i32): [u64, i32] {
	if (e != 0) {
		return [u & ~(0 as u64) >> 12 | (1 as u64) << 52, e]
	}
	let ex = 0
	let i = u << 12
	while (i >> 63 == 0) {
		ex--
		i <<= 1
	}
	return [u << ((1 - ex) as u64), ex]
}

function normalizef(u: u32, e: i32): [u32, i32] {
	if (e != 0) {
		return [u & ~(0 as u32) >> 9 | (1 as u32) << 23, e]
	}
	let ex = 0
	let i = u << 9
	while (i >> 31 == 0) {
		ex--
		i <<= 1
	}
	return [u << ((1 - ex) as u32), ex]
}

/// The bits of the f64 of significand m and exponent e as normalize gives them; a subnormal's when e is below 1.
function scaled(m: u64, e: i32): u64 {
	return if (e > 0) m - ((1 as u64) << 52) | (e as u64) << 52 else m >> ((1 - e) as u64)
}

function scaledf(m: u32, e: i32): u32 {
	return if (e > 0) m - ((1 as u32) << 23) | (e as u32) << 23 else m >> ((1 - e) as u32)
}

/// The remainder of x/y, x - n*y with n the integer nearest x/y, halves to even; and the low 31 bits of |n|, with
/// x/y's sign.
function remquoF64(x: f64, y: f64): [f64, i32] {
	let ux = asU64(x)
	let uy = asU64(y)
	let ex = (ux >> 52 & 0x7ff) as i32
	let ey = (uy >> 52 & 0x7ff) as i32
	const sx = ux >> 63 != 0
	const sy = uy >> 63 != 0
	if (uy << 1 == 0 || y != y || ex == 0x7ff) {
		return [x * y / (x * y), 0]
	}
	if (ux << 1 == 0) {
		return [x, 0]
	}
	[ux, ex] = normalize(ux, ex)
	[uy, ey] = normalize(uy, ey)
	let q: u32 = 0
	if (ex < ey) {
		if (ex + 1 != ey) {
			return [x, 0]
		}
	} else {
		// x mod y
		while (ex > ey) {
			const i = ux - uy
			if (i >> 63 == 0) {
				ux = i
				q++
			}
			ux <<= 1
			q <<= 1
			ex--
		}
		const i = ux - uy
		if (i >> 63 == 0) {
			ux = i
			q++
		}
		if (ux == 0) {
			ex = -60
		} else {
			while (ux >> 52 == 0) {
				ux <<= 1
				ex--
			}
		}
	}
	// scale the result and decide between |x| and |x|-|y|
	let r = asF64(scaled(ux, ex))
	const ay = if (sy) -y else y
	if (ex == ey || ex + 1 == ey && (2.0 * r > ay || 2.0 * r == ay && q % 2 != 0)) {
		r -= ay
		q++
	}
	const n = (q & 0x7fffffff) as i32
	return [if (sx) -r else r, if (sx != sy) -n else n]
}

function remquoF32(x: f32, y: f32): [f32, i32] {
	let ux = asU32(x)
	let uy = asU32(y)
	let ex = (ux >> 23 & 0xff) as i32
	let ey = (uy >> 23 & 0xff) as i32
	const sx = ux >> 31 != 0
	const sy = uy >> 31 != 0
	if (uy << 1 == 0 || y != y || ex == 0xff) {
		return [x * y / (x * y), 0]
	}
	if (ux << 1 == 0) {
		return [x, 0]
	}
	[ux, ex] = normalizef(ux, ex)
	[uy, ey] = normalizef(uy, ey)
	let q: u32 = 0
	if (ex < ey) {
		if (ex + 1 != ey) {
			return [x, 0]
		}
	} else {
		while (ex > ey) {
			const i = ux - uy
			if (i >> 31 == 0) {
				ux = i
				q++
			}
			ux <<= 1
			q <<= 1
			ex--
		}
		const i = ux - uy
		if (i >> 31 == 0) {
			ux = i
			q++
		}
		if (ux == 0) {
			ex = -30
		} else {
			while (ux >> 23 == 0) {
				ux <<= 1
				ex--
			}
		}
	}
	let r = asF32(scaledf(ux, ex))
	const ay = if (sy) -y else y
	if (ex == ey || ex + 1 == ey && (2.0 * r > ay || 2.0 * r == ay && q % 2 != 0)) {
		r -= ay
		q++
	}
	const n = (q & 0x7fffffff) as i32
	return [if (sx) -r else r, if (sx != sy) -n else n]
}

/// x - n*y, n the integer nearest x/y, halves to even.
function remainderF64(x: f64, y: f64): f64 { return remquoF64(x, y)[0] }
function remainderF32(x: f32, y: f32): f32 { return remquoF32(x, y)[0] }

/// x's fractional and integral parts, both of x's sign.
function modfF64(x: f64): [f64, f64] {
	const u = asU64(x)
	const e = ((u >> 52 & 0x7ff) as i32) - 0x3ff
	const sign = asF64(u & 0x8000000000000000)
	// no fractional part
	if (e >= 52) {
		return [if (e == 0x400 && u << 12 != 0) x else sign, x]
	}
	// no integral part
	if (e < 0) {
		return [x, sign]
	}
	const mask = ~(0 as u64) >> 12 >> (e as u64)
	if ((u & mask) == 0) {
		return [sign, x]
	}
	const i = asF64(u & ~mask)
	return [x - i, i]
}

function modfF32(x: f32): [f32, f32] {
	const u = asU32(x)
	const e = ((u >> 23 & 0xff) as i32) - 0x7f
	const sign = asF32(u & 0x80000000)
	if (e >= 23) {
		return [if (e == 0x80 && u << 9 != 0) x else sign, x]
	}
	if (e < 0) {
		return [x, sign]
	}
	const mask: u32 = 0x007fffff >> (e as u32)
	if ((u & mask) == 0) {
		return [sign, x]
	}
	const i = asF32(u & ~mask)
	return [x - i, i]
}

/// x as f × 2^e with |f| in [1/2, 1), or f x and e 0 if x is 0, infinite or NaN.
function frexpF64(x: f64): [f64, i32] {
	const u = asU64(x)
	const e = (u >> 52 & 0x7ff) as i32
	if (e == 0) {
		if (x == 0.0) {
			return [x, 0]
		}
		const [f, k] = frexpF64(x * 18446744073709551616.0)
		return [f, k - 64]
	}
	if (e == 0x7ff) {
		return [x, 0]
	}
	return [asF64(u & 0x800fffffffffffff | 0x3fe0000000000000), e - 0x3fe]
}

function frexpF32(x: f32): [f32, i32] {
	const u = asU32(x)
	const e = (u >> 23 & 0xff) as i32
	if (e == 0) {
		if (x == 0.0) {
			return [x, 0]
		}
		const [f, k] = frexpF32(x * 18446744073709551616.0)
		return [f, k - 64]
	}
	if (e == 0xff) {
		return [x, 0]
	}
	return [asF32(u & 0x807fffff | 0x3f000000), e - 0x7e]
}

/// x × 2^n, rounded once.
function scalbn(x: f64, n: i32): f64 {
	let y = x
	let k = n
	if (k > 1023) {
		y *= 8.98846567431158e307 // 2^1023
		k -= 1023
		if (k > 1023) {
			y *= 8.98846567431158e307
			k -= 1023
			if (k > 1023) {
				k = 1023
			}
		}
	} else if (k < -1022) {
		// make sure the final k < -53 to avoid double rounding in the subnormal range
		y *= asF64(0x0360000000000000) // 2^-1022 × 2^53
		k += 1022 - 53
		if (k < -1022) {
			y *= asF64(0x0360000000000000)
			k += 1022 - 53
			if (k < -1022) {
				k = -1022
			}
		}
	}
	return y * asF64(((0x3ff + k) as u64) << 52)
}

function scalbnf(x: f32, n: i32): f32 {
	let y = x
	let k = n
	if (k > 127) {
		y *= 1.7014118346046923e38 // 2^127
		k -= 127
		if (k > 127) {
			y *= 1.7014118346046923e38
			k -= 127
			if (k > 127) {
				k = 127
			}
		}
	} else if (k < -126) {
		y *= asF32(0x0c800000) // 2^-126 × 2^24
		k += 126 - 24
		if (k < -126) {
			y *= asF32(0x0c800000)
			k += 126 - 24
			if (k < -126) {
				k = -126
			}
		}
	}
	return y * asF32(((0x7f + k) as u32) << 23)
}

/// The least i32, the result of ilogb for 0 and NaN.
const ilogb0 = -2147483648

/// The exponent of x: e where |x| is in [2^e, 2^(e+1)); ilogb0 for 0 and NaN, the greatest i32 for infinities.
function ilogbF64(x: f64): i32 {
	let i = asU64(x)
	let e = (i >> 52 & 0x7ff) as i32
	if (e == 0) {
		i <<= 12
		if (i == 0) {
			return ilogb0
		}
		// subnormal x
		e = -0x3ff
		while (i >> 63 == 0) {
			e--
			i <<= 1
		}
		return e
	}
	if (e == 0x7ff) {
		return if (i << 12 != 0) ilogb0 else 2147483647
	}
	return e - 0x3ff
}

function ilogbF32(x: f32): i32 {
	let i = asU32(x)
	let e = (i >> 23 & 0xff) as i32
	if (e == 0) {
		i <<= 9
		if (i == 0) {
			return ilogb0
		}
		e = -0x7f
		while (i >> 31 == 0) {
			e--
			i <<= 1
		}
		return e
	}
	if (e == 0xff) {
		return if (i << 9 != 0) ilogb0 else 2147483647
	}
	return e - 0x7f
}

/// ilogb(x) as a float: -infinity for 0, infinity for infinities, NaN for NaN.
function logbF64(x: f64): f64 {
	if (x - x != x - x) {
		return x * x
	}
	return if (x == 0.0) -1.0 / (x * x) else ilogbF64(x) as f64
}

function logbF32(x: f32): f32 {
	if (x - x != x - x) {
		return x * x
	}
	return if (x == 0.0) -1.0 / (x * x) else ilogbF32(x) as f32
}

/// The float after x toward y, or y if they are equal.
function nextafterF64(x: f64, y: f64): f64 {
	if (x != x || y != y) {
		return x + y
	}
	const ux = asU64(x)
	const uy = asU64(y)
	if (ux == uy) {
		return y
	}
	const ax = ux & 0x7fffffffffffffff
	const ay = uy & 0x7fffffffffffffff
	if (ax == 0) {
		return if (ay == 0) y else asF64(uy & 0x8000000000000000 | 1)
	}
	return asF64(if (ax > ay || (ux ^ uy) >> 63 != 0) ux - 1 else ux + 1)
}

function nextafterF32(x: f32, y: f32): f32 {
	if (x != x || y != y) {
		return x + y
	}
	const ux = asU32(x)
	const uy = asU32(y)
	if (ux == uy) {
		return y
	}
	const ax = ux & 0x7fffffff
	const ay = uy & 0x7fffffff
	if (ax == 0) {
		return if (ay == 0) y else asF32(uy & 0x80000000 | 1)
	}
	return asF32(if (ax > ay || (ux ^ uy) >> 31 != 0) ux - 1 else ux + 1)
}

/// x - y if x is greater, else 0; NaN if either is.
function fdimF64(x: f64, y: f64): f64 { return if (x != x) x else if (y != y) y else if (x > y) x - y else 0.0 }
function fdimF32(x: f32, y: f32): f32 { return if (x != x) x else if (y != y) y else if (x > y) x - y else 0.0 }

/// The greater of x and y, +0 of the zeros; the other if one is NaN.
function fmaxF64(x: f64, y: f64): f64 {
	if (x != x) {
		return y
	}
	if (y != y) {
		return x
	}
	if (signbitF64(x) != signbitF64(y)) {
		return if (signbitF64(x)) y else x
	}
	return if (x < y) y else x
}

function fmaxF32(x: f32, y: f32): f32 {
	if (x != x) {
		return y
	}
	if (y != y) {
		return x
	}
	if (signbitF32(x) != signbitF32(y)) {
		return if (signbitF32(x)) y else x
	}
	return if (x < y) y else x
}

/// The lesser of x and y, -0 of the zeros; the other if one is NaN.
function fminF64(x: f64, y: f64): f64 {
	if (x != x) {
		return y
	}
	if (y != y) {
		return x
	}
	if (signbitF64(x) != signbitF64(y)) {
		return if (signbitF64(x)) x else y
	}
	return if (x < y) x else y
}

function fminF32(x: f32, y: f32): f32 {
	if (x != x) {
		return y
	}
	if (y != y) {
		return x
	}
	if (signbitF32(x) != signbitF32(y)) {
		return if (signbitF32(x)) x else y
	}
	return if (x < y) x else y
}

// # Roots
//
// Square and cube roots, and the hypotenuse. sqrt is correctly rounded in integer arithmetic, not by the hardware's
// instruction, so that it is musl's anywhere. Being correctly rounded, the instruction gives the same bits, and is
// the fast path once bober's backend has it as an intrinsic.
//
// Ported from musl 1.2.5, MIT, Copyright © 2005-2020 Rich Felker, et al. (vendor/musl/COPYRIGHT). cbrt and cbrtf are
// from FreeBSD: Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved. Developed at SunPro, a Sun
// Microsystems, Inc. business. Permission to use, copy, modify, and distribute this software is freely granted,
// provided that this notice is preserved. Optimized by Bruce D. Evans; cbrtf converted to float by Ian Lance Taylor,
// Cygnus Support.
/// 1/sqrt(x) to 8 bits, as 2^-16 times the entry of x's last exponent bit and first 6 significand bits, x in [1, 4).
const rsqrtTab: u16[] = [0xb451, 0xb2f0, 0xb196, 0xb044, 0xaef9, 0xadb6, 0xac79, 0xab43, 0xaa14, 0xa8eb, 0xa7c8, 0xa6aa,
	0xa592, 0xa480, 0xa373, 0xa26b, 0xa168, 0xa06a, 0x9f70, 0x9e7b, 0x9d8a, 0x9c9d, 0x9bb5, 0x9ad1, 0x99f0, 0x9913,
	0x983a, 0x9765, 0x9693, 0x95c4, 0x94f8, 0x9430, 0x936b, 0x92a9, 0x91ea, 0x912e, 0x9075, 0x8fbe, 0x8f0a, 0x8e59,
	0x8daa, 0x8cfe, 0x8c54, 0x8bac, 0x8b07, 0x8a64, 0x89c4, 0x8925, 0x8889, 0x87ee, 0x8756, 0x86c0, 0x862b, 0x8599,
	0x8508, 0x8479, 0x83ec, 0x8361, 0x82d8, 0x8250, 0x81c9, 0x8145, 0x80c2, 0x8040, 0xff02, 0xfd0e, 0xfb25, 0xf947,
	0xf773, 0xf5aa, 0xf3ea, 0xf234, 0xf087, 0xeee3, 0xed47, 0xebb3, 0xea27, 0xe8a3, 0xe727, 0xe5b2, 0xe443, 0xe2dc,
	0xe17a, 0xe020, 0xdecb, 0xdd7d, 0xdc34, 0xdaf1, 0xd9b3, 0xd87b, 0xd748, 0xd61a, 0xd4f1, 0xd3cd, 0xd2ad, 0xd192,
	0xd07b, 0xcf69, 0xce5b, 0xcd51, 0xcc4a, 0xcb48, 0xca4a, 0xc94f, 0xc858, 0xc764, 0xc674, 0xc587, 0xc49d, 0xc3b7,
	0xc2d4, 0xc1f4, 0xc116, 0xc03c, 0xbf65, 0xbe90, 0xbdbe, 0xbcef, 0xbc23, 0xbb59, 0xba91, 0xb9cc, 0xb90a, 0xb84a,
	0xb78c, 0xb6d0, 0xb617, 0xb560]

/// a*b*2^-32 of the low 32 bits of each, rounded down.
function mul32(a: u64, b: u64): u64 { return (a & 0xffffffff) * (b & 0xffffffff) >> 32 }

/// a*b*2^-64, less at most 3.
function mul64(a: u64, b: u64): u64 {
	return (a >> 32) * (b >> 32) + ((a >> 32) * (b & 0xffffffff) >> 32) + ((a & 0xffffffff) * (b >> 32) >> 32)
}

function sqrtF64(x: f64): f64 {
	let ix = asU64(x)
	let top = ix >> 52
	if (top - 1 >= 0x7ff - 1) {
		// ±0, a negative, a subnormal, inf or NaN
		if (ix * 2 == 0 || ix == 0x7ff0000000000000) {
			return x
		}
		if (ix > 0x7ff0000000000000) {
			return (x - x) / (x - x)
		}
		ix = asU64(x * 4503599627370496.0)
		top = (ix >> 52) - 52
	}
	// x = 4^e m, m in [1, 4) as fixed point 2.62, and 2^e the result's exponent
	const m = (ix << 11 | 0x8000000000000000) >> (top & 1)
	top = (top + 0x3ff) >> 1
	// r ~ 1/sqrt(m) and s ~ sqrt(m): from the table, by two Goldschmidt iterations in 32 bits and one in 64
	const three: u64 = 0xc0000000
	let r = (rsqrtTab[(ix >> 46) % 128] as u64) << 16
	let s = mul32(m >> 32, r)
	let u = three - mul32(s, r)
	r = mul32(r, u) << 1
	s = mul32(s, u) << 1
	u = three - mul32(s, r)
	r = mul32(r, u) << 33
	s = mul64(m, r)
	u = (three << 32) - mul64(s, r)
	s = (mul64(s, u) - 2) >> 9
	// s < sqrt(m) < s + 2^-52: round to s or s + 2^-52 by comparing (2^52 s + 1/2)^2 with 2^104 m
	const d = s - ((m << 42) - s * s)
	return asF64((s + (d >> 63)) & 0xfffffffffffff | top << 52)
}

function sqrtF32(x: f32): f32 {
	let ix = asU32(x)
	if (ix - 0x00800000 >= 0x7f800000 - 0x00800000) {
		if (ix * 2 == 0 || ix == 0x7f800000) {
			return x
		}
		if (ix > 0x7f800000) {
			return (x - x) / (x - x)
		}
		ix = asU32(x * 8388608.0) - (23 << 23)
	}
	// as sqrt, in 32 bits, m as fixed point 2.30
	const m = if ((ix & 0x00800000) != 0) ix << 7 & 0x7fffffff else ix << 8 | 0x80000000
	const three: u32 = 0xc0000000
	let r = (rsqrtTab[(ix >> 17) % 128] as u32) << 16
	let s = mul32(m, r) as u32
	let u = three - (mul32(s, r) as u32)
	r = (mul32(r, u) as u32) << 1
	s = (mul32(s, u) as u32) << 1
	u = three - (mul32(s, r) as u32)
	s = ((mul32(s, u) as u32) - 1) >> 6
	const d = s - ((m << 16) - s * s)
	return asF32((s + (d >> 31)) & 0x7fffff | ((ix >> 1) + (0x3f800000 >> 1)) & 0x7f800000)
}

/// cbrt's polynomial, 1/cbrt(r) to 2^-23.5 for |r - 1| < 1/10.
const P0 = 1.87595182427177009643
const P1 = -1.88497979543377169875
const P2 = 1.621429720105354466140
const P3 = -0.758397934778766047437
const P4 = 0.145996192886612446982

function cbrtF64(x: f64): f64 {
	let u = asU64(x)
	let hx = ((u >> 32) as u32) & 0x7fffffff
	if (hx >= 0x7ff00000) {
		return x + x
	}
	// cbrt(2^e (1 + m)) ~ 2^(e/3) (1 + (e%3 + m)/3): dividing x's top bits by 3 nearly does, to 5 bits, and adding a
	// bias of (1023 - 1023/3 - 0.03306235651) 2^20 restores the exponent's and halves the error
	if (hx < 0x00100000) {
		u = asU64(x * 18014398509481984.0)
		hx = ((u >> 32) as u32) & 0x7fffffff
		if (hx == 0) {
			return x
		}
		hx = hx / 3 + 696219795
	} else {
		hx = hx / 3 + 715094163
	}
	let t = asF64(u & 0x8000000000000000 | (hx as u64) << 32)
	// to 23 bits by the polynomial in t^3/x
	let r = t * t * (t / x)
	t = t * (P0 + r * (P1 + r * P2) + r * r * r * (P3 + r * P4))
	// rounded away from zero to 23 bits, so that it is above cbrt(x), by at most 2 of their ulps
	t = asF64((asU64(t) + 0x80000000) & 0xffffffffc0000000)
	// to 53 bits by a Newton step, with an error below 0.667 ulps
	r = x / (t * t)
	r = (r - t) / (t + t + r)
	return t + t * r
}

function cbrtF32(x: f32): f32 {
	let u = asU32(x)
	let hx = u & 0x7fffffff
	if (hx >= 0x7f800000) {
		return x + x
	}
	// as cbrt, to 5 bits
	if (hx < 0x00800000) {
		if (hx == 0) {
			return x
		}
		u = asU32(x * 16777216.0)
		hx = (u & 0x7fffffff) / 3 + 642849266
	} else {
		hx = hx / 3 + 709958130
	}
	// to 16 bits by a Newton step, and to 47 by another, in f64 so that no term overflows
	let t = asF32(u & 0x80000000 | hx) as f64
	const xd = x as f64
	for (const _ of 1 ... 2) {
		const r = t * t * t
		t = t * (xd + xd + r) / (xd + r + r)
	}
	return t as f32
}

/// x*x as hi + lo, x split into halves that multiply exactly.
function sq(x: f64): [f64, f64] {
	const xc = x * 134217729.0
	const xh = x - xc + xc
	const xl = x - xh
	const hi = x * x
	return [hi, xh * xh - hi + 2.0 * xh * xl + xl * xl]
}

/// sqrt(x*x + y*y), without undue overflow or underflow; inf if either is, though the other be NaN.
function hypotF64(x: f64, y: f64): f64 {
	let ux = asU64(x) & 0x7fffffffffffffff
	let uy = asU64(y) & 0x7fffffffffffffff
	if (ux < uy) {
		[ux, uy] = [uy, ux]
	}
	const ex = (ux >> 52) as i32
	const ey = (uy >> 52) as i32
	let a = asF64(ux)
	let b = asF64(uy)
	if (ey == 0x7ff) {
		return b
	}
	if (ex == 0x7ff || uy == 0) {
		return a
	}
	if (ex - ey > 64) {
		return a + b
	}
	// scaled by 2^±700 so that neither hi*hi overflows nor lo*lo underflows
	let z = 1.0
	if (ex > 0x3ff + 510) {
		z = asF64(0x6bb0000000000000)
		a *= asF64(0x1430000000000000)
		b *= asF64(0x1430000000000000)
	} else if (ey < 0x3ff - 450) {
		z = asF64(0x1430000000000000)
		a *= asF64(0x6bb0000000000000)
		b *= asF64(0x6bb0000000000000)
	}
	const [ha, la] = sq(a)
	const [hb, lb] = sq(b)
	return z * sqrtF64(lb + la + hb + ha)
}

function hypotF32(x: f32, y: f32): f32 {
	let ux = asU32(x) & 0x7fffffff
	let uy = asU32(y) & 0x7fffffff
	if (ux < uy) {
		[ux, uy] = [uy, ux]
	}
	let a = asF32(ux)
	let b = asF32(uy)
	if (uy == 0xff << 23) {
		return b
	}
	if (ux >= 0xff << 23 || uy == 0 || ux - uy >= 25 << 23) {
		return a + b
	}
	// scaled by 2^±90, the sum in f64
	let z: f32 = 1.0
	if (ux >= (0x7f + 60) << 23) {
		z = asF32(0x6c800000)
		a *= asF32(0x12800000)
		b *= asF32(0x12800000)
	} else if (uy < (0x7f - 60) << 23) {
		z = asF32(0x12800000)
		a *= asF32(0x6c800000)
		b *= asF32(0x6c800000)
	}
	return z * sqrtF32(((a as f64) * (a as f64) + (b as f64) * (b as f64)) as f32)
}

// # Fused multiply-add
//
// Fused multiply-add, x*y + z rounded once, in integer arithmetic, not by the hardware's instruction, so that it is
// musl's anywhere. Being correctly rounded, the instruction gives the same bits, and is the fast path once bober's
// backend has it as an intrinsic.
//
// Ported from musl 1.2.5, MIT, Copyright © 2005-2020 Rich Felker, et al. (vendor/musl/COPYRIGHT). fmaf is from FreeBSD:
// Copyright (c) 2005-2011 David Schultz <das@FreeBSD.ORG>. All rights reserved. Redistribution and use in source and
// binary forms, with or without modification, are permitted provided that the following conditions are met: 1.
// Redistributions of source code must retain the above copyright notice, this list of conditions and the following
// disclaimer. 2. Redistributions in binary form must reproduce the above copyright notice, this list of conditions and
// the following disclaimer in the documentation and/or other materials provided with the distribution. THIS SOFTWARE IS
// PROVIDED BY THE AUTHOR AND CONTRIBUTORS ``AS IS'' AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED
// TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL
// THE AUTHOR OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL
// DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
// OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR
// TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
// POSSIBILITY OF SUCH DAMAGE.
/// The exponent split gives an infinity or NaN; a zero's is above it.
const zeroInfNan: i32 = 0x7ff - 0x3ff - 52 - 1

/// x as its sign and m 2^e, m's top 10 bits and last bit 0.
function split(x: f64): [bool, u64, i32] {
	let ix = asU64(x)
	let e = ((ix >> 52) & 0x7ff) as i32
	if (e == 0) {
		ix = asU64(x * 9223372036854775808.0)
		e = ((ix >> 52) & 0x7ff) as i32
		e = if (e != 0) e - 63 else 0x800
	}
	return [ix >> 63 != 0, (ix & 0xfffffffffffff | 0x10000000000000) << 1, e - (0x3ff + 52 + 1)]
}

/// x*y as 128 bits, high and low.
function mul(x: u64, y: u64): [u64, u64] {
	const t1 = (x & 0xffffffff) * (y & 0xffffffff)
	const t2 = (x & 0xffffffff) * (y >> 32) + (x >> 32) * (y & 0xffffffff)
	const lo = t1 + (t2 << 32)
	return [(x >> 32) * (y >> 32) + (t2 >> 32) + ((t1 > lo) as u64), lo]
}

/// The bits of x shifted left by n.
function shl(x: u64, n: i32): u64 { return x << (n as u64) }
/// The bits of x shifted right by n.
function shr(x: u64, n: i32): u64 { return x >> (n as u64) }

function fmaF64(x: f64, y: f64, z: f64): f64 {
	const [sx, mx, ex] = split(x)
	const [sy, my, ey] = split(y)
	const [sz, mz, ez] = split(z)
	if (ex >= zeroInfNan || ey >= zeroInfNan) {
		return x * y + z
	}
	if (ez >= zeroInfNan) {
		// A zero z leaves x*y, as musl after 1.2.5: x*y + z turns an underflowed -0 into +0.
		return if (ez > zeroInfNan) x * y else z
	}
	// r = x*y, then z shifted left by kz and r right by kr, kz + kr = d, so that their exponents are e = e + kr
	let [rhi, rlo] = mul(mx, my)
	let e = ex + ey
	let d = ez - e
	let zhi: u64 = 0
	let zlo: u64 = 0
	if (d > 0) {
		if (d < 64) {
			zlo = shl(mz, d)
			zhi = shr(mz, 64 - d)
		} else {
			zhi = mz
			e = ez - 64
			d -= 64
			if (d >= 64) {
				rlo = 1
				rhi = 0
			} else if (d > 0) {
				rlo = shl(rhi, 64 - d) | shr(rlo, d) | ((shl(rlo, 64 - d) != 0) as u64)
				rhi = shr(rhi, d)
			}
		}
	} else {
		d = -d
		zlo = if (d == 0) mz else if (d < 64) shr(mz, d) | ((shl(mz, 64 - d) != 0) as u64) else 1
	}
	// r ± z
	let neg = sx != sy
	let nonzero = true
	if (neg == sz) {
		rlo += zlo
		rhi += zhi + ((rlo < zlo) as u64)
	} else {
		const t = rlo
		rlo -= zlo
		rhi = rhi - zhi - ((t < rlo) as u64)
		if (rhi >> 63 != 0) {
			rlo = -rlo
			rhi = -rhi - ((rlo != 0) as u64)
			neg = !neg
		}
		nonzero = rhi != 0
	}
	// rhi = the result's top 63 bits, the last sticky
	if (nonzero) {
		e += 64
		d = clz64(rhi) - 1
		rhi = shl(rhi, d) | shr(rlo, 64 - d) | ((shl(rlo, d) != 0) as u64)
	} else if (rlo != 0) {
		d = clz64(rlo) - 1
		rhi = if (d < 0) rlo >> 1 | rlo & 1 else shl(rlo, d)
	} else {
		return x * y + z
	}
	e -= d
	const signed = (m: u64) => (if (neg) -(m as i64) else m as i64) as f64
	let r = signed(rhi)
	if (e < -1022 - 62) {
		// subnormal before rounding
		if (e == -1022 - 63) {
			const c = if (neg) -9223372036854775808.0 else 9223372036854775808.0
			if (r == c) {
				// the least normal, after rounding
				return asF64(0x0010000000000000 | (neg as u64) << 63)
			}
			// a bit is lost when scaled: so that only the conversion rounds, add another on top, and take it off after
			if (rhi << 53 != 0) {
				r = 2.0 * signed(rhi >> 1 | rhi & 1 | 0x4000000000000000) - c
			}
		} else {
			// rounded only once, when scaled
			r = signed((rhi >> 10 | ((rhi << 54 != 0) as u64)) << 10)
		}
	}
	return scalbn(r, e)
}

function fmaF32(x: f32, y: f32, z: f32): f32 {
	// x*y is exact in f64 and the sum rounds once there; rounded to f32, it rounds twice only from halfway between two
	const xy = (x as f64) * (y as f64)
	const zd = z as f64
	const result = xy + zd
	let u = asU64(result)
	if ((u & 0x1fffffff) != 0x10000000 || (u >> 52 & 0x7ff) == 0x7ff || result - xy == zd && result - zd == xy) {
		return result as f32
	}
	// inexact and halfway: its last bit moved toward the error
	const neg = u >> 63 != 0
	const err = if (neg == (zd > xy)) xy - result + zd else zd - result + xy
	u = if (neg == (err < 0.0)) u + 1 else u - 1
	return asF64(u) as f32
}

// # Reduction by pi/2
//
// Arguments of the trigonometric functions reduced by multiples of pi/2: x = n pi/2 + y with |y| ~<= pi/4, y as a
// sum y0 + y1 of two f64s, as musl's __rem_pio2, __rem_pio2f and __rem_pio2_large reduce them.
//
// Ported from musl 1.2.5, MIT, Copyright © 2005-2020 Rich Felker, et al. (vendor/musl/COPYRIGHT), from FreeBSD:
// Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved. Developed at SunSoft, a Sun Microsystems, Inc.
// business. Permission to use, copy, modify, and distribute this software is freely granted, provided that this notice
// is preserved. Optimized by Bruce D. Evans.
const pio4 = 0.7853981633974483
const invpio2 = 6.36619772367581382433e-01
/// pi/2 as pio2a + pio2b + pio2c + pio2ct, the first three of 33 bits each; pio2at is pi/2 - pio2a, pio2bt
/// pi/2 - pio2a - pio2b.
const pio2a = 1.57079632673412561417e+00
const pio2at = 6.07710050650619224932e-11
const pio2b = 6.07710050630396597660e-11
const pio2bt = 2.02226624879595063154e-21
const pio2c = 2.02226624871116645580e-21
const pio2ct = 8.47842766036889956997e-32

/// The exponent bits of x.
function expo(x: f64): i32 { return (asU64(x) >> 52 & 0x7ff) as i32 }

/// [n, y0, y1] of x, x - n pi/2 = y0 + y1 with |y0 + y1| ~<= pi/4; of inf or NaN, [0, NaN, NaN].
function remPio2(x: f64): [i32, f64, f64] {
	const u = asU64(x)
	const sign = if (u >> 63 != 0) -1 else 1
	const ix = (u >> 32 & 0x7fffffff) as u32
	if (ix <= 0x400f6a7a) {
		// |x| ~<= 5pi/4, unless about pi/2 or pi, where the first round cancels
		if ((ix & 0xfffff) != 0x921fb) {
			return near(x, sign * (if (ix <= 0x4002d97c) 1 else 2))
		}
	} else if (ix <= 0x401c463b) {
		// |x| ~<= 9pi/4, unless about 3pi/2 or 2pi
		if (ix != 0x4012d97c && ix != 0x401921fb) {
			return near(x, sign * (if (ix <= 0x4015fdbc) 3 else 4))
		}
	} else if (ix >= 0x413921fb) {
		// |x| ~>= 2^20 pi/2
		if (ix >= 0x7ff00000) {
			return [0, x - x, x - x]
		}
		// |x| scaled to [2^23, 2^24), in three 24-bit pieces, the last nonzero first
		const tx = new f64[](3)
		let z = asF64(u & 0xfffffffffffff | 0x4160000000000000)
		for (const i of 0 ... 1) {
			tx[i] = (z as i32) as f64
			z = (z - tx[i]) * 16777216.0
		}
		tx[2] = z
		let nx = 3
		while (tx[nx - 1] == 0.0) {
			nx--
		}
		const [n, y0, y1] = remPio2Large(tx, ((ix >> 20) as i32) - (0x3ff + 23), nx, 1)
		return if (sign < 0) [-n, -y0, -y1] else [n, y0, y1]
	}
	// rint(x / (pi/2)), x less n pi/2 to 85 bits, or to 118 or 151 where those cancel
	let fn = x * invpio2 + toint - toint
	let n = fn as i32
	let r = x - fn * pio2a
	let w = fn * pio2at
	if (r - w < -pio4 || r - w > pio4) {
		// x * invpio2 rounded across a half
		const d = if (r - w < -pio4) -1 else 1
		n += d
		fn += d as f64
		r = x - fn * pio2a
		w = fn * pio2at
	}
	let y0 = r - w
	const ex = (ix >> 20) as i32
	if (ex - expo(y0) > 16) {
		let t = r
		w = fn * pio2b
		r = t - w
		w = fn * pio2bt - ((t - r) - w)
		y0 = r - w
		if (ex - expo(y0) > 49) {
			t = r
			w = fn * pio2c
			r = t - w
			w = fn * pio2ct - ((t - r) - w)
			y0 = r - w
		}
	}
	return [n, y0, (r - y0) - w]
}

/// remPio2 of x within 9pi/4 of 0, about n pi/2, n in ±1 ... ±4, in one round.
function near(x: f64, n: i32): [i32, f64, f64] {
	const k = n as f64
	const z = x - k * pio2a
	const y0 = z - k * pio2at
	return [n, y0, (z - y0) - k * pio2at]
}

/// pi/2 as f64 in 25 bits and the rest.
const pio2fa = 1.57079631090164184570e+00
const pio2fat = 1.58932547735281966916e-08

/// [n, y] of x, x - n pi/2 = y with |y| ~<= pi/4; of inf or NaN, [0, NaN].
function remPio2f(x: f32): [i32, f64] {
	const u = asU32(x)
	const ix = u & 0x7fffffff
	if (ix < 0x4dc90fdb) {
		// |x| ~< 2^28 pi/2, where 25 + 53 bits of pi/2 do
		const xd = x as f64
		// musl corrects n where y passes pi/4, which in round to nearest no f32 makes it do
		const fn = xd * invpio2 + toint - toint
		return [fn as i32, xd - fn * pio2fa - fn * pio2fat]
	}
	if (ix >= 0x7f800000) {
		return [0, (x - x) as f64]
	}
	// |x| scaled to [2^23, 2^24)
	const e0 = ((ix >> 23) as i32) - (0x7f + 23)
	const [n, y, _] = remPio2Large([asF32(ix - ((e0 as u32) << 23)) as f64], e0, 1, 0)
	return if (u >> 31 != 0) [-n, -y] else [n, y]
}

/// 2/pi in 24-bit pieces, as many as an f64's exponent needs.
const ipio2: i32[] = [0xa2f983, 0x6e4e44, 0x1529fc, 0x2757d1, 0xf534dd, 0xc0db62, 0x95993c, 0x439041, 0xfe5163,
	0xabdebb, 0xc561b7, 0x246e3a, 0x424dd2, 0xe00649, 0x2eea09, 0xd1921c, 0xfe1deb, 0x1cb129, 0xa73ee8, 0x8235f5,
	0x2ebb44, 0x84e99c, 0x7026b4, 0x5f7e41, 0x3991d6, 0x398353, 0x39f49c, 0x845f8b, 0xbdf928, 0x3b1ff8, 0x97ffde,
	0x05980f, 0xef2f11, 0x8b5a0a, 0x6d1f6d, 0x367ecf, 0x27cb09, 0xb74f46, 0x3f669e, 0x5fea2d, 0x7527ba, 0xc7ebe5,
	0xf17b3d, 0x0739f7, 0x8a5292, 0xea6bfb, 0x5fb11f, 0x8d5d08, 0x560330, 0x46fc7b, 0x6babf0, 0xcfbc20, 0x9af436,
	0x1da9e3, 0x91615e, 0xe61b08, 0x659985, 0x5f14a0, 0x68408d, 0xffd880, 0x4d7327, 0x310606, 0x1556ca, 0x73a8c9,
	0x60e27b, 0xc08c6b]

/// pi/2 in pieces of 24 bits.
const pio2s: f64[] = [1.57079625129699707031e+00, 7.54978941586159635335e-08, 5.39030252995776476554e-15,
	3.28200341580791294123e-22, 1.27065575308067607349e-29, 1.22933308981111328932e-36, 2.73370053816464559624e-44,
	2.16741683877804819444e-51]

/// [n mod 8, y0, y1] of x in pieces, x[i] an integer below 2^24 times 2^(e0 - 24 i), the first and last nonzero:
/// x - n pi/2 = y0 + y1, by 2/pi to as many bits as that needs (Payne and Hanek). prec 0 is for an f32's 24 bits, and
/// gives y1 0; prec 1 for an f64's 53.
function remPio2Large(x: f64[], e0: i32, nx: i32, prec: i32): [i32, f64, f64] {
	const jk = if (prec == 0) 3 else 4
	const jx = nx - 1
	const jv = if (e0 - 3 < 0) 0 else (e0 - 3) / 24
	let q0 = e0 - 24 * (jv + 1)
	const f = new f64[](20)
	const q = new f64[](20)
	const fq = new f64[](20)
	const iq = new i32[](20)
	// f[0 ... jx + jk] the pieces of 2/pi from ipio2[jv - jx]; q[i] the products with x
	for (const i of 0 ... jx + jk) {
		const j = jv - jx + i
		f[i] = if (j < 0) 0.0 else ipio2[j] as f64
	}
	const product = (i: i32) => {
		let fw = 0.0
		for (const j of 0 ... jx) {
			fw += x[j] * f[jx + i - j]
		}
		return fw
	}
	for (const i of 0 ... jk) {
		q[i] = product(i)
	}
	let jz = jk
	let z = 0.0
	let n = 0
	let ih = 0
	while (true) {
		// q in 24-bit integers, iq[0] its last
		z = q[jz]
		let j = jz
		while (j > 0) {
			const fw = ((5.960464477539063e-08 * z) as i32) as f64
			iq[jz - j] = (z - 16777216.0 * fw) as i32
			z = q[j - 1] + fw
			j--
		}
		// n, and z its fraction
		z = scalbn(z, q0)
		z -= 8.0 * floorF64(z * 0.125)
		n = z as i32
		z -= n as f64
		ih = 0
		if (q0 > 0) {
			const i = iq[jz - 1] >> (24 - q0)
			n += i
			iq[jz - 1] -= i << (24 - q0)
			ih = iq[jz - 1] >> (23 - q0)
		} else if (q0 == 0) {
			ih = iq[jz - 1] >> 23
		} else if (z >= 0.5) {
			ih = 2
		}
		if (ih > 0) {
			// past 1/2: 1 - q
			n += 1
			let carry = false
			for (const i of 0 ... jz - 1) {
				if (carry) {
					iq[i] = 0xffffff - iq[i]
				} else if (iq[i] != 0) {
					carry = true
					iq[i] = 0x1000000 - iq[i]
				}
			}
			if (q0 == 1) {
				iq[jz - 1] &= 0x7fffff
			} else if (q0 == 2) {
				iq[jz - 1] &= 0x3fffff
			}
			if (ih == 2) {
				z = 1.0 - z
				if (carry) {
					z -= scalbn(1.0, q0)
				}
			}
		}
		// more pieces of 2/pi where these leave nothing
		if (z != 0.0) {
			break
		}
		let any = 0
		for (const i of jk ... jz - 1) {
			any |= iq[i]
		}
		if (any != 0) {
			break
		}
		let k = 1
		while (iq[jk - k] == 0) {
			k++
		}
		for (const i of jz + 1 ... jz + k) {
			f[jx + i] = ipio2[jv + i] as f64
			q[i] = product(i)
		}
		jz += k
	}
	// less the zero pieces, or z in 24-bit pieces
	if (z == 0.0) {
		jz--
		q0 -= 24
		while (iq[jz] == 0) {
			jz--
			q0 -= 24
		}
	} else {
		z = scalbn(z, -q0)
		if (z >= 16777216.0) {
			const fw = ((5.960464477539063e-08 * z) as i32) as f64
			iq[jz] = (z - 16777216.0 * fw) as i32
			jz++
			q0 += 24
			iq[jz] = fw as i32
		} else {
			iq[jz] = z as i32
		}
	}
	// the pieces as floats, times pi/2
	let fw = scalbn(1.0, q0)
	let i = jz
	while (i >= 0) {
		q[i] = fw * (iq[i] as f64)
		fw *= 5.960464477539063e-08
		i--
	}
	i = jz
	while (i >= 0) {
		fw = 0.0
		let k = 0
		while (k <= jk && k <= jz - i) {
			fw += pio2s[k] * q[i + k]
			k++
		}
		fq[jz - i] = fw
		i--
	}
	// summed, from the least
	fw = 0.0
	i = jz
	while (i >= 0) {
		fw += fq[i]
		i--
	}
	const y0 = if (ih == 0) fw else -fw
	if (prec == 0) {
		return [n & 7, y0, 0.0]
	}
	fw = fq[0] - fw
	for (const i of 1 ... jz) {
		fw += fq[i]
	}
	return [n & 7, y0, if (ih == 0) fw else -fw]
}

// # Sine, cosine and tangent
//
// Sine, cosine and tangent, of x reduced to within pi/4 of 0 by remPio2. The kernels, k-prefixed, are musl's __sin,
// __cos, __tan, __sindf, __cosdf and __tandf, of a reduced argument.
//
// Ported from musl 1.2.5, MIT, Copyright © 2005-2020 Rich Felker, et al. (vendor/musl/COPYRIGHT), from FreeBSD:
// Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved. Developed at SunPro, a Sun Microsystems, Inc.
// business. Permission to use, copy, modify, and distribute this software is freely granted, provided that this notice
// is preserved. Copyright (C) 2004 by Sun Microsystems, Inc. All rights reserved (__tan). Permission to use, copy,
// modify, and distribute this software is freely granted, provided that this notice is preserved. f32 kernels by Ian
// Lance Taylor, Cygnus Support, and Bruce D. Evans; f32 functions optimized by Bruce D. Evans.
// sin(x) ~ x + S1 x^3 + ... + S6 x^13 on [-pi/4, pi/4]
const S1 = -1.66666666666666324348e-01
const S2 = 8.33333333332248946124e-03
const S3 = -1.98412698298579493134e-04
const S4 = 2.75573137070700676789e-06
const S5 = -2.50507602534068634195e-08
const S6 = 1.58969099521155010221e-10

/// sin(x + y), |x + y| ~<= pi/4, y a tail of x; iy 0 if there is none.
function kSin(x: f64, y: f64, iy: i32): f64 {
	const z = x * x
	const w = z * z
	const r = S2 + z * (S3 + z * S4) + z * w * (S5 + z * S6)
	const v = z * x
	if (iy == 0) {
		return x + v * (S1 + z * r)
	}
	return x - ((z * (0.5 * y - v * r) - y) - v * S1)
}

// cos(x) ~ 1 - x^2/2 + C1 x^4 + ... + C6 x^14 on [-pi/4, pi/4]
const C1 = 4.16666666666666019037e-02
const C2 = -1.38888888888741095749e-03
const C3 = 2.48015872894767294178e-05
const C4 = -2.75573143513906633035e-07
const C5 = 2.08757232129817482790e-09
const C6 = -1.13596475577881948265e-11

/// cos(x + y), |x + y| ~<= pi/4, y a tail of x.
function kCos(x: f64, y: f64): f64 {
	const z = x * x
	let w = z * z
	const r = z * (C1 + z * (C2 + z * C3)) + w * w * (C4 + z * (C5 + z * C6))
	const hz = 0.5 * z
	w = 1.0 - hz
	return w + (((1.0 - w) - hz) + (z * r - x * y))
}

// tan(x) ~ x + T0 x^3 + ... + T12 x^27 on [0, 0.67434]
const T0 = 3.33333333333334091986e-01
const T1 = 1.33333333333201242699e-01
const T2 = 5.39682539762260521377e-02
const T3 = 2.18694882948595424599e-02
const T4 = 8.86323982359930005737e-03
const T5 = 3.59207910759131235356e-03
const T6 = 1.45620945432529025516e-03
const T7 = 5.88041240820264096874e-04
const T8 = 2.46463134818469906812e-04
const T9 = 7.81794442939557092300e-05
const T10 = 7.14072491382608190305e-05
const T11 = -1.85586374855275456654e-05
const T12 = 2.59073051863633712884e-05
const pio4lo = 3.06161699786838301793e-17

/// tan(x + y), or if odd is 1, -1/tan(x + y); |x + y| ~<= pi/4, y a tail of x.
function kTan(x0: f64, y0: f64, odd: i32): f64 {
	let x = x0
	let y = y0
	const hx = (asU64(x) >> 32) as u32
	const big = (hx & 0x7fffffff) >= 0x3fe59428 // |x| >= 0.6744: tan(pi/4 - x) instead
	const neg = hx >> 31 != 0
	if (big) {
		if (neg) {
			x = -x
			y = -y
		}
		x = (pio4 - x) + (pio4lo - y)
		y = 0.0
	}
	const z = x * x
	let w = z * z
	// odd and even terms apart
	let r = T1 + w * (T3 + w * (T5 + w * (T7 + w * (T9 + w * T11))))
	let v = z * (T2 + w * (T4 + w * (T6 + w * (T8 + w * (T10 + w * T12)))))
	let s = z * x
	r = y + z * (s * (r + v) + y) + s * T0
	w = x + r
	if (big) {
		s = (1 - 2 * odd) as f64
		v = s - 2.0 * (x + (r - w * w / (w + s)))
		return if (neg) -v else v
	}
	if (odd == 0) {
		return w
	}
	// -1/(x + r) to an ulp, by its high half and a Newton step
	const w0 = asF64(asU64(w) & 0xffffffff00000000)
	v = r - (w0 - x) // w0 + v = r + x
	const a = -1.0 / w
	const a0 = asF64(asU64(a) & 0xffffffff00000000)
	return a0 + a * (1.0 + a0 * w0 + a0 * v)
}

// as S1 ... S4, C0 ... C3 and T0 ... T5, for f32's precision
const SF1 = -0.16666666641626524
const SF2 = 0.008333329385889463
const SF3 = -0.00019839334836096632
const SF4 = 2.718311493989822e-06
const CF0 = -0.499999997251031
const CF1 = 0.04166662332373906
const CF2 = -0.001388676377460993
const CF3 = 2.439044879627741e-05
const TF0 = 0.3333313950307914
const TF1 = 0.13339200271297674
const TF2 = 0.05338123784456704
const TF3 = 0.024528318116654728
const TF4 = 0.002974357433599673
const TF5 = 0.009465647849436732

/// sin(x), |x| ~<= pi/4, to an f32.
function kSinf(x: f64): f32 {
	const z = x * x
	const w = z * z
	const r = SF3 + z * SF4
	const s = z * x
	return ((x + s * (SF1 + z * SF2)) + s * w * r) as f32
}

/// cos(x), |x| ~<= pi/4, to an f32.
function kCosf(x: f64): f32 {
	const z = x * x
	const w = z * z
	const r = CF2 + z * CF3
	return (((1.0 + z * CF0) + w * CF1) + (w * z) * r) as f32
}

/// tan(x), or if odd is 1, -1/tan(x), |x| ~<= pi/4, to an f32.
function kTanf(x: f64, odd: i32): f32 {
	const z = x * x
	let r = TF4 + z * TF5
	const t = TF2 + z * TF3
	const w = z * z
	const s = z * x
	const u = TF0 + z * TF1
	r = (x + s * u) + (s * w) * (t + w * r)
	return (if (odd != 0) -1.0 / r else r) as f32
}

function sinF64(x: f64): f64 {
	const ix = (asU64(x) >> 32 & 0x7fffffff) as u32
	if (ix <= 0x3fe921fb) {
		// |x| ~<= pi/4
		return if (ix < 0x3e500000) x else kSin(x, 0.0, 0)
	}
	if (ix >= 0x7ff00000) {
		return x - x
	}
	const [n, y0, y1] = remPio2(x)
	return switch (n & 3) {
		case 0: kSin(y0, y1, 1)
		case 1: kCos(y0, y1)
		case 2: -kSin(y0, y1, 1)
		default: -kCos(y0, y1)
	}
}

function cosF64(x: f64): f64 {
	const ix = (asU64(x) >> 32 & 0x7fffffff) as u32
	if (ix <= 0x3fe921fb) {
		return if (ix < 0x3e46a09e) 1.0 else kCos(x, 0.0)
	}
	if (ix >= 0x7ff00000) {
		return x - x
	}
	const [n, y0, y1] = remPio2(x)
	return switch (n & 3) {
		case 0: kCos(y0, y1)
		case 1: -kSin(y0, y1, 1)
		case 2: -kCos(y0, y1)
		default: kSin(y0, y1, 1)
	}
}

function tanF64(x: f64): f64 {
	const ix = (asU64(x) >> 32 & 0x7fffffff) as u32
	if (ix <= 0x3fe921fb) {
		return if (ix < 0x3e400000) x else kTan(x, 0.0, 0)
	}
	if (ix >= 0x7ff00000) {
		return x - x
	}
	const [n, y0, y1] = remPio2(x)
	return kTan(y0, y1, n & 1)
}

/// [sin(x), cos(x)].
function sincosF64(x: f64): [f64, f64] {
	const ix = (asU64(x) >> 32 & 0x7fffffff) as u32
	if (ix <= 0x3fe921fb) {
		return if (ix < 0x3e46a09e) [x, 1.0] else [kSin(x, 0.0, 0), kCos(x, 0.0)]
	}
	if (ix >= 0x7ff00000) {
		return [x - x, x - x]
	}
	const [n, y0, y1] = remPio2(x)
	const s = kSin(y0, y1, 1)
	const c = kCos(y0, y1)
	return switch (n & 3) {
		case 0: [s, c]
		case 1: [c, -s]
		case 2: [-s, -c]
		default: [-c, s]
	}
}

/// k pi/2 rounded to f64, as pio2xk.
const pio2x1 = 1.5707963267948966
const pio2x2 = 3.141592653589793
const pio2x3 = 4.71238898038469
const pio2x4 = 6.283185307179586

function sinF32(x: f32): f32 {
	const u = asU32(x)
	const neg = u >> 31 != 0
	const ix = u & 0x7fffffff
	const d = x as f64
	if (ix <= 0x3f490fda) {
		// |x| ~<= pi/4
		return if (ix < 0x39800000) x else kSinf(d)
	}
	if (ix <= 0x407b53d1) {
		// |x| ~<= 5pi/4
		if (ix <= 0x4016cbe3) {
			return if (neg) -kCosf(d + pio2x1) else kCosf(d - pio2x1)
		}
		return kSinf(if (neg) -(d + pio2x2) else -(d - pio2x2))
	}
	if (ix <= 0x40e231d5) {
		// |x| ~<= 9pi/4
		if (ix <= 0x40afeddf) {
			return if (neg) kCosf(d + pio2x3) else -kCosf(d - pio2x3)
		}
		return kSinf(if (neg) d + pio2x4 else d - pio2x4)
	}
	if (ix >= 0x7f800000) {
		return x - x
	}
	const [n, y] = remPio2f(x)
	return switch (n & 3) {
		case 0: kSinf(y)
		case 1: kCosf(y)
		case 2: kSinf(-y)
		default: -kCosf(y)
	}
}

function cosF32(x: f32): f32 {
	const u = asU32(x)
	const neg = u >> 31 != 0
	const ix = u & 0x7fffffff
	const d = x as f64
	if (ix <= 0x3f490fda) {
		return if (ix < 0x39800000) 1.0 else kCosf(d)
	}
	if (ix <= 0x407b53d1) {
		if (ix > 0x4016cbe3) {
			return -kCosf(if (neg) d + pio2x2 else d - pio2x2)
		}
		return if (neg) kSinf(d + pio2x1) else kSinf(pio2x1 - d)
	}
	if (ix <= 0x40e231d5) {
		if (ix > 0x40afeddf) {
			return kCosf(if (neg) d + pio2x4 else d - pio2x4)
		}
		return if (neg) kSinf(-d - pio2x3) else kSinf(d - pio2x3)
	}
	if (ix >= 0x7f800000) {
		return x - x
	}
	const [n, y] = remPio2f(x)
	return switch (n & 3) {
		case 0: kCosf(y)
		case 1: kSinf(-y)
		case 2: -kCosf(y)
		default: kSinf(y)
	}
}

function tanF32(x: f32): f32 {
	const u = asU32(x)
	const neg = u >> 31 != 0
	const ix = u & 0x7fffffff
	const d = x as f64
	if (ix <= 0x3f490fda) {
		return if (ix < 0x39800000) x else kTanf(d, 0)
	}
	if (ix <= 0x407b53d1) {
		if (ix <= 0x4016cbe3) {
			return kTanf(if (neg) d + pio2x1 else d - pio2x1, 1)
		}
		return kTanf(if (neg) d + pio2x2 else d - pio2x2, 0)
	}
	if (ix <= 0x40e231d5) {
		if (ix <= 0x40afeddf) {
			return kTanf(if (neg) d + pio2x3 else d - pio2x3, 1)
		}
		return kTanf(if (neg) d + pio2x4 else d - pio2x4, 0)
	}
	if (ix >= 0x7f800000) {
		return x - x
	}
	const [n, y] = remPio2f(x)
	return kTanf(y, n & 1)
}

/// [sinf(x), cosf(x)].
function sincosF32(x: f32): [f32, f32] {
	const u = asU32(x)
	const neg = u >> 31 != 0
	const ix = u & 0x7fffffff
	const d = x as f64
	if (ix <= 0x3f490fda) {
		return if (ix < 0x39800000) [x, 1.0] else [kSinf(d), kCosf(d)]
	}
	if (ix <= 0x407b53d1) {
		if (ix <= 0x4016cbe3) {
			return if (neg) [-kCosf(d + pio2x1), kSinf(d + pio2x1)] else [kCosf(pio2x1 - d), kSinf(pio2x1 - d)]
		}
		// -sin(x + c) is not sin(-(x + c)) where x + c is 0
		const y = if (neg) d + pio2x2 else d - pio2x2
		return [-kSinf(y), -kCosf(y)]
	}
	if (ix <= 0x40e231d5) {
		if (ix <= 0x40afeddf) {
			return if (neg) [kCosf(d + pio2x3), -kSinf(d + pio2x3)] else [-kCosf(d - pio2x3), kSinf(d - pio2x3)]
		}
		const y = if (neg) d + pio2x4 else d - pio2x4
		return [kSinf(y), kCosf(y)]
	}
	if (ix >= 0x7f800000) {
		return [x - x, x - x]
	}
	const [n, y] = remPio2f(x)
	const s = kSinf(y)
	const c = kCosf(y)
	return switch (n & 3) {
		case 0: [s, c]
		case 1: [c, -s]
		case 2: [-s, -c]
		default: [-c, s]
	}
}

// # Inverse trigonometric functions
//
// The inverse trigonometric functions, arcsine, arccosine and arctangent, and the arctangent of y/x in all four
// quadrants.
//
// Ported from musl 1.2.5, MIT, Copyright © 2005-2020 Rich Felker, et al. (vendor/musl/COPYRIGHT), from FreeBSD:
// Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved. Developed at SunSoft, a Sun Microsystems, Inc.
// business. Permission to use, copy, modify, and distribute this software is freely granted, provided that this notice
// is preserved. f32 versions by Ian Lance Taylor, Cygnus Support.
const pio2Hi = 1.57079632679489655800e+00
const pio2Lo = 6.12323399573676603587e-17
// asin(x) ~ x + x^3 R(x^2) on [-0.5, 0.5], R a rational function
const pS0 = 1.66666666666666657415e-01
const pS1 = -3.25565818622400915405e-01
const pS2 = 2.01212532134862925881e-01
const pS3 = -4.00555345006794114027e-02
const pS4 = 7.91534994289814532176e-04
const pS5 = 3.47933107596021167570e-05
const qS1 = -2.40339491173441421878e+00
const qS2 = 2.02094576023350569471e+00
const qS3 = -6.88283971605453293030e-01
const qS4 = 7.70381505559019352791e-02

function rational(z: f64): f64 {
	const p = z * (pS0 + z * (pS1 + z * (pS2 + z * (pS3 + z * (pS4 + z * pS5)))))
	const q = 1.0 + z * (qS1 + z * (qS2 + z * (qS3 + z * qS4)))
	return p / q
}

/// x's upper 32 bits, its low ones 0.
function upper(x: f64): f64 { return asF64(asU64(x) & 0xffffffff00000000) }

function asinF64(x: f64): f64 {
	const u = asU64(x)
	const hx = (u >> 32) as u32
	const ix = hx & 0x7fffffff
	if (ix >= 0x3ff00000) {
		// |x| >= 1, or NaN
		if ((ix - 0x3ff00000 | (u as u32)) == 0) {
			return x * pio2Hi
		}
		return 0.0 / (x - x)
	}
	if (ix < 0x3fe00000) {
		// |x| < 0.5
		if (ix < 0x3e500000 && ix >= 0x00100000) {
			return x
		}
		return x + x * rational(x * x)
	}
	// asin(x) = pi/2 - 2 asin(sqrt((1 - |x|)/2))
	const z = (1.0 - fabs(x)) * 0.5
	const s = sqrtF64(z)
	const r = rational(z)
	let y = 0.0
	if (ix >= 0x3fef3333) {
		// |x| > 0.975
		y = pio2Hi - (2.0 * (s + s * r) - pio2Lo)
	} else {
		// f + c = sqrt(z)
		const f = upper(s)
		const c = (z - f * f) / (s + f)
		y = 0.5 * pio2Hi - (2.0 * s * r - (pio2Lo - 2.0 * c) - (0.5 * pio2Hi - 2.0 * f))
	}
	return if (hx >> 31 != 0) -y else y
}

function acosF64(x: f64): f64 {
	const u = asU64(x)
	const hx = (u >> 32) as u32
	const ix = hx & 0x7fffffff
	if (ix >= 0x3ff00000) {
		if ((ix - 0x3ff00000 | (u as u32)) == 0) {
			return if (hx >> 31 != 0) 2.0 * pio2Hi else 0.0
		}
		return 0.0 / (x - x)
	}
	if (ix < 0x3fe00000) {
		if (ix <= 0x3c600000) {
			// |x| < 2^-57
			return pio2Hi
		}
		return pio2Hi - (x - (pio2Lo - x * rational(x * x)))
	}
	if (hx >> 31 != 0) {
		// x < -0.5: acos(x) = pi - 2 asin(sqrt((1 + x)/2))
		const z = (1.0 + x) * 0.5
		const s = sqrtF64(z)
		const w = rational(z) * s - pio2Lo
		return 2.0 * (pio2Hi - (s + w))
	}
	// x > 0.5: acos(x) = 2 asin(sqrt((1 - x)/2))
	const z = (1.0 - x) * 0.5
	const s = sqrtF64(z)
	const df = upper(s)
	const c = (z - df * df) / (s + df)
	const w = rational(z) * s + c
	return 2.0 * (df + w)
}

/// atan of 0.5, 1, 1.5 and inf, each as a sum.
const atanHi: f64[] = [4.63647609000806093515e-01, 7.85398163397448278999e-01, 9.82793723247329054082e-01,
	1.57079632679489655800e+00]

const atanLo: f64[] = [2.26987774529616870924e-17, 3.06161699786838301793e-17, 1.39033110312309984516e-17,
	6.12323399573676603587e-17]

// atan(x) ~ x - x^3 (aT0 + aT1 x^2 + ... + aT10 x^20) on [-7/16, 7/16]
const aT0 = 3.33333333333329318027e-01
const aT1 = -1.99999999998764832476e-01
const aT2 = 1.42857142725034663711e-01
const aT3 = -1.11111104054623557880e-01
const aT4 = 9.09088713343650656196e-02
const aT5 = -7.69187620504482999495e-02
const aT6 = 6.66107313738753120669e-02
const aT7 = -5.83357013379057348645e-02
const aT8 = 4.97687799461593236017e-02
const aT9 = -3.65315727442169155270e-02
const aT10 = 1.62858201153657823623e-02

function atanF64(x0: f64): f64 {
	const hx = (asU64(x0) >> 32) as u32
	const neg = hx >> 31 != 0
	const ix = hx & 0x7fffffff
	if (ix >= 0x44100000) {
		// |x| >= 2^66
		if (x0 != x0) {
			return x0
		}
		return if (neg) -atanHi[3] else atanHi[3]
	}
	// x reduced to within 7/16 of 0 by atan(x) = atan(c) + atan((x - c)/(1 + xc)), c the id-th of 0.5, 1, 1.5 and inf
	let x = x0
	let id = -1
	if (ix < 0x3fdc0000) {
		// |x| < 0.4375
		if (ix < 0x3e400000) {
			return x
		}
	} else {
		x = fabs(x)
		if (ix < 0x3fe60000) {
			id = 0
			x = (2.0 * x - 1.0) / (2.0 + x)
		} else if (ix < 0x3ff30000) {
			id = 1
			x = (x - 1.0) / (x + 1.0)
		} else if (ix < 0x40038000) {
			id = 2
			x = (x - 1.5) / (1.0 + 1.5 * x)
		} else {
			id = 3
			x = -1.0 / x
		}
	}
	const z = x * x
	const w = z * z
	// odd and even terms apart
	const s1 = z * (aT0 + w * (aT2 + w * (aT4 + w * (aT6 + w * (aT8 + w * aT10)))))
	const s2 = w * (aT1 + w * (aT3 + w * (aT5 + w * (aT7 + w * aT9))))
	if (id < 0) {
		return x - x * (s1 + s2)
	}
	const r = atanHi[id] - (x * (s1 + s2) - atanLo[id] - x)
	return if (neg) -r else r
}

const piLo = 1.2246467991473531772E-16

/// The angle of the point (x, y) from the x axis, in [-pi, pi].
function atan2F64(y: f64, x: f64): f64 {
	if (x != x || y != y) {
		return x + y
	}
	const ux = asU64(x)
	const uy = asU64(y)
	const lx = ux as u32
	const ly = uy as u32
	if ((((ux >> 32) as u32) - 0x3ff00000 | lx) == 0) {
		// x = 1
		return atanF64(y)
	}
	const m = (uy >> 63 | ux >> 62 & 2) as i32 // 2 sign(x) + sign(y)
	const ix = (ux >> 32 & 0x7fffffff) as u32
	const iy = (uy >> 32 & 0x7fffffff) as u32
	if ((iy | ly) == 0) {
		return switch (m) {
			case 0, 1: y
			case 2: pi
			default: -pi
		}
	}
	if ((ix | lx) == 0) {
		return if ((m & 1) != 0) -pi / 2.0 else pi / 2.0
	}
	if (ix == 0x7ff00000) {
		if (iy == 0x7ff00000) {
			return switch (m) {
				case 0: pi / 4.0
				case 1: -pi / 4.0
				case 2: 3.0 * pi / 4.0
				default: -3.0 * pi / 4.0
			}
		}
		return switch (m) {
			case 0: 0.0
			case 1: -0.0
			case 2: pi
			default: -pi
		}
	}
	if (ix + (64 << 20) < iy || iy == 0x7ff00000) {
		// |y/x| > 2^64
		return if ((m & 1) != 0) -pi / 2.0 else pi / 2.0
	}
	// atan(|y/x|), without underflow where it is below 2^-64 and x < 0
	const z = if ((m & 2) != 0 && iy + (64 << 20) < ix) 0.0 else atanF64(fabs(y / x))
	return switch (m) {
		case 0: z
		case 1: -z
		case 2: pi - (z - piLo)
		default: (z - piLo) - pi
	}
}

// as R, for f32's precision
const pS0f: f32 = 1.6666586697e-01
const pS1f: f32 = -4.2743422091e-02
const pS2f: f32 = -8.6563630030e-03
const qS1f: f32 = -7.0662963390e-01

function rationalf(z: f32): f32 {
	const p = z * (pS0f + z * (pS1f + z * pS2f))
	const q = 1.0 + z * qS1f
	return p / q
}

function asinF32(x: f32): f32 {
	const hx = asU32(x)
	const ix = hx & 0x7fffffff
	if (ix >= 0x3f800000) {
		if (ix == 0x3f800000) {
			return ((x as f64) * pio2Hi) as f32
		}
		return 0.0 / (x - x)
	}
	if (ix < 0x3f000000) {
		if (ix < 0x39800000 && ix >= 0x00800000) {
			return x
		}
		return x + x * rationalf(x * x)
	}
	const z: f32 = (1.0 - fabsf(x)) * 0.5
	const s = sqrtF64(z as f64)
	const y = (pio2Hi - 2.0 * (s + s * (rationalf(z) as f64))) as f32
	return if (hx >> 31 != 0) -y else y
}

const pio2Hif: f32 = 1.5707962513e+00
const pio2Lof: f32 = 7.5497894159e-08

function acosF32(x: f32): f32 {
	const hx = asU32(x)
	const ix = hx & 0x7fffffff
	if (ix >= 0x3f800000) {
		if (ix == 0x3f800000) {
			return if (hx >> 31 != 0) 2.0 * pio2Hif else 0.0
		}
		return 0.0 / (x - x)
	}
	if (ix < 0x3f000000) {
		if (ix <= 0x32800000) {
			return pio2Hif
		}
		return pio2Hif - (x - (pio2Lof - x * rationalf(x * x)))
	}
	if (hx >> 31 != 0) {
		const z: f32 = (1.0 + x) * 0.5
		const s = sqrtF32(z)
		const w = rationalf(z) * s - pio2Lof
		return 2.0 * (pio2Hif - (s + w))
	}
	const z: f32 = (1.0 - x) * 0.5
	const s = sqrtF32(z)
	const df = asF32(asU32(s) & 0xfffff000)
	const c = (z - df * df) / (s + df)
	const w = rationalf(z) * s + c
	return 2.0 * (df + w)
}

const atanHif: f32[] = [4.6364760399e-01, 7.8539812565e-01, 9.8279368877e-01, 1.5707962513e+00]
const atanLof: f32[] = [5.0121582440e-09, 3.7748947079e-08, 3.4473217170e-08, 7.5497894159e-08]
const aT0f: f32 = 3.3333328366e-01
const aT1f: f32 = -1.9999158382e-01
const aT2f: f32 = 1.4253635705e-01
const aT3f: f32 = -1.0648017377e-01
const aT4f: f32 = 6.1687607318e-02

function atanF32(x0: f32): f32 {
	const hx = asU32(x0)
	const neg = hx >> 31 != 0
	const ix = hx & 0x7fffffff
	if (ix >= 0x4c800000) {
		// |x| >= 2^26
		if (x0 != x0) {
			return x0
		}
		return if (neg) -atanHif[3] else atanHif[3]
	}
	let x = x0
	let id = -1
	if (ix < 0x3ee00000) {
		if (ix < 0x39800000) {
			return x
		}
	} else {
		x = fabsf(x)
		if (ix < 0x3f300000) {
			id = 0
			x = (2.0 * x - 1.0) / (2.0 + x)
		} else if (ix < 0x3f980000) {
			id = 1
			x = (x - 1.0) / (x + 1.0)
		} else if (ix < 0x401c0000) {
			id = 2
			x = (x - 1.5) / (1.0 + 1.5 * x)
		} else {
			id = 3
			x = -1.0 / x
		}
	}
	const z = x * x
	const w = z * z
	const s1 = z * (aT0f + w * (aT2f + w * aT4f))
	const s2 = w * (aT1f + w * aT3f)
	if (id < 0) {
		return x - x * (s1 + s2)
	}
	const r = atanHif[id] - ((x * (s1 + s2) - atanLof[id]) - x)
	return if (neg) -r else r
}

const pif: f32 = 3.1415927410e+00
const piLof: f32 = -8.7422776573e-08

/// The angle of the point (x, y) from the x axis, in [-pi, pi].
function atan2F32(y: f32, x: f32): f32 {
	if (x != x || y != y) {
		return x + y
	}
	const ux = asU32(x)
	const uy = asU32(y)
	if (ux == 0x3f800000) {
		return atanF32(y)
	}
	const m = (uy >> 31 | ux >> 30 & 2) as i32
	const ix = ux & 0x7fffffff
	const iy = uy & 0x7fffffff
	if (iy == 0) {
		return switch (m) {
			case 0, 1: y
			case 2: pif
			default: -pif
		}
	}
	if (ix == 0) {
		return if ((m & 1) != 0) -pif / 2.0 else pif / 2.0
	}
	if (ix == 0x7f800000) {
		if (iy == 0x7f800000) {
			return switch (m) {
				case 0: pif / 4.0
				case 1: -pif / 4.0
				case 2: 3.0 * pif / 4.0
				default: -3.0 * pif / 4.0
			}
		}
		return switch (m) {
			case 0: 0.0
			case 1: -0.0
			case 2: pif
			default: -pif
		}
	}
	if (ix + (26 << 23) < iy || iy == 0x7f800000) {
		return if ((m & 1) != 0) -pif / 2.0 else pif / 2.0
	}
	const z: f32 = if ((m & 2) != 0 && iy + (26 << 23) < ix) 0.0 else atanF32(fabsf(y / x))
	return switch (m) {
		case 0: z
		case 1: -z
		case 2: pif - (z - piLof)
		default: (z - piLof) - pif
	}
}

// # Exponentials
