	6.22741452364621501295e-09, 1.66559246207992079114e-11]

const y1uf: f32[] = [-1.9605709612e-01, 5.0443872809e-02, -1.9125689287e-03, 2.3525259166e-05, -9.1909917899e-08]
const y1vf: f32[] = [1.9916731864e-02, 2.0255257550e-04, 1.3560879779e-06, 6.2274145840e-09, 1.6655924903e-11]

/// p1(x) = 1 + R/S, R and S of 1/x^2, x >= 2.
function p1(x: f64): f64 {
	const b = band(high(x) & 0x7fffffff)
	const z = 1.0 / (x * x)
	return 1.0 + poly(p1R[b], z) / (1.0 + z * poly(p1S[b], z))
}

/// q1(x) = (3/8 + R/S)/x, R and S of 1/x^2, x >= 2.
function q1(x: f64): f64 {
	const b = band(high(x) & 0x7fffffff)
	const z = 1.0 / (x * x)
	return (0.375 + poly(q1R[b], z) / (1.0 + z * poly(q1S[b], z))) / x
}

function p1f(x: f32): f32 {
	const b = bandf(asU32(x) & 0x7fffffff)
	const z: f32 = 1.0 / (x * x)
	return 1.0 + polyf(p1Rf[b], z) / (1.0 + z * polyf(p1Sf[b], z))
}

function q1f(x: f32): f32 {
	const b = bandf(asU32(x) & 0x7fffffff)
	const z: f32 = 1.0 / (x * x)
	return (0.375 + polyf(q1Rf[b], z) / (1.0 + z * polyf(q1Sf[b], z))) / x
}

/// j1(x), or y1(x) if y, for x >= 2 of high word ix, negated if neg: 1/sqrt(pi x) (p1 (sin x - cos x) -+
/// q1 (-sin x - cos x)), as common0.
function common1(ix: u32, x: f64, y: bool, neg: bool): f64 {
	const s = if (y) -sinF64(x) else sinF64(x)
	const c = cosF64(x)
	let cc = s - c
	if (ix < 0x7fe00000) {
		let ss = -s - c
		const z = cosF64(2.0 * x)
		if (s * c > 0.0) {
			cc = z / ss
		} else {
			ss = z / cc
		}
		if (ix < 0x48000000) {
			cc = p1(x) * cc - q1(x) * (if (y) -ss else ss)
		}
	}
	return invsqrtpi * (if (neg) -cc else cc) / sqrtF64(x)
}

/// common1 in f32, but for its sums and result, which musl takes in f64.
function common1f(ix: u32, x: f32, y: bool, neg: bool): f32 {
	const s = (if (y) -sinF32(x) else sinF32(x)) as f64
	const c = cosF32(x) as f64
	let cc = s - c
	if (ix < 0x7f000000) {
		let ss = -s - c
		const z = cosF32(2.0 * x) as f64
		if (s * c > 0.0) {
			cc = z / ss
		} else {
			ss = z / cc
		}
		if (ix < 0x58800000) {
			cc = (p1f(x) as f64) * cc - (q1f(x) as f64) * (if (y) -ss else ss)
		}
	}
	return ((invsqrtpif as f64) * (if (neg) -cc else cc) / (sqrtF32(x) as f64)) as f32
}

/// The Bessel function of the first kind of order 1.
function j1F64(x: f64): f64 {
	const hx = high(x)
	const ix = hx & 0x7fffffff
	if (ix >= 0x7ff00000) {
		return 1.0 / (x * x)
	}
	if (ix >= 0x40000000) {
		return common1(ix, fabs(x), false, hx >> 31 != 0)
	}
	if (ix < 0x38000000) {
		// |x| < 2^-127
		return (0.5 + x) * x
	}
	const z = x * x
	return (0.5 + z * poly(j1r, z) / (1.0 + z * poly(j1s, z))) * x
}

function j1F32(x: f32): f32 {
	const hx = asU32(x)
	const ix = hx & 0x7fffffff
	if (ix >= 0x7f800000) {
		return 1.0 / (x * x)
	}
	if (ix >= 0x40000000) {
		return common1f(ix, fabsf(x), false, hx >> 31 != 0)
	}
	if (ix < 0x39000000) {
		// |x| < 2^-13
		return 0.5 * x
	}
	const z = x * x
	return (0.5 + z * polyf(j1rf, z) / (1.0 + z * polyf(j1sf, z))) * x
}

/// The Bessel function of the second kind of order 1: -infinity at 0, NaN below.
function y1F64(x: f64): f64 {
	const u = asU64(x)
	const ix = (u >> 32) as u32
	if (u << 1 == 0) {
		return -inf
	}
	if (ix >> 31 != 0) {
		return nan
	}
	if (ix >= 0x7ff00000) {
		return 1.0 / x
	}
	if (ix >= 0x40000000) {
		return common1(ix, x, true, false)
	}
	if (ix < 0x3c900000) {
		// x < 2^-54
		return -tpi / x
	}
	const z = x * x
	return x * (poly(y1u, z) / (1.0 + z * poly(y1v, z))) + tpi * (j1F64(x) * logF64(x) - 1.0 / x)
}

function y1F32(x: f32): f32 {
	const ix = asU32(x)
	if (ix & 0x7fffffff == 0) {
		return -inff
	}
	if (ix >> 31 != 0) {
		return nanf
	}
	if (ix >= 0x7f800000) {
		return 1.0 / x
	}
	if (ix >= 0x40000000) {
		return common1f(ix, x, true, false)
	}
	if (ix < 0x33000000) {
		// x < 2^-25
		return -tpif / x
	}
	const z = x * x
	return x * (polyf(y1uf, z) / (1.0 + z * polyf(y1vf, z))) + tpif * (j1F32(x) * logF32(x) - 1.0 / x)
}

// Order n.
/// sqrt(2) sin(x0) or, for j, sqrt(2) cos(x0), x0 = x - (2n + 1) pi/4, by n mod 4, from s = sin x and c = cos x.
function shifted(m: i32, j: bool, x: f64): f64 {
	const s = sinF64(x)
	const c = cosF64(x)
	if (j) {
		return switch (m & 3) {
			case 0: -c + s
			case 1: -c - s
			case 2: c - s
			default: c + s
		}
	}
	return switch (m & 3) {
		case 0: -s - c
		case 1: -s + c
		case 2: s + c
		default: s - c
	}
}

/// The Bessel function of the first kind of order n; j(-n, x) = j(n, -x) = (-1)^n j(n, x).
function jnF64(n: i32, x: f64): f64 {
	if (x != x) {
		return x
	}
	if (n == 0) {
		return j0F64(x)
	}
	let sign = (asU64(x) >> 63) as i32
	let y = x
	let nm1 = n - 1 // |n| - 1, which holds for the least i32
	if (n < 0) {
		nm1 = -(n + 1)
		y = -x
		sign ^= 1
	}
	if (nm1 == 0) {
		return j1F64(y)
	}
	sign &= n // signbit(x) for odd n
	y = fabs(y)
	let b = 0.0
	if (y == 0.0 || y == inf) {
		b = 0.0
	} else if ((nm1 as f64) < y) {
		if (high(y) >= 0x52d00000) {
			// x > 2^302
			b = invsqrtpi * shifted(nm1, true, y) / sqrtF64(y)
		} else {
			// j(n + 1, x) = 2n/x j(n, x) - j(n - 1, x)
			let a = j0F64(y)
			b = j1F64(y)
			for (const i of 1 ... nm1) {
				const t = b
				b = b * (2.0 * (i as f64) / y) - a
				a = t
			}
		}
	} else if (high(y) < 0x3e100000) {
		// x < 2^-29: (x/2)^n / n!, or 0 where that underflows
		if (nm1 <= 32) {
			const half = y * 0.5
			let a = 1.0
			b = half
			for (const i of 2 ... nm1 + 1) {
				a *= i as f64
				b *= half
			}
			b = b / a
		}
	} else {
		// Backward from j(n, x)/j(n - 1, x) as a continued fraction 1/(w - 1/(w + h - 1/(w + 2h - ...))), w = 2n/x
		// and h = 2/x, of k terms, k where Q(0) = w, Q(1) = w(w + h) - 1, Q(k) = (w + kh) Q(k - 1) - Q(k - 2)
		// passes 1e9.
		const nf = (nm1 as f64) + 1.0
		const w = 2.0 * nf / y
		const h = 2.0 / y
		let z = w + h
		let q0 = w
		let q1 = w * z - 1.0
		let k = 1
		while (q1 < 1.0e9) {
			k += 1
			z += h
			const q = z * q1 - q0
			q0 = q1
			q1 = q
		}
		let t = 0.0
		let i = k
		while (i >= 0) {
			t = 1.0 / (2.0 * ((i as f64) + nf) / y - t)
			i--
		}
		let a = t
		b = 1.0
		// Past log of the greatest f64, n log(2n/x) estimating log((2/x)^n n!), b is kept from overflowing.
		const scale = nf * logF64(fabs(w)) >= 7.09782712893383973096e+02
		i = nm1
		while (i > 0) {
			const tb = b
			b = b * (2.0 * (i as f64)) / y - a
			a = tb
			if (scale && b > asF64(0x5f30000000000000)) {
				// 2^500
				a /= b
				t /= b
				b = 1.0
			}
			i--
		}
		const j0x = j0F64(y)
		const j1x = j1F64(y)
		b = if (fabs(j0x) >= fabs(j1x)) t * j0x / b else t * j1x / a
	}
	return if (sign != 0) -b else b
}

function jnF32(n: i32, x: f32): f32 {
	if (x != x) {
		return x
	}
	if (n == 0) {
		return j0F32(x)
	}
	let sign = (asU32(x) >> 31) as i32
	let y = x
	let nm1 = n - 1
	if (n < 0) {
		nm1 = -(n + 1)
		y = -x
		sign ^= 1
	}
	if (nm1 == 0) {
		return j1F32(y)
	}
	sign &= n
	y = fabsf(y)
	let b: f32 = 0.0
	if (y == 0.0 || y == inff) {
		b = 0.0
	} else if ((nm1 as f32) < y) {
		let a = j0F32(y)
		b = j1F32(y)
		for (const i of 1 ... nm1) {
			const t = b
			b = b * (2.0 * (i as f32) / y) - a
			a = t
		}
	} else if (asU32(y) < 0x35800000) {
		// x < 2^-20: (x/2)^n / n!, n at most 9
		const half = 0.5 * y
		let a: f32 = 1.0
		b = half
		for (const i of 2 ... (if (nm1 > 8) 8 else nm1) + 1) {
			a *= i as f32
			b *= half
		}
		b = b / a
	} else {
		// as jn, to 1e4
		const nf = (nm1 as f32) + 1.0
		const w = 2.0 * nf / y
		const h = 2.0 / y
		let z = w + h
		let q0 = w
		let q1 = w * z - 1.0
		let k = 1
		while (q1 < 1.0e4) {
			k += 1
			z += h
			const q = z * q1 - q0
			q0 = q1
			q1 = q
		}
		let t: f32 = 0.0
		let i = k
		while (i >= 0) {
			t = 1.0 / (2.0 * ((i as f32) + nf) / y - t)
			i--
		}
		let a = t
		b = 1.0
		const scale = nf * logF32(fabsf(w)) >= 88.721679688
		i = nm1
		while (i > 0) {
			const tb = b
			b = 2.0 * (i as f32) * b / y - a
			a = tb
			if (scale && b > asF32(0x5d800000)) {
				// 2^60
				a /= b
				t /= b
				b = 1.0
			}
			i--
		}
		const j0x = j0F32(y)
		const j1x = j1F32(y)
		b = if (fabsf(j0x) >= fabsf(j1x)) t * j0x / b else t * j1x / a
	}
	return if (sign != 0) -b else b
}

/// The Bessel function of the second kind of order n; y(-n, x) = (-1)^n y(n, x). -infinity at 0, NaN below.
function ynF64(n: i32, x: f64): f64 {
	if (x != x) {
		return x
	}
	if (asU64(x) >> 63 != 0 && x != 0.0) {
		return nan
	}
	if (x == inf) {
		return 0.0
	}
	if (n == 0) {
		return y0F64(x)
	}
	const nm1 = if (n < 0) -(n + 1) else n - 1
	const neg = n < 0 && (n & 1) != 0
	let b = 0.0
	if (nm1 == 0) {
		b = y1F64(x)
	} else if (high(x) & 0x7fffffff >= 0x52d00000) {
		// x > 2^302
		b = invsqrtpi * shifted(nm1, false, x) / sqrtF64(x)
	} else {
		// y(n + 1, x) = 2n/x y(n, x) - y(n - 1, x), until -infinity
		let a = y0F64(x)
		b = y1F64(x)
		let i = 0
		while (i < nm1 && high(b) != 0xfff00000) {
			i++
			const t = b
			b = (2.0 * (i as f64) / x) * b - a
			a = t
		}
	}
	return if (neg) -b else b
}

function ynF32(n: i32, x: f32): f32 {
	if (x != x) {
		return x
	}
	if (asU32(x) >> 31 != 0 && x != 0.0) {
		return nanf
	}
	if (x == inff) {
		return 0.0
	}
	if (n == 0) {
		return y0F32(x)
	}
	const nm1 = if (n < 0) -(n + 1) else n - 1
	const neg = n < 0 && (n & 1) != 0
	let b: f32 = 0.0
	if (nm1 == 0) {
		b = y1F32(x)
	} else {
		let a = y0F32(x)
		b = y1F32(x)
		let i = 0
		while (i < nm1 && asU32(b) != 0xff800000) {
			i++
			const t = b
			b = (2.0 * (i as f32) / x) * b - a
			a = t
		}
	}
	return if (neg) -b else b
}
