//! Type sets for constraining type parameters, reading tags, and the values of a union of literals.

export interface Signed extends i8 | i16 | i32 | i64 {}
export interface Unsigned extends u8 | u16 | u32 | u64 {}
export interface Integral extends Signed | Unsigned {}
export interface Float extends f32 | f64 {}
export interface Numeric extends Integral | Float {}
/// The types < compares.
export interface Ordered extends Numeric | string {}
/// A class that new makes without arguments.
export interface New { constructor() }
/// The types encodings decode: scalars, classes new makes of fields of these types, and arrays and tuples of them.
export interface Decodable extends bool | Numeric | string | null | New | Decodable[] | [...Decodable[]] {}

/// Whether tags hold A, or A with type arguments.
export function has(tags: Type[], A: Type): bool {
	for (const B of tags) {
		if (B == A || B.base == A) {
			return true
		}
	}
	return false
}

/// The value v of the tag A[v] among tags, or otherwise.
export function tag(tags: Type[], A: Type, otherwise: string): string {
	for (const B of tags) {
		if (B.args.length == 1 && B.base == A) {
			return B.args[0].value as string
		}
	}
	return otherwise
}

/// The values of the members of T, a union of literals.
export function values[T](): T[] {
	const out: T[] = []
	for (const m of T.members) {
		out.push(m.value)
	}
	return out
}
