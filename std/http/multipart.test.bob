import { Request, Response, Server, post, text } from "../http"
import { File, encode, form, parts } from "./multipart"
import { Reader } from "../io"
import { ParseError } from "../string"

/// s given k bytes at a time.
class Chunks implements Reader {
	s: string
	k: i32
	at = 0

	constructor(s: string, k: i32) {
		this.s = s
		this.k = k
	}

	read(n: i32): string | null throws IoError {
		if (this.at >= this.s.length) {
			return null
		}
		let end = this.at + (if (n < this.k) n else this.k)
		if (end > this.s.length) {
			end = this.s.length
		}
		const r = this.s.slice(this.at, end)
		this.at = end
		return r
	}
}

function whole(r: Reader): string throws IoError {
	let s = ""
	while (true) {
		const c = r.read(7)
		if (c == null) {
			return s
		}
		s += c
	}
}

const rfc = "--AaB03x\r\ncontent-disposition: form-data; name=\"field1\"\r\ncontent-type: text/plain;charset=windows-1250\r\n"
	+ "content-transfer-encoding: quoted-printable\r\n\r\nJoe owes =80100.\r\n--AaB03x--"

test "the RFC 7578 example" {
	const ps = parts(new Chunks(rfc, 1000), "multipart/form-data; boundary=AaB03x")
	const p = ps.next()!
	assert p.name == "field1" && p.filename == null
		&& p.headers.get("content-type") == "text/plain;charset=windows-1250"
	assert whole(p.body) == "Joe owes =80100."
	assert ps.next() == null && ps.next() == null
}

/// A preamble, a field, two files, one holding boundary-like lines, and an epilogue.
const mixed = "preamble\r\n--b\r\nContent-Disposition: form-data; name=\"f\"\r\n\r\nv\r\n"
	+ "--b  \r\nContent-Disposition: form-data; name=\"a\"; filename=\"x\\\"y.txt\"\r\nContent-Type: text/plain\r\n\r\n"
	+ "line\r\n--bx\r\n--b-x\r\n--b foo\r\n--\r\n"
	+ "--b\r\nContent-Disposition: form-data; name=\"c\"; filename=\"\"\r\n\r\n\r\n--b--\r\nepilogue"

test "parts stream however the bytes come" {
	for (const k of [1, 3, 1000]) {
		const ps = parts(new Chunks(mixed, k), "multipart/form-data; boundary=b")
		const f = ps.next()!
		assert f.name == "f" && f.filename == null && whole(f.body) == "v"
		const a = ps.next()!
		assert a.name == "a" && a.filename == "x\"y.txt" && a.headers.get("content-type") == "text/plain"
		assert whole(a.body) == "line\r\n--bx\r\n--b-x\r\n--b foo\r\n--"
		const c = ps.next()!
		assert c.filename == "" && c.body.read(10) == null
		assert ps.next() == null
	}
	// A part not read is skipped.
	const ps = parts(new Chunks(mixed, 2), "multipart/form-data; boundary=b")
	ps.next()
	assert ps.next()!.name == "a" && ps.next()!.name == "c" && ps.next() == null
}

test "errors" {
	assert parts(new Chunks(rfc, 10), "text/plain") throws new ParseError("syntax", 0)
	assert parts(new Chunks(rfc, 10), "multipart/form-data") throws new ParseError("syntax", 0)
	const cut = parts(new Chunks(rfc.slice(0, 100), 10), "multipart/form-data; boundary=AaB03x")
	assert whole(cut.next()!.body) throws new IoError("Protocol", "read", "multipart")
	const none = parts(new Chunks("nothing here", 10), "multipart/form-data; boundary=AaB03x")
	assert none.next() throws new IoError("Protocol", "read", "multipart")
	let big = "--b\r\nx: "
	for (const _ of 1 ... 9000) {
		big += "y"
	}
	assert parts(new Chunks(big, 100),
		"multipart/mixed; boundary=b").next() throws new IoError("TooLarge", "read", "multipart head")
	let many = "--b\r\n"
	for (const _ of 1 ... 2000) {
		many += "x: y\r\n"
	}
	assert parts(new Chunks(many, 100),
		"multipart/mixed; boundary=b").next() throws new IoError("TooLarge", "read", "multipart head")
	const bad = parts(new Chunks("--b\r\nno colon\r\n\r\n", 100), "multipart/mixed; boundary=b")
	assert bad.next() throws new IoError("Protocol", "read", "multipart")
}

test "the epilogue is not read, be it parts or long" {
	const hidden = "--b--junk\r\n--b\r\nContent-Disposition: form-data; name=\"h\"\r\n\r\nv\r\n--b--"
	assert parts(new Chunks(hidden, 100), "multipart/form-data; boundary=b").next() == null
	let long = "--b--"
	for (const _ of 1 ... 9000) {
		long += "y"
	}
	assert parts(new Chunks(long, 100), "multipart/form-data; boundary=b").next() == null
}

test "a quoted parameter may hold a semicolon" {
	const q = "--b\r\nContent-Disposition: form-data; name=\"a;b\"; filename=\"c\\\";d.txt\"\r\n\r\nv\r\n--b--"
	const p = parts(new Chunks(q, 100), "multipart/form-data; boundary=\"b\"").next()!
	assert p.name == "a;b" && p.filename == "c\";d.txt" && whole(p.body) == "v"
}

test "a backslash escapes only a quote or a backslash, as browsers leave a path's unescaped" {
	const q = "--b\r\nContent-Disposition: form-data; name=\"a\"; filename=\"C:\\dir\\\\x\\\"y.txt\"\r\n\r\nv\r\n--b--"
	assert parts(new Chunks(q, 100), "multipart/form-data; boundary=b").next()!.filename == "C:\\dir\\x\"y.txt"
}

test "a quoted parameter not closed at its end is none" {
	for (const v of ["\"abc", "\"a\"b\"", "\""]) {
		const q = `--b\r\nContent-Disposition: form-data; name="n"; filename=${v}\r\n\r\nv\r\n--b--`
		const p = parts(new Chunks(q, 100), "multipart/form-data; boundary=b").next()!
		assert p.name == "n" && p.filename == null
	}
	for (const b of ["\"b", "\"b\\"]) {
		assert parts(new Chunks("", 100), `multipart/form-data; boundary=${b}`) throws new ParseError("syntax", 0)
	}
}

function request(body: string, contentType: string): Request throws ParseError {
	const req = new Request("POST", "http://x/form", body)
	req.headers.set("content-type", contentType)
	return req
}

test "forms" {
	const u = form(request("a=1&b=x+y%21&a=2", "application/x-www-form-urlencoded"))
	assert u.fields.all("a").join(",") == "1,2" && u.fields.get("b") == "x y!" && u.files.length == 0
	const m = form(request(mixed, "multipart/form-data; boundary=b"))
	assert m.fields.get("f") == "v" && m.files.length == 2
	assert m.files[0].name == "a" && m.files[0].filename == "x\"y.txt" && m.files[0].contentType == "text/plain"
		&& m.files[0].data == "line\r\n--bx\r\n--b-x\r\n--b foo\r\n--"
	assert m.files[1].contentType == "application/octet-stream" && m.files[1].data == ""
	assert form(request(mixed, "multipart/form-data; boundary=b"), 10) throws new IoError("TooLarge", "read", "form")
	assert form(request("x", "text/plain")) throws new ParseError("syntax", 0)
	// A raw # or space is a form's, not a URL's.
	const raw = form(request("pass=ab#cd&next=a b", "application/x-www-form-urlencoded"))
	assert raw.fields.get("pass") == "ab#cd" && raw.fields.get("next") == "a b"
	// Empty parts count against the memory too.
	let empty = ""
	for (const _ of 1 ... 4) {
		empty += "--b\r\nContent-Disposition: form-data; name=\"n\"\r\n\r\n\r\n"
	}
	assert form(request(`${empty}--b--`, "multipart/form-data; boundary=b"), 100) throws new IoError("TooLarge", "read", "form")
	// So does a file's type.
	const typed = `--b\r\nContent-Disposition: form-data; name="a"; filename="f"\r\n`
		+ "Content-Type: application/vnd.openxmlformats-officedocument.wordprocessingml.document\r\n\r\n\r\n--b--"
	assert form(request(typed, "multipart/form-data; boundary=b"), 100) throws new IoError("TooLarge", "read", "form")
}

test "encode makes what parts and form read, and refuses a type that would split the head" {
	const f = new File()
	f.name = "up\\"
	f.filename = "a \"b\".bin"
	f.contentType = "application/octet-stream"
	f.data = "\r\n--\0\xff"
	const [body, ct] = encode([["k", "v"], ["k", "w\r\n"]], [f])
	const got = form(request(body, ct))
	assert got.fields.all("k").join("|") == "v|w\r\n"
	assert got.files.length == 1 && got.files[0].name == f.name
		&& got.files[0].filename == "a %22b%22.bin" && got.files[0].data == f.data
	assert encode([])[0] != encode([])[0]
	f.contentType = "a\r\nx: 1"
	assert encode([], [f]) throws new IoError("Protocol", "read", "Content-Type: a\r\nx: 1")
}

function app(req: Request): Response throws IoError | ParseError {
	const f = form(req, 200)
	return text(`${f.fields.get("k")}:${f.files.length}:${f.files[0].data}`)
}

test "a form goes through a server" {
	const s = new Server()
	s.addr = "127.0.0.1:0"
	const job = async s.serve(app)
	const f = new File()
	f.name = "file"
	f.filename = "f.txt"
	f.data = "hello"
	const [body, ct] = encode([["k", "v"]], [f])
	const res = post(`http://${s.addr}/form`, body, ct)
	assert res.status == 200 && res.body.text() == "v:1:hello"
	s.close()
	await job
}
