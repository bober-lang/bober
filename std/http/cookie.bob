//! Cookies as RFC 6265 has them: a Cookie is what Set-Cookie carries, and a Jar keeps a client's, as a Middleware.

import { endsWith, indexOf, lastIndexOf, stableSort, startsWith } from "../algo"
import { colon, isAlphanumeric, isDigit, slash } from "../ascii"
import { Middleware, Request, Response } from "../http"
import { maxOf, minOf } from "../limits"
import { min } from "../math"
import { ParseError, lower, parseInt, replace, split, trim } from "../string"
import { Date, DateTime, httpDate, isValid, second, utc } from "../time"
import { Url } from "../url"

export type SameSite = "Strict" | "Lax" | "None"

export class Cookie {
	name: string
	value: string
	domain = ""
	path = ""
	/// In ns since the epoch, as now() counts.
	expires: i64 | null = null
	/// In seconds; wins over expires.
	maxAge: i64 | null = null
	secure = false
	httpOnly = false
	sameSite: SameSite | null = null

	constructor(name: string = "", value: string = "") {
		this.name = name
		this.value = value
	}

	/// A Set-Cookie value; a syntax error past 4096 bytes of name and value, and an attribute's past 1024 ignored, as
	/// RFC 6265bis §5.6 has them, which bounds what a jar keeps.
	static parse(s: string): Cookie throws ParseError {
		const parts = split(s, ";")
		const eq = indexOf(parts[0], "=")
		const name = trim(parts[0].slice(0, if (eq < 0) parts[0].length else eq))
		const c = new Cookie(name, trim(parts[0].slice(eq + 1, parts[0].length)))
		if (eq < 0 || name == "" || name.length + c.value.length > 4096) {
			throw new ParseError("syntax", 0)
		}
		for (const part of parts.slice(1, parts.length)) {
			const at = indexOf(part, "=")
			const key = lower(trim(part.slice(0, if (at < 0) part.length else at)))
			const value = if (at < 0) "" else trim(part.slice(at + 1, part.length))
			if (value.length > 1024) {
				continue // Ignored (RFC 6265bis §5.6).
			}
			switch (key) {
				case "domain": c.domain = lower(if (startsWith(value, ".")) value.slice(1, value.length) else value)
				case "path": c.path = value
				case "expires": c.expires = cookieDate(value) ?? c.expires
				case "max-age": try {
					c.maxAge = parseInt[i64](value)
				} catch (e: ParseError) {
					// Past i64 it saturates too, if digits alone: a negative one is the earliest date, a positive one the
					// 400-day cap.
					const sign = if (startsWith(value, "-")) 1 else 0
					if (e.kind == "range" && sign + digits(value, sign) == value.length) {
						c.maxAge = if (sign == 1) minOf[i64]() else maxOf[i64]()
					}
				}
				case "secure": c.secure = true
				case "httponly": c.httpOnly = true
				case "samesite":
					const v = lower(value)
					c.sameSite = switch (v) {
						case "strict": "Strict"
						case "lax": "Lax"
						case "none": "None"
						default: c.sameSite
					}
				default: {}
			}
		}
		return c
	}

	/// As a Set-Cookie value.
	toString(): string {
		let s = `${replace(this.name, ";", "")}=${replace(this.value, ";", "")}`
		if (this.domain != "") {
			s += `; Domain=${replace(this.domain, ";", "")}`
		}
		if (this.path != "") {
			s += `; Path=${replace(this.path, ";", "")}`
		}
		if (this.expires != null) {
			s += `; Expires=${httpDate(this.expires!)}`
		}
		if (this.maxAge != null) {
			s += `; Max-Age=${this.maxAge}`
		}
		if (this.secure) {
			s += "; Secure"
		}
		if (this.httpOnly) {
			s += "; HttpOnly"
		}
		if (this.sameSite != null) {
			s += `; SameSite=${this.sameSite}`
		}
		return s
	}
}

/// The pairs of a Cookie request header, in order; one without = is skipped.
export function parseCookie(header: string): [string, string][] {
	const out: [string, string][] = []
	for (const part of split(header, ";")) {
		const eq = indexOf(part, "=")
		if (eq >= 0) {
			out.push([trim(part.slice(0, eq)), trim(part.slice(eq + 1, part.length))])
		}
	}
	return out
}

/// The cookies a request carries.
export function cookies(req: Request): [string, string][] { return parseCookie(req.headers.all("cookie").join("; ")) }
/// Adds c to a response.
export function add(res: Response, c: Cookie) { res.headers.append("set-cookie", c.toString()) }

/// A cookie as a Jar keeps it.
class Stored {
	c: Cookie
	/// Whether Set-Cookie gave no Domain.
	hostOnly: bool
	/// Resolved; null for the session.
	expiry: i64 | null

	constructor(c: Cookie, hostOnly: bool, expiry: i64 | null) {
		this.c = c
		this.hostOnly = hostOnly
		this.expiry = expiry
	}
}

export class Jar {
	private stored: Stored[] = []

	/// For Client.use: sends what matches, after any Cookie the request has, and keeps what is set. The request's
	/// headers are given back as they were, so it can be sent again.
	middleware: Middleware = (req, next) => {
		const given = [...req.headers.entries]
		const pairs = this.get(req.url)
		if (pairs.length > 0) {
			req.headers.set("cookie", [...req.headers.all("cookie"), ...pairs.map(p => `${p[0]}=${p[1]}`)].join("; "))
		}
		try {
			const res = next(req)
			for (const h of res.headers.all("set-cookie")) {
				try {
					this.set(Cookie.parse(h), req.url)
				} catch (e: ParseError) {}
			}
			return res
		} finally {
			req.headers.entries = given
		}
	}

	/// Keeps c, set by a response to url, as RFC 6265 §5.3 does: a Domain the host is not in, or a bare suffix like
	/// com, is refused, no Domain binds it to the host, no Path takes the URL's directory, Max-Age wins over Expires
	/// and either is cut to 400 days, as RFC 6265bis cuts them, one already expired only removes what it matches, and a
	/// Secure one is ignored unless set over https, as is one over http that would shadow a Secure one (6265bis §5.7),
	/// and one named __Secure- or __Host- unless Secure, the latter also with no Domain and Path / (6265bis §4.1.3).
	set(c: Cookie, url: Url) {
		const host = lower(url.host)
		const hostOnly = c.domain == ""
		const domain = if (hostOnly) host else c.domain
		const path = if (startsWith(c.path, "/")) c.path else defaultPath(url.path)
		const plain = url.scheme != "https"
		const name = lower(c.name)
		if (c.secure && plain
			|| startsWith(name, "__secure-") && !c.secure
			|| startsWith(name, "__host-") && (!c.secure || !hostOnly || c.path != "/")
			|| !hostOnly && (!inDomain(host, domain) || domain != host && indexOf(domain, ".") < 0)
			|| plain && this.stored.some(s => s.c.secure && s.c.name == c.name
				&& (inDomain(domain, s.c.domain) || inDomain(s.c.domain, domain)) && inPath(path, s.c.path))) {
			return
		}
		const age = c.maxAge
		const expiry = if (age == null && c.expires == null) null
			else if (age == null) min(c.expires!, now() + ageLimit * second)
			else if (age <= 0) 0 as i64
			else now() + min(age, ageLimit) * second
		this.stored = this.stored.filter(s => !(s.c.name == c.name && s.c.domain == domain && s.c.path == path)
			&& (s.expiry == null || s.expiry! > now()))
		if (expiry != null && expiry <= now()) {
			return
		}
		// Copies, as slices of the header would keep all of it.
		const kept = new Cookie(c.name.copy(), c.value.copy())
		kept.domain = domain
		kept.path = path.copy()
		kept.secure = c.secure
		kept.httpOnly = c.httpOnly
		kept.sameSite = c.sameSite
		this.stored.push(new Stored(kept, hostOnly, expiry))
		// Past the least RFC 6265 §6.1 has a jar keep, 50 a domain and 3000 in all, the oldest go.
		const same = this.stored.filter(s => s.c.domain == domain)
		if (same.length > 50) {
			this.stored = this.stored.filter(s => s != same[0])
		}
		if (this.stored.length > 3000) {
			this.stored = this.stored.slice(1, this.stored.length)
		}
	}

	/// The name and value of each cookie to send to url, longest path first.
	get(url: Url): [string, string][] {
		const host = lower(url.host)
		const path = if (url.path == "") "/" else url.path
		this.stored = this.stored.filter(s => s.expiry == null || s.expiry! > now())
		const hits = this.stored.filter(s => (if (s.hostOnly) host == s.c.domain else inDomain(host, s.c.domain))
			&& inPath(path, s.c.path) && (!s.c.secure || url.scheme == "https"))
		stableSort(hits, (a, b) => a.c.path.length > b.c.path.length)
		return hits.map(s => [s.c.name, s.c.value])
	}
}

/// An Expires date as RFC 6265 §5.1.1 reads one, in any of HTTP's forms or older: its time, day, month and year are the
/// first tokens that look like each, a two-digit year 70 to 99 in the 1900s and one below in the 2000s. Null if one is
/// missing, out of range, or before 1601; outside the span of instants, as 9999 is for never, its nearer end.
function cookieDate(s: string): i64 | null {
	let [hour, minute, sec, day, month, year] = [-1, 0, 0, -1, -1, -1]
	let i = 0
	while (i < s.length) {
		let j = i
		while (j < s.length && !delimiter(s[j])) {
			j++
		}
		const t = s.slice(i, j)
		i = j + 1
		const a = digits(t, 0)
		const b = digits(t, a + 1)
		const c = digits(t, a + b + 2)
		const m = if (t.length < 3) -1 else indexOf("janfebmaraprmayjunjulaugsepoctnovdec", lower(t.slice(0, 3)))
		if (hour < 0 && a >= 1 && a <= 2 && b >= 1 && b <= 2 && c >= 1 && c <= 2 && t[a] == colon
			&& t[a + b + 1] == colon) {
			[hour, minute, sec] = [number(t, 0, a), number(t, a + 1, b), number(t, a + b + 2, c)]
		} else if (day < 0 && a >= 1 && a <= 2) {
			day = number(t, 0, a)
		} else if (month < 0 && m >= 0 && m % 3 == 0) {
			month = m / 3 + 1
		} else if (year < 0 && a >= 2 && a <= 4) {
			year = number(t, 0, a)
		}
	}
	if (year >= 0 && year < 100) {
		year += if (year < 70) 2000 else 1900
	}
	if (hour < 0 || hour > 23 || minute > 59 || sec > 59 || month < 0 || year < 1601 || !isValid(year, month, day)) {
		return null
	}
	return utc.instant(new DateTime(new Date(year, month, day), hour, minute, sec))
}

/// Whether c separates the tokens of a cookie date.
function delimiter(c: u8): bool {
	return c == 9 || c >= 0x20 && c < 0x7f && !isAlphanumeric(c) && c != colon
}

/// How many digits t has from at on.
function digits(t: string, at: i32): i32 {
	let i = at
	while (i < t.length && isDigit(t[i])) {
		i++
	}
	return i - at
}

/// The n digits of t from at on as a number.
function number(t: string, at: i32, n: i32): i32 { return parseInt[i32](t.slice(at, at + n)) }

/// The longest a cookie is kept, in seconds.
const ageLimit: i64 = 400 * 86400

/// Whether host is domain or, a name and not an IP, below it (§5.1.3); an IP's last label is a number, as for URLs.
function inDomain(host: string, domain: string): bool {
	const last = host.slice(lastIndexOf(host, ".") + 1, host.length)
	return host == domain || endsWith(host, `.${domain}`) && indexOf(host, ":") < 0 && digits(last, 0) < last.length
}

/// Whether the request path is under the cookie's (§5.1.4).
function inPath(path: string, cookie: string): bool {
	return path == cookie || startsWith(path, cookie) && (endsWith(cookie, "/") || path[cookie.length] == slash)
}

/// The directory of a request path, as a cookie without Path takes it (§5.1.4).
function defaultPath(path: string): string {
	const slash = lastIndexOf(path, "/")
	return if (!startsWith(path, "/") || slash <= 0) "/" else path.slice(0, slash)
}
