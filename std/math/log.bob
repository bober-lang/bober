/// The bits of 1 - 0x1.5b51p-5 and 1 + 0x1.6ab2p-5, about 1 where log2 takes log2(1 + r) directly.
const near2lo = asU64(0.9576029777526855)
const near2hi = asU64(1.0442743301391602)

export function log2(x: f64): f64 {
	let ix = asU64(x)
	const top = (ix >> 48) as u32
	if (ix - near2lo < near2hi - near2lo) {
		if (ix == 0x3ff0000000000000) {
			return 0.0
		}
		const r = x - 1.0
		const rhi = asF64(asU64(r) & 0xffffffff00000000)
		const rlo = r - rhi
		const hi = rhi * invln2hi
		let lo = rlo * invln2hi + r * invln2lo
		const r2 = r * r
		const r4 = r2 * r2
		const p = r2 * (log2B[0] + r * log2B[1])
		const y = hi + p
		lo += hi - y + p
		lo += r4
			* (log2B[2] + r * log2B[3] + r2 * (log2B[4] + r * log2B[5])
			+ r4 * (log2B[6] + r * log2B[7] + r2 * (log2B[8] + r * log2B[9])))
		return y + lo
	}
	if (top - 0x0010 >= 0x7ff0 - 0x0010) {
		if (ix * 2 == 0) {
			return -1.0 / 0.0
		}
		if (ix == 0x7ff0000000000000) {
			return x
		}
		if ((top & 0x8000) != 0 || (top & 0x7ff0) == 0x7ff0) {
			return (x - x) / (x - x)
		}
		ix = asU64(x * two52) - (52 << 52)
	}
	// log2(x) = k + log2(c) + log2(z/c)
	const [k, iz, i] = reduce(ix, 0x3fe6000000000000, 6)
	const invc = log2Tab[2 * i]
	const logc = log2Tab[2 * i + 1]
	const z = asF64(iz)
	const kd = k as f64
	const r = (z - log2Tab2[2 * i] - log2Tab2[2 * i + 1]) * invc
	const rhi = asF64(asU64(r) & 0xffffffff00000000)
	const rlo = r - rhi
	const t1 = rhi * invln2hi
	const t2 = rlo * invln2hi + r * invln2lo
	// hi + lo = r/ln2 + log2(c) + k
	const t3 = kd + logc
	const hi = t3 + t1
	const lo = t3 - hi + t1 + t2
	const r2 = r * r
	const r4 = r2 * r2
	const p = log2A[0] + r * log2A[1] + r2 * (log2A[2] + r * log2A[3]) + r4 * (log2A[4] + r * log2A[5])
	return lo + r2 * p + hi
}

/// log10(2) in two parts, the first with 32 trailing zero bits, and 1/ln10 in two.
const ivln10hi = 4.34294481878168880939e-01
const ivln10lo = 2.50829467116452752298e-11
const log10_2hi = 3.01029995663611771306e-01
const log10_2lo = 3.69423907715893078616e-13
/// (log(1 + s) - log(1 - s))/s - 2 = lg1 s^2 + lg2 s^4 + ..., |s| <= 0.1716, to 2^-58.45.
const lg1 = 6.666666666666735130e-01
const lg2 = 3.999999999940941908e-01
const lg3 = 2.857142874366239149e-01
const lg4 = 2.222219843214978396e-01
const lg5 = 1.818357216161805012e-01
const lg6 = 1.531383769920937332e-01
const lg7 = 1.479819860511658591e-01

/// log(1 + f) - f + f^2/2, as s (f^2/2 + R(s)), s = f/(2 + f).
function logTail(f: f64, hfsq: f64): f64 {
	const s = f / (2.0 + f)
	const z = s * s
	const w = z * z
	const t1 = w * (lg2 + w * (lg4 + w * lg6))
	const t2 = z * (lg1 + w * (lg3 + w * (lg5 + w * lg7)))
	return s * (hfsq + (t2 + t1))
}

export function log10(x: f64): f64 {
	let u = asU64(x)
	let hx = (u >> 32) as u32
	let k = 0
	if (hx < 0x00100000 || hx >> 31 != 0) {
		if (u << 1 == 0) {
			return -1.0 / (x * x)
		}
		if (hx >> 31 != 0) {
			return (x - x) / 0.0
		}
		// a subnormal, scaled up
		k -= 54
		u = asU64(x * 18014398509481984.0)
		hx = (u >> 32) as u32
	} else if (hx >= 0x7ff00000) {
		return x
	} else if (hx == 0x3ff00000 && u << 32 == 0) {
		return 0.0
	}
	// x = 2^k (1 + f), 1 + f in [sqrt(2)/2, sqrt(2)]
	hx += 0x3ff00000 - 0x3fe6a09e
	k += ((hx >> 20) as i32) - 0x3ff
	hx = (hx & 0x000fffff) + 0x3fe6a09e
	const f = asF64((hx as u64) << 32 | u & 0xffffffff) - 1.0
	const hfsq = 0.5 * f * f
	// hi + lo = f - hfsq + s (hfsq + R) ~ log(1 + f), hi with 32 trailing zero bits
	const hi = asF64(asU64(f - hfsq) & 0xffffffff00000000)
	const lo = f - hi - hfsq + logTail(f, hfsq)
	// valhi + vallo ~ log10(1 + f) + k log10(2)
	let valhi = hi * ivln10hi
	const dk = k as f64
	const y = dk * log10_2hi
	let vallo = dk * log10_2lo + (lo + hi) * ivln10lo + lo * ivln10hi
	const w = y + valhi
	vallo += y - w + valhi
	valhi = w
	return vallo + valhi
}

/// log(1 + x), exact for small x.
export function log1p(x: f64): f64 {
	const hx = (asU64(x) >> 32) as u32
	let k = 1
	let c = 0.0
	let f = 0.0
	if (hx < 0x3fda827a || hx >> 31 != 0) {
		// 1 + x < sqrt(2)+
		if (hx >= 0xbff00000) {
			// x <= -1
			return if (x == -1.0) x / 0.0 else (x - x) / 0.0
		}
		if (hx << 1 < 0x3ca00000 << 1) {
			// |x| < 2^-53
			return x
		}
		if (hx <= 0xbfd2bec4) {
			// sqrt(2)/2- <= 1 + x < sqrt(2)+
			k = 0
			f = x
		}
	} else if (hx >= 0x7ff00000) {
		return x
	}
	if (k != 0) {
		// 1 + x = 2^k (1 + f), 1 + f in [sqrt(2)/2, sqrt(2)], c the error of 1 + x rounded, divided by it
		const u = asU64(1.0 + x)
		let hu = ((u >> 32) as u32) + (0x3ff00000 - 0x3fe6a09e)
		k = ((hu >> 20) as i32) - 0x3ff
		if (k < 54) {
			const v = asF64(u)
			c = (if (k >= 2) 1.0 - (v - x) else x - (v - 1.0)) / v
		}
		hu = (hu & 0x000fffff) + 0x3fe6a09e
		f = asF64((hu as u64) << 32 | u & 0xffffffff) - 1.0
	}
	const hfsq = 0.5 * f * f
	const dk = k as f64
	return logTail(f, hfsq) + (dk * ln2lo + c) - hfsq + f + dk * ln2hi
}

/// logf's 1/c and log(c) of c near the center of each of N = 16 intervals of [0x1.66p-1, 0x1.66p0].
const logfTab: f64[] = [1.398907162146528, -0.33569133332882284, 1.3403141896637998, -0.2929040563774074,
	1.286432210124115, -0.2518726580937369, 1.2367150214269895, -0.21245868807117255, 1.1906977166711752,
	-0.17453945183745634, 1.1479821020556429, -0.1380057072319758, 1.1082251448272158, -0.10275976698545139,
	1.0711297413057381, -0.06871392447020525, 1.036437278977283, -0.0357891387398228, 1.0, 0.0, 0.9492859795739057,
	0.05204517742929496, 0.8951049428609004, 0.11081431298787942, 0.8476821620351103, 0.1652495223695143,
	0.8050314851692001, 0.21687389031699977, 0.7664671008843108, 0.2659635028121397, 0.731428603316328,
	0.3127556664073557]

/// log(1 + r) - r, |r| < 1/(2 N), from r^2.
const logfA: f64[] = [-0.25089342214237154, 0.333456765744066, -0.4999997485802103]

export function logf(x: f32): f32 {
	let ix = asU32(x)
	if (ix == 0x3f800000) {
		return 0.0
	}
	if (ix - 0x00800000 >= 0x7f800000 - 0x00800000) {
		// below 2^-126, or inf, or NaN
		if (ix * 2 == 0) {
			return -1.0 / 0.0
		}
		if (ix == 0x7f800000) {
			return x
		}
		if ((ix & 0x80000000) != 0 || ix * 2 >= 0xff000000) {
			return (x - x) / (x - x)
		}
		ix = asU32(x * two23) - (23 << 23)
	}
	// log(x) = k ln2 + log(c) + log(z/c)
	const [k, z, i] = reducef(ix)
	const r = z * logfTab[2 * i] - 1.0
	const y0 = logfTab[2 * i + 1] + (k as f64) * ln2
	const r2 = r * r
	const y = logfA[0] * r2 + (logfA[1] * r + logfA[2])
	return (y * r2 + (y0 + r)) as f32
}

/// x as k and z, x = 2^k z, z in [0x1.66p-1, 0x1.66p0), and z's interval of 16, ix x's bits.
export function reducef(ix: u32): [i32, f64, u32] {
	const tmp = ix - 0x3f330000
	return [(tmp as i32) >> 23, asF32(ix - (tmp & 0xff800000)) as f64, (tmp >> 19) % 16]
}

/// As logfTab, log2(c) for log(c).
export const log2fTab: f64[] = [1.398907162146528, -0.48430022186289673, 1.3403141896637998, -0.42257122959194704,
	1.286432210124115, -0.3633754347673556, 1.2367150214269895, -0.30651309567405577, 1.1906977166711752,
	-0.25180720160537634, 1.1479821020556429, -0.19910014943794563, 1.1082251448272158, -0.14825100623281615,
	1.0711297413057381, -0.09913323807318392, 1.036437278977283, -0.051632812977629436, 1.0, 0.0, 0.9492859795739057,
	0.07508531937943004, 0.8951049428609004, 0.15987125980713107, 0.8476821620351103, 0.2384046664317681,
	0.8050314851692001, 0.31288288605863257, 0.7664671008843108, 0.38370422656453185, 0.731428603316328,
	0.451211048935815]

/// log2(1 + r), |r| < 1/(2 N).
const log2fA: f64[] = [-0.36051725506874704, 0.4811247078767291, -0.7213476299867769, 1.4426950186867042]

export function log2f(x: f32): f32 {
	let ix = asU32(x)
	if (ix == 0x3f800000) {
		return 0.0
	}
	if (ix - 0x00800000 >= 0x7f800000 - 0x00800000) {
		if (ix * 2 == 0) {
			return -1.0 / 0.0
		}
		if (ix == 0x7f800000) {
			return x
		}
		if ((ix & 0x80000000) != 0 || ix * 2 >= 0xff000000) {
			return (x - x) / (x - x)
		}
		ix = asU32(x * two23) - (23 << 23)
	}
	// log2(x) = k + log2(c) + log2(z/c)
	const [k, z, i] = reducef(ix)
	const r = z * log2fTab[2 * i] - 1.0
	const y0 = log2fTab[2 * i + 1] + (k as f64)
	const r2 = r * r
	const y = log2fA[0] * r2 + (log2fA[1] * r + log2fA[2])
	return (y * r2 + (log2fA[3] * r + y0)) as f32
}

/// As log10's, for f32: log10(2) and 1/ln10 in two parts, the first with 12 trailing zero bits.
const ivln10hif: f32 = 0.434326171875
const ivln10lof: f32 = -3.1689971365267411e-05
const log10_2hif: f32 = 0.30102920532226562
const log10_2lof: f32 = 7.9034151667656261e-07
/// As lg1, ..., |s| <= 0.1716, to 2^-34.24.
const lg1f: f32 = 0.66666662693023682
const lg2f: f32 = 0.40000972151756287
const lg3f: f32 = 0.28498786687850952
const lg4f: f32 = 0.24279078841209412

/// As logTail, for f32.
function logTailf(f: f32, hfsq: f32): f32 {
	const s = f / (2.0 + f)
	const z = s * s
	const w = z * z
	const t1 = w * (lg2f + w * lg4f)
	const t2 = z * (lg1f + w * lg3f)
	return s * (hfsq + (t2 + t1))
}

export function log10f(x: f32): f32 {
	let ix = asU32(x)
	let k = 0
	if (ix < 0x00800000 || ix >> 31 != 0) {
		if (ix << 1 == 0) {
			return -1.0 / (x * x)
		}
		if (ix >> 31 != 0) {
			return (x - x) / 0.0
		}
		k -= 25
		ix = asU32(x * 33554432.0)
	} else if (ix >= 0x7f800000) {
		return x
	} else if (ix == 0x3f800000) {
		return 0.0
	}
	ix += 0x3f800000 - 0x3f3504f3
	k += ((ix >> 23) as i32) - 0x7f
	ix = (ix & 0x007fffff) + 0x3f3504f3
	const f = asF32(ix) - 1.0
	const hfsq: f32 = 0.5 * f * f
	const hi = asF32(asU32(f - hfsq) & 0xfffff000)
	const lo = f - hi - hfsq + logTailf(f, hfsq)
	const dk = k as f32
	return dk * log10_2lof + (lo + hi) * ivln10lof + lo * ivln10hif + hi * ivln10hif + dk * log10_2hif
}

export function log1pf(x: f32): f32 {
	const ix = asU32(x)
	let k = 1
	let c: f32 = 0.0
	let f: f32 = 0.0
	if (ix < 0x3ed413d0 || ix >> 31 != 0) {
		if (ix >= 0xbf800000) {
			return if (x == -1.0) x / 0.0 else (x - x) / 0.0
		}
		if (ix << 1 < 0x33800000 << 1) {
			// |x| < 2^-24
			return x
		}
		if (ix <= 0xbe95f619) {
			k = 0
			f = x
		}
	} else if (ix >= 0x7f800000) {
		return x
	}
	if (k != 0) {
		const v = 1.0 + x
		let iu = asU32(v) + (0x3f800000 - 0x3f3504f3)
		k = ((iu >> 23) as i32) - 0x7f
		if (k < 25) {
			c = (if (k >= 2) 1.0 - (v - x) else x - (v - 1.0)) / v
		}
		iu = (iu & 0x007fffff) + 0x3f3504f3
		f = asF32(iu) - 1.0
	}
	const hfsq: f32 = 0.5 * f * f
	const dk = k as f32
	return logTailf(f, hfsq) + (dk * ln2lof + c) - hfsq + f + dk * ln2hif
}
