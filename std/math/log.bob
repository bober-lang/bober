//! Logarithms: natural, base 2, base 10, and of 1 + x; each for f64 and, suffixed f, f32. log and log2 take log(c)
//! of c near x's significand from a table and log(z/c) by a polynomial, in f64 for the f32 ones; log10 and log1p
//! reduce x to [sqrt(2)/2, sqrt(2)] and take log((1 + s)/(1 - s)) by a polynomial in s.
//!
//! Ported from musl 1.2.5, MIT, Copyright © 2005-2020 Rich Felker, et al. (vendor/musl/COPYRIGHT). log, log2, logf,
//! log2f and their tables: Copyright (c) 2017-2018, Arm Limited, MIT. log10, log10f, log1p and log1pf are from FreeBSD:
//! Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved. Developed at SunPro, a Sun Microsystems, Inc.
//! business. Permission to use, copy, modify, and distribute this software is freely granted, provided that this notice
//! is preserved.

import { asF32, asF64, asU32, asU64, ln2, ln2hi, ln2hif, ln2lo, ln2lof, two23, two52 } from "./bits"

/// x as k and the bits of z, x = 2^k z, z in [off, 2 off), and z's interval in a table of n, ix x's bits.
function reduce(ix: u64, off: u64, bits: u64): [i32, u64, u64] {
	const tmp = ix - off
	return [((tmp as i64) >> 52) as i32, ix - (tmp & 0xfff0000000000000), (tmp >> (52 - bits)) % (1 << bits)]
}

/// log's ln2 in two parts, the first with 11 trailing zero bits, so that k times the first plus log(c) is exact.
export const logLn2hi = 0.6931471805598903
export const logLn2lo = 5.497923018708371e-14

