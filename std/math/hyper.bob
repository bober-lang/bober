//! The hyperbolic functions and their inverses, of exp, expm1, log and log1p; each for f64 and, suffixed f, f32.
//!
//! Ported from musl 1.2.5, MIT, Copyright © 2005-2020 Rich Felker, et al. (vendor/musl/COPYRIGHT).

import { asF32, asF64, asU32, asU64, ln2 } from "./bits"
import { exp, expf, expm1, expm1f } from "./exp"
import { log, log1p, log1pf, logf } from "./log"
import { sqrt, sqrtf } from "./root"

/// ln2 rounded to an f32.
const ln2f: f32 = 0.69314718246459961

/// sign e^x/2 for x at least log of the greatest float: e^(x - k ln2) 2^(k-1), k = 2043 such that k ln2 rounds closely,
/// 2^(k-1) as two factors, for it overflows.
function expo2(x: f64, sign: f64): f64 {
	const scale = asF64(0x7fc0000000000000) // 2^((k-1)/2)
	return exp(x - 1416.0996898839683) * (sign * scale) * scale
}

/// expo2 in f32, k = 235.
function expo2f(x: f32, sign: f32): f32 {
	const scale = asF32(0x7a000000)
	return expf(x - 162.88958740234375) * (sign * scale) * scale
}

export function sinh(x: f64): f64 {
	const h = if (asU64(x) >> 63 != 0) -0.5 else 0.5
	const ax = asF64(asU64(x) & 0x7fffffffffffffff)
	const w = (asU64(ax) >> 32) as u32
	if (w < 0x40862e42) {
		// |x| < log of the greatest f64
		const t = expm1(ax)
		if (w < 0x3ff00000) {
			if (w < 0x3ff00000 - (26 << 20)) {
				return x
			}
			return h * (2.0 * t - t * t / (t + 1.0))
		}
		return h * (t + t / (t + 1.0))
	}
	return expo2(ax, 2.0 * h)
}

export function sinhf(x: f32): f32 {
	const h: f32 = if (asU32(x) >> 31 != 0) -0.5 else 0.5
	const w = asU32(x) & 0x7fffffff
	const ax = asF32(w)
	if (w < 0x42b17217) {
		const t = expm1f(ax)
		if (w < 0x3f800000) {
			if (w < 0x3f800000 - (12 << 23)) {
				return x
			}
			return h * (2.0 * t - t * t / (t + 1.0))
		}
		return h * (t + t / (t + 1.0))
	}
	return expo2f(ax, 2.0 * h)
}

export function cosh(x: f64): f64 {
	const ax = asF64(asU64(x) & 0x7fffffffffffffff)
	const w = (asU64(ax) >> 32) as u32
	if (w < 0x3fe62e42) {
		// |x| < ln2
		if (w < 0x3ff00000 - (26 << 20)) {
			return 1.0
		}
		const t = expm1(ax)
		return 1.0 + t * t / (2.0 * (1.0 + t))
	}
	if (w < 0x40862e42) {
		const t = exp(ax)
		return 0.5 * (t + 1.0 / t)
	}
	return expo2(ax, 1.0)
}

export function coshf(x: f32): f32 {
	const w = asU32(x) & 0x7fffffff
	const ax = asF32(w)
	if (w < 0x3f317217) {
		if (w < 0x3f800000 - (12 << 23)) {
			return 1.0
		}
		const t = expm1f(ax)
		return 1.0 + t * t / (2.0 * (1.0 + t))
	}
	if (w < 0x42b17217) {
		const t = expf(ax)
		return 0.5 * (t + 1.0 / t)
	}
	return expo2f(ax, 1.0)
}

/// (e^2x - 1)/(e^2x + 1), from expm1 of 2|x| or of -2|x|.
export function tanh(x: f64): f64 {
	const ax = asF64(asU64(x) & 0x7fffffffffffffff)
	const w = (asU64(ax) >> 32) as u32
	let t = ax
	if (w > 0x3fe193ea) {
		// |x| > log(3)/2, or NaN
		if (w > 0x40340000) {
			t = 1.0 - 0.0 / ax // |x| > 20, or NaN
		} else {
			t = 1.0 - 2.0 / (expm1(2.0 * ax) + 2.0)
		}
	} else if (w > 0x3fd058ae) {
		// |x| > log(5/3)/2
		const e = expm1(2.0 * ax)
		t = e / (e + 2.0)
	} else if (w >= 0x00100000) {
		const e = expm1(-2.0 * ax)
		t = -e / (e + 2.0)
	}
	return if (asU64(x) >> 63 != 0) -t else t
}

export function tanhf(x: f32): f32 {
	const w = asU32(x) & 0x7fffffff
	const ax = asF32(w)
	let t = ax
	if (w > 0x3f0c9f54) {
		if (w > 0x41200000) {
			t = 1.0 + 0.0 / ax // |x| > 10, or NaN
		} else {
			t = 1.0 - 2.0 / (expm1f(2.0 * ax) + 2.0)
		}
	} else if (w > 0x3e82c578) {
		const e = expm1f(2.0 * ax)
		t = e / (e + 2.0)
	} else if (w >= 0x00800000) {
		const e = expm1f(-2.0 * ax)
		t = -e / (e + 2.0)
	}
	return if (asU32(x) >> 31 != 0) -t else t
}

/// log(|x| + sqrt(x^2 + 1)), of x's sign.
export function asinh(x: f64): f64 {
	const e = asU64(x) >> 52 & 0x7ff
	const ax = asF64(asU64(x) & 0x7fffffffffffffff)
	let y = ax
	if (e >= 0x3ff + 26) {
		y = log(ax) + ln2 // |x| >= 2^26, inf or NaN
	} else if (e >= 0x3ff + 1) {
		y = log(2.0 * ax + 1.0 / (sqrt(ax * ax + 1.0) + ax))
	} else if (e >= 0x3ff - 26) {
		y = log1p(ax + ax * ax / (sqrt(ax * ax + 1.0) + 1.0))
	}
	return if (asU64(x) >> 63 != 0) -y else y
}

export function asinhf(x: f32): f32 {
	const i = asU32(x) & 0x7fffffff
	const ax = asF32(i)
	let y = ax
	if (i >= 0x3f800000 + (12 << 23)) {
		y = logf(ax) + ln2f
	} else if (i >= 0x3f800000 + (1 << 23)) {
		y = logf(2.0 * ax + 1.0 / (sqrtf(ax * ax + 1.0) + ax))
	} else if (i >= 0x3f800000 - (12 << 23)) {
		y = log1pf(ax + ax * ax / (sqrtf(ax * ax + 1.0) + 1.0))
	}
	return if (asU32(x) >> 31 != 0) -y else y
}

/// log(x + sqrt(x^2 - 1)); NaN for x < 1.
export function acosh(x: f64): f64 {
	const e = asU64(x) >> 52 & 0x7ff
	if (e < 0x3ff + 1) {
		// |x| < 2
		return log1p(x - 1.0 + sqrt((x - 1.0) * (x - 1.0) + 2.0 * (x - 1.0)))
	}
	if (e < 0x3ff + 26) {
		return log(2.0 * x - 1.0 / (x + sqrt(x * x - 1.0)))
	}
	return log(x) + ln2
}

export function acoshf(x: f32): f32 {
	const i = asU32(x)
	if ((i & 0x7fffffff) < 0x3f800000 + (1 << 23)) {
		return log1pf(x - 1.0 + sqrtf((x - 1.0) * (x - 1.0) + 2.0 * (x - 1.0)))
	}
	if (i < 0x3f800000 + (12 << 23)) {
		// 2 <= x < 2^12
		return logf(2.0 * x - 1.0 / (x + sqrtf(x * x - 1.0)))
	}
	return logf(x) + ln2f
}

/// log((1 + x)/(1 - x))/2, as log1p(2x/(1 - x))/2.
export function atanh(x: f64): f64 {
	const e = asU64(x) >> 52 & 0x7ff
	const ax = asF64(asU64(x) & 0x7fffffffffffffff)
	let y = ax
	if (e >= 0x3ff - 1) {
		y = 0.5 * log1p(2.0 * (ax / (1.0 - ax)))
	} else if (e >= 0x3ff - 32) {
		y = 0.5 * log1p(2.0 * ax + 2.0 * ax * ax / (1.0 - ax)) // |x| < 1/2
	}
	return if (asU64(x) >> 63 != 0) -y else y
}

export function atanhf(x: f32): f32 {
	const i = asU32(x) & 0x7fffffff
	const ax = asF32(i)
	let y = ax
	if (i >= 0x3f800000 - (1 << 23)) {
		y = 0.5 * log1pf(2.0 * (ax / (1.0 - ax)))
	} else if (i >= 0x3f800000 - (32 << 23)) {
		y = 0.5 * log1pf(2.0 * ax + 2.0 * ax * ax / (1.0 - ax))
	}
	return if (asU32(x) >> 31 != 0) -y else y
}
