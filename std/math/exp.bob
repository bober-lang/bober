	0x3feea2f336cf4e62, 0xbc88a1c52fb3cf42, 0x3feea427543e1a12, 0xbc9369b6f13b3734, 0x3feea589994cce13,
	0xbc805e843a19ff1e, 0x3feea71a4623c7ad, 0xbc94d450d872576e, 0x3feea8d99b4492ed, 0x3c90ad675b0e8a00,
	0x3feeaac7d98a6699, 0x3c8db72fc1f0eab4, 0x3feeace5422aa0db, 0xbc65b6609cc5e7ff, 0x3feeaf3216b5448c,
	0x3c7bf68359f35f44, 0x3feeb1ae99157736, 0xbc93091fa71e3d83, 0x3feeb45b0b91ffc6, 0xbc5da9b88b6c1e29,
	0x3feeb737b0cdc5e5, 0xbc6c23f97c90b959, 0x3feeba44cbc8520f, 0xbc92434322f4f9aa, 0x3feebd829fde4e50,
	0xbc85ca6cd7668e4b, 0x3feec0f170ca07ba, 0x3c71affc2b91ce27, 0x3feec49182a3f090, 0x3c6dd235e10a73bb,
	0x3feec86319e32323, 0xbc87c50422622263, 0x3feecc667b5de565, 0x3c8b1c86e3e231d5, 0x3feed09bec4a2d33,
	0xbc91bbd1d3bcbb15, 0x3feed503b23e255d, 0x3c90cc319cee31d2, 0x3feed99e1330b358, 0x3c8469846e735ab3,
	0x3feede6b5579fdbf, 0xbc82dfcd978e9db4, 0x3feee36bbfd3f37a, 0x3c8c1a7792cb3387, 0x3feee89f995ad3ad,
	0xbc907b8f4ad1d9fa, 0x3feeee07298db666, 0xbc55c3d956dcaeba, 0x3feef3a2b84f15fb, 0xbc90a40e3da6f640,
	0x3feef9728de5593a, 0xbc68d6f438ad9334, 0x3feeff76f2fb5e47, 0xbc91eee26b588a35, 0x3fef05b030a1064a,
	0x3c74ffd70a5fddcd, 0x3fef0c1e904bc1d2, 0xbc91bdfbfa9298ac, 0x3fef12c25bd71e09, 0x3c736eae30af0cb3,
	0x3fef199bdd85529c, 0x3c8ee3325c9ffd94, 0x3fef20ab5fffd07a, 0x3c84e08fd10959ac, 0x3fef27f12e57d14b,
	0x3c63cdaf384e1a67, 0x3fef2f6d9406e7b5, 0x3c676b2c6c921968, 0x3fef3720dcef9069, 0xbc808a1883ccb5d2,
	0x3fef3f0b555dc3fa, 0xbc8fad5d3ffffa6f, 0x3fef472d4a07897c, 0xbc900dae3875a949, 0x3fef4f87080d89f2,
	0x3c74a385a63d07a7, 0x3fef5818dcfba487, 0xbc82919e2040220f, 0x3fef60e316c98398, 0x3c8e5a50d5c192ac,
	0x3fef69e603db3285, 0x3c843a59ac016b4b, 0x3fef7321f301b460, 0xbc82d52107b43e1f, 0x3fef7c97337b9b5f,
	0xbc892ab93b470dc9, 0x3fef864614f5a129, 0x3c74b604603a88d3, 0x3fef902ee78b3ff6, 0x3c83c5ec519d7271,
	0x3fef9a51fbc74c83, 0xbc8ff7128fd391f0, 0x3fefa4afa2a490da, 0xbc8dae98e223747d, 0x3fefaf482d8e67f1,
	0x3c8ec3bc41aa2008, 0x3fefba1bee615a27, 0x3c842b94c3a9eb32, 0x3fefc52b376bba97, 0x3c8a64a931d185ee,
	0x3fefd0765b6e4540, 0xbc8e37bae43be3ed, 0x3fefdbfdad9cbe14, 0x3c77893b4d91cd9d, 0x3fefe7c1819e90d8,
	0x3c5305c14160cc89, 0x3feff3c22b8f71f1]

/// scale (1 + tmp), scale of bits sbits whose exponent may have left its range, by k, the low 32 bits of ki,
/// times 2^-k: by at most 460 up if bigUp, else by 1, or down into the subnormals, there rounding y once.
function special(tmp: f64, sbits: u64, ki: u64, bigUp: bool): f64 {
	if ((ki & 0x80000000) == 0) {
		if (bigUp) {
			const scale = asF64(sbits - (1009 << 52))
			return asF64(0x7f00000000000000) * (scale + scale * tmp) // 2^1009
		}
		const scale = asF64(sbits - (1 << 52))
		return 2.0 * (scale + scale * tmp)
	}
	const scale = asF64(sbits + (1022 << 52))
	let y = scale + scale * tmp
	if (fabs(y) < 1.0) {
		// rounded to f64 before scaled into the subnormals, which would round it again
		const one = if (y < 0.0) -1.0 else 1.0
		let lo = scale - y + scale * tmp
		const hi = one + y
		lo = one - hi + y + lo
		y = hi + lo - one
		if (y == 0.0) {
			y = asF64(asU64(scale) & 0x8000000000000000)
		}
	}
	return asF64(0x0010000000000000) * y // 2^-1022
}

export function exp(x: f64): f64 {
	const abstop = top12(x) & 0x7ff
	if (abstop - 0x3c9 >= 0x408 - 0x3c9) {
		// |x| < 2^-54, or at least 512, or NaN
		if (abstop - 0x3c9 >= 0x80000000) {
			return 1.0 + x
		}
		if (abstop >= 0x409) {
			if (asU64(x) == 0xfff0000000000000) {
				return 0.0
			}
			if (abstop >= 0x7ff) {
				return 1.0 + x
			}
			return if (asU64(x) >> 63 != 0) 0.0 else inf
		}
		return expTail(x, 0.0, 0, true)
	}
	return expTail(x, 0.0, 0, false)
}

/// e^(x + xtail), negated if signBias is 0x40000, for |x| < 1024; near over- or underflow if near.
function expTail(x: f64, xtail: f64, signBias: u64, near: bool): f64 {
	// x = k ln2/N + r, |r| <= ln2/2N, so that e^x = 2^(k/N) e^r
	const z = invln2N * x
	let kd = z + toint
	const ki = asU64(kd)
	kd -= toint
	let r = x + kd * negln2hiN + kd * negln2loN
	r += xtail
	// 2^(k/N) ~ scale (1 + tail), and e^x ~ scale + scale (tail + e^r - 1)
	const idx = 2 * (ki % 128)
	const tail = asF64(expTab[idx])
	const sbits = expTab[idx + 1] + ((ki + signBias) << 45)
	const r2 = r * r
	const tmp = tail + r + r2 * (c2 + r * c3) + r2 * r2 * (c4 + r * c5)
	if (near) {
		return special(tmp, sbits, ki, true)
	}
	const scale = asF64(sbits)
	return scale + scale * tmp
}

/// e^(x + xtail), negated if signBias is 0x40000, for |xtail| < 2^-15 and |xtail| <= |x|: pow's last step.
export function expPow(x: f64, xtail: f64, signBias: u64): f64 {
	const abstop = top12(x) & 0x7ff
	if (abstop - 0x3c9 >= 0x408 - 0x3c9) {
		// |x| < 2^-54, or at least 512
		if (abstop - 0x3c9 >= 0x80000000) {
			const one = 1.0 + x
			return if (signBias != 0) -one else one
		}
		if (abstop >= 0x409) {
			const y = if (asU64(x) >> 63 != 0) 0.0 else inf
			return if (signBias != 0) -y else y
		}
		return expTail(x, xtail, signBias, true)
	}
	return expTail(x, xtail, signBias, false)
}

export function exp2(x: f64): f64 {
	let abstop = top12(x) & 0x7ff
	if (abstop - 0x3c9 >= 0x408 - 0x3c9) {
		// |x| < 2^-54, or at least 512, or NaN
		if (abstop - 0x3c9 >= 0x80000000) {
			return 1.0 + x
		}
		if (abstop >= 0x409) {
			if (asU64(x) == 0xfff0000000000000) {
				return 0.0
			}
			if (abstop >= 0x7ff) {
				return 1.0 + x
			}
			if (asU64(x) >> 63 == 0) {
				return inf
			}
			if (asU64(x) >= 0xc090cc0000000000) {
				// -1075
				return 0.0
			}
		}
		if (2 * asU64(x) > 2 * 0x408d000000000000) {
			// |x| > 928
			abstop = 0
		}
	}
	// x = k/N + r, |r| <= 1/2N, so that 2^x = 2^(k/N) 2^r
	let kd = x + shift2
	const ki = asU64(kd)
	kd -= shift2
	const r = x - kd
	const idx = 2 * (ki % 128)
	const tail = asF64(expTab[idx])
	const sbits = expTab[idx + 1] + (ki << 45)
	const r2 = r * r
	const tmp = tail + r * d1 + r2 * (d2 + r * d3) + r2 * r2 * (d4 + r * d5)
	if (abstop == 0) {
		return special(tmp, sbits, ki, false)
	}
	const scale = asF64(sbits)
	return scale + scale * tmp
}

/// expm1's 1/ln2, and where it overflows.
const invln2 = 1.44269504088896338700e+00
const othreshold = 7.09782712893383973096e+02
/// 6/x (1 + 2 (1/(e^x - 1) - 1/x)) as a polynomial in x^2/2, |x| < 0.35.
const q1 = -3.33333333333331316428e-02
const q2 = 1.58730158725481460165e-03
const q3 = -7.93650757867487942473e-05
const q4 = 4.00821782732936239552e-06
const q5 = -2.01099218183624371326e-07

/// e^x - 1, exact for small x.
export function expm1(x: f64): f64 {
	const u = asU64(x)
	const hx = ((u >> 32) as u32) & 0x7fffffff
	const sign = u >> 63 != 0
	if (hx >= 0x4043687a) {
		// |x| >= 56 ln2, or NaN
		if (x != x) {
			return x
		}
		if (sign) {
			return -1.0
		}
		if (x > othreshold) {
			return x * asF64(0x7fe0000000000000) // 2^1023
		}
	}
	// x = k ln2 + hi - lo, k an integer, hi - lo in [-ln2/2, ln2/2]; c the error of x rounded
	let k = 0
	let y = x
	let c = 0.0
	if (hx > 0x3fd62e42) {
		// |x| > ln2/2
		let hi = 0.0
		let lo = 0.0
		if (hx < 0x3ff0a2b2) {
			// and |x| < 1.5 ln2
			k = if (sign) -1 else 1
			hi = if (sign) x + ln2hi else x - ln2hi
			lo = if (sign) -ln2lo else ln2lo
		} else {
			k = (invln2 * x + (if (sign) -0.5 else 0.5)) as i32
			const t = k as f64
			hi = x - t * ln2hi
			lo = t * ln2lo
		}
		y = hi - lo
		c = hi - y - lo
	} else if (hx < 0x3c900000) {
		// |x| < 2^-54
		return x
	}
	const hfx = 0.5 * y
	const hxs = y * hfx
	const r1 = 1.0 + hxs * (q1 + hxs * (q2 + hxs * (q3 + hxs * (q4 + hxs * q5))))
	const t = 3.0 - r1 * hfx
	let e = hxs * ((r1 - t) / (6.0 - y * t))
	if (k == 0) {
		return y - (y * e - hxs)
	}
	e = y * (e - c) - c
	e -= hxs
	// e^x ~ 2^k (y - e + 1)
	if (k == -1) {
		return 0.5 * (y - e) - 0.5
	}
	if (k == 1) {
		return if (y < -0.25) -2.0 * (e - (y + 0.5)) else 1.0 + 2.0 * (y - e)
	}
	const twopk = asF64(((0x3ff + k) as u64) << 52)
	if (k < 0 || k > 56) {
		const z = y - e + 1.0
		return (if (k == 1024) z * 2.0 * asF64(0x7fe0000000000000) else z * twopk) - 1.0
	}
	const twomk = asF64(((0x3ff - k) as u64) << 52)
	return if (k < 20) (y - e + (1.0 - twomk)) * twopk else (y - (e + twomk) + 1.0) * twopk
}

/// expf's N/ln2, and exp2f's toint/N, N = 32.
const invln2Nf = 46.16624130844683
const shift2f: f64 = toint / 32.0
/// 2^(r/N) - 1 for expf, and 2^r - 1 for exp2f, |r| < 1/2N, to 1.69 2^-34.
const e0 = 1.6938359250920212e-06
const e1 = 0.00023459809789509004
const e2 = 0.021660849396613134
const f0 = 0.05550361559341535
const f1 = 0.2402284522445722
const f2 = 0.6931471806916203

/// The bits of 2^(i/N), less i 2^52/N, for i in [0, N).
const exp2fTab: u64[] = [0x3ff0000000000000, 0x3fefd9b0d3158574, 0x3fefb5586cf9890f, 0x3fef9301d0125b51,
	0x3fef72b83c7d517b, 0x3fef54873168b9aa, 0x3fef387a6e756238, 0x3fef1e9df51fdee1, 0x3fef06fe0a31b715,
	0x3feef1a7373aa9cb, 0x3feedea64c123422, 0x3feece086061892d, 0x3feebfdad5362a27, 0x3feeb42b569d4f82,
	0x3feeab07dd485429, 0x3feea47eb03a5585, 0x3feea09e667f3bcd, 0x3fee9f75e8ec5f74, 0x3feea11473eb0187,
	0x3feea589994cce13, 0x3feeace5422aa0db, 0x3feeb737b0cdc5e5, 0x3feec49182a3f090, 0x3feed503b23e255d,
	0x3feee89f995ad3ad, 0x3feeff76f2fb5e47, 0x3fef199bdd85529c, 0x3fef3720dcef9069, 0x3fef5818dcfba487,
	0x3fef7c97337b9b5f, 0x3fefa4afa2a490da, 0x3fefd0765b6e4540]

export function expf(x: f32): f32 {
	const abstop = (asU32(x) >> 20) & 0x7ff
	if (abstop >= 0x42b) {
		// |x| >= 88, or NaN
		if (asU32(x) == 0xff800000) {
			return 0.0
		}
		if (abstop >= 0x7f8) {
			return x + x
		}
		if (x > 88.72283172607422) {
			// ln 2^128
			return inf as f32
		}
		if (x < -103.97207641601562) {
			// ln 2^-150
			return 0.0
		}
	}
	// x N/ln2 = k + r, |r| <= 1/2, so that e^x = 2^(k/N) 2^(r/N)
	const z = invln2Nf * (x as f64)
	let kd = z + toint
	const ki = asU64(kd)
	kd -= toint
	const r = z - kd
	const s = asF64(exp2fTab[ki % 32] + (ki << 47))
	const y = (e0 * r + e1) * (r * r) + (e2 * r + 1.0)
	return (y * s) as f32
}

export function exp2f(x: f32): f32 {
	const abstop = (asU32(x) >> 20) & 0x7ff
	if (abstop >= 0x430) {
		// |x| >= 128, or NaN
		if (asU32(x) == 0xff800000) {
			return 0.0
		}
		if (abstop >= 0x7f8) {
			return x + x
		}
		if (x > 0.0) {
			return inf as f32
		}
		if (x <= -150.0) {
			return 0.0
		}
	}
	return exp2fTail(x as f64, 0)
}

/// 2^xd, negated if signBias is 0x10000, for xd in [-150, 128]: powf's last step, as exp2f's.
export function exp2fTail(xd: f64, signBias: u64): f32 {
	// xd = k/N + r, |r| <= 1/2N, so that 2^xd = 2^(k/N) 2^r
	let kd = xd + shift2f
	const ki = asU64(kd)
	kd -= shift2f
	const r = xd - kd
	const s = asF64(exp2fTab[ki % 32] + ((ki + signBias) << 47))
	const y = (f0 * r + f1) * (r * r) + (f2 * r + 1.0)
	return (y * s) as f32
}

/// expm1f's 1/ln2.
const invln2f: f32 = 1.4426950216293335
/// As expm1's q, |x| < 0.35, to 2^-30.
const q1f: f32 = -0.03333321213722229
const q2f: f32 = 0.0015807170420885086

export function expm1f(x: f32): f32 {
	const u = asU32(x)
	const hx = u & 0x7fffffff
	const sign = u >> 31 != 0
	if (hx >= 0x4195b844) {
		// |x| >= 27 ln2, or NaN
		if (hx > 0x7f800000) {
			return x
		}
		if (sign) {
			return -1.0
		}
		if (hx > 0x42b17217) {
			return x * asF32(0x7f000000) // 2^127
		}
	}
	let k = 0
	let y = x
	let c: f32 = 0.0
	if (hx > 0x3eb17218) {
		// |x| > ln2/2
		let hi: f32 = 0.0
		let lo: f32 = 0.0
		if (hx < 0x3f851592) {
			// and |x| < 1.5 ln2
			k = if (sign) -1 else 1
			hi = if (sign) x + ln2hif else x - ln2hif
			lo = if (sign) -ln2lof else ln2lof
		} else {
			k = (invln2f * x + (if (sign) -0.5 else 0.5)) as i32
			const t = k as f32
			hi = x - t * ln2hif
			lo = t * ln2lof
		}
		y = hi - lo
		c = hi - y - lo
	} else if (hx < 0x33000000) {
		// |x| < 2^-25
		return x
	}
	const hfx: f32 = 0.5 * y
	const hxs = y * hfx
	const r1: f32 = 1.0 + hxs * (q1f + hxs * q2f)
	const t: f32 = 3.0 - r1 * hfx
	let e = hxs * ((r1 - t) / (6.0 - y * t))
	if (k == 0) {
		return y - (y * e - hxs)
	}
	e = y * (e - c) - c
	e -= hxs
	if (k == -1) {
		return 0.5 * (y - e) - 0.5
	}
	if (k == 1) {
		return if (y < -0.25) -2.0 * (e - (y + 0.5)) else 1.0 + 2.0 * (y - e)
	}
	const twopk = asF32(((0x7f + k) as u32) << 23)
	if (k < 0 || k > 56) {
		const z = y - e + 1.0
		return (if (k == 128) z * 2.0 * asF32(0x7f000000) else z * twopk) - 1.0
	}
	const twomk = asF32(((0x7f - k) as u32) << 23)
	return if (k < 23) (y - e + (1.0 - twomk)) * twopk else (y - (e + twomk) + 1.0) * twopk
}
