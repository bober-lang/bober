import { exp2, exp2f, exp2fTail, expPow } from "./exp"
import { modf, modff } from "./ieee"
import { logLn2hi, logLn2lo, log2fTab, reducef } from "./log"

/// Where pow's x^y has the sign of x, for x < 0 and y an odd integer, the bias of its exp's k.
const signBias: u64 = 0x800 << 7
const signBiasf: u64 = 1 << 16

/// log(1 + r) for |r| < 0x1.6bp-8, scaled as the evaluation is.
