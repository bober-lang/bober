/// p0(x) = 1 + R/S, R and S of 1/x^2, x >= 2.
function p0(x: f64): f64 {
	const b = band(high(x) & 0x7fffffff)
	const z = 1.0 / (x * x)
	return 1.0 + poly(p0R[b], z) / (1.0 + z * poly(p0S[b], z))
}

/// q0(x) = (-1/8 + R/S)/x, R and S of 1/x^2, x >= 2.
function q0(x: f64): f64 {
	const b = band(high(x) & 0x7fffffff)
	const z = 1.0 / (x * x)
	return (-0.125 + poly(q0R[b], z) / (1.0 + z * poly(q0S[b], z))) / x
}

function p0f(x: f32): f32 {
	const b = bandf(asU32(x) & 0x7fffffff)
	const z: f32 = 1.0 / (x * x)
	return 1.0 + polyf(p0Rf[b], z) / (1.0 + z * polyf(p0Sf[b], z))
}

function q0f(x: f32): f32 {
	const b = bandf(asU32(x) & 0x7fffffff)
	const z: f32 = 1.0 / (x * x)
	return (-0.125 + polyf(q0Rf[b], z) / (1.0 + z * polyf(q0Sf[b], z))) / x
}

/// j0(x), or y0(x) if y, for x >= 2 of high word ix: 1/sqrt(pi x) (p0 (sin x + cos x) -+ q0 (sin x - cos x)), the
/// sum that cancels taken as -cos(2x) over the other. From 2^1023, where 2x overflows, the sum as it is; from 2^129,
/// without p0 and q0.
function common0(ix: u32, x: f64, y: bool): f64 {
	const s = sin(x)
	const c = if (y) -cos(x) else cos(x)
	let cc = s + c
	if (ix < 0x7fe00000) {
		let ss = s - c
		const z = -cos(2.0 * x)
		if (s * c < 0.0) {
			cc = z / ss
		} else {
			ss = z / cc
		}
		if (ix < 0x48000000) {
			cc = p0(x) * cc - q0(x) * (if (y) -ss else ss)
		}
	}
	return invsqrtpi * cc / sqrt(x)
}

/// common0 in f32, past 2^127 and 2^50.
function common0f(ix: u32, x: f32, y: bool): f32 {
	const s = sinf(x)
	const c = if (y) -cosf(x) else cosf(x)
	let cc = s + c
	if (ix < 0x7f000000) {
		let ss = s - c
		const z = -cosf(2.0 * x)
		if (s * c < 0.0) {
			cc = z / ss
		} else {
			ss = z / cc
		}
		if (ix < 0x58800000) {
			cc = p0f(x) * cc - q0f(x) * (if (y) -ss else ss)
		}
	}
	return invsqrtpif * cc / sqrtf(x)
}

/// The Bessel function of the first kind of order 0.
export function j0(x: f64): f64 {
	const ix = high(x) & 0x7fffffff
	if (ix >= 0x7ff00000) {
		return 1.0 / (x * x)
	}
	const a = fabs(x)
	if (ix >= 0x40000000) {
		return common0(ix, a, false)
	}
	if (ix >= 0x3f200000) {
		// |x| >= 2^-13
		const z = a * a
		return (1.0 + a / 2.0) * (1.0 - a / 2.0) + z * (z * poly(r0, z) / (1.0 + z * poly(s0, z)))
	}
	return 1.0 - (if (ix >= 0x38000000) 0.25 * a * a else a)
}

export function j0f(x: f32): f32 {
	const ix = asU32(x) & 0x7fffffff
	if (ix >= 0x7f800000) {
		return 1.0 / (x * x)
	}
	const a = fabsf(x)
	if (ix >= 0x40000000) {
		return common0f(ix, a, false)
	}
	if (ix >= 0x3a000000) {
		// |x| >= 2^-11
		const z = a * a
		return (1.0 + a / 2.0) * (1.0 - a / 2.0) + z * (z * polyf(r0f, z) / (1.0 + z * polyf(s0f, z)))
	}
	return 1.0 - (if (ix >= 0x21800000) 0.25 * a * a else a)
}

/// The Bessel function of the second kind of order 0: -infinity at 0, NaN below.
export function y0(x: f64): f64 {
	const u = asU64(x)
	const ix = (u >> 32) as u32
	if (u << 1 == 0) {
		return -inf
	}
	if (ix >> 31 != 0) {
		return nan
	}
	if (ix >= 0x7ff00000) {
		return 1.0 / x
	}
	if (ix >= 0x40000000) {
		return common0(ix, x, true)
	}
	if (ix >= 0x3e400000) {
		// x >= 2^-27
		const z = x * x
		return poly(u0, z) / (1.0 + z * poly(v0, z)) + tpi * (j0(x) * log(x))
	}
	return u0[0] + tpi * log(x)
}

export function y0f(x: f32): f32 {
	const ix = asU32(x)
	if (ix & 0x7fffffff == 0) {
		return -inff
	}
	if (ix >> 31 != 0) {
		return nanf
	}
	if (ix >= 0x7f800000) {
		return 1.0 / x
	}
	if (ix >= 0x40000000) {
		return common0f(ix, x, true)
	}
	if (ix >= 0x39000000) {
		// x >= 2^-13
		const z = x * x
		return polyf(u0f, z) / (1.0 + z * polyf(v0f, z)) + tpif * (j0f(x) * logf(x))
	}
	return u0f[0] + tpif * logf(x)
}

