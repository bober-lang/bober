import { acosh, acoshf, asinh, asinhf, atanh, atanhf, cosh, coshf, sinh, sinhf, tanh, tanhf } from "./hyper"
import { agree1, c } from "./musl/oracle"

test "sinh" {
	agree1("sinh", sinh, c.sinh)
	agree1("sinhf", sinhf, c.sinhf)
}

test "cosh" {
	agree1("cosh", cosh, c.cosh)
	agree1("coshf", coshf, c.coshf)
}

test "tanh" {
	agree1("tanh", tanh, c.tanh)
	agree1("tanhf", tanhf, c.tanhf)
}

test "asinh" {
	agree1("asinh", asinh, c.asinh)
	agree1("asinhf", asinhf, c.asinhf)
}

test "acosh" {
	agree1("acosh", acosh, c.acosh)
	agree1("acoshf", acoshf, c.acoshf)
}

test "atanh" {
	agree1("atanh", atanh, c.atanh)
	agree1("atanhf", atanhf, c.atanhf)
}
