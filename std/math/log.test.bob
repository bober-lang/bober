import { log, log10, log10f, log1p, log1pf, log2, log2f, logf } from "./log"
import { agree1, c } from "./musl/oracle"

test "log" {
	agree1("log", log, c.log)
	agree1("logf", logf, c.logf)
}

test "log2" {
	agree1("log2", log2, c.log2)
	agree1("log2f", log2f, c.log2f)
}

test "log10" {
	agree1("log10", log10, c.log10)
	agree1("log10f", log10f, c.log10f)
}

test "log1p" {
	agree1("log1p", log1p, c.log1p)
	agree1("log1pf", log1pf, c.log1pf)
}
