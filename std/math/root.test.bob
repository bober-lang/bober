import { cbrt, cbrtf, hypot, hypotf, sqrt, sqrtf } from "./root"
import { agree1, agree2, c } from "./musl/oracle"

test "roots" {
	agree1("sqrt", sqrt, c.sqrt)
	agree1("sqrtf", sqrtf, c.sqrtf)
	agree1("cbrt", cbrt, c.cbrt)
	agree1("cbrtf", cbrtf, c.cbrtf)
}

test "hypot" {
	agree2("hypot", hypot, c.hypot)
	agree2("hypotf", hypotf, c.hypotf)
}
