import { exp, exp2, exp2f, expf, expm1, expm1f } from "./exp"
import { agree1, c } from "./musl/oracle"

test "exp" {
	agree1("exp", exp, c.exp)
	agree1("expf", expf, c.expf)
}

test "exp2" {
	agree1("exp2", exp2, c.exp2)
	agree1("exp2f", exp2f, c.exp2f)
}

test "expm1" {
	agree1("expm1", expm1, c.expm1)
	agree1("expm1f", expm1f, c.expm1f)
}
