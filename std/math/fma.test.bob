import { asF64, asU64 } from "./bits"
import { fma, fmaf } from "./fma"
import { agree, agree3, c, count } from "./musl/oracle"

test "fma" {
	agree3("fma", fma, c.fma)
	agree3("fmaf", fmaf, c.fmaf)
}

test "fma about the least normal" {
	// x*y a few ulps from ±2^-1022, plus a tiny z: where fma rounds as a subnormal, or to the least normal
	agree("fma", (t: [f64, f64, f64]) => fma(t[0], t[1], t[2]), (t: [f64, f64, f64]) => c.fma(t[0], t[1], t[2]), [],
		count(100000), r => {
			const b = r.next()
			const x = asF64(0x3ff0000000000000 | b >> 12 | (b & 1) << 63)
			const y = asF64(asU64(asF64(0x0010000000000000) / x) + (b >> 1) % 9 - 4)
			return [x, y, asF64(r.next() >> (54 + (b >> 4) % 10))]
		})
}
