const a9f: f32 = 0.00010801156895468011
const a10f: f32 = 2.5214456400135532e-05
const a11f: f32 = 4.486409670789726e-05
const tcf: f32 = 1.4616321325302124
const tff: f32 = -0.12148628383874893
const ttf: f32 = 6.697100651820165e-09
