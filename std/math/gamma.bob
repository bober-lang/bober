const t13f: f32 = -0.00031275415676645935
const t14f: f32 = 0.00033552918466739357
const u0f: f32 = -0.07721566408872604
const u1f: f32 = 0.6328270435333252
const u2f: f32 = 1.4549225568771362
const u3f: f32 = 0.9777175188064575
const u4f: f32 = 0.2289637327194214
const u5f: f32 = 0.013381091877818108
