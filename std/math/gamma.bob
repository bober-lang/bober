//! The gamma function and the logarithm of its magnitude; each for f64 and, suffixed f, f32. tgamma is Lanczos's
//! approximation with g = 6.0247, reflected for x < 0; tgammaf is tgamma rounded. lgamma reduces x below 8 to
//! [2, 3) and fits polynomials there and about its minimum, takes Stirling's series beyond, and reflects for x < 0
//! through sin(pi x), whose sign is gamma's.
//!
//! Ported from musl 1.2.5, MIT, Copyright © 2005-2020 Rich Felker, et al. (vendor/musl/COPYRIGHT); tgamma is musl's
//! own, its constants from Boost and Python. lgamma is from FreeBSD: Copyright (C) 1993 by Sun Microsystems, Inc.
//! All rights reserved. Developed at SunSoft, a Sun Microsystems, Inc. business. Permission to use, copy, modify, and
//! distribute this software is freely granted, provided that this notice is preserved. lgammaf converted to float by
//! Ian Lance Taylor, Cygnus Support.

import { asF64, asU32, asU64, inf, pi } from "./bits"
import { exp } from "./exp"
import { floor, floorf } from "./ieee"
import { log, logf } from "./log"
import { pow } from "./pow"
import { kCos, kCosf, kSin, kSinf } from "./trig"


/// sin(pi x), x > 2^-100, of x mod 2 reduced to within 1/4 of a multiple of 1/2; of either sign where it is 0.
function sinpi(x0: f64): f64 {
	let x = 2.0 * (x0 * 0.5 - floor(x0 * 0.5))
	const n = (((x * 4.0) as i32) + 1) / 2
	x = (x - (n as f64) * 0.5) * pi
	return switch (n) {
		case 1: kCos(x, 0.0)
		case 2: kSin(-x, 0.0, 0)
		case 3: -kCos(x, 0.0)
		default: kSin(x, 0.0, 0)
	}
}

/// g - 1/2, where Lanczos's sum S is fitted for g.
const gmhalf = 5.52468004077673

/// S(x) = Snum(x)/Sden(x), the coefficients from the constant term up.
const snum: f64[] = [23531376880.41076, 42919803642.6491, 35711959237.35567, 17921034426.03721, 6039542586.352028,
	1439720407.3117216, 248874557.86205417, 31426415.585400194, 2876370.6289353725, 186056.26539522348,
	8071.672002365816, 210.82427775157936, 2.5066282746310002]

const sden: f64[] = [0.0, 39916800.0, 120543840.0, 150917976.0, 105258076.0, 45995730.0, 13339535.0, 2637558.0,
	357423.0, 32670.0, 1925.0, 66.0, 1.0]

/// (n-1)! for n from 1 to 23.
const fact: f64[] = [1.0, 1.0, 2.0, 6.0, 24.0, 120.0, 720.0, 5040.0, 40320.0, 362880.0, 3628800.0, 39916800.0,
	479001600.0, 6227020800.0, 87178291200.0, 1307674368000.0, 20922789888000.0, 355687428096000.0, 6402373705728000.0,
	1.21645100408832e+17, 2.43290200817664e+18, 5.109094217170944e+19, 1.1240007277776077e+21]

/// Lanczos's sum, x > 0: by Horner in x below 8, else in 1/x, as not to overflow.
function lanczos(x: f64): f64 {
	let num = 0.0
	let den = 0.0
	const n = snum.length - 1
	for (const k of 0 ... n) {
		const i = if (x < 8.0) n - k else k
		num = (if (x < 8.0) num * x else num / x) + snum[i]
		den = (if (x < 8.0) den * x else den / x) + sden[i]
	}
	return num / den
}

/// Γ(x): exact at the integers to 23; infinite at ±0 and beyond 171.62, NaN at the negative integers.
export function tgamma(x: f64): f64 {
	const ix = ((asU64(x) >> 32) as u32) & 0x7fffffff
	const sign = asU64(x) >> 63 != 0
	if (ix >= 0x7ff00000) {
		return x + inf // NaN at -infinity
	}
	if (ix < (0x3ff - 54) << 20) {
		return 1.0 / x // |x| < 2^-54: 1/x
	}
	if (x == floor(x)) {
		if (sign) {
			return (x - x) / (x - x)
		}
		if (x <= 23.0) {
			return fact[(x as i32) - 1]
		}
	}
	if (ix >= 0x40670000) {
		// |x| >= 184: overflows, or underflows to 0 of gamma's sign
		if (sign) {
			return if (floor(x) * 0.5 == floor(x * 0.5)) 0.0 else -0.0
		}
		return x * asF64(0x7fe0000000000000) // 2^1023
	}
	const absx = if (sign) -x else x
	// y = x + g - 1/2, and its rounding error dy
	let y = absx + gmhalf
	let dy = if (absx > gmhalf) y - absx - gmhalf else y - gmhalf - absx
	let z = absx - 0.5
	let r = lanczos(absx) * exp(-y)
	if (x < 0.0) {
		// Γ(x) Γ(-x) = -pi / (x sin(pi x)); sin(pi x) is not 0, for the integers are done
		r = -pi / (sinpi(absx) * absx * r)
		dy = -dy
		z = -z
	}
	r += dy * (gmhalf + 0.5) * r / y
	z = pow(y, 0.5 * z)
	return r * z * z
}

export function tgammaf(x: f32): f32 { return tgamma(x as f64) as f32 }

// lgamma: polynomials about 2 (a), about the minimum tc (t), about 1 (u/v), on [2, 3) (s/r) and Stirling's (w);
// tf = lgamma(tc), tt the negated tail of tf.
const a0 = 0.07721566490153287
const a1 = 0.3224670334241136
const a2 = 0.06735230105312927
const a3 = 0.020580808432516733
const a4 = 0.007385550860814029
