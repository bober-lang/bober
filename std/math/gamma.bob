const a8 = 0.00022086279071390839
const a9 = 0.00010801156724758394
const a10 = 2.5214456545125733e-05
const a11 = 4.4864094961891516e-05
const tc = 1.4616321449683622
const tf = -0.12148629053584961
const tt = -3.638676997039505e-18
const t0 = 0.48383612272381005
const t1 = -0.1475877229945939
