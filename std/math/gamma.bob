const t13 = -0.00031275416837512086
const t14 = 0.0003355291926355191
const u0 = -0.07721566490153287
const u1 = 0.6328270640250934
const u2 = 1.4549225013723477
const u3 = 0.9777175279633727
const u4 = 0.22896372806469245
const u5 = 0.013381091853678766
const v1 = 2.4559779371304113
const v2 = 2.128489763798934
const v3 = 0.7692851504566728
const v4 = 0.10422264559336913
const v5 = 0.003217092422824239
const s0 = -0.07721566490153287
const s1 = 0.21498241596060885
const s2 = 0.325778796408931
const s3 = 0.14635047265246445
const s4 = 0.02664227030336386
const s5 = 0.0018402845140733772
const s6 = 3.194753265841009e-05
const r1 = 1.3920053346762105
const r2 = 0.7219355475671381
const r3 = 0.17193386563280308
const r4 = 0.01864591917156529
const r5 = 0.0007779424963818936
const r6 = 7.326684307446256e-06
const w0 = 0.4189385332046727
const w1 = 0.08333333333333297
const w2 = -0.0027777777772877554
const w3 = 0.0007936505586430196
const w4 = -0.00059518755745034
const w5 = 0.0008363399189962821
const w6 = -0.0016309293409657527

/// log|Γ(x)|, and the sign of Γ(x), 1 where it is infinite or NaN.
export function lgamma(x0: f64): [f64, i32] {
	const sign = asU64(x0) >> 63 != 0
	const ix = ((asU64(x0) >> 32) as u32) & 0x7fffffff
	const x = if (sign) -x0 else x0
	if (ix >= 0x7ff00000) {
		return [x0 * x0, 1]
	}
	if (ix < (0x3ff - 70) << 20) {
		return [-log(x), if (sign) -1 else 1] // |x| < 2^-70: -log|x|
	}
	let s = 1
	let nadj = 0.0
	if (sign) {
		let t = sinpi(x)
		if (t == 0.0) {
			return [1.0 / (x - x), 1] // a negative integer
		}
		if (t > 0.0) {
			s = -1
		} else {
			t = -t
		}
		nadj = log(pi / (t * x))
	}
	let r = 0.0
	if ((ix == 0x3ff00000 || ix == 0x40000000) && (asU64(x0) as u32) == 0) {
		r = 0.0 // 1 and 2
	} else if (ix < 0x40000000) {
		// x < 2: from lgamma(x + 1) - log(x) below 0.9, of x about 1, tc the minimum, or 2
		let y = 0.0
		let i = 0
		if (ix <= 0x3feccccc) {
			r = -log(x)
			if (ix >= 0x3fe76944) {
				y = 1.0 - x
			} else if (ix >= 0x3fcda661) {
				y = x - (tc - 1.0)
				i = 1
			} else {
				y = x
				i = 2
			}
		} else if (ix >= 0x3ffbb4c3) {
			y = 2.0 - x // [1.7316, 2]
		} else if (ix >= 0x3ff3b4c4) {
			y = x - tc // [1.23, 1.73]
			i = 1
		} else {
			y = x - 1.0
			i = 2
		}
		if (i == 0) {
			const z = y * y
			const p1 = a0 + z * (a2 + z * (a4 + z * (a6 + z * (a8 + z * a10))))
			const p2 = z * (a1 + z * (a3 + z * (a5 + z * (a7 + z * (a9 + z * a11)))))
			r += y * p1 + p2 - 0.5 * y
		} else if (i == 1) {
			const z = y * y
			const w = z * y
			const p1 = t0 + w * (t3 + w * (t6 + w * (t9 + w * t12)))
			const p2 = t1 + w * (t4 + w * (t7 + w * (t10 + w * t13)))
			const p3 = t2 + w * (t5 + w * (t8 + w * (t11 + w * t14)))
			r += tf + (z * p1 - (tt - w * (p2 + y * p3)))
		} else {
			const p1 = y * (u0 + y * (u1 + y * (u2 + y * (u3 + y * (u4 + y * u5)))))
			const p2 = 1.0 + y * (v1 + y * (v2 + y * (v3 + y * (v4 + y * v5))))
			r += -0.5 * y + p1 / p2
		}
	} else if (ix < 0x40200000) {
		// x < 8: lgamma(2 + y) + log((y + 2) ... (y + i - 1)), i = floor(x)
		const i = x as i32
		const y = x - (i as f64)
		const p = y * (s0 + y * (s1 + y * (s2 + y * (s3 + y * (s4 + y * (s5 + y * s6))))))
		const q = 1.0 + y * (r1 + y * (r2 + y * (r3 + y * (r4 + y * (r5 + y * r6)))))
		r = 0.5 * y + p / q
		if (i >= 3) {
			let z = 1.0
			for (const k of 0 ... (i - 3)) {
				z *= y + ((i - 1 - k) as f64)
			}
			r += log(z)
		}
	} else if (ix < 0x43900000) {
		// x < 2^58: Stirling's series
		const t = log(x)
		const z = 1.0 / x
		const y = z * z
		const w = w0 + z * (w1 + y * (w2 + y * (w3 + y * (w4 + y * (w5 + y * w6)))))
		r = (x - 0.5) * (t - 1.0) + w
	} else {
		r = x * (log(x) - 1.0)
	}
	return [if (sign) nadj - r else r, s]
}

// lgammaf's, as lgamma's.
const pif: f32 = 3.1415927410125732
const a0f: f32 = 0.07721566408872604
const a1f: f32 = 0.32246702909469604
const a2f: f32 = 0.0673523023724556
