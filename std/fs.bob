//! Files and directories, as Deno's runtime has them. Every call goes through the run time's I/O (src/rt.h) and throws
//! an IoError if it fails.

import { backslash, lbracket, question, star } from "./ascii"
import { Set } from "./collections/set"
import { fromCString } from "./c"
import { File, IoError, checked, readAll } from "./io"
import { dir, isAbs, join, matchName, patternNames } from "./fs/path"
import { sort } from "./sort"
import { indexOf } from "./string"
import { bober_io_list, bober_io_mkdir, bober_io_open, bober_io_remove, bober_io_rename, bober_io_stat } from "../src/rt.h"

/// How open opens a file, as C's fopen does: r reads, w truncates or creates, a appends or creates, x creates one that
/// must not exist; + both reads and writes.
export type Mode = "r" | "r+" | "w" | "w+" | "a" | "a+" | "x" | "x+"

export function open(path: string, mode: Mode = "r"): File throws IoError {
	return new File(on("open", path, p => bober_io_open(p, mode)) as i32)
}

export function readFile(path: string): string throws IoError {
	const f = open(path)
	try {
		return readAll(f)
	} finally {
		f.close()
	}
}

/// Replaces the file's bytes with data.
export function writeFile(path: string, data: string) throws IoError { put(path, "w", data) }

/// Adds data to the end of the file.
export function appendFile(path: string, data: string) throws IoError { put(path, "a", data) }

function put(path: string, mode: Mode, data: string) throws IoError {
	const f = open(path, mode)
	try {
		f.write(data)
	} finally {
		f.close()
	}
}

/// What stat finds of a file; times are in ns since the epoch, born null where the file system does not keep it.
export class FileInfo {
	isFile: bool
	isDirectory: bool
	isSymlink: bool
	size: i64
	/// The permission bits.
	mode: u32
	modified: i64
	accessed: i64
	born: i64 | null
}

/// Of the file at path, following symlinks.
export function stat(path: string): FileInfo throws IoError { return info("stat", path, true) }

/// Of the file at path, a symlink itself.
export function lstat(path: string): FileInfo throws IoError { return info("lstat", path, false) }

function info(op: string, path: string, follow: bool): FileInfo throws IoError {
	const s = bober_io_stat(cPath(op, path), if (follow) 1 else 0)
	checked(s.err, op, path)
	const i = new FileInfo()
	const kind = fromCString(s.kind)
	i.isFile = kind == "file"
	i.isDirectory = kind == "directory"
	i.isSymlink = kind == "symlink"
	i.size = s.size
	i.mode = s.perm
	i.modified = s.modified
	i.accessed = s.accessed
	i.born = if (s.born == 0) null else s.born
	return i
}

/// Whether there is a file at path.
export function exists(path: string): bool throws IoError {
	try {
		stat(path)
		return true
	} catch (e: IoError) {
		if (e.kind != "NotFound") {
			throw e
		}
		return false
	}
}

export function mkdir(path: string) throws IoError { on("mkdir", path, p => bober_io_mkdir(p)) }

/// Makes a directory and its missing parents, or none if it is one already.
export function mkdirAll(path: string): void throws IoError {
	try {
		mkdir(path)
	} catch (e: IoError) {
		if (e.kind == "NotFound" && dir(path) != path) {
			mkdirAll(dir(path))
			mkdir(path)
		} else if (e.kind != "AlreadyExists" || !stat(path).isDirectory) {
			throw e
		}
	}
}

/// Removes a file or an empty directory.
export function remove(path: string) throws IoError { on("remove", path, p => bober_io_remove(p)) }

/// Removes a file or a directory and all in it.
export function removeAll(path: string): void throws IoError {
	if (lstat(path).isDirectory) {
		for (const e of readDir(path)) {
			removeAll(join(path, e.name))
		}
	}
	remove(path)
}

export function rename(from: string, to: string) throws IoError {
	const p = cPath("rename", to)
	on("rename", from, q => bober_io_rename(q, p))
}

export class DirEntry {
	name: string
	isFile: bool
	isDirectory: bool
	isSymlink: bool
}

/// The entries of the directory, in no order, without . and ..; on a file system that keeps no types, all three
/// flags are false.
export function readDir(path: string): DirEntry[] throws IoError {
	let buf = new u8[](1 << 16)
	let n = on("readDir", path, p => bober_io_list(p, buf, buf.length as u64)) as i32
	while (n > buf.length) {
		buf = new u8[](2 * n)  // with room for what is added meanwhile
		n = on("readDir", path, p => bober_io_list(p, buf, buf.length as u64)) as i32
	}
	const s = fromBytes(buf.slice(0, n))
	const entries: DirEntry[] = []
	let i = 0
	while (i < s.length) {
		const name = indexOf(s, "\0", i)
		const end = indexOf(s, "\0", name + 1)
		const kind = s.slice(name + 1, end)
		const e = new DirEntry()
		e.name = s.slice(i, name)
		e.isFile = kind == "file"
		e.isDirectory = kind == "directory"
		e.isSymlink = kind == "symlink"
		entries.push(e)
		i = end + 1
	}
	return entries
}

/// The paths that match pattern, as path.match takes it, sorted and cleaned; * matches dot files too. A name without *,
/// ?, [ or \ is looked up rather than matched against its directory's, and ** does not follow symlinks to directories.
export function glob(pattern: string): string[] throws IoError {
	// A set, as two **s can split a path in more than one way, as a/x/x/f for **/x/**.
	const found = new Set()
	expand(if (isAbs(pattern)) "/" else ".", patternNames(pattern), 0, found)
	const out = [...found.items]
	sort(out)
	return out
}

/// Adds to out the paths in the directory dir that match the pattern's names from i.
function expand(dir: string, parts: string[], i: i32, out: Set): void throws IoError {
	if (i == parts.length) {
		out.add(dir)
		return
	}
	const part = parts[i]
	const last = i + 1 == parts.length
	if (part == "**") {
		expand(dir, parts, i + 1, out)
		for (const e of readDir(dir)) {
			if (e.isDirectory) {
				expand(join(dir, e.name), parts, i, out)
			} else if (last) {
				out.add(join(dir, e.name))
			}
		}
	} else if (isLiteral(part)) {
		const p = join(dir, part)
		if (if (last) exists(p) else isDir(p)) {
			expand(p, parts, i + 1, out)
		}
	} else {
		for (const e of readDir(dir)) {
			const p = join(dir, e.name)
			// A symlink, or an entry of no known type, may be a directory.
			if (matchName(part, e.name) && (last || e.isDirectory || !e.isFile && isDir(p))) {
				expand(p, parts, i + 1, out)
			}
		}
	}
}

/// Whether name, of a glob pattern, matches only itself.
function isLiteral(name: string): bool {
	for (const ch of name) {
		if (ch == star || ch == question || ch == lbracket || ch == backslash) {
			return false
		}
	}
	return true
}

/// Whether path is a directory, following symlinks; false if there is nothing there.
function isDir(path: string): bool throws IoError { return exists(path) && stat(path).isDirectory }

/// What f, a call of the run time's I/O on path, gives, unless an error, which it throws as op's.
function on(op: string, path: string, f: (p: string) => i64): i64 throws IoError {
	return checked(f(cPath(op, path)), op, path)
}

/// path, unless it holds a NUL, which C would take as its end: then an IoError, as op's.
function cPath(op: string, path: string): string throws IoError {
	if (indexOf(path, "\0") >= 0) {
		throw new IoError("InvalidInput", op, path)
	}
	return path
}
