//! The ranges of the number types, as Rust's i32::MAX or JS's Number.MAX_VALUE: `maxOf[i32]()`.

import { Numeric } from "./types"

/// The largest value of T, for a float the largest finite one.
export function maxOf[T extends Numeric](): T {
	if (T.kind == "float") {
		return switch (T.bits) {
			case 32: 3.40282346638528859811704183484516925440e+38
			default: 1.79769313486231570814527423731704356798070e+308
		}
	}
	const ones = ~(0 as T)
	return if (ones < 0) ~((1 as T) << (T.bits - 1)) else ones
}

/// The smallest value of T, for a float the most negative finite one.
export function minOf[T extends Numeric](): T {
	switch (T.kind) {
		case "int": return ~maxOf[T]()
		default: return -maxOf[T]()
	}
}
