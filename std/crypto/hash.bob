//! Digests, MACs and keys from secrets: by Monocypher BLAKE2b, SHA-512 with its HMAC and HKDF, and Argon2id; by Mbed
//! TLS's PSA crypto SHA-256 with its HMAC.

import { CryptoError } from "./error"
import { CRYPTO_ARGON2_ID, crypto_argon2, crypto_argon2_config, crypto_argon2_extras, crypto_argon2_inputs,
	crypto_blake2b_keyed } from "../../vendor/monocypher/monocypher.h"
import { crypto_sha512, crypto_sha512_hkdf, crypto_sha512_hmac } from "../../vendor/monocypher/monocypher-ed25519.h"
import { PSA_ALG_HASH_MASK, PSA_ALG_HMAC_BASE, PSA_ALG_SHA_256, PSA_KEY_TYPE_HMAC, PSA_KEY_USAGE_SIGN_MESSAGE,
	psa_crypto_init, psa_destroy_key, psa_hash_compute, psa_import_key, psa_key_attributes_t, psa_mac_compute,
	psa_set_key_algorithm, psa_set_key_type,
	psa_set_key_usage_flags } from "../../vendor/mbedtls/tf-psa-crypto/include/psa/crypto.h"
import { free, malloc } from "../../builtin/c"
import { memcpy } from "string.h"

export function sha512(data: string): string {
	const h = new u8[](64)
	crypto_sha512(h, data, data.length as u64)
	return fromBytes(h)
}

export function hmacSha512(key: string, data: string): string {
	const mac = new u8[](64)
	crypto_sha512_hmac(mac, key, key.length as u64, data, data.length as u64)
	return fromBytes(mac)
}

export function sha256(data: string): string throws CryptoError {
	psa(psa_crypto_init())
	const h = new u8[](32)
	psa(psa_hash_compute(PSA_ALG_SHA_256, data, data.length as u64, h, 32, new u64[](1)))
	return fromBytes(h)
}

/// Of a key of at least a byte.
export function hmacSha256(key: string, data: string): string throws CryptoError {
	psa(psa_crypto_init())
	const alg = PSA_ALG_HMAC_BASE | (PSA_ALG_SHA_256 & PSA_ALG_HASH_MASK)
	const a = new psa_key_attributes_t()
	psa_set_key_type(a, PSA_KEY_TYPE_HMAC)
	psa_set_key_algorithm(a, alg)
	psa_set_key_usage_flags(a, PSA_KEY_USAGE_SIGN_MESSAGE)
	const id = new u32[](1)
	psa(psa_import_key(a, key, key.length as u64, id))
	const mac = new u8[](32)
	const status = psa_mac_compute(id[0], alg, data, data.length as u64, mac, 32, new u64[](1))
	psa_destroy_key(id[0])
	psa(status)
	return fromBytes(mac)
}

/// Throws unless status, PSA's, is success.
function psa(status: i32) throws CryptoError {
	if (status != 0) {
		throw new CryptoError(`PSA status ${status}`)
	}
}

/// size bytes of key from the secret ikm, as RFC 5869.
export function hkdfSha512(ikm: string, salt: string, info: string, size: i32): string {
	const k = new u8[](size)
	crypto_sha512_hkdf(k, size as u64, ikm, ikm.length as u64, salt, salt.length as u64, info, info.length as u64)
	return fromBytes(k)
}

/// A digest of 1 to 64 bytes, keyed by up to 64 bytes or "".
export function blake2b(data: string, size: i32 = 64, key: string = ""): string throws CryptoError {
	if (size < 1 || size > 64 || key.length > 64) {
		throw new CryptoError("blake2b takes a size of 1 to 64 bytes and a key of up to 64")
	}
	const h = new u8[](size)
	crypto_blake2b_keyed(h, size as u64, key, key.length as u64, data, data.length as u64)
	return fromBytes(h)
}

/// For storing passwords: Argon2id over kib KiB, by default RFC 9106's second choice, 64 MiB and 3 passes. The salt,
/// random and at least 8 bytes, is stored with the result.
export function argon2id(password: string, salt: string, size: i32 = 32, kib: i32 = 65536,
	passes: i32 = 3): string throws CryptoError {
	if (salt.length < 8 || size < 4 || kib < 8 || passes < 1) {
		throw new CryptoError("argon2id takes a salt of 8 bytes or more, a size of 4, 8 KiB and a pass")
	}
	const c = new crypto_argon2_config()
	c.algorithm = CRYPTO_ARGON2_ID as u32
	c.nb_blocks = kib as u32
	c.nb_passes = passes as u32
	c.nb_lanes = 1
	const i = new crypto_argon2_inputs() // whose pointers are u64 fields, so to C's memory, which copy gives
	i.pass = copy(password)
	i.pass_size = password.length as u32
	i.salt = copy(salt)
	i.salt_size = salt.length as u32
	const work = malloc(1024 * (kib as u64))
	const h = new u8[](size)
	crypto_argon2(h, size as u32, work, c, i, new crypto_argon2_extras())
	free(work)
	free(i.pass)
	free(i.salt)
	return fromBytes(h)
}

/// s's bytes in C's memory, for the caller to free.
function copy(s: string): u64 {
	const p = malloc(s.length as u64)
	memcpy(p, s, s.length as u64)
	return p
}

/// Whether a == b, in time that depends only on their lengths, for comparing MACs.
export function equal(a: string, b: string): bool {
	if (a.length != b.length) {
		return false
	}
	let d: u8 = 0
	for (const i of 0 ... a.length - 1) {
		d |= a[i] ^ b[i]
	}
	return d == 0
}
