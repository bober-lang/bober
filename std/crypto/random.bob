//! Bytes for keys and nonces, from the kernel's CSPRNG, read through std/io like any file.

import { open } from "../fs"

export function bytes(n: i32): string throws IoError {
	const f = open("/dev/urandom")
	let s = ""
	try {
		while (s.length < n) {
			s += f.read(n - s.length)!
		}
	} finally {
		f.close()
	}
	return s
}
