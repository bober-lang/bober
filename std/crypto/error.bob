//! What std/crypto throws for bytes of a wrong size, which Monocypher would read past.

export class CryptoError {
	what: string

	constructor(what: string) { this.what = what }
}

/// Throws unless s, the argument what, has n bytes.
export function sized(s: string, n: i32, what: string) throws CryptoError {
	if (s.length != n) {
		throw new CryptoError(`${what} has ${s.length} bytes, not ${n}`)
	}
}
