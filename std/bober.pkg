{
	"name": "@bober/std",
	"c": {
		"tls": { "src": "tls", "include": ["."] },
		"monocypher": {
			"src": "../vendor/monocypher",
			"sources": ["*.c"],
			"include": ["."]
		},
		"mbedtls": {
			"src": "../vendor/mbedtls",
			"sources": ["library/*.c", "tf-psa-crypto/core/*.c", "tf-psa-crypto/drivers/builtin/src/*.c",
				"tf-psa-crypto/drivers/pqcp/src/*.c", "tf-psa-crypto/platform/*.c", "tf-psa-crypto/utilities/*.c",
				"tf-psa-crypto/extras/*.c"],
			"exclude": ["library/net_sockets.c"],
			"include": ["include", "tf-psa-crypto/include", "tf-psa-crypto/drivers/builtin/include"],
			"private": ["library", "tf-psa-crypto/core", "tf-psa-crypto/dispatch", "tf-psa-crypto/drivers/builtin/src",
				"tf-psa-crypto/drivers/pqcp/include", "tf-psa-crypto/platform", "tf-psa-crypto/utilities",
				"tf-psa-crypto/extras"]
		}
	}
}
