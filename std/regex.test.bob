import { ParseError } from "./parse"
import { compile } from "./regex"

test "find" {
	assert compile("a+").find("baaab")! == [1, 4]
	assert compile("(a)|b").find("b")! == [0, 1, -1, -1]
	assert compile("a").find("aba", 1)! == [2, 3]
	assert compile("^a").find("ba", 1) == null
	assert compile("x*").find("日本")! == [0, 0]
	assert compile("本").find("日本")! == [3, 6]
	assert compile(".").find("\xff")! == [0, 1]
	assert compile("a*?").find("aa")! == [0, 0]
	assert compile("(?U)a*").find("aa")! == [0, 0]
	assert compile("a{2,3}").find("aaaa")! == [0, 3]
	assert compile("a{,2}").find("a{,2}")! == [0, 5]
	assert compile("\\Qa.b\\E+").find("a.bb")! == [0, 4]
	assert compile("[[:^alpha:]\\d]+").find("ab1-c")! == [2, 4]
	assert compile("a{01}").find("a{01}")! == [0, 5]
	assert compile("a{2,01}").find("aaa{2,01}")! == [2, 9]
	assert compile("a{2,}").find("aaa")! == [0, 3]
	assert compile("Sh").find("aSh")! == [1, 3]
	// A surrogate's UTF-8 is three invalid bytes, each U+FFFD.
	assert compile("\\x{d800}").find("\xed\xa0\x80") == null
	// From within a code point, its bytes are each U+FFFD.
	assert compile("\\x{fffd}*").find("éé", 1)! == [1, 2] && compile("(\\x{fffd})").find("é", 1)! == [1, 2, 1, 2]
	// A loop of an x that does not match empty is not left at its end, as (x+)? is.
	assert compile("(?:.*?(?:b*)*)+").find("baAb 1a")! == [0, 2]
	assert compile("^a").find("ab", -1)! == [0, 1]
	// A long chain of instructions that take no code point, which a fiber's stack would not fit recursion along.
	assert compile("(?:(){1000}){24}b").find("b")! == [0, 1, 0, 0]
}

test "flags" {
	assert compile("(?i)ab").test("aB")
	assert compile("(?i:a)b").find("AB") == null
	assert compile("((?i)a)b").find("AB") == null
	assert compile("(?i)a|b").test("B")
	assert compile("(?s).").test("\n")
	assert !compile(".").test("\n")
	assert compile("(?m)^b$").find("a\nb\nc")! == [2, 3]
	assert compile("^b$").find("a\nb\nc") == null
	assert compile("(?i)[^k]").find("K") == null
	// A named class is folded before it is negated.
	assert compile("(?i)[[:^upper:]]").find("aB1")! == [2, 3]
	// The Kelvin sign and long s fold to k and s.
	assert compile("(?i)k").find("\u{212a}")! == [0, 3] && compile("(?i)[^S]").find("\u{17f}s") == null
	assert compile("(?i)\\x{212a}").find("k")! == [0, 1] && compile("(?i)\\W").find("\u{17f}") == null
}

test "names" {
	assert compile("(?P<y>\\d+)-(\\d+)-(?<d>\\d+)").names == ["", "y", "", "d"]
}

test "test" {
	assert compile("\\bfoo\\b").test("a foo b")
	assert !compile("\\bfoo\\b").test("afoo")
}

test "findAll" {
	assert compile("a*").findAll("baaab") == [[0, 0], [1, 4], [5, 5]]
	assert compile("").findAll("日本") == [[0, 0], [3, 3], [6, 6]]
}

test "replaceAll" {
	const date = compile("(?<y>\\d+)-(\\d+)")
	assert date.replaceAll("on 2026-11, 2027-01", "$2/$<y>") == "on 11/2026, 01/2027"
	assert date.replaceAll("2026-11", "$$0 $0 $< $<z> $") == "$0 2026-11 $<  $"
	assert compile("(a)|b").replaceAll("ab", "[$1]") == "[a][]"
	assert compile("x*").replaceAll("abc", "-") == "-a-b-c-"
}

test "syntax errors" {
	for (const [pattern, at] of [["*", 0], ["a|+", 2], ["(?:?)", 3], ["(abc", 0], ["abc)", 3], ["x[a-z", 1],
		["[z-a]", 1], ["abc\\", 3], ["a**", 2], ["a*+", 2], ["\\x", 0], ["\\x{110000}", 0], ["\\1", 0], ["\\8", 0],
		["\\pL", 0], ["\\C", 0], ["[[:foo:]]", 1], ["(?<n>a)(?P<n>b)", 7], ["(?<a-b>c)", 0], ["(?z)", 0],
		["(?i-)", 0], ["(?Pi)a", 0], ["(?P:a)", 0], ["(?<<a>x)", 0], ["(?i)*", 4], ["x(?i)*", 5],
		["[[:al^pha:]]", 1]] as [string, i32][]) {
		assert compile(pattern) throws new ParseError("syntax", at)
	}
	assert compile("a{1001}") throws new ParseError("range", 1)
	assert compile("a{2,1}") throws new ParseError("range", 1)
	assert compile("a{100001}") throws new ParseError("range", 1)
	assert compile("((a{100}){100}){100}") throws new ParseError("range", 15)
	assert compile("(?:a{1000}){0,1000}") throws new ParseError("range", 11)
	// 251 groups nested.
	assert compile(new string[](252).join("(")) throws new ParseError("range", 250)
}
