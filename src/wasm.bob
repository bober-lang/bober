//! WebAssembly GC: a monomorphized Program (src/mono.bob) as a Binaryen module, which node runs with
//! builtin/wasm/host.mjs, what src/rt.c is natively. What has no body, builtin/wasm/'s functions the host gives and C's,
//! is imported from it, and traps with its name where it has none. Values are held so:
//!
//! - null, bool and integers of up to 32 bits as an i32, normalized to their type; 64-bit ones as an i64; floats as an
//!   f32 or f64.
//! - A string as a struct of its length, an array of its bytes and whether it ends where they are used, so that
//!   appends take the free bytes after it (builtin/wasm/string.bob); a T[] as a struct of its length and a T[0] of its
//!   elements, which push grows; a T[n] as an array of them, copied deeply where stored, as it is a value.
//! - A class instance, object or tuple as a struct of its fields, an embedded one a ref to a struct of its own.
//! - A union of refs and null as a ref, null a null one, its type told by a cast; another as a box: the id of its
//!   value's type, its bits if a number, else its ref; null's is one global.
//! - A function value as its code and env: a struct of the cells of the locals a closure captures, as such a local is
//!   held, or the instance a method is bound to.
//! - An optional param as two: its value and whether it was given.
//! - In a field or element, a bool or a narrow integer packed.
//!
//! The types of values are of one rec group, each its own, however alike (build).
//!
//! A throw throws the box with tag bober; Try is a try_table, its finally run inline where its body or handler is left,
//! as src/emit.bob does. Each value a code computes is in a local of its own, which Binaryen's optimizer folds.

import { fromBits } from "../builtin/math"
import { HashMap } from "../std/collections/hashmap"
import * as decl from "./bc/decl"
import * as kind from "./bc/kind"
import * as op from "./bc/op"
import { Opcode } from "./bc/op"
import { Code, Program } from "./bc/program"
import { showType } from "./bc/show"
import { listed } from "./emit"
import { CompileError } from "./error"
import { builtin, builtinPath } from "./root"

import { BinaryenAddFloat32, BinaryenAddFloat64, BinaryenAddFunctionExport, BinaryenAddFunctionImport,
	BinaryenAddFunctionWithHeapType, BinaryenAddGlobal, BinaryenAddInt32, BinaryenAddInt64, BinaryenAddTag,
	BinaryenAddTagExport, BinaryenAndInt32, BinaryenAndInt64, BinaryenArrayCopy, BinaryenArrayGet, BinaryenArrayLen,
	BinaryenArrayNew, BinaryenArrayNewFixed, BinaryenArraySet, BinaryenBinary, BinaryenBlock, BinaryenBreak,
	BinaryenCall, BinaryenCallRef, BinaryenConstSetValueF32, BinaryenConstSetValueF64, BinaryenConstSetValueI32,
	BinaryenConstSetValueI64, BinaryenConvertSInt32ToFloat32, BinaryenConvertSInt32ToFloat64,
	BinaryenConvertSInt64ToFloat32, BinaryenConvertSInt64ToFloat64, BinaryenConvertUInt32ToFloat32,
	BinaryenConvertUInt32ToFloat64, BinaryenConvertUInt64ToFloat32, BinaryenConvertUInt64ToFloat64,
	BinaryenDemoteFloat64, BinaryenDivFloat32, BinaryenDivFloat64, BinaryenDivSInt32, BinaryenDivSInt64,
	BinaryenDivUInt32, BinaryenDivUInt64, BinaryenEqFloat32, BinaryenEqFloat64, BinaryenEqInt32, BinaryenEqInt64,
	BinaryenEqZInt32, BinaryenExpressionCopy, BinaryenExtendS16Int32, BinaryenExtendS8Int32, BinaryenExtendSInt32,
	BinaryenExtendUInt32, BinaryenFeatureExceptionHandling, BinaryenFeatureGC, BinaryenFeatureNontrappingFPToInt,
	BinaryenFeatureReferenceTypes, BinaryenFeatureSignExt, BinaryenGeFloat32, BinaryenGeFloat64, BinaryenGeSInt32,
	BinaryenGeSInt64, BinaryenGeUInt32, BinaryenGeUInt64, BinaryenGetGlobal, BinaryenGlobalGet,
	BinaryenGlobalGetInitExpr, BinaryenGlobalSet, BinaryenGtFloat32, BinaryenGtFloat64, BinaryenGtSInt32,
	BinaryenGtSInt64, BinaryenGtUInt32, BinaryenGtUInt64, BinaryenIf, BinaryenLeFloat32, BinaryenLeFloat64,
	BinaryenLeSInt32, BinaryenLeSInt64, BinaryenLeUInt32, BinaryenLeUInt64, BinaryenLocalGet, BinaryenLocalSet,
	BinaryenLoop, BinaryenLtFloat32, BinaryenLtFloat64, BinaryenLtSInt32, BinaryenLtSInt64, BinaryenLtUInt32,
	BinaryenLtUInt64, BinaryenMaxFloat64, BinaryenMinFloat64, BinaryenModuleCreate, BinaryenModuleDispose,
	BinaryenModuleOptimize, BinaryenModuleParse, BinaryenModuleSetFeatures, BinaryenModuleValidate, BinaryenModuleWrite,
	BinaryenMulFloat32, BinaryenMulFloat64, BinaryenMulInt32, BinaryenMulInt64, BinaryenNeFloat32, BinaryenNeFloat64,
	BinaryenNeInt32, BinaryenNeInt64, BinaryenNegFloat32, BinaryenNegFloat64, BinaryenOrInt32, BinaryenOrInt64,
	BinaryenPackedTypeInt16, BinaryenPackedTypeInt8, BinaryenPackedTypeNotPacked, BinaryenPromoteFloat32,
	BinaryenRefCast, BinaryenRefEq, BinaryenRefFunc, BinaryenRefIsNull, BinaryenRefNull, BinaryenRefTest,
	BinaryenReinterpretFloat32, BinaryenReinterpretFloat64, BinaryenReinterpretInt32, BinaryenReinterpretInt64,
	BinaryenRemSInt32, BinaryenRemSInt64, BinaryenRemUInt32, BinaryenRemUInt64, BinaryenReturn, BinaryenSelect,
	BinaryenSetOptimizeLevel, BinaryenShlInt32, BinaryenShlInt64, BinaryenShrSInt32, BinaryenShrSInt64,
	BinaryenShrUInt32, BinaryenShrUInt64, BinaryenStructGet, BinaryenStructNew, BinaryenStructSet, BinaryenSubFloat32,
	BinaryenSubFloat64, BinaryenSubInt32, BinaryenSubInt64, BinaryenThrow, BinaryenTruncSatSFloat32ToInt32,
	BinaryenTruncSatSFloat32ToInt64, BinaryenTruncSatSFloat64ToInt32, BinaryenTruncSatSFloat64ToInt64,
	BinaryenTruncSatUFloat32ToInt32, BinaryenTruncSatUFloat32ToInt64, BinaryenTruncSatUFloat64ToInt32,
	BinaryenTruncSatUFloat64ToInt64, BinaryenTryTable, BinaryenTypeAuto, BinaryenTypeCreate, BinaryenTypeEqref,
	BinaryenTypeFloat32, BinaryenTypeFloat64, BinaryenTypeFromHeapType, BinaryenTypeFuncref, BinaryenTypeGetHeapType,
	BinaryenTypeInt32, BinaryenTypeInt64, BinaryenTypeNone, BinaryenUnary, BinaryenUnreachable, BinaryenWrapInt64,
	BinaryenXorInt32, BinaryenXorInt64, TypeBuilderBuildAndDispose, TypeBuilderCreate, TypeBuilderCreateRecGroup,
	TypeBuilderGetSize, TypeBuilderGetTempHeapType, TypeBuilderGetTempTupleType, TypeBuilderGrow,
	TypeBuilderSetArrayType, TypeBuilderSetSignatureType, TypeBuilderSetStructType } from "binaryen-c.h"

/// Translates p, monomorphized for its module main, into the module at path, validated and optimized, whose export
/// start runs main, or with tests its tests, and gives the exit status.
export function wasm(p: Program, main: i32, tests: bool, path: string) throws CompileError {
	const w = new Wasm(p)
	try {
		w.run(main, tests)
		w.write(path)
	} finally {
		BinaryenModuleDispose(w.m)
		BinaryenModuleDispose(w.consts)
	}
}

/// A value: the local holding it and its type, normalized; of a left-out arg, Missing's, local -1; of an optional, whether
/// it was given in the local after.
type V = { l: i32, t: i32 }
/// A field of a class instance, object or tuple; an embedded one a ref to its own struct.
type Slot = { name: i32, t: i32, embed: bool, decl: i32 }
/// Field k of the struct v holds.
type Place = { v: V, k: i32, s: Slot }

/// An open block: its code goes to body, an If's after Else to other, and once it ends, wrapped, to outer.
class Frame {
	o: Opcode = op.Block
	t = 0
	height = 0
	/// Where a Br to it goes.
	label = ""
	outer: u64[] = []
	body: u64[] = []
	other: u64[] = []
	/// The local of its result, -1 if none.
	slot = -1
	/// An If's condition, a Default's not given.
	cond: u64 = 0
	/// A Default's param.
	local = 0
	/// An Each's loop: its labels, and what runs before and after its body each time; a Try's handler's end.
	exit = ""
	head = ""
	before: u64[] = []
	after: u64[] = []
	/// A Try's Finally, or -1; what runs: "body", "catch" or "finally".
	fin = -1
	phase = "body"
}

class Wasm {
	p: Program
	m: u64
	private i32 = BinaryenTypeInt32()
	private i64 = BinaryenTypeInt64()
	private f32 = BinaryenTypeFloat32()
	private f64 = BinaryenTypeFloat64()
	private none = BinaryenTypeNone()
	private eqref = BinaryenTypeEqref()
	private any = 0
	/// A zero of each number type, which constants are copies of, as bober cannot pass a BinaryenLiteral, a struct holding a
	/// union, by value.
	consts = BinaryenModuleParse(`(module ${["i32", "i64", "f32", "f64"].map(t => `(global $${t} ${t} (${t}.const 0))`).join("")})`)
	/// Heap types: build's by type, a function type's signature by "sig" and it, the others by what they are made of.
	private heaps = new HashMap[string, u64]()
	/// The functions and globals made or to be made, by name.
	private made = new HashMap[string, bool]()
	/// The global of each string literal.
	private strs = new HashMap[string, string]()
	private norms = new HashMap[i32, i32]()
	private layouts = new HashMap[i32, Slot[]]()
	/// The decls a Closure makes a closure's code of, which takes its env first.
	private closures = new HashMap[i32, bool]()
	/// Thunks to make once the decls are: function values' code.
	private pending: (() => void)[] = []
	// The function being made.
	private code = new Code()
	private mod = 0
	private path = ""
	private pos = -1
	private ret = 0
	/// The types of its params, then of its locals.
	private types: u64[] = []
	private np = 0
	private out: u64[] = []
	private stack: V[] = []
	private frames: Frame[] = []
	private dead = false
	private labels = 0
	/// Per local of the code, its wasm local, -1 if it holds nothing; an optional param's of whether it was given; and
	/// whether it is a cell, which a closure captures.
	private locals: i32[] = []
	private given: i32[] = []
	private cells: bool[] = []

	constructor(p: Program) {
		this.p = p
		this.m = BinaryenModuleCreate()
		BinaryenModuleSetFeatures(this.m,
			BinaryenFeatureGC() | BinaryenFeatureReferenceTypes() | BinaryenFeatureExceptionHandling()
			| BinaryenFeatureNontrappingFPToInt() | BinaryenFeatureSignExt())
		this.any = p.type(kind.Union)
	}

	run(main: i32, tests: bool) throws CompileError {
		const p = this.p
		this.build(this.roots())
		const box = this.boxType()
		BinaryenAddGlobal(this.m, "null", box, false,
			BinaryenStructNew(this.m, [this.i32c(kind.Null), this.i64c(0), this.nullRef()], 3, this.boxHeap()))
		this.str("") // first, as a string's zero
		BinaryenAddTag(this.m, "bober", box, this.none)
		BinaryenAddTagExport(this.m, "bober", "bober")
		for (const x of p.decls) {
			const c = x.code
			if (c != null) {
				for (const i of 0 ... c.ops.length - 1) {
					if (c.ops[i] == op.Closure) {
						this.closures.set(c.a(i), true)
					} else if (c.ops[i] == op.CallRef && c.b(i) > 0) {
						this.closures.set(c.b(i) - 1, true) // a closure's code, called as known
					}
				}
			}
		}
		for (const m of 0 ... p.modules.length - 1) {
			for (const d of listed(p, m)) {
				this.decl(d)
			}
		}
		for (const m of 0 ... p.modules.length - 1) {
			this.init(m)
		}
		this.start(main, tests)
		this.exports()
		while (this.pending.length > 0) {
			const f = this.pending.pop()
			f()
		}
	}

	write(path: string) throws CompileError {
		if (!BinaryenModuleValidate(this.m)) {
			throw new CompileError("wasm: the module is not valid")
		}
		BinaryenSetOptimizeLevel(2)
		BinaryenModuleOptimize(this.m)
		let buf = new u8[](1 << 20)
		let n = BinaryenModuleWrite(this.m, buf, buf.length as u64)
		while (n == (buf.length as u64)) {
			buf = new u8[](2 * buf.length)
			n = BinaryenModuleWrite(this.m, buf, buf.length as u64)
		}
		if (!writeFile(path, fromBytes(buf.slice(0, n as i32)))) {
			throw new CompileError(`cannot write ${path}`)
		}
	}

	// Decls.
	private decl(d: i32) {
		const p = this.p
		const x = p.decls[d]
		const c = p.classOf(d)
		const code = x.code
		if (c >= 0 && p.decls[c].kind == decl.Interface) {
			return
		}
		if (x.kind == decl.Class) {
			this.construct(d)
		} else if (x.kind == decl.Test && code != null) {
			this.define(this.fn(d), d, code, [], kind.None, false)
		} else if (x.kind == decl.Function && this.arrayMethod(d)) {
			this.arrayFn(d)
		} else if (x.kind == decl.Function && code != null) {
			this.define(this.fn(d), d, code, this.params(d), p.b(x.type), this.closures.has(d))
		} else if (x.kind == decl.Var && c >= 0 && (x.mods & decl.Static) == 0) {
			if (code != null) {
				this.define(this.initName(d), d, code, [code.locals[0].type], x.type, false)
			}
		} else if (x.kind == decl.Var) {
			this.made.set(this.fn(d), true)
			BinaryenAddGlobal(this.m, this.fn(d), this.val(x.type), true, this.zero(x.type))
			if (code != null) {
				this.define(this.initName(d), d, code, [], x.type, false)
			}
			if (this.lazy(d)) {
				this.once(`${this.fn(d)}:set`, x.module)
				this.initialize(d)
				this.finish(this.accessor(d), this.none)
			}
		}
	}

	/// Whether var decl d is a static field of a generic class's instance, initialized on first use by its accessor.
	private lazy(d: i32): bool { return this.p.decls[d].env != 0 }
	private accessor(d: i32): string { return `${this.fn(d)}:at` }

	/// Initializes var decl d if lazy and not yet.
	private touch(d: i32) {
		if (this.p.decls[d].kind == decl.Var && this.lazy(d)) {
			this.emit(BinaryenCall(this.m, this.accessor(d), [], 0, this.none))
		}
	}

	/// The name of decl d's function, or global.
	private fn(d: i32): string { return `${this.name(d)}#${d}` }
	/// The name of the function initializing class d's instances, or giving var d's value.
	private initName(d: i32): string { return `${this.fn(d)}:init` }
	private name(d: i32): string { return this.p.strings[this.p.decls[d].name] }

	/// The types of function decl d's params, this first in a method.
	private params(d: i32): i32[] {
		const x = this.p.decls[d]
		const ps = this.p.items(x.type)
		return if (this.p.method(d)) [x.code!.locals[0].type, ...ps] else ps
	}

	/// The init of module m, which runs once: the inits of the modules it depends on, and of builtin/ but in builtin/,
	/// then the initializers of its vars, static fields too, in order.
	private init(m: i32) {
		const p = this.p
		this.once(`inited#${m}`, m)
		const deps = p.modules[m].deps.slice(0, p.modules[m].deps.length)
		if (!builtin(p.modules[m].path)) {
			for (const k of 0 ... p.modules.length - 1) {
				if (builtin(p.modules[k].path) && !deps.includes(k)) {
					deps.push(k)
				}
			}
		}
		for (const k of deps) {
			this.emit(BinaryenCall(this.m, `init#${k}`, [], 0, this.none))
		}
		for (const d of p.modules[m].inits) {
			if (this.made.has(this.fn(d)) && !this.lazy(d)) {
				this.initialize(d)
			}
		}
		this.finish(`init#${m}`, this.none)
	}

	/// Starts a function of module m that returns at once but the first time, as flag, a global, tells.
	private once(flag: string, m: i32) {
		BinaryenAddGlobal(this.m, flag, this.i32, true, this.i32c(0))
		this.begin([], m)
		this.emit(BinaryenIf(this.m, BinaryenGlobalGet(this.m, flag, this.i32), BinaryenReturn(this.m, 0), 0))
		this.emit(BinaryenGlobalSet(this.m, flag, this.i32c(1)))
	}

	/// Sets var decl d to its initializer's value, if it has one.
	private initialize(d: i32) {
		const t = this.p.decls[d].type
		if (this.p.decls[d].code != null) {
			this.pushCall(this.initName(d), [], t)
			this.emit(BinaryenGlobalSet(this.m, this.fn(d), this.put(this.pop(), t)))
		}
	}

	/// The export start: main's module initialized, then main called, or each test by the host's test; the exit status.
	private start(main: i32, tests: bool) {
		const p = this.p
		const s = this.strType()
		this.begin([], main)
		this.emit(BinaryenCall(this.m, `init#${main}`, [], 0, this.none))
		let r = this.i32c(0)
		for (const d of p.modules[main].decls) {
			const x = p.decls[d]
			if (tests && x.kind == decl.Test) {
				const f = BinaryenRefFunc(this.m, this.fn(d), this.sigHeap([], this.none))
				this.emit(this.host("test", [this.str(this.name(d)), this.str(this.path), f],
					[s, s, BinaryenTypeFuncref()], this.none))
			} else if (!tests && x.kind == decl.Function && this.name(d) == "main") {
				this.pushCall(this.fn(d), [], p.b(x.type))
				if (this.stack.length > 0 && this.val(this.stack[0].t) == this.i32) {
					r = this.get(this.pop())
				}
			}
		}
		if (tests) {
			r = this.host("tested", [], [], this.i32)
		}
		this.emit(BinaryenReturn(this.m, r))
		this.finish("start", this.i32)
		BinaryenAddFunctionExport(this.m, "start", "start")
	}

	/// The exports the host makes and reads strings and reads boxes by, and calls a closure () => null by.
	private exports() {
		const s = this.strType()
		const box = this.boxType()
		const arg = (l: u32, t: u64) => BinaryenLocalGet(this.m, l, t)
		const exported = (name: string, ps: u64[], r: u64, body: u64) => {
			this.function(name, ps, r, [], body)
			BinaryenAddFunctionExport(this.m, name, name)
		}
		exported("strLen", [s], this.i32, BinaryenStructGet(this.m, 0, arg(0, s), this.i32, false))
		exported("strAt", [s, this.i32], this.i32,
			BinaryenArrayGet(this.m, this.bytes(arg(0, s)), arg(1, this.i32), this.i32, false))
		exported("strNew", [this.i32], s, this.newStr(0))
		exported("strSet", [s, this.i32, this.i32], this.none,
			BinaryenArraySet(this.m, this.bytes(arg(0, s)), arg(1, this.i32), arg(2, this.i32)))
		exported("boxTag", [box], this.i32, BinaryenStructGet(this.m, 0, arg(0, box), this.i32, false))
		exported("boxBits", [box], this.i64, BinaryenStructGet(this.m, 1, arg(0, box), this.i64, false))
		exported("boxRef", [box], this.eqref, BinaryenStructGet(this.m, 2, arg(0, box), this.eqref, false))
		const f = this.p.type(kind.Func, this.p.list([]), kind.Null)
		this.begin([this.val(f)], 0)
		this.emit(this.callClosure({ l: 0, t: f }, []))
		this.finish("call", this.none)
		BinaryenAddFunctionExport(this.m, "call", "call")
	}

	/// Adds function name of params ps, result r, locals vs and body.
	private function(name: string, ps: u64[], r: u64, vs: u64[], body: u64) {
		BinaryenAddFunctionWithHeapType(this.m, name, this.sigHeap(ps, r), vs, vs.length as u32, body)
	}

	/// The initializer of class c, which initializes an instance in place, field by field: each set to its zero value
	/// or by its initializer, an embedded one made and initialized first (spec 5.3).
	private construct(c: i32) {
		const p = this.p
		const n = p.type(kind.Named, c, 0)
		this.begin([this.val(n)], p.decls[c].module)
		const self: V = { l: 0, t: n }
		try {
			const slots = this.layout(n)
			for (const k of 0 ... slots.length - 1) {
				const s = slots[k]
				const t = this.norm(s.t)
				const code = p.decls[s.decl].code
				if (s.embed) {
					const e = this.instance(t, [])
					this.emit(BinaryenStructSet(this.m, k as u32, this.get(self), this.get(e)))
				}
				if (code != null) {
					this.pushCall(this.initName(s.decl), [this.get(self)], t)
				}
				const v = if (code != null) this.pop() else null
				if (!s.embed) {
					this.emit(BinaryenStructSet(this.m, k as u32, this.get(self),
						if (v == null) this.zero(t) else this.put(v!, t)))
				}
			}
		} catch (e: CompileError) {
			this.trap(e.msg)
		}
		this.finish(this.initName(c), this.none)
	}

	// Functions.
	/// Starts a function of params ps, of a decl of module m.
	private begin(ps: u64[], m: i32) {
		this.mod = m
		this.path = this.p.modules[m].path
		this.pos = -1
		this.types = ps.slice(0, ps.length)
		this.np = ps.length
		this.out = []
		this.stack = []
		this.frames = []
		this.dead = false
		this.labels = 0
	}

	/// Adds the function begun as name, of result r, and of signature sig if not 0, the code of function values'.
	private finish(name: string, r: u64, sig: u64 = 0) {
		if (r != this.none) {
			this.emit(BinaryenUnreachable(this.m))
		}
		const body = BinaryenBlock(this.m, 0, this.out, this.out.length as u32, BinaryenTypeAuto())
		const vs = this.types.slice(this.np, this.types.length)
		BinaryenAddFunctionWithHeapType(this.m, name,
			if (sig != 0) sig else this.sigHeap(this.types.slice(0, this.np), r), vs, vs.length as u32, body)
	}

	/// Defines function name of decl d's code c, of params of types ps and result ret; if env, a closure's code, which
	/// takes its env first. Code that has what is not translated traps with what instead.
	private define(name: string, d: i32, c: Code, ps: i32[], ret: i32, env: bool) {
		const ws = if (env) [this.eqref, ...this.expand(ps)] else this.expand(ps)
		const m = this.p.decls[d].module
		try {
			this.body(c, ps, ret, env, ws, m)
		} catch (e: CompileError) {
			this.begin(ws, m)
			this.trap(e.msg)
		}
		this.finish(name, this.resultType(ret), if (env) this.codeSig(this.p.decls[d].type) else 0)
	}

	private body(c: Code, ps: i32[], ret: i32, env: bool, ws: u64[], m: i32) throws CompileError {
		this.begin(ws, m)
		this.code = c
		this.ret = ret
		const cells = c.locals.map(_ => false)
		for (const i of 0 ... c.ops.length - 1) {
			if (c.ops[i] == op.Closure) {
				for (const l of c.items(c.c(i))) {
					cells[l] = true
				}
			}
		}
		const capAt = c.locals.map(_ => -1)
		for (const k of 0 ... (if (env) c.captures.length else 0) - 1) {
			capAt[c.captures[k]] = k
			cells[c.captures[k]] = true
		}
		const envType = if (env) this.ref(this.envHeap(c.captures.map(l => this.cellType(c.locals[l].type)))) else 0
		this.cells = cells
		this.locals = []
		this.given = []
		let w = if (env) 1 else 0
		for (const i of 0 ... c.locals.length - 1) {
			const t = this.bare(c.locals[i].type)
			const vt = this.val(t)
			const cell = this.cellType(t)
			this.locals.push(-1)
			this.given.push(-1)
			if (vt == this.none) {
				continue // an untyped catch's local holds nothing
			} else if (capAt[i] >= 0) {
				const all = BinaryenRefCast(this.m, BinaryenLocalGet(this.m, 0, this.eqref), envType)
				this.locals[i] = this.spill(BinaryenStructGet(this.m, capAt[i] as u32, all, cell, false), cell)
				continue
			}
			let x = this.zero(t)
			if (i < ps.length) {
				x = this.put({ l: w, t: t }, t)
				w++
				if (this.p.kind(ps[i]) == kind.Optional) {
					this.given[i] = w
					w++
				}
			}
			this.locals[i] = if (cells[i]) this.spill(BinaryenStructNew(this.m, [x], 1, this.cellHeap(vt)), cell)
				else this.spill(x, vt)
		}
		this.ops(0, c.ops.length)
	}

	/// The wasm params of params of types ts: an optional one's value and whether it was given.
	private expand(ts: i32[]): u64[] {
		const r: u64[] = []
		for (const t of ts) {
			r.push(this.val(t))
			if (this.p.kind(t) == kind.Optional) {
				r.push(this.i32)
			}
		}
		return r
	}

	/// Translates the ops of the code from i up to end.
	private ops(i: i32, end: i32) throws CompileError {
		let at = i
		while (at < end) {
			at = this.op(at) + 1
		}
	}

	/// Translates op i; returns the last op it translated, itself or the End of an Each it unrolled.
	private op(i: i32): i32 throws CompileError {
		const c = this.code
		const p = this.p
		const o = c.ops[i]
		const n = c.a(i)
		this.pos = c.pos[i]
		switch (o) {
			case op.End: this.end()
			case op.Unreachable: this.trap("unreachable")
			case op.Block: this.open(o, n)
			case op.Loop: this.open(o, kind.None)
			case op.If:
				const yes = this.cond()
				this.open(o, n).cond = yes
			case op.Else:
				const f = this.frames[this.frames.length - 1]
				this.leaveBlock(f)
				this.out = f.other
				this.dead = false
			case op.Default:
				const f = this.open(o, kind.None)
				f.local = n
				f.cond = BinaryenUnary(this.m, BinaryenEqZInt32(),
					BinaryenLocalGet(this.m, this.given[n] as u32, this.i32))
			case op.Each: return this.each(n, i)
			case op.Try: this.try(i)
			case op.Catch: this.catch(n, c.b(i))
			case op.Finally: this.finally()
			case op.Throw:
				const v = this.cast(this.pop(), this.any)
				this.emit(this.host("thrown", [this.str(this.path), this.i32c(this.pos)], [this.strType(), this.i32],
					this.none))
				this.emit(BinaryenThrow(this.m, "bober", [v], 1))
				this.dead = true
			case op.Br: this.branch(n)
			case op.BrIf: this.branchIf(this.cond(), n)
			case op.BrNull:
				const u = this.pop()
				this.push(this.i32c(0), kind.Null)
				this.branchIf(this.isa(u, kind.Null), n)
				this.stack.pop()
				const rest = p.union(p.members(u.t).filter(m => m != kind.Null))
				this.push(this.cast(u, rest), rest)
			case op.Return: this.return()
			case op.Call: this.invoke(n, c.b(i))
			case op.CallRef:
				const xs = this.popN(n)
				const f = this.pop()
				this.pushResult(this.callClosure(f, this.args(xs, p.items(f.t)), c.b(i) - 1), p.b(f.t))
			case op.Drop: this.stack.pop()
			case op.Local:
				const t = this.norm(c.locals[n].type)
				if (p.kind(t) != kind.Optional) {
					this.push(this.load(n), t)
				} else {
					// An optional param, a dispatch's, passed on as given.
					const l = this.spill(this.load(n), this.val(t))
					this.spill(BinaryenLocalGet(this.m, this.given[n] as u32, this.i32), this.i32)
					this.stack.push({ l: l, t: t })
				}
			case op.SetLocal: this.setLocal(n, this.pop())
			case op.Fresh: this.renew(n)
			case op.Global:
				const x = p.decls[n]
				this.touch(n)
				this.push(if (x.kind == decl.Function) this.value(n)
					else BinaryenGlobalGet(this.m, this.fn(n), this.val(x.type)), x.type)
			case op.SetGlobal:
				const t = p.decls[n].type
				this.touch(n)
				this.emit(BinaryenGlobalSet(this.m, this.fn(n), this.put(this.pop(), t)))
			case op.False, op.True: this.push(this.i32c(if (o == op.True) 1 else 0), kind.Bool)
			case op.Null: this.push(this.i32c(0), kind.Null)
			case op.Int, op.Float:
				const v = p.ints[c.b(i)]
				const k = this.kindOf(n)
				const f = if (o == op.Float) fromBits[f64](v as u64) else v as f64
				this.push(if (k == kind.F32) this.f32c(f as f32)
					else if (kind.isFloat(k)) this.f64c(f)
					else if (this.val(n) == this.i64) this.i64c(v)
					else this.normal(this.i32c(v as i32), k), n)
			case op.Str: this.push(this.str(p.strings[n]), kind.String)
			case op.Missing: this.stack.push({ l: -1, t: this.norm(n) })
			case op.Member, op.Field: this.field(this.pop(), if (o == op.Field) n else p.decls[n].name)
			case op.SetMember, op.SetField:
				const v = this.pop()
				this.setField(this.pop(), if (o == op.SetField) n else p.decls[n].name, v)
			case op.Subscript:
				const k = this.pop()
				const arr = this.pop()
				this.push(this.element(arr, k), this.elementType(arr.t))
			case op.SetSubscript:
				const v = this.pop()
				const k = this.pop()
				const arr = this.pop()
				const at = this.index(arr, k)
				this.emit(BinaryenArraySet(this.m, this.data(arr), at, this.put(v, this.elementType(arr.t))))
			case op.Unpack:
				const arr = this.stack[this.stack.length - 1]
				if (p.kind(arr.t) == kind.Array) {
					this.check(BinaryenBinary(this.m, BinaryenGeSInt32(), this.length(arr), this.i32c(n)),
						"array pattern longer than array")
				}
			case op.Array, op.Object: this.array(n, this.popN(c.b(i)), c.items(c.c(i)))
			case op.Init: {} // made at its op, as struct.new and array.new_fixed take all the values
			case op.New: this.make(n)
			case op.Closure:
				const ls = c.items(c.c(i)).map(l => this.locals[l])
				const cells = ls.map(l => BinaryenLocalGet(this.m, l as u32, this.types[l]))
				const env = if (cells.length == 0) this.nullRef()
					else BinaryenStructNew(this.m, cells, cells.length as u32, this.envHeap(ls.map(l => this.types[l])))
				this.push(this.closure(this.fn(n), p.decls[n].type, env), p.decls[n].type)
			case op.Cast: this.push(this.cast(this.pop(), n), n)
			case op.Is: this.push(this.isa(this.pop(), n), kind.Bool)
			case op.Assert: this.check(this.cond(), "assert failed")
			case op.Fail:
				const msg = this.cast(this.pop(), kind.String)
				this.emit(this.trapCall(this.lang("concat", [this.str("assert failed: "), msg]), true))
				this.dead = true
			case op.Not: this.push(BinaryenUnary(this.m, BinaryenEqZInt32(), this.cond()), kind.Bool)
			case op.Eq, op.Ne, op.Lt, op.Gt, op.Le, op.Ge: this.compare(o)
			case op.Same:
				const y = this.pop()
				const x = this.pop()
				if (p.kind(x.t) != kind.Union && p.kind(y.t) != kind.Union && this.isRef(this.val(x.t))) {
					this.push(BinaryenRefEq(this.m, this.get(x), this.get(y)), kind.Bool)
				} else {
					this.stack.push(x)
					this.stack.push(y)
					this.compare(op.Eq)
				}
			case op.Add, op.Sub, op.Mul, op.Div, op.Rem, op.Pow, op.And, op.Or, op.Xor, op.Shl, op.Shr: this.arith(o)
			case op.Neg:
				const a = this.pop()
				const vt = this.val(a.t)
				this.push(if (vt == this.f32) BinaryenUnary(this.m, BinaryenNegFloat32(), this.get(a))
					else if (vt == this.f64) BinaryenUnary(this.m, BinaryenNegFloat64(), this.get(a))
					else this.normal(this.binary(op.Sub, vt, false, this.zeroOf(vt), this.get(a)), p.kind(a.t)), a.t)
			case op.Concat:
				const xs = this.popN(n)
				let r = this.cast(xs[0], kind.String)
				for (const x of xs.slice(1, n)) {
					r = this.lang("concat", [r, this.cast(x, kind.String)])
				}
				this.push(r, kind.String)
			default: throw new CompileError(`wasm: ${op.names[o]}`)
		}
		return i
	}

	// Control flow.
	private open(o: Opcode, t: i32): Frame {
		const f = new Frame()
		f.o = o
		f.t = t
		f.height = this.stack.length
		f.label = this.label()
		f.outer = this.out
		if (t != kind.None) {
			f.slot = this.temp(this.val(t))
		}
		this.frames.push(f)
		this.out = f.body
		return f
	}

	private label(): string {
		this.labels++
		return `L${this.labels}`
	}

	private end() {
		if (this.frames.length == 0) {
			if (!this.dead) {
				this.return()
			}
			return
		}
		const f = this.frames.pop()
		if (f.o != op.Try) {
			this.leaveBlock(f)
		}
		this.stack = this.stack.slice(0, f.height)
		const x = switch (f.o) {
			case op.Loop: BinaryenLoop(this.m, f.label, this.block(f.body))
			case op.If: this.labeled(f.label, [BinaryenIf(this.m, f.cond, this.block(f.body), this.block(f.other))])
			case op.Default: this.labeled(f.label, [BinaryenIf(this.m, f.cond, this.block(f.body), 0)])
			case op.Try: this.labeled(f.label, if (f.phase == "catch") [this.labeled(f.exit, f.other)] else f.body)
			default: if (f.exit == "") this.labeled(f.label, f.body)
				else this.labeled(f.exit,
				[BinaryenLoop(this.m, f.head, this.block([...f.before, this.labeled(f.label, f.body), ...f.after]))])
		}
		this.out = f.outer
		this.emit(x)
		this.dead = false
		if (f.slot >= 0) {
			this.stack.push({ l: f.slot, t: this.norm(f.t) })
		}
	}

	/// Ends the code of f's block that falls through to its end: its result stored, or a Default's in its param.
	private leaveBlock(f: Frame) {
		if (!this.dead) {
			if (f.o == op.Default) {
				this.setLocal(f.local, this.pop())
			} else if (f.slot >= 0) {
				this.emit(BinaryenLocalSet(this.m, f.slot as u32, this.cast(this.pop(), f.t)))
			}
		}
		this.stack = this.stack.slice(0, f.height)
	}

	/// Returns the value on the stack, if any, through the finallys on the way.
	private return() {
		const r = this.resultType(this.ret)
		const v = if (r == this.none || this.stack.length == 0) -1 else this.spill(this.cast(this.pop(), this.ret), r)
		this.leave(0)
		this.emit(BinaryenReturn(this.m, if (v < 0) 0 else BinaryenLocalGet(this.m, v as u32, r)))
		this.dead = true
	}

	/// Branches out of the block at depth n, through the finallys on the way: to after its end, or to a Loop's start,
	/// or an Each's next element.
	private branch(n: i32) {
		const j = this.frames.length - 1 - n
		const f = this.frames[j]
		const v = if (f.slot >= 0) this.pop() else null
		this.leave(j)
		if (v != null) {
			this.emit(BinaryenLocalSet(this.m, f.slot as u32, this.cast(v!, f.t)))
		}
		this.emit(BinaryenBreak(this.m, f.label, 0, 0))
		this.dead = true
	}

	/// Branches out of the block at depth n if yes, the stack left as it was for the path not taken.
	private branchIf(yes: u64, n: i32) {
		const stack = this.stack.slice(0, this.stack.length)
		const taken = this.nested(() => this.branch(n))
		this.stack = stack
		this.dead = false
		this.emit(BinaryenIf(this.m, yes, taken, 0))
	}

	/// Runs the finallys of the Trys from the innermost to the one at frame j.
	private leave(j: i32) {
		let k = this.frames.length - 1
		while (k >= j) {
			const f = this.frames[k]
			if (f.o == op.Try && f.fin >= 0 && f.phase != "finally") {
				this.final(k)
			}
			k--
		}
	}

	/// Translates the finally of the Try at frame k where it is left, as if in it.
	private final(k: i32) {
		const frames = this.frames
		const stack = this.stack
		const f = frames[k]
		const phase = f.phase
		f.phase = "finally"
		this.frames = frames.slice(0, k + 1)
		this.stack = stack.slice(0, f.height)
		this.ops(f.fin + 1, this.code.next(f.fin))
		f.phase = phase
		this.frames = frames
		this.stack = stack
	}

	/// Each of op i over the array, fixed array, string or tuple on the stack, local l holding each element in turn: a
	/// loop, or over a tuple its body translated once per element. A Br to it goes on to the next. Returns the last op
	/// it translated.
	private each(l: i32, i: i32): i32 {
		const xs = this.pop()
		if (this.p.kind(xs.t) == kind.Tuple) {
			const end = this.code.next(i)
			for (const e of 0 ... this.p.items(xs.t).length - 1) {
				this.open(op.Each, kind.None)
				this.field(xs, this.p.elementName(e))
				this.renew(l)
				this.setLocal(l, this.pop())
				this.ops(i + 1, end)
				this.end()
			}
			return end
		}
		const at: V = { l: this.spill(this.i32c(0), this.i32), t: kind.I32 }
		const f = this.open(op.Each, kind.None)
		f.exit = this.label()
		f.head = this.label()
		this.out = f.before
		// The length read anew each time, as the body may change it.
		this.emit(BinaryenBreak(this.m, f.exit,
			BinaryenBinary(this.m, BinaryenGeUInt32(), this.get(at), this.length(xs)), 0))
		this.renew(l)
		const e = this.elementType(xs.t)
		this.setLocal(l, { l: this.spill(this.at(xs, this.get(at)), this.val(e)), t: this.norm(e) })
		f.after = [this.increment(at), BinaryenBreak(this.m, f.head, 0, 0)]
		this.out = f.body
		return i
	}

	/// Makes local l a new variable, where a closure captures its cell (Fresh).
	private renew(l: i32) {
		if (this.cells[l]) {
			const t = this.bare(this.code.locals[l].type)
			this.emit(BinaryenLocalSet(this.m, this.locals[l] as u32,
				BinaryenStructNew(this.m, [this.zero(t)], 1, this.cellHeap(this.val(t)))))
		}
	}

	private try(i: i32) {
		const f = this.open(op.Try, kind.None)
		let j = this.code.next(i)
		if (this.code.ops[j] == op.Catch) {
			j = this.code.next(j)
		}
		f.fin = if (this.code.ops[j] == op.Finally) j else -1
	}

	/// The handler of what a Try's body throws: the body in a try_table, past the handler to f.exit if it ends; what it
	/// throws rethrown unless of type t, else stored in local l.
	private catch(t: i32, l: i32) {
		const f = this.frames[this.frames.length - 1]
		f.phase = "catch"
		f.exit = this.label()
		this.stack = this.stack.slice(0, f.height)
		const c = this.caught(this.block(f.body), f.exit)
		f.other = []
		this.out = f.other
		this.emit(c[1])
		this.dead = false
		if (t != kind.None) {
			this.emit(BinaryenIf(this.m, BinaryenUnary(this.m, BinaryenEqZInt32(), this.isa(c[0], t)),
				BinaryenThrow(this.m, "bober", [this.get(c[0])], 1), 0))
			this.setLocal(l, c[0])
		}
	}

	/// A Try's finally: run inline where what is before it throws, then that rethrown, and then on the normal path.
	private finally() {
		const k = this.frames.length - 1
		const f = this.frames[k]
		this.stack = this.stack.slice(0, f.height)
		const fin = this.label()
		const c = this.caught(if (f.phase == "catch") this.labeled(f.exit, f.other) else this.block(f.body), fin)
		f.body = []
		this.out = f.body
		this.emit(c[1])
		this.dead = false
		this.final(k)
		this.emit(BinaryenThrow(this.m, "bober", [this.get(c[0])], 1))
		f.body = [this.labeled(fin, f.body)]
		this.out = f.body
		this.dead = false
		f.phase = "finally"
	}

	/// What body throws caught, in a try_table that goes to exit if body ends: the box, and the code storing it.
	private caught(body: u64, exit: string): [V, u64] {
		const pad = this.label()
		const c: V = { l: this.temp(this.boxType()), t: this.any }
		const tried = BinaryenTryTable(this.m, body, ["bober"], [pad], [false], 1)
		const x = BinaryenBlock(this.m, pad, [tried, BinaryenBreak(this.m, exit, 0, 0)], 2, this.boxType())
		return [c, BinaryenLocalSet(this.m, c.l as u32, x)]
	}

	// Calls.
	/// Call of decl d of env: a bober function, an intrinsic of builtin/, or an import.
	private invoke(d: i32, env: i32) {
		const p = this.p
		const x = p.decls[d]
		const t = p.subst(x.type, env)
		if (x.code == null && (x.mods & decl.Extern) == 0 && this.intrinsic(this.name(d), env, p.b(t))) {
			return
		}
		const xs = this.popN(p.items(t).length)
		const first: u64[] = []
		if (p.method(d)) {
			const obj = this.pop()
			first.push(this.get(this.upcast(obj, x.owner) ?? obj))
		} else if (this.closures.has(d)) {
			first.push(this.nullRef())
		}
		this.pushCall(this.callee(d, env), [...first, ...this.args(xs, p.items(t))], p.b(t))
	}

	/// The function a call of decl d of env calls: its own, or the import of one without a body, of its name.
	private callee(d: i32, env: i32): string {
		const x = this.p.decls[d]
		if (x.code != null) {
			return this.fn(d)
		}
		const name = `import:${this.name(d)}:${d}:${env}`
		if (!this.made.has(name)) {
			this.made.set(name, true)
			const t = this.p.subst(x.type, env)
			BinaryenAddFunctionImport(this.m, name, "bober", this.name(d), this.tuple(this.expand(this.p.items(t))),
				this.resultType(this.p.b(t)))
		}
		return name
	}

	/// The intrinsic name of builtin/wasm/, of the type args of env and result ret, in place; false if it is none.
	private intrinsic(name: string, env: i32, ret: i32): bool {
		const t = if (env == 0) kind.None else this.p.lists[env][0]
		switch (name) {
			case "array": this.push(this.newArray(t, BinaryenUnary(this.m, BinaryenWrapInt64(), this.get(this.pop()))),
				ret)
			case "zero": this.push(this.zero(t), t)
			case "newString": this.push(this.newStr(this.pop().l), kind.String)
			case "setByte":
				const xs = this.popN(3).map(x => this.get(x))
				this.pushResult(BinaryenArraySet(this.m, this.bytes(xs[0]), xs[1], xs[2]), ret)
			case "copyBytes":
				const xs = this.popN(5).map(x => this.get(x))
				this.pushResult(BinaryenArrayCopy(this.m, this.bytes(xs[0]), xs[1], this.bytes(xs[2]), xs[3], xs[4]),
					ret)
			case "room":
				const s = this.pop()
				const free = this.binary(op.Sub, this.i32, false, BinaryenArrayLen(this.m, this.data(s)),
					this.length(s))
				this.push(BinaryenSelect(this.m, BinaryenStructGet(this.m, 2, this.get(s), this.i32, false), free,
					this.i32c(-1)), kind.I32)
			case "extend":
				const n = this.pop()
				const s = this.pop()
				this.emit(BinaryenStructSet(this.m, 2, this.get(s), this.i32c(0)))
				this.push(BinaryenStructNew(this.m, [this.get(n), this.data(s), this.i32c(1)], 3, this.strHeap()),
					kind.String)
			case "bits":
				const x = this.get(this.pop())
				this.push(if (this.kindOf(t) == kind.F32) BinaryenUnary(this.m, BinaryenExtendUInt32(),
					BinaryenUnary(this.m, BinaryenReinterpretFloat32(), x))
					else BinaryenUnary(this.m, BinaryenReinterpretFloat64(), x), kind.U64)
			case "fromBits":
				const x = this.get(this.pop())
				this.push(if (this.kindOf(t) == kind.F32) BinaryenUnary(this.m, BinaryenReinterpretInt32(),
					BinaryenUnary(this.m, BinaryenWrapInt64(), x))
					else BinaryenUnary(this.m, BinaryenReinterpretInt64(), x), t)
			case "trap": this.pushResult(this.trapCall(this.get(this.pop()), false), ret)
			case "catching":
				// builtin/wasm/fiber.bob's: what a call throws, kept in a Thrown, whose one field is a box.
				const into = this.get(this.pop())
				const f = this.pop()
				const threw = this.spill(this.i32c(0), this.i32)
				const done = this.label()
				const [box, caught] = this.caught(this.callClosure(f, []), done)
				this.emit(this.labeled(done,
					[caught, BinaryenStructSet(this.m, 0, into, this.get(box)),
					BinaryenLocalSet(this.m, threw as u32, this.i32c(1))]))
				this.stack.push({ l: threw, t: ret })
			case "rethrow":
				const box = BinaryenStructGet(this.m, 0, this.get(this.pop()), this.boxType(), false)
				this.pushResult(BinaryenThrow(this.m, "bober", [box], 1), ret)
			default: return false
		}
		return true
	}

	/// The values of args xs of params ps: an optional one's and whether it was given; one left out its zero.
	private args(xs: V[], ps: i32[]): u64[] {
		const r: u64[] = []
		for (const k of 0 ... ps.length - 1) {
			const opt = this.p.kind(ps[k]) == kind.Optional
			const t = if (opt) this.p.a(ps[k]) else ps[k]
			const given = k < xs.length && xs[k].l >= 0
			// An optional param's value is its local's, and whether it was given the next local's.
			const held = given && this.p.kind(xs[k].t) == kind.Optional
			if (!given) {
				r.push(this.zero(t))
			} else if (held) {
				r.push(this.cast({ l: xs[k].l, t: this.p.a(xs[k].t) }, t))
			} else {
				r.push(this.cast(xs[k], t))
			}
			if (opt) {
				r.push(if (held) BinaryenLocalGet(this.m, (xs[k].l + 1) as u32, this.i32)
					else this.i32c(if (given) 1 else 0))
			}
		}
		return r
	}

	/// Pushes what a call x gives of type t, if anything: null's of a function of none.
	private pushResult(x: u64, t: i32) {
		if (this.resultType(t) != this.none) {
			this.push(x, t)
			return
		}
		this.emit(x)
		if (this.kindOf(t) == kind.Null) {
			this.push(this.i32c(0), kind.Null)
		}
	}

	private pushCall(name: string, args: u64[], t: i32) {
		this.pushResult(BinaryenCall(this.m, name, args, args.length as u32, this.resultType(t)), t)
	}

	/// A call of builtin/'s function name, which gives a value.
	private lang(name: string, args: u64[]): u64 {
		const d = this.p.lang(name)
		return BinaryenCall(this.m, this.fn(d), args, args.length as u32,
			this.resultType(this.p.b(this.p.decls[d].type)))
	}

	/// A call of the host's function name, of params ps and result r.
	private host(name: string, args: u64[], ps: u64[], r: u64): u64 {
		const f = `host:${name}`
		if (!this.made.has(f)) {
			this.made.set(f, true)
			BinaryenAddFunctionImport(this.m, f, "bober", name, this.tuple(ps), r)
		}
		return BinaryenCall(this.m, f, args, args.length as u32, r)
	}

	/// A call of the function value f with args, or of its code, function via, if known.
	private callClosure(f: V, args: u64[], via = -1): u64 {
		const xs = [BinaryenStructGet(this.m, 1, this.get(f), this.eqref, false), ...args]
		const r = this.resultType(this.p.b(f.t))
		if (via >= 0) {
			return BinaryenCall(this.m, this.fn(via), xs, xs.length as u32, r)
		}
		const code = BinaryenStructGet(this.m, 0, this.get(f), this.ref(this.codeSig(f.t)), false)
		return BinaryenCallRef(this.m, code, xs, xs.length as u32, r)
	}

	/// The function value of the function name of type t and env.
	private closure(name: string, t: i32, env: u64): u64 {
		const code = BinaryenRefFunc(this.m, name, this.codeSig(t))
		return BinaryenStructNew(this.m, [code, env], 2, this.heap(t))
	}

	/// The function value of function d, a Global's: its code a thunk ignoring its env.
	private value(d: i32): u64 {
		const t = this.p.decls[d].type
		const name = this.thunk(`value#${d}`, t, n => {
			const args: u64[] = if (this.closures.has(d)) [this.nullRef()] else []
			for (const i of 1 ... n - 1) {
				args.push(this.param(i))
			}
			this.pushCall(this.callee(d, 0), args, this.p.b(t))
		})
		return this.closure(name, t, this.nullRef())
	}

	/// Method d bound to obj, as a field of obj gives it: its code a thunk calling d on its env.
	private bound(d: i32, obj: V): u64 {
		const t = this.p.decls[d].type
		const self = this.val(this.p.decls[d].code!.locals[0].type)
		const name = this.thunk(`bound#${d}`, t, n => {
			const args = [BinaryenRefCast(this.m, this.param(0), self)]
			for (const i of 1 ... n - 1) {
				args.push(this.param(i))
			}
			this.pushCall(this.callee(d, 0), args, this.p.b(t))
		})
		return this.closure(name, t, this.get(this.upcast(obj, this.p.decls[d].owner) ?? obj))
	}

	/// Function value f as one of type to (4.6): its code a thunk calling f, its env, with the args cast to f's params
	/// and f's result cast to to's.
	private adapt(f: V, to: i32): u64 {
		const p = this.p
		const from = f.t
		const name = this.thunk(`adapt#${from}#${to}`, to, n => {
			const g: V = { l: this.spill(BinaryenRefCast(this.m, this.param(0), this.val(from)), this.val(from)),
				t: from }
			const xs: V[] = []
			let w = 1
			for (const q of p.items(to)) {
				xs.push({ l: w, t: q })
				w += if (p.kind(q) == kind.Optional) 2 else 1
			}
			this.pushResult(this.callClosure(g, this.args(xs, p.items(from))), p.b(from))
		})
		return this.closure(name, to, this.get(f))
	}

	/// The function name of the code of function values of type t, made once the decls are, of the code build adds, given
	/// the count of its params, then returning what it pushed.
	private thunk(name: string, t: i32, build: (n: i32) => void): string {
		if (!this.made.has(name)) {
			this.made.set(name, true)
			const m = this.mod
			this.pending.push(() => {
				const ps = [this.eqref, ...this.expand(this.p.items(t))]
				this.begin(ps, m)
				this.ret = this.p.b(t)
				build(ps.length)
				this.return()
				this.finish(name, this.resultType(this.ret), this.codeSig(t))
			})
		}
		return name
	}

	private param(i: i32): u64 { return BinaryenLocalGet(this.m, i as u32, this.types[i]) }

	/// Whether d is builtin/array.bob's push, pop or slice, which reach an array's layout by address, so are made here.
	private arrayMethod(d: i32): bool {
		const p = this.p
		const c = p.classOf(d)
		return c >= 0 && p.modules[p.decls[d].module].path == builtinPath("array") && this.name(c) == "Array"
			&& ["push", "pop", "slice"].includes(this.name(d))
	}

	/// builtin/array.bob's method d: push grows the elements to twice their room and 8 more once full.
	private arrayFn(d: i32) {
		const p = this.p
		const x = p.decls[d]
		const ps = this.params(d)
		this.begin(this.expand(ps), x.module)
		this.ret = p.b(x.type)
		const a: V = { l: 0, t: this.norm(ps[0]) }
		const e = p.a(a.t)
		const n: V = { l: this.spill(this.length(a), this.i32), t: kind.I32 }
		const int = (k: i32) => this.i32c(k)
		const range = (cond: u64,
			what: string) => this.emit(BinaryenIf(this.m, cond, this.trapCall(this.str(what), false), 0))
		switch (this.name(d)) {
			case "push":
				const grow = this.nested(() => {
					const room = this.binary(op.Add, this.i32, false,
						this.binary(op.Mul, this.i32, false, this.get(n), int(2)), int(8))
					const to = this.spill(this.newData(e, room), this.ref(this.dataHeap(e)))
					const data = () => BinaryenLocalGet(this.m, to as u32, this.types[to])
					this.emit(BinaryenArrayCopy(this.m, data(), int(0), this.data(a), int(0), this.get(n)))
					this.emit(BinaryenStructSet(this.m, 1, this.get(a), data()))
				})
				this.emit(BinaryenIf(this.m,
					this.binary(op.Eq, this.i32, false, this.get(n), BinaryenArrayLen(this.m, this.data(a))), grow, 0))
				this.emit(BinaryenArraySet(this.m, this.data(a), this.get(n), this.put({ l: 1, t: this.norm(e) }, e)))
				this.emit(BinaryenStructSet(this.m, 0, this.get(a),
					this.binary(op.Add, this.i32, false, this.get(n), int(1))))
			case "pop":
				range(BinaryenUnary(this.m, BinaryenEqZInt32(), this.get(n)), "pop of an empty array")
				this.emit(BinaryenLocalSet(this.m, n.l as u32,
					this.binary(op.Sub, this.i32, false, this.get(n), int(1))))
				this.emit(BinaryenStructSet(this.m, 0, this.get(a), this.get(n)))
				this.push(this.at(a, this.get(n)), e)
			case "slice":
				const from: V = { l: 1, t: kind.I32 }
				const to: V = { l: 2, t: kind.I32 }
				const lt = (x: V, y: V) => this.binary(op.Lt, this.i32, true, this.get(x), this.get(y))
				const or = (x: u64, y: u64) => BinaryenBinary(this.m, BinaryenOrInt32(), x, y)
				range(or(BinaryenBinary(this.m, BinaryenLtSInt32(), this.get(from), int(0)),
					or(lt(to, from), lt(n, to))), "slice out of range")
				const k: V = { l: this.spill(this.binary(op.Sub, this.i32, false, this.get(to), this.get(from)),
					this.i32), t: kind.I32 }
				const r: V = { l: this.spill(this.newArray(e, this.get(k)), this.val(a.t)), t: a.t }
				this.emit(BinaryenArrayCopy(this.m, this.data(r), int(0), this.data(a), this.get(from), this.get(k)))
				this.stack.push(r)
		}
		this.return()
		this.finish(this.fn(d), this.resultType(this.ret))
	}

	// Values.
	/// Pushes the value x of type t, in a local of its own.
	private push(x: u64, t: i32) {
		const n = this.norm(t)
		this.stack.push({ l: this.spill(x, this.val(n)), t: n })
	}

	private pop(): V { return this.stack.pop() }
	private cond(): u64 { return this.cast(this.pop(), kind.Bool) }

	/// The n values on top of the stack.
	private popN(n: i32): V[] {
		const at = this.stack.length - n
		const vs = this.stack.slice(at, this.stack.length)
		this.stack = this.stack.slice(0, at)
		return vs
	}

	private get(v: V): u64 { return BinaryenLocalGet(this.m, v.l as u32, this.types[v.l]) }

	/// A new local of type t.
	private temp(t: u64): i32 {
		this.types.push(t)
		return this.types.length - 1
	}

	/// x, of type t, in a new local.
	private spill(x: u64, t: u64): i32 {
		const l = this.temp(t)
		this.emit(BinaryenLocalSet(this.m, l as u32, x))
		return l
	}

	private emit(x: u64) { this.out.push(x) }
	private block(xs: u64[]): u64 { return BinaryenBlock(this.m, 0, xs, xs.length as u32, this.none) }

	private labeled(label: string, xs: u64[]): u64 {
		return BinaryenBlock(this.m, label, xs, xs.length as u32, this.none)
	}

	/// The code f emits, as a block.
	private nested(f: () => void): u64 {
		const out = this.out
		this.out = []
		f()
		const r = this.block(this.out)
		this.out = out
		return r
	}

	/// The value of local n of the code.
	private load(n: i32): u64 {
		const at = BinaryenLocalGet(this.m, this.locals[n] as u32, this.types[this.locals[n]])
		return if (this.cells[n]) BinaryenStructGet(this.m, 0, at, this.val(this.bare(this.code.locals[n].type)), false)
			else at
	}

	/// Stores v in local n of the code.
	private setLocal(n: i32, v: V) {
		if (this.locals[n] < 0) {
			return
		}
		const x = this.put(v, this.bare(this.code.locals[n].type))
		const at = this.locals[n]
		this.emit(if (this.cells[n]) BinaryenStructSet(this.m, 0, BinaryenLocalGet(this.m, at as u32, this.types[at]),
			x)
			else BinaryenLocalSet(this.m, at as u32, x))
	}

	private increment(v: V): u64 {
		return BinaryenLocalSet(this.m, v.l as u32,
			BinaryenBinary(this.m, BinaryenAddInt32(), this.get(v), this.i32c(1)))
	}

	/// v as a place of type t holds it: cast, and a T[n] copied, as it is a value.
	private put(v: V, t: i32): u64 {
		const x = this.cast(v, t)
		const n = this.bare(t)
		return if (this.p.kind(n) == kind.FixedArray) this.copied(x, n) else x
	}

	/// A copy of x, a T[n] of type n, as deep as its elements are T[n]s too.
	private copied(x: u64, n: i32): u64 {
		const e = this.norm(this.p.a(n))
		const len = () => this.i32c(this.p.b(n))
		const from: V = { l: this.spill(x, this.val(n)), t: n }
		const to: V = { l: this.spill(BinaryenArrayNew(this.m, this.heap(n), len(), 0), this.val(n)), t: n }
		if (this.p.kind(e) != kind.FixedArray) {
			this.emit(BinaryenArrayCopy(this.m, this.get(to), this.i32c(0), this.get(from), this.i32c(0), len()))
		} else {
			const at: V = { l: this.spill(this.i32c(0), this.i32), t: kind.I32 }
			this.forEach(from, y => {
				this.emit(BinaryenArraySet(this.m, this.get(to), this.get(at), this.copied(this.get(y), e)))
				this.emit(this.increment(at))
			})
		}
		return this.get(to)
	}

	/// Pushes field name of held: a length, a method bound to it, or the value of a field.
	private field(held: V, name: i32) {
		const p = this.p
		const t = held.t
		const k = p.kind(t)
		const d = if (k == kind.Named) p.member(p.a(t), name) else -1
		if (p.strings[name] == "length" && (k == kind.String || k == kind.Array || k == kind.FixedArray)) {
			this.push(this.length(held), kind.I32)
		} else if (p.strings[name] == "length" && k == kind.Tuple) {
			this.push(this.i32c(p.items(t).length), kind.I32)
		} else if (d >= 0 && p.decls[d].kind == decl.Function) {
			this.push(this.bound(d, held), p.decls[d].type)
		} else {
			const at = this.place(held, name)
			this.push(this.read(at), at.s.t)
		}
	}

	private setField(obj: V, name: i32, v: V) {
		const at = this.place(obj, name)
		if (at.s.embed) {
			const t = this.norm(at.s.t)
			this.copy(v, { l: this.spill(this.read(at), this.val(t)), t: t })
		} else {
			this.emit(BinaryenStructSet(this.m, at.k as u32, this.get(at.v), this.put(v, at.s.t)))
		}
	}

	/// The field of a class instance, object or tuple of the name, a Str, also of one an embedded field holds.
	private place(obj: V, name: i32): Place {
		const r = this.find(obj, name)
		if (r == null) {
			throw new CompileError(`wasm: no field ${this.p.strings[name]} in ${showType(this.p, obj.t)}`)
		}
		return r!
	}

	private find(obj: V, name: i32): Place | null {
		const slots = this.layout(obj.t)
		for (const i of 0 ... slots.length - 1) {
			if (slots[i].name == name) {
				return { v: obj, k: i, s: slots[i] }
			}
		}
		for (const i of 0 ... slots.length - 1) {
			if (slots[i].embed) {
				const r = this.find(this.embedded(obj, i, slots[i]), name)
				if (r != null) {
					return r
				}
			}
		}
		return null
	}

	/// The struct embedded field k, s, of obj holds.
	private embedded(obj: V, k: i32, s: Slot): V {
		const t = this.norm(s.t)
		return { l: this.spill(this.read({ v: obj, k: k, s: s }), this.val(t)), t: t }
	}

	/// The value of field at.
	private read(at: Place): u64 {
		return BinaryenStructGet(this.m, at.k as u32, this.get(at.v), this.storage(at.s.t)[0], this.signed(at.s.t))
	}

	/// Whether a field or element of type t is read sign-extended.
	private signed(t: i32): bool { return this.kindOf(t) == kind.I8 || this.kindOf(t) == kind.I16 }

	/// obj as an instance of class decl c: obj, or a field embedded in it; null if neither.
	private upcast(obj: V, c: i32): V | null {
		if (this.p.kind(obj.t) != kind.Named) {
			return null
		} else if (this.p.a(obj.t) == c) {
			return obj
		}
		const slots = this.layout(obj.t)
		for (const i of 0 ... slots.length - 1) {
			if (slots[i].embed) {
				const r = this.upcast(this.embedded(obj, i, slots[i]), c)
				if (r != null) {
					return r
				}
			}
		}
		return null
	}

	/// Copies the fields of src, an object, instance or a union of them, to those of the name of dst.
	private copy(src: V, dst: V) {
		const p = this.p
		if (p.kind(src.t) == kind.Union) {
			for (const m of p.members(src.t).filter(m => [kind.Named, kind.Object, kind.Tuple].includes(p.kind(m)))) {
				this.emit(BinaryenIf(this.m, this.is(src, m),
					this.nested(() => this.copy({ l: this.spill(this.unbits(src, m), this.val(m)), t: m }, dst)), 0))
			}
			return
		}
		for (const s of this.layout(dst.t)) {
			const from = this.find(src, s.name)
			if (from != null) {
				const t = this.norm(from!.s.t)
				this.setField(dst, s.name, { l: this.spill(this.read(from!), this.val(t)), t: t })
			}
		}
	}

	/// Element k of an array, fixed array or string; traps out of range.
	private element(arr: V, k: V): u64 { return this.at(arr, this.index(arr, k)) }

	/// Element at, an i32 in range, of arr.
	private at(arr: V, at: u64): u64 {
		const e = this.elementType(arr.t)
		return BinaryenArrayGet(this.m, this.data(arr), at, this.storage(e)[0], this.signed(e))
	}

	/// Index k into arr, checked.
	private index(arr: V, k: V): u64 {
		if (this.val(k.t) == this.i64) {
			const len = BinaryenUnary(this.m, BinaryenExtendUInt32(), this.length(arr))
			this.check(BinaryenBinary(this.m, BinaryenLtUInt64(), this.get(k), len), "index out of range")
			return BinaryenUnary(this.m, BinaryenWrapInt64(), this.get(k))
		}
		this.check(BinaryenBinary(this.m, BinaryenLtUInt32(), this.get(k), this.length(arr)), "index out of range")
		return this.get(k)
	}

	private length(arr: V): u64 {
		return if (this.p.kind(arr.t) == kind.FixedArray) this.i32c(this.p.b(arr.t))
			else BinaryenStructGet(this.m, 0, this.get(arr), this.i32, false)
	}

	/// The array of the elements of arr.
	private data(arr: V): u64 {
		return switch (this.p.kind(arr.t)) {
			case kind.String: this.bytes(this.get(arr))
			case kind.Array: BinaryenStructGet(this.m, 1, this.get(arr), this.ref(this.dataHeap(this.p.a(arr.t))),
				false)
			default: this.get(arr)
		}
	}

	private elementType(t: i32): i32 { return if (this.p.kind(t) == kind.String) kind.U8 else this.p.a(t) }

	/// A new T[] of n elements of type e, refs null, not their zero, as its caller sets each (builtin/array.bob's).
	private newArray(e: i32, n: u64): u64 {
		const at = this.spill(n, this.i32)
		const len = () => BinaryenLocalGet(this.m, at as u32, this.i32)
		return BinaryenStructNew(this.m, [len(), this.newData(e, len())], 2, this.arrHeap(e))
	}

	private newData(e: i32, n: u64): u64 { return BinaryenArrayNew(this.m, this.dataHeap(e), n, 0) }

	/// An array, tuple, fixed array or object of type t of the values; a spread's elements appended, or its fields copied.
	private array(t: i32, vs: V[], spreads: i32[]) {
		const p = this.p
		const n = this.norm(t)
		const k = p.kind(n)
		if (k == kind.Array) {
			const e = p.a(n)
			let len = this.i32c(vs.length - spreads.length)
			for (const s of spreads) {
				len = BinaryenBinary(this.m, BinaryenAddInt32(), len, this.length(vs[s]))
			}
			const r: V = { l: this.spill(this.newArray(e, len), this.val(n)), t: n }
			const j: V = { l: this.spill(this.i32c(0), this.i32), t: kind.I32 }
			const set = (v: V) => {
				this.emit(BinaryenArraySet(this.m, this.data(r), this.get(j), this.put(v, e)))
				this.emit(this.increment(j))
			}
			for (const i of 0 ... vs.length - 1) {
				if (spreads.includes(i)) {
					this.forEach(vs[i], set)
				} else {
					set(vs[i])
				}
			}
			this.stack.push(r)
		} else if (k == kind.FixedArray && spreads.length == 0) {
			const xs = vs.map(v => this.put(v, p.a(n)))
			this.push(BinaryenArrayNewFixed(this.m, this.heap(n), xs, xs.length as u32), n)
		} else {
			const slots = this.layout(n)
			const r: V = { l: this.spill(BinaryenStructNew(this.m, 0, 0, this.heap(n)), this.val(n)), t: n }
			let f = 0
			for (const i of 0 ... vs.length - 1) {
				if (spreads.includes(i)) {
					this.copy(vs[i], r)
				} else {
					this.emit(BinaryenStructSet(this.m, f as u32, this.get(r), this.put(vs[i], slots[f].t)))
					f++
				}
			}
			this.stack.push(r)
		}
	}

	/// Runs f on each element of xs, an array, fixed array, string or tuple.
	private forEach(xs: V, f: (x: V) => void) {
		const p = this.p
		if (p.kind(xs.t) == kind.Tuple) {
			for (const i of 0 ... p.items(xs.t).length - 1) {
				this.field(xs, p.elementName(i))
				f(this.pop())
			}
			return
		}
		const at: V = { l: this.spill(this.i32c(0), this.i32), t: kind.I32 }
		const exit = this.label()
		const head = this.label()
		const e = this.elementType(xs.t)
		const body = this.nested(() => {
			this.emit(BinaryenBreak(this.m, exit,
				BinaryenBinary(this.m, BinaryenGeUInt32(), this.get(at), this.length(xs)), 0))
			f({ l: this.spill(this.at(xs, this.get(at)), this.val(e)), t: this.norm(e) })
			this.emit(this.increment(at))
			this.emit(BinaryenBreak(this.m, head, 0, 0))
		})
		this.emit(this.labeled(exit, [BinaryenLoop(this.m, head, body)]))
	}

	/// New: a class instance, initialized, then its constructor called, a param left out its zero (5.3).
	private make(t: i32) {
		const p = this.p
		const n = this.norm(t)
		if (p.kind(n) != kind.Named) {
			throw new CompileError(`wasm: new ${showType(p, n)}`)
		}
		const ctor = p.member(p.a(n), p.intern("constructor"))
		const r = this.instance(n, this.popN(if (ctor >= 0) p.items(p.decls[ctor].type).length else 0))
		this.stack.push(r)
	}

	/// A new instance of class type n, initialized, then constructed of args xs, those left out Missing.
	private instance(n: i32, xs: V[]): V {
		const p = this.p
		const r: V = { l: this.spill(BinaryenStructNew(this.m, 0, 0, this.heap(n)), this.val(n)), t: n }
		this.emit(BinaryenCall(this.m, this.initName(p.a(n)), [this.get(r)], 1, this.none))
		const ctor = p.member(p.a(n), p.intern("constructor"))
		if (ctor >= 0) {
			const ps = p.items(p.decls[ctor].type)
			const args = [this.get(r), ...this.args(xs, ps)]
			this.emit(BinaryenCall(this.m, this.fn(ctor), args, args.length as u32, this.none))
		}
		return r
	}

	/// v converted to t: Cast's conversions, and the implicit ones into a union.
	private cast(v: V, to: i32): u64 {
		const p = this.p
		const f = v.t
		const t = this.bare(to)
		const fk = p.kind(f)
		const tk = p.kind(t)
		if (f == t) {
			return this.get(v)
		} else if (tk == kind.Union && isNumber(fk) && (kind.untyped(fk) || !this.holds(t, f))) {
			// As the union's number member it converts to, else an untyped constant as an i64 or f64.
			const m = p.numberIn(t, fk)
			const u = if (m != t) m else if (kind.isFloat(fk)) kind.F64 else if (kind.untyped(fk)) kind.I64 else f
			return this.box({ l: this.spill(this.cast(v, u), this.val(u)), t: u }, t)
		} else if (tk == kind.Union && fk == kind.Union) {
			return this.rebox(v, t)
		} else if (tk == kind.Union) {
			return this.box(v, t)
		} else if (fk == kind.Union) {
			this.check(this.isa(v, t), "cast to a type that is not the value's")
			return this.unbits(v, t)
		} else if (fk == kind.Func && tk == kind.Func) {
			return this.adapt(v, t)
		} else if (isNumber(fk) && isNumber(tk)) {
			return this.convert(this.get(v), fk, tk)
		} else if (fk == kind.Null && this.isRef(this.val(t))) {
			return this.nullOf(this.val(t))
		} else if (this.isRef(this.val(t)) && this.val(f) != this.val(t)) {
			// Of another class, as after an instanceof that cannot hold.
			this.check(this.isa(v, t), "cast to a type that is not the value's")
			return this.nullOf(this.val(t))
		}
		return this.get(v)
	}

	/// Union v as union t, which has each member of v's but numbers, which widen (§4.1); checked if it lacks one. Held
	/// alike and none widening, it is as it was, else made anew of the member it holds.
	private rebox(v: V, t: i32): u64 {
		const p = this.p
		const from = if (v.t == this.any) p.members(t) else p.members(v.t)
		const lacking = from.filter(m => !this.holds(t, m))
		const widened = lacking.filter(m => p.members(t).some(x => kind.widens(m, x)))
		if (lacking.length > widened.length) {
			const ok = BinaryenBinary(this.m, BinaryenOrInt32(), this.isa(v, t), this.isIn(v, widened))
			this.check(ok, "cast to a type that is not the value's")
		}
		const vt = this.val(t)
		const alike = this.boxed(v.t) == this.boxed(t)
		if (alike && widened.length == 0) {
			return this.recast(v, vt)
		}
		const r = if (alike) this.spill(this.get(v), vt) else this.temp(vt)
		for (const m of if (alike) widened else from.filter(m => this.holds(t, m) || widened.includes(m))) {
			const set = this.nested(() => {
				const x: V = { l: this.spill(this.unbits(v, m), this.val(m)), t: m }
				this.emit(BinaryenLocalSet(this.m, r as u32, this.cast(x, t)))
			})
			this.emit(BinaryenIf(this.m, this.is(v, m), set, 0))
		}
		return BinaryenLocalGet(this.m, r as u32, vt)
	}

	/// v, of no union type, as union t holds it: boxed, its type's id, a number's bits, else its ref; or null as a null
	/// ref and a ref as itself.
	private box(v: V, t: i32): u64 {
		const k = this.p.kind(v.t)
		const vt = this.val(v.t)
		if (!this.boxed(t)) {
			return if (k == kind.Null) this.nullOf(this.val(t)) else this.put(v, v.t)
		} else if (k == kind.Null) {
			return BinaryenGlobalGet(this.m, "null", this.boxType())
		}
		let bits = this.i64c(0)
		let ref = this.nullRef()
		if (vt == this.f32) {
			bits = BinaryenUnary(this.m, BinaryenExtendUInt32(),
				BinaryenUnary(this.m, BinaryenReinterpretFloat32(), this.get(v)))
		} else if (vt == this.f64) {
			bits = BinaryenUnary(this.m, BinaryenReinterpretFloat64(), this.get(v))
		} else if (vt == this.i32) {
			bits = BinaryenUnary(this.m, if (kind.isSigned(k)) BinaryenExtendSInt32() else BinaryenExtendUInt32(),
				this.get(v))
		} else if (vt == this.i64) {
			bits = this.get(v)
		} else {
			ref = this.put(v, v.t)
		}
		return BinaryenStructNew(this.m, [this.i32c(v.t), bits, ref], 3, this.boxHeap())
	}

	/// The value of type t union v holds.
	private unbits(v: V, t: i32): u64 {
		const n = this.norm(t)
		const vt = this.val(n)
		if (this.p.kind(n) == kind.Null) {
			return this.i32c(0)
		} else if (!this.boxed(v.t)) {
			return this.recast(v, vt)
		}
		const bits = BinaryenStructGet(this.m, 1, this.get(v), this.i64, false)
		return if (vt == this.f32) BinaryenUnary(this.m, BinaryenReinterpretInt32(),
			BinaryenUnary(this.m, BinaryenWrapInt64(), bits))
			else if (vt == this.f64) BinaryenUnary(this.m, BinaryenReinterpretInt64(), bits)
			else if (vt == this.i32) BinaryenUnary(this.m, BinaryenWrapInt64(), bits)
			else if (vt == this.i64) bits
			else BinaryenRefCast(this.m, BinaryenStructGet(this.m, 2, this.get(v), this.eqref, false), vt)
	}

	/// Whether union v holds a value of its member type m: by its tag if boxed, else null by a null ref, a ref by its
	/// type.
	private is(v: V, m: i32): u64 {
		return if (this.boxed(v.t)) BinaryenBinary(this.m, BinaryenEqInt32(), this.tagOf(v), this.i32c(m))
			else if (m == kind.Null) BinaryenRefIsNull(this.m, this.get(v))
			else BinaryenRefTest(this.m, this.get(v), BinaryenTypeFromHeapType(this.heap(m), false))
	}

	/// v, a ref, as one of type vt.
	private recast(v: V, vt: u64): u64 {
		return if (this.val(v.t) == vt) this.get(v) else BinaryenRefCast(this.m, this.get(v), vt)
	}

	private tagOf(v: V): u64 { return BinaryenStructGet(this.m, 0, this.get(v), this.i32, false) }
	/// Whether union u holds a value of type t: has it as a member, or is the union of any type.
	private holds(u: i32, t: i32): bool { return u == this.any || this.p.members(u).includes(this.norm(t)) }

	/// Whether v's type, the type of its value if a union, fits t.
	private isa(v: V, t: i32): u64 {
		const n = this.norm(t)
		if (n == this.any) {
			return this.i32c(1)
		} else if (this.p.kind(v.t) != kind.Union) {
			return this.i32c(if (this.p.members(n).includes(v.t)) 1 else 0)
		}
		return this.isIn(v, this.p.members(n))
	}

	/// Whether union v holds a value of one of the types.
	private isIn(v: V, ts: i32[]): u64 {
		let r = this.i32c(0)
		for (const t of ts.filter(t => this.holds(v.t, t))) {
			r = BinaryenBinary(this.m, BinaryenOrInt32(), r, this.is(v, t))
		}
		return r
	}

	/// Number x of kind fk as one of kind tk: a float to an integer saturated, an integer wrapped.
	private convert(x: u64, fk: i32, tk: i32): u64 {
		const fv = this.val(fk)
		const tv = this.val(tk)
		const s = kind.isSigned(fk)
		if (tk == kind.Bool) {
			return this.binary(op.Ne, fv, false, x, this.zeroOf(fv))
		} else if (kind.isFloat(fk) && kind.isFloat(tk)) {
			return if (fv == tv) x
				else BinaryenUnary(this.m, if (tv == this.f64) BinaryenPromoteFloat32() else BinaryenDemoteFloat64(), x)
		} else if (kind.isFloat(tk)) {
			const at: i32 = (if (fv == this.i64) 1 else 0) + (if (tv == this.f64) 2 else 0)
			const u = switch (at) {
				case 0: if (s) BinaryenConvertSInt32ToFloat32() else BinaryenConvertUInt32ToFloat32()
				case 1: if (s) BinaryenConvertSInt64ToFloat32() else BinaryenConvertUInt64ToFloat32()
				case 2: if (s) BinaryenConvertSInt32ToFloat64() else BinaryenConvertUInt32ToFloat64()
				default: if (s) BinaryenConvertSInt64ToFloat64() else BinaryenConvertUInt64ToFloat64()
			}
			return BinaryenUnary(this.m, u, x)
		} else if (kind.isFloat(fk) && kind.width(tk) < 32) {
			// Clamped to tk's range, as a 32-bit conversion saturates to its own.
			const w: i64 = kind.width(tk)
			const one: i64 = 1
			const lo = if (kind.isSigned(tk)) -(one << (w - 1)) else 0
			const hi = if (kind.isSigned(tk)) (one << (w - 1)) - 1 else (one << w) - 1
			const f = if (fv == this.f32) BinaryenUnary(this.m, BinaryenPromoteFloat32(), x) else x
			const clamped = BinaryenBinary(this.m, BinaryenMinFloat64(),
				BinaryenBinary(this.m, BinaryenMaxFloat64(), f, this.f64c(lo as f64)), this.f64c(hi as f64))
			return this.normal(BinaryenUnary(this.m, BinaryenTruncSatSFloat64ToInt32(), clamped), tk)
		} else if (kind.isFloat(fk)) {
			const ts = kind.isSigned(tk)
			const at: i32 = (if (fv == this.f64) 1 else 0) + (if (tv == this.i64) 2 else 0)
			const u = switch (at) {
				case 0: if (ts) BinaryenTruncSatSFloat32ToInt32() else BinaryenTruncSatUFloat32ToInt32()
				case 1: if (ts) BinaryenTruncSatSFloat64ToInt32() else BinaryenTruncSatUFloat64ToInt32()
				case 2: if (ts) BinaryenTruncSatSFloat32ToInt64() else BinaryenTruncSatUFloat32ToInt64()
				default: if (ts) BinaryenTruncSatSFloat64ToInt64() else BinaryenTruncSatUFloat64ToInt64()
			}
			return BinaryenUnary(this.m, u, x)
		} else if (fv == this.i64 && tv == this.i32) {
			return this.normal(BinaryenUnary(this.m, BinaryenWrapInt64(), x), tk)
		} else if (fv == this.i32 && tv == this.i64) {
			return BinaryenUnary(this.m, if (s) BinaryenExtendSInt32() else BinaryenExtendUInt32(), x)
		}
		return if (tv == this.i32) this.normal(x, tk) else x
	}

	/// An i32 x as an integer of kind k holds it: a narrow one's bits above its width its sign's.
	private normal(x: u64, k: i32): u64 {
		return switch (k) {
			case kind.I8: BinaryenUnary(this.m, BinaryenExtendS8Int32(), x)
			case kind.I16: BinaryenUnary(this.m, BinaryenExtendS16Int32(), x)
			case kind.U8: BinaryenBinary(this.m, BinaryenAndInt32(), x, this.i32c(0xff))
			case kind.U16: BinaryenBinary(this.m, BinaryenAndInt32(), x, this.i32c(0xffff))
			default: x
		}
	}

	private compare(o: Opcode) {
		const p = this.p
		const b = this.pop()
		const a = this.pop()
		// A union if either is.
		const t = if (p.kind(b.t) == kind.Union && p.kind(a.t) != kind.Union) b.t else a.t
		const k = p.kind(t)
		const vt = this.val(t)
		const x: V = { l: this.spill(this.cast(a, t), vt), t: t }
		const y: V = { l: this.spill(this.cast(b, t), vt), t: t }
		let r: u64 = 0
		if (k == kind.Null) {
			r = this.i32c(if (o == op.Ne) 0 else 1)
		} else if (k == kind.String && o != op.Eq && o != op.Ne) {
			r = this.binary(o, this.i32, true, this.lang("strCompare", [this.get(x), this.get(y)]), this.i32c(0))
		} else if (k == kind.String || k == kind.Union || this.isRef(vt)) {
			r = if (k == kind.String) this.lang("strEq", [this.get(x), this.get(y)])
				else if (k == kind.Union) this.unionEq(x, y)
				else BinaryenRefEq(this.m, this.get(x), this.get(y))
			if (o == op.Ne) {
				r = BinaryenUnary(this.m, BinaryenEqZInt32(), r)
			}
		} else {
			r = this.binary(o, vt, kind.isSigned(k), this.get(x), this.get(y))
		}
		this.push(r, kind.Bool)
	}

	/// Whether unions x and y hold one value: of one type, and one string or float by value, else the same bits and
	/// ref, or the same ref.
	private unionEq(x: V, y: V): u64 {
		const and = (a: u64, b: u64) => BinaryenBinary(this.m, BinaryenAndInt32(), a, b)
		const bits = (v: V) => BinaryenStructGet(this.m, 1, this.get(v), this.i64, false)
		const ref = (v: V) => BinaryenStructGet(this.m, 2, this.get(v), this.eqref, false)
		const r = this.spill(if (!this.boxed(x.t)) BinaryenRefEq(this.m, this.get(x), this.get(y))
			else and(BinaryenBinary(this.m, BinaryenEqInt32(), this.tagOf(x), this.tagOf(y)),
			and(BinaryenBinary(this.m, BinaryenEqInt64(), bits(x), bits(y)), BinaryenRefEq(this.m, ref(x), ref(y)))),
			this.i32)
		for (const t of [kind.F32, kind.F64, kind.String]) {
			if (this.holds(x.t, t)) {
				const eq = if (t == kind.String) this.lang("strEq", [this.unbits(x, t), this.unbits(y, t)])
					else this.binary(op.Eq, this.val(t), false, this.unbits(x, t), this.unbits(y, t))
				this.emit(BinaryenIf(this.m, and(this.is(x, t), this.is(y, t)), BinaryenLocalSet(this.m, r as u32, eq),
					0))
			}
		}
		return BinaryenLocalGet(this.m, r as u32, this.i32)
	}

	/// An arithmetic or bitwise op: a string's concat, a float's remainder and power the host's, an integer's wrapped,
	/// its shift count masked, its division by 0 a trap.
	private arith(o: Opcode) {
		const b = this.pop()
		const a = this.pop()
		const t = a.t
		const k = this.p.kind(t)
		const vt = this.val(t)
		const s = kind.isSigned(k)
		const x: V = { l: this.spill(this.cast(a, t), vt), t: t }
		const y: V = { l: this.spill(this.cast(b, t), vt), t: t }
		const int = (n: i32) => if (vt == this.i64) this.i64c(n as i64) else this.i32c(n)
		let r: u64 = 0
		if (k == kind.String) {
			r = this.lang("concat", [this.get(x), this.get(y)])
		} else if (kind.isFloat(k) && (o == op.Rem || o == op.Pow)) {
			const wide = (v: V) => if (vt == this.f32) BinaryenUnary(this.m, BinaryenPromoteFloat32(), this.get(v))
				else this.get(v)
			r = this.host(if (o == op.Rem) "fmod" else "pow", [wide(x), wide(y)], [this.f64, this.f64], this.f64)
			if (vt == this.f32) {
				r = BinaryenUnary(this.m, BinaryenDemoteFloat64(), r)
			}
		} else if (kind.isFloat(k) || o == op.Add || o == op.Sub || o == op.Mul || o == op.And || o == op.Or
			|| o == op.Xor) {
			r = this.binary(o, vt, s, this.get(x), this.get(y))
		} else if (o == op.Shl || o == op.Shr) {
			r = this.binary(o, vt, s, this.get(x), this.binary(op.And, vt, false, this.get(y), int(kind.width(k) - 1)))
		} else {
			this.check(this.binary(op.Ne, vt, false, this.get(y), int(0)), "division by zero")
			if (s) {
				// x / -1 is -x, wrapped, and x % -1 is 0, where wasm's would trap.
				const minus = () => this.binary(op.Eq, vt, false, this.get(y), int(-1))
				const q = this.binary(o, vt, s, this.get(x), BinaryenSelect(this.m, minus(), int(1), this.get(y)))
				const neg = if (o == op.Div) this.binary(op.Sub, vt, false, int(0), this.get(x)) else int(0)
				r = BinaryenSelect(this.m, minus(), neg, q)
			} else {
				r = this.binary(o, vt, s, this.get(x), this.get(y))
			}
		}
		this.push(if (vt == this.i32) this.normal(r, k) else r, t)
	}

	/// x o y, of wasm type vt, signed if s.
	private binary(o: Opcode, vt: u64, s: bool, x: u64, y: u64): u64 {
		return BinaryenBinary(this.m, this.binOp(o, vt, s), x, y)
	}

	private binOp(o: Opcode, vt: u64, s: bool): i32 {
		if (vt == this.i32) {
			return switch (o) {
				case op.Add: BinaryenAddInt32()
				case op.Sub: BinaryenSubInt32()
				case op.Mul: BinaryenMulInt32()
				case op.Div: if (s) BinaryenDivSInt32() else BinaryenDivUInt32()
				case op.Rem: if (s) BinaryenRemSInt32() else BinaryenRemUInt32()
				case op.And: BinaryenAndInt32()
				case op.Or: BinaryenOrInt32()
				case op.Xor: BinaryenXorInt32()
				case op.Shl: BinaryenShlInt32()
				case op.Shr: if (s) BinaryenShrSInt32() else BinaryenShrUInt32()
				case op.Eq: BinaryenEqInt32()
				case op.Ne: BinaryenNeInt32()
				case op.Lt: if (s) BinaryenLtSInt32() else BinaryenLtUInt32()
				case op.Gt: if (s) BinaryenGtSInt32() else BinaryenGtUInt32()
				case op.Le: if (s) BinaryenLeSInt32() else BinaryenLeUInt32()
				default: if (s) BinaryenGeSInt32() else BinaryenGeUInt32()
			}
		} else if (vt == this.i64) {
			return switch (o) {
				case op.Add: BinaryenAddInt64()
				case op.Sub: BinaryenSubInt64()
				case op.Mul: BinaryenMulInt64()
				case op.Div: if (s) BinaryenDivSInt64() else BinaryenDivUInt64()
				case op.Rem: if (s) BinaryenRemSInt64() else BinaryenRemUInt64()
				case op.And: BinaryenAndInt64()
				case op.Or: BinaryenOrInt64()
				case op.Xor: BinaryenXorInt64()
				case op.Shl: BinaryenShlInt64()
				case op.Shr: if (s) BinaryenShrSInt64() else BinaryenShrUInt64()
				case op.Eq: BinaryenEqInt64()
				case op.Ne: BinaryenNeInt64()
				case op.Lt: if (s) BinaryenLtSInt64() else BinaryenLtUInt64()
				case op.Gt: if (s) BinaryenGtSInt64() else BinaryenGtUInt64()
				case op.Le: if (s) BinaryenLeSInt64() else BinaryenLeUInt64()
				default: if (s) BinaryenGeSInt64() else BinaryenGeUInt64()
			}
		} else if (vt == this.f32) {
			return switch (o) {
				case op.Add: BinaryenAddFloat32()
				case op.Sub: BinaryenSubFloat32()
				case op.Mul: BinaryenMulFloat32()
				case op.Div: BinaryenDivFloat32()
				case op.Eq: BinaryenEqFloat32()
				case op.Ne: BinaryenNeFloat32()
				case op.Lt: BinaryenLtFloat32()
				case op.Gt: BinaryenGtFloat32()
				case op.Le: BinaryenLeFloat32()
				default: BinaryenGeFloat32()
			}
		}
		return switch (o) {
			case op.Add: BinaryenAddFloat64()
			case op.Sub: BinaryenSubFloat64()
			case op.Mul: BinaryenMulFloat64()
			case op.Div: BinaryenDivFloat64()
			case op.Eq: BinaryenEqFloat64()
			case op.Ne: BinaryenNeFloat64()
			case op.Lt: BinaryenLtFloat64()
			case op.Gt: BinaryenGtFloat64()
			case op.Le: BinaryenLeFloat64()
			default: BinaryenGeFloat64()
		}
	}

	// Traps.
	/// Traps with what unless cond.
	private check(cond: u64, what: string) {
		this.emit(BinaryenIf(this.m, BinaryenUnary(this.m, BinaryenEqZInt32(), cond),
			this.trapCall(this.str(what), true), 0))
	}

	private trap(what: string) {
		this.emit(this.trapCall(this.str(what), true))
		this.dead = true
	}

	/// A trap with the string what, at the op being translated if site, as src/rt.c's bober_trap.
	private trapCall(what: u64, site: bool): u64 {
		const s = this.strType()
		const path = if (site) this.str(this.path) else this.nullOf(s)
		const at = this.host("trap", [what, path, this.i32c(if (site) this.pos else -1)], [s, s, this.i32], this.none)
		return this.block([at, BinaryenUnreachable(this.m)])
	}

	// Types.
	/// t with what is held as another type as that: a literal type as its base, a rest param's and an Embed's as theirs.
	private norm(t: i32): i32 {
		const have = this.norms.get(t)
		if (have != null) {
			return have!
		}
		const k = this.p.kind(t)
		const r = if (k == kind.Literal || k == kind.Rest || k == kind.Embed) this.norm(this.p.a(t))
			else if (k == kind.Named) t
			else this.p.map(t, x => this.norm(x))
		this.norms.set(t, r)
		return r
	}

	/// t, normalized, an optional param's as what it holds.
	private bare(t: i32): i32 {
		const n = this.norm(t)
		return if (this.p.kind(n) == kind.Optional) this.norm(this.p.a(n)) else n
	}

	private kindOf(t: i32): kind.Kind { return this.p.kind(this.norm(t)) }

	/// The type of a value of t: a ref to its heap type, a box, or of a union held as a ref, its one member but null's
	/// type, else an eqref.
	private val(t: i32): u64 {
		const p = this.p
		const n = this.bare(t)
		if (p.kind(n) == kind.Union) {
			const refs = p.members(n).filter(m => m != kind.Null)
			return if (this.boxed(n)) this.boxType() else if (refs.length == 1) this.val(refs[0]) else this.eqref
		}
		return switch (p.kind(n)) {
			case kind.None: this.none
			case kind.Null, kind.Bool, kind.I8, kind.I16, kind.I32, kind.U8, kind.U16, kind.U32: this.i32
			case kind.I64, kind.U64, kind.Int, kind.Type: this.i64
			case kind.F32: this.f32
			case kind.F64, kind.Float: this.f64
			default: this.ref(this.heap(n))
		}
	}

	/// Whether union u is held as a box: the union of any type, or one of a member neither null nor a ref. Else it is
	/// held as a ref, null as a null one, whose type a cast tells, as no two types are one (build).
	private boxed(u: i32): bool {
		return u == this.any || this.p.members(u).some(m => m != kind.Null && !this.isRef(this.val(m)))
	}

	/// The result type of a function giving a t: none of null.
	private resultType(t: i32): u64 { return if (this.kindOf(t) == kind.Null) this.none else this.val(t) }

	private isRef(t: u64): bool {
		return t != this.i32 && t != this.i64 && t != this.f32 && t != this.f64 && t != this.none
	}

	/// The type and packing of a field or element of type t.
	private storage(t: i32): [u64, u32] {
		const k = this.kindOf(t)
		const vt = this.val(t)
		return if (k == kind.Null || k == kind.Bool || k == kind.I8
			|| k == kind.U8) [this.i32, BinaryenPackedTypeInt8()]
			else if (k == kind.I16 || k == kind.U16) [this.i32, BinaryenPackedTypeInt16()]
			else [vt, BinaryenPackedTypeNotPacked()]
	}

	/// The fields of a class instance, object or tuple of type t.
	private layout(t: i32): Slot[] {
		const have = this.layouts.get(t)
		if (have != null) {
			return have!
		}
		const p = this.p
		const k = p.kind(t)
		const slots: Slot[] = []
		if (k == kind.Named) {
			for (const f of p.decls[p.a(t)].members) {
				const d = p.decls[f]
				if (d.kind == decl.Var && (d.mods & decl.Static) == 0) {
					slots.push({ name: d.name, t: p.subst(d.type, p.b(t)), embed: (d.mods & decl.Embed) != 0, decl: f })
				}
			}
		} else if (k == kind.Object || k == kind.Tuple) {
			const ts = p.lists[p.a(t)]
			for (const i of 0 ... ts.length - 1) {
				const object = k == kind.Object
				const mods = if (object) p.names[p.b(t)][2 * i + 1] else 0
				const name = if (object) p.names[p.b(t)][2 * i] else p.elementName(i)
				slots.push({ name: name, t: ts[i], embed: (mods & decl.Embed) != 0, decl: -1 })
			}
		} else {
			throw new CompileError(`wasm: fields of ${showType(p, t)}`)
		}
		this.layouts.set(t, slots)
		return slots
	}

	/// The zero value of t (spec 5.1), a constant.
	private zero(t: i32): u64 {
		const p = this.p
		const n = this.bare(t)
		const k = p.kind(n)
		const vt = this.val(n)
		if (k == kind.String) {
			return this.str("")
		} else if (k == kind.Union) {
			const m = if (this.holds(n, kind.Null)) kind.Null else p.members(n)[0]
			return if (!this.boxed(n)) (if (m == kind.Null) this.nullOf(vt) else this.zero(m))
				else if (m == kind.Null) BinaryenGlobalGet(this.m, "null", this.boxType())
				else BinaryenStructNew(this.m,
				[this.i32c(m), this.i64c(0), if (this.isRef(this.val(m))) this.zero(m) else this.nullRef()], 3,
				this.boxHeap())
		} else if (k == kind.Tuple || k == kind.Object) {
			const xs = this.layout(n).map(s => this.zero(s.t))
			return BinaryenStructNew(this.m, xs, xs.length as u32, this.heap(n))
		} else if (k == kind.FixedArray) {
			const e = p.a(n)
			const ek = this.kindOf(e)
			if (ek == kind.Tuple || ek == kind.Object || ek == kind.FixedArray) {
				const xs: u64[] = []
				for (const _ of 1 ... p.b(n)) {
					xs.push(this.zero(e)) // each its own
				}
				return BinaryenArrayNewFixed(this.m, this.heap(n), xs, xs.length as u32)
			}
			return BinaryenArrayNew(this.m, this.heap(n), this.i32c(p.b(n)),
				if (ek == kind.String || ek == kind.Union) this.zero(e) else 0)
		}
		return if (this.isRef(vt)) this.nullOf(vt) else this.zeroOf(vt)
	}

	private zeroOf(vt: u64): u64 {
		return if (vt == this.i64) this.i64c(0)
			else if (vt == this.f32) this.f32c(0.0)
			else if (vt == this.f64) this.f64c(0.0)
			else this.i32c(0)
	}

	private i32c(x: i32): u64 { return this.constant("i32", c => BinaryenConstSetValueI32(c, x)) }
	private i64c(x: i64): u64 { return this.constant("i64", c => BinaryenConstSetValueI64(c, x)) }
	private f32c(x: f32): u64 { return this.constant("f32", c => BinaryenConstSetValueF32(c, x)) }
	private f64c(x: f64): u64 { return this.constant("f64", c => BinaryenConstSetValueF64(c, x)) }

	/// A copy of global name of consts' zero, set by set.
	private constant(name: string, set: (c: u64) => void): u64 {
		const c = BinaryenExpressionCopy(BinaryenGlobalGetInitExpr(BinaryenGetGlobal(this.consts, name)), this.m)
		set(c)
		return c
	}

	/// A new string of as many zero bytes as local l holds, that ends where they are used.
	private newStr(l: i32): u64 {
		const len = () => BinaryenLocalGet(this.m, l as u32, this.i32)
		return BinaryenStructNew(this.m, [len(), this.newData(kind.U8, len()), this.i32c(1)], 3, this.strHeap())
	}

	/// The bytes of string s, some after its end maybe free (builtin/wasm/string.bob).
	private bytes(s: u64): u64 { return BinaryenStructGet(this.m, 1, s, this.ref(this.dataHeap(kind.U8)), false) }
	private nullRef(): u64 { return this.nullOf(this.eqref) }
	private nullOf(t: u64): u64 { return BinaryenRefNull(this.m, BinaryenTypeGetHeapType(t)) }
	private ref(h: u64): u64 { return BinaryenTypeFromHeapType(h, true) }
	private tuple(ts: u64[]): u64 { return BinaryenTypeCreate(ts, ts.length as u32) }

	/// The global of string literal s.
	private str(s: string): u64 {
		const have = this.strs.get(s)
		const name = have ?? `str#${this.strs.size}`
		if (have == null) {
			const bytes: u64[] = []
			for (const i of 0 ... s.length - 1) {
				bytes.push(this.i32c(s[i] as i32))
			}
			const data = BinaryenArrayNewFixed(this.m, this.dataHeap(kind.U8), bytes, bytes.length as u32)
			BinaryenAddGlobal(this.m, name, this.strType(), false,
				BinaryenStructNew(this.m, [this.i32c(s.length), data, this.i32c(0)], 3, this.strHeap()))
			this.strs.set(s, name)
		}
		return BinaryenGlobalGet(this.m, name, this.strType())
	}

	/// The heap type of a value of t, which build made.
	private heap(t: i32): u64 { return this.built(`${this.bare(t)}`, t) }
	/// The signature of the code of function values of type t: of its env, then its params.
	private codeSig(t: i32): u64 { return this.built(`sig ${this.bare(t)}`, t) }

	private built(key: string, t: i32): u64 {
		const h = this.heaps.get(key)
		if (h == null) {
			throw new CompileError(`wasm: no type of ${showType(this.p, t)}`)
		}
		return h!
	}

	private strHeap(): u64 { return this.heap(kind.String) }
	private strType(): u64 { return this.ref(this.strHeap()) }
	private arrHeap(e: i32): u64 { return this.heap(this.p.type(kind.Array, e)) }
	/// A T[]'s elements are a T[0]'s, as are a string's bytes, which no union holds for a cast to tell apart.
	private dataHeap(e: i32): u64 { return this.heap(this.p.type(kind.FixedArray, e, 0)) }
	private boxHeap(): u64 { return this.structHeap([this.i32, this.i64, this.eqref], false) }
	private boxType(): u64 { return this.ref(this.boxHeap()) }
	private cellHeap(t: u64): u64 { return this.structHeap([t], true) }
	/// The type of a cell of a local of type t.
	private cellType(t: i32): u64 { return this.ref(this.cellHeap(this.val(t))) }
	/// The env of a closure capturing cells of types ts.
	private envHeap(ts: u64[]): u64 { return this.structHeap(ts, false) }

	/// Builds the heap types of the types ts and of those they are made of as one rec group, in which no two are one,
	/// however alike, so that a cast tells any two apart. A function type's is its function values' struct, its code's
	/// signature after it.
	private build(ts: i32[]) throws CompileError {
		const p = this.p
		const b = TypeBuilderCreate(0)
		const made: i32[] = []
		const at: i32[] = []
		while (ts.length > 0) {
			const n = this.bare(ts.pop())
			const k = p.kind(n)
			if (k == kind.Union) {
				ts.append(p.members(n))
			} else if ([kind.String, kind.Array, kind.FixedArray, kind.Tuple, kind.Object, kind.Func,
				kind.Named].includes(k) && !this.heaps.has(`${n}`)) {
				const i = TypeBuilderGetSize(b)
				TypeBuilderGrow(b, if (k == kind.Func) 2 else 1)
				this.heaps.set(`${n}`, TypeBuilderGetTempHeapType(b, i))
				if (k == kind.Func) {
					this.heaps.set(`sig ${n}`, TypeBuilderGetTempHeapType(b, i + 1))
				}
				made.push(n)
				at.push(i as i32)
				ts.append(this.parts(n))
			}
		}
		for (const j of 0 ... made.length - 1) {
			const n = made[j]
			const i = at[j] as u32
			if (p.kind(n) == kind.FixedArray) {
				const s = this.storage(p.a(n))
				TypeBuilderSetArrayType(b, i, s[0], s[1], 1)
			} else if (p.kind(n) == kind.Func) {
				TypeBuilderSetStructType(b, i, [this.ref(this.codeSig(n)), this.eqref], [0, 0], [false, false], 2)
				const ps = [this.eqref, ...this.expand(p.items(n))]
				TypeBuilderSetSignatureType(b, i + 1, TypeBuilderGetTempTupleType(b, ps, ps.length as u32),
					this.resultType(p.b(n)))
			} else {
				const fs = this.parts(n).map(f => this.storage(f))
				TypeBuilderSetStructType(b, i, fs.map(f => f[0]), fs.map(f => f[1]), fs.map(_ => true), fs.length)
			}
		}
		const size = TypeBuilderGetSize(b)
		TypeBuilderCreateRecGroup(b, 0, size)
		const hs = new u64[](size as i32)
		const where: u32[] = [0]
		const why: u32[] = [0]
		if (!TypeBuilderBuildAndDispose(b, hs, where, why)) {
			throw new CompileError(`wasm: types: error ${why[0]} at ${where[0]}`)
		}
		for (const j of 0 ... made.length - 1) {
			this.heaps.set(`${made[j]}`, hs[at[j]])
			if (p.kind(made[j]) == kind.Func) {
				this.heaps.set(`sig ${made[j]}`, hs[at[j] + 1])
			}
		}
	}

	/// What a value of type n, which has a heap type, is made of: a string's length, bytes and whether it ends where
	/// they are used (builtin/wasm/string.bob); a T[]'s length and elements; a fixed array's element; a function's
	/// params and result; else its fields.
	private parts(n: i32): i32[] {
		const p = this.p
		return switch (p.kind(n)) {
			case kind.String: [kind.I32, p.type(kind.FixedArray, kind.U8, 0), kind.Bool]
			case kind.Array: [kind.I32, p.type(kind.FixedArray, p.a(n), 0)]
			case kind.FixedArray, kind.Func: p.parts(n)
			default: this.layout(n).map(s => s.t)
		}
	}

	/// The types the program holds values of: of its decls, their locals and the types their ops name, of what a call
	/// calls, and of the host's closures.
	private roots(): i32[] {
		const p = this.p
		const ts = [kind.String, p.type(kind.Func, p.list([]), kind.Null)]
		for (const m of 0 ... p.modules.length - 1) {
			for (const d of listed(p, m)) {
				const x = p.decls[d]
				// A function's own type is a value's only where a Global or Closure makes one of it, a method's also where
				// a field read binds it.
				if (x.kind == decl.Class) {
					ts.push(p.type(kind.Named, d, 0))
				} else {
					ts.append(if (x.kind == decl.Function && p.classOf(d) < 0) p.parts(x.type) else [x.type])
				}
				const c = x.code
				if (c != null) {
					ts.append(c.locals.map(l => l.type))
					for (const i of 0 ... c.ops.length - 1) {
						const o = c.ops[i]
						for (const j of 0 ... op.shape[o].length - 1) {
							if (op.shape[o][j] == op.TypeId) {
								ts.push(c.imm(i, j))
							} else if (op.shape[o][j] == op.TypeList) {
								ts.append(p.lists[c.imm(i, j)])
							}
						}
						if (o == op.Global || o == op.Closure) {
							ts.push(p.subst(p.decls[c.a(i)].type, c.b(i)))
						} else if (o == op.Call) {
							ts.append(p.parts(p.subst(p.decls[c.a(i)].type, c.b(i))))
						}
					}
				}
			}
		}
		return ts.filter(t => p.closed(t))
	}

	private structHeap(ts: u64[], mutable: bool): u64 {
		return this.heapOf(`struct ${mutable} ${ts.join(",")}`,
			b => TypeBuilderSetStructType(b, 0, ts, ts.map(_ => 0 as u32), ts.map(_ => mutable), ts.length))
	}

	private sigHeap(ps: u64[], r: u64): u64 {
		return this.heapOf(`func ${ps.join(",")} ${r}`, b => TypeBuilderSetSignatureType(b, 0, this.tuple(ps), r))
	}

	/// The heap type key names, made by make the first time.
	private heapOf(key: string, make: (b: u64) => void): u64 {
		const have = this.heaps.get(key)
		if (have != null) {
			return have!
		}
		const b = TypeBuilderCreate(1)
		make(b)
		const hs: u64[] = [0]
		const at: u32[] = [0]
		const why: u32[] = [0]
		if (!TypeBuilderBuildAndDispose(b, hs, at, why)) {
			throw new CompileError(`wasm: type ${key}: error ${why[0]}`)
		}
		this.heaps.set(key, hs[0])
		return hs[0]
	}
}

function isNumber(k: i32): bool { return kind.isInt(k) || kind.isFloat(k) || k == kind.Bool }
