//! bober lift: the Program being made and what the checker and lower know of it, keyed by the checker's symbols and
//! types; and the modules of the bundle, linked into it from their files (src/bc/file.bob) rather than checked and
//! lowered.

import { indexOf } from "../std/algo"
import { HashMap } from "../std/collections/hashmap"
import { Reader, Writer } from "../std/encoding/binary"
import { open } from "../std/fs"
import { join } from "../std/fs/path"
import { fnv } from "../std/hash"
import { executable } from "../std/process"
import { ParseError } from "../std/string"
import * as decl from "./bc/decl"
import { In, abi, head, read, write } from "./bc/file"
import { Program, sourceHash } from "./bc/program"
import { CompileError } from "./error"
import { builtin, root } from "./root"
import { Type } from "./type"

/// lib/std.bobc, the package's bundle (src/root.bob), once read; empty in a repo, which has none, or if malformed. std
/// imports its C headers relative to itself or from the sysroot, so that the package finds a header's module by the
/// path the repo gave it.
let std: HashMap[string, string] | null = null

export class Lift {
	prog = new Program()
	/// Each top-level decl by its checker symbol.
	entries = new HashMap[string, i32]()
	/// Per decl, the checker's type of what it declares.
	types = new HashMap[i32, Type]()
	/// By checker type id: the decl of each class and interface, and the Param of each type param.
	nominals = new HashMap[i32, i32]()
	params = new HashMap[i32, i32]()
	/// The bundle: the file of each module by the path it holds, of source hash 0 and made by this compiler; the
	/// package's, stdBundle, unless set.
	bundle = stdBundle()
	/// The cache: the files a build's kept image holds (src/bober.bob) of modules of their source as it is, made by
	/// this compiler, by the path each holds (cached).
	cache = new HashMap[string, string]()
	/// The headers of the files linked from the cache.
	private served: In[] = []

	/// Adds those of files to the cache that are of their module's source as read gives it and made by this compiler,
	/// but builtin/'s, which every program checks first (src/check.bob), and those of or using a C header's module,
	/// which is bound anew.
	cached(files: string[], read: (path: string) => string | null) throws IoError {
		const compiler = compilerId()
		for (const f of files) {
			try {
				const h = head(f)
				const skip = builtin(h.path) || [h.path, ...h.paths].some(x => indexOf(x, ": ") >= 0)
				const src = if (skip) null else read(h.path)
				if (src != null && h.source == sourceHash(h.path, src!) && h.compiler == compiler) {
					this.cache.set(h.path, f)
				}
			} catch (e: ParseError) {}
		}
	}

	/// The module at path of the bundle, linked with the modules it imports not yet linked; else of the cache, linked
	/// once each module it uses is loaded by load, as the checker checks a module, which says whether it is done; each
	/// top-level decl but a test an entry. -1 if neither has it, or one of those is not done or of another ABI than the
	/// cache's file has. Throws a CompileError if the bundle's, or a module it imports, is missing, stale or malformed.
	module(path: string, load: (path: string) => bool = _ => false): i32 {
		const file = this.cache.get(path)
		if (file == null) {
			return this.bundled(path)
		}
		this.cache.delete(path) // once: one using it while those it uses load checks it
		try {
			const h = head(file!)
			if (h.paths.every(load) && this.prog.module(path) < 0) {
				const ms = read(this.prog, [file!], compilerId(), [h.source])
				if (ms != null) {
					this.served.push(h)
					return this.entered(ms!)
				}
			}
		} catch (e: ParseError | IoError) {}
		return -1
	}

	/// Whether each module linked from the cache holds the ABI hash each module it uses has, now that all are made;
	/// those hashed before, when some a module's signatures reach may not have been, forgotten.
	current(): bool {
		const p = this.prog
		for (const x of p.modules) {
			x.abi = 0
		}
		for (const h of this.served) {
			for (const i of 0 ... h.paths.length - 1) {
				if (abi(p, p.module(h.paths[i])) != h.hashes[i]) {
					return false
				}
			}
		}
		return true
	}

	private bundled(path: string): i32 {
		const file = this.bundle.get(path)
		if (file == null) {
			return -1
		}
		const p = this.prog
		const linked = p.module(path)
		if (linked >= 0) {
			return linked
		}
		const paths = [path]
		const files = [file!]
		try {
			let i = 0
			while (i < files.length) {
				for (const d of head(files[i], root).paths) {
					const f = if (p.module(d) < 0 && !paths.includes(d)) this.bundle.get(d) else null
					if (f != null) {
						paths.push(d)
						files.push(f!)
					}
				}
				i++
			}
			const ms = read(p, files, compilerId(), files.map(_ => 0 as u64), root)
			if (ms != null) {
				return this.entered(ms!)
			}
		} catch (e: ParseError | IoError) {}
		throw new CompileError(`the bundle's ${path}, or a module it imports, is missing, stale or malformed`)
	}

	/// The first of modules ms, each top-level decl of which but a test made an entry.
	private entered(ms: i32[]): i32 {
		const p = this.prog
		for (const m of ms) {
			for (const d of p.modules[m].decls.filter(d => p.decls[d].kind != decl.Test)) {
				this.entries.set(`${p.modules[m].path}:${p.strings[p.decls[d].name]}`, d)
			}
		}
		return ms[0]
	}
}

function stdBundle(): HashMap[string, string] {
	if (std == null) {
		try {
			std = unbundle(readFile(join(root, "lib/std.bobc")) ?? "")
		} catch (e: ParseError) {
			print("bober: lib/std.bobc is malformed")
			std = new HashMap[string, string]()
		}
	}
	return std!
}

/// The bundle of the modules of p, made by the compiler whose hash is compiler, which drops their tests and source
/// hashes first: each one's file, as its length, unsigned LEB128, and its bytes.
export function bundle(p: Program, compiler: u64): string {
	for (const x of p.modules) {
		x.source = 0
		x.decls = x.decls.filter(d => p.decls[d].kind != decl.Test)
	}
	const w = new Writer()
	for (const m of 0 ... p.modules.length - 1) {
		const f = write(p, m, compiler)
		w.uleb(f.length as u64)
		w.raw(f)
	}
	return w.bytes
}

/// The files of bundle s by the path each holds.
export function unbundle(s: string): HashMap[string, string] throws ParseError {
	const files = new HashMap[string, string]()
	const r = new Reader(s)
	while (r.pos < s.length) {
		const f = r.raw(r.uleb() as i32)
		files.set(head(f, root).path, f)
	}
	return files
}

/// The hash of the compiler's ID: Mach-O's UUID, which signing it keeps, else its first page, with ELF's build ID.
export function compilerId(): u64 throws IoError {
	const f = open(executable())
	const page = f.read(4096) ?? ""
	f.close()
	const r = new Reader(page)
	try {
		if (r.fixed(4) == 0xfeedfacf) {
			r.pos = 32 // the load commands, after the header
			while (true) {
				const at = r.pos
				if (r.fixed(4) == 0x1b) { // LC_UUID
					return fnv(page.slice(at + 8, at + 24))
				}
				r.pos = at + (r.fixed(4) as i32)
			}
		}
	} catch (e: ParseError) {}
	return fnv(page)
}
