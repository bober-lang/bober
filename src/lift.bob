//! bober lift: the Program being made and what the checker and lower know of it, keyed by the checker's symbols and
//! types; and the modules of the bundle, linked into it from their files (src/bc/file.bob) rather than checked and
//! lowered.

import { indexOf, startsWith } from "../std/algo"
import { HashMap } from "../std/collections/hashmap"
import { Reader, Writer } from "../std/encoding/binary"
import { open, remove, rename, stat } from "../std/fs"
import { join } from "../std/fs/path"
import { fnv } from "../std/hash"
import { executable, name } from "../std/process"
import { ParseError } from "../std/string"
import * as decl from "./bc/decl"
import { In, head, read, seen, write } from "./bc/file"
import { Program, sourceHash } from "./bc/program"
import { system } from "./c/bind"
import { CompileError } from "./error"
import { root } from "./root"
import { Type } from "./type"
import { getpid } from "unistd.h"

/// The package's bundles (src/root.bob) by name, each once read: std, lib/std.bobc, and wasm, lib/wasm.bobc, the same
/// of builtin/wasm/'s modules where it has one, and js, lib/js.bobc, of builtin/js/'s before those; empty in a repo,
/// which has none, or if malformed. std imports its C headers relative to itself or from the sysroot, so that the
/// package finds a header's module by the path the repo gave it.
let bundles = new HashMap[string, HashMap[string, string]]()

/// The bundle a Lift links: wasm for WebAssembly, js for JavaScript, else std.
export let bundleName = "std"

export class Lift {
	prog = new Program()
	/// Each top-level decl by its checker symbol.
	entries = new HashMap[string, i32]()
	/// Per decl, the checker's type of what it declares.
	types = new HashMap[i32, Type]()
	/// By checker type id: the decl of each class and interface, and the Param of each type param.
	nominals = new HashMap[i32, i32]()
	params = new HashMap[i32, i32]()
	/// The bundle: the file of each module by the path it holds, of source hash 0 and made by this compiler; the
	/// package's, stdBundle, unless set.
	bundle = stdBundle()
	/// The cache: the files a build's kept image holds (src/bober.bob) of modules of their source as it is, made by
	/// this compiler, by the path each holds (cached).
	cache = new HashMap[string, string]()
	/// The headers of the cache's files, by path.
	heads = new HashMap[string, In]()
	/// The headers of the files linked from the cache.
	private served: In[] = []
	/// Whether a file of the cache was malformed, perhaps once prog held part of it, after which the cache is dropped.
	malformed = false

	/// Adds those of files to the cache that are of their module's source as it is, as digest gives the hash of each
	/// file's bytes, made by this compiler.
	cached(files: string[], includes: string[], digest: (path: string) => u64) throws IoError {
		if (files.length == 0) {
			return
		}
		const compiler = compilerId()
		const joined = searched(includes)
		for (const f of files) {
			try {
				const h = head(f)
				const src = hashedSource(h.path, joined, digest)
				if (src != 0 && h.source == src && h.compiler == compiler) {
					this.cache.set(h.path, f)
					this.heads.set(h.path, h)
				}
			} catch (e: ParseError) {}
		}
	}

	/// The module at path of the bundle, linked with the modules it imports not yet linked; else of the cache, linked
	/// once each module it uses is loaded by load, as the checker checks a module, which says whether it is done; each
	/// top-level decl but a test an entry. -1 if neither has it, or one of those is not done or of another ABI than the
	/// cache's file has. Throws a CompileError if the bundle's, or a module it imports, is missing, stale or malformed.
	module(path: string, load: (path: string) => bool = _ => false): i32 {
		const file = this.cache.get(path)
		if (file == null) {
			return this.bundled(path)
		}
		this.cache.delete(path) // once: one using it while those it uses load checks it
		try {
			const h = head(file!)
			if (h.paths.every(load) && this.prog.module(path) < 0) {
				const f = file!.copy() // of the image, which may change once lowered
				const ms = read(this.prog, [f], compilerId(), [h.source])
				if (ms != null) {
					this.served.push(h)
					this.prog.modules[ms![0]].bc = f
					return this.entered(ms!)
				}
			}
		} catch (e: ParseError | IoError) {
			this.malformed = true
			this.cache = new HashMap[string, string]()
		}
		return -1
	}

	/// Whether each module linked from the cache holds the ABI hash each module it uses has, now that all are made: of
	/// those lowered anew, which may have been hashed before all their signatures reach were, hashed again; of the
	/// others as their files hold them, of the same source and, as checked here, of the same ABIs of their deps.
	current(): bool {
		const p = this.prog
		for (const x of p.modules.filter(x => x.source != 0 && x.bc == "")) {
			x.abi = 0
		}
		for (const h of this.served) {
			for (const i of 0 ... h.paths.length - 1) {
				if (h.hashes[i] != seen(p, p.module(h.paths[i]), h.hidden[i])) {
					return false
				}
			}
		}
		return true
	}

	/// The module at path, linked from the bundle or the cache as module does, with those it uses, once all lowered are
	/// made; -1 if neither has it.
	linked(path: string): i32 {
		const m = this.prog.module(path)
		return if (m >= 0) m else this.module(path, d => this.linked(d) >= 0)
	}

	/// Whether each file of the cache not linked holds the ABI hash each module it uses that was lowered anew has, as
	/// current checks those linked.
	unlinked(): bool {
		const p = this.prog
		for (const h of this.heads.values().filter(h => p.module(h.path) < 0)) {
			for (const i of 0 ... h.paths.length - 1) {
				const m = p.module(h.paths[i])
				if (m >= 0 && p.modules[m].bc == "" && h.hashes[i] != seen(p, m, h.hidden[i])) {
					return false
				}
			}
		}
		return true
	}

	private bundled(path: string): i32 {
		const file = this.bundle.get(path)
		if (file == null) {
			return -1
		}
		const p = this.prog
		const linked = p.module(path)
		if (linked >= 0) {
			return linked
		}
		const paths = [path]
		const files = [file!]
		try {
			let i = 0
			while (i < files.length) {
				for (const d of head(files[i], root).paths) {
					const f = if (p.module(d) < 0 && !paths.includes(d)) this.bundle.get(d) else null
					if (f != null) {
						paths.push(d)
						files.push(f!)
					}
				}
				i++
			}
			const ms = read(p, files, compilerId(), files.map(_ => 0 as u64), root)
			if (ms != null) {
				return this.entered(ms!)
			}
		} catch (e: ParseError | IoError) {}
		this.bundle = new HashMap[string, string]() // as p may hold part of it
		throw new CompileError(`the bundle's ${path}, or a module it imports, is missing, stale or malformed`)
	}

	/// The first of modules ms, each top-level decl of which but a test made an entry.
	private entered(ms: i32[]): i32 {
		const p = this.prog
		for (const m of ms) {
			for (const d of p.modules[m].decls.filter(d => p.decls[d].kind != decl.Test)) {
				this.entries.set(`${p.modules[m].path}:${p.strings[p.decls[d].name]}`, d)
			}
		}
		return ms[0]
	}
}

/// What a module is of beyond its file: for a header's names, the source bind made of them, else ""; the includes
/// searched (searched); and each file read meanwhile, by bind, or to locate the headers a module imports, by path, with
/// the hash of its bytes, 0 if there are none.
export class Bound {
	src = ""
	/// Of one kept, the hash of src, which the image holds as a read of no path; else 0.
	private srcHash = 0 as u64
	includes: string
	reads: [string, u64][] = []

	constructor(includes: string) { this.includes = includes }

	/// Keeps each Bound of files, as bytes made them, the last well-formed of a path, of copies of its bytes, which may
	/// change.
	static keep(files: string[]) {
		for (const f of files) {
			try {
				const r = new Reader(f)
				const s = () => r.raw(r.uleb() as i32).copy()
				const path = s()
				const b = new Bound(s())
				b.src = s()
				while (r.pos < f.length) {
					const p = s()
					const h = r.fixed(8)
					if (p == "") {
						b.srcHash = h
					} else {
						b.reads.push([p, h])
					}
				}
				bound.set(path, b)
			} catch (e: ParseError) {}
		}
	}

	/// Whether includes are those searched, and each file read is of the hash digest gives.
	current(includes: string, digest: (path: string) => u64): bool {
		return includes == this.includes && this.reads.every(r => digest(r[0]) == r[1])
	}

	/// read, adding to reads each file it reads.
	reader(read: (path: string) => string | null): (path: string) => string | null {
		return p => {
			const s = read(p)
			if (!this.reads.some(r => r[0] == p)) {
				this.reads.push([p, hash(s)])
			}
			return s
		}
	}

	/// The hash of src.
	hashed(): u64 { return if (this.srcHash != 0) this.srcHash else fnv(this.src) }

	/// This, of the module at path, as a build's kept image holds it; but its src by its hash alone, if digest.
	bytes(path: string, digest = false): string {
		const w = new Writer()
		for (const s of [path, this.includes, if (digest) "" else this.src]) {
			w.uleb(s.length as u64)
			w.raw(s)
		}
		for (const [f, h] of [...this.reads, ["", this.hashed()] as [string, u64]]) {
			w.uleb(f.length as u64)
			w.raw(f)
			w.fixed(h, 8)
		}
		return w.bytes
	}
}

/// The Bound of each module by path that is of a header or imports one, made by a check or kept in a build's kept image
/// (Bound.keep), as binding is slow; current again on each use.
export let bound = new HashMap[string, Bound]()

/// includes, then the system's, joined by lines.
export function searched(includes: string[]): string { return [...includes, system].join("\n") }

/// The source of the module at path as it is: as read gives it, or for a header's module as bind made it; null if its
/// Bound is not current, as includes, the includes searched, or a file it read changed.
export function source(path: string, includes: string, read: (path: string) => string | null): string | null {
	const b = bound.get(path)
	if (b == null) {
		return read(path)
	}
	return if (!b.current(includes, p => hash(read(p)))) null else if (b.src != "") b.src else read(path)
}

/// The hash of the source of the module at path as it is (source, sourceHash), as digest gives the hash of each file's
/// bytes; 0 if there is none.
function hashedSource(path: string, includes: string, digest: (path: string) => u64): u64 {
	const b = bound.get(path)
	if (b != null && !b.current(includes, digest)) {
		return 0
	}
	const h = if (b != null && b.src != "") b!.hashed() else digest(path)
	return if (h == 0) 0 else sourceHash(path, h)
}

/// The hash of bytes s, 0 if there are none.
export function hash(s: string | null): u64 { return if (s == null) 0 else fnv(s!) }

/// Of each file by path, its time and size and the hash of its bytes, of the build that runs (hashing).
let hashes = new HashMap[string, [string, string, u64]]()
/// When the build that runs started, by the files' clock; 0 if none runs.
let since: i64 = 0

/// The hash of the bytes of the file at path, 0 if there are none: as hashes holds it of the time and size it has, else
/// read, and held only if written before the build started, as one written again in the same tick keeps its time and
/// size.
export function hashed(path: string): u64 {
	try {
		const s = stat(path)
		const stamp = `${s.modified} ${s.size}`
		const k = hashes.get(path)
		if (k != null && k![1] == stamp) {
			return k![2]
		}
		const h = hash(readFile(path))
		if (s.modified < since) {
			hashes.set(path, [path, stamp, h])
		}
		return h
	} catch (e: IoError) {
		return 0
	}
}

/// f(), as a build, started at the time of a file made then: with the hashes the file at path keeps, which those held
/// after are then written to, first to a file of its own.
export function hashing(path: string, f: () => Program): Program {
	const made = `${path}.${getpid()}` // its own, as another bober may be at it too
	hashes = new HashMap[string, [string, string, u64]]()
	try {
		const r = new Reader(readFile(path) ?? "")
		if (writeFile(made, "")) {
			since = stat(made).modified
			remove(made) // not left if this is killed
		}
		const s = () => r.raw(r.uleb() as i32)
		while (r.pos < r.bytes.length) {
			const p = s()
			hashes.set(p, [p, s(), r.fixed(8)])
		}
	} catch (e: ParseError | IoError) {}
	try {
		return f()
	} finally {
		since = 0
		const w = new Writer()
		for (const [p, stamp, h] of hashes.values()) {
			for (const x of [p, stamp]) {
				w.uleb(x.length as u64)
				w.raw(x)
			}
			w.fixed(h, 8)
		}
		try {
			if (writeFile(made, w.bytes)) {
				rename(made, path) // whole, if at all
			}
		} catch (e: IoError) {}
	}
}

/// The files of the bundle named bundleName by the path each holds.
export function stdBundle(): HashMap[string, string] {
	if (!bundles.has(bundleName)) {
		const file = join(root, `lib/${bundleName}.bobc`)
		try {
			bundles.set(bundleName, unbundle(readFile(file) ?? ""))
		} catch (e: ParseError) {
			print(`bober: ${file} is malformed`)
			bundles.set(bundleName, new HashMap[string, string]())
		}
	}
	return bundles.get(bundleName)!
}

/// The bundle of the modules of p, made by the compiler whose hash is compiler, which drops their tests and source
/// hashes first: each one's file, as its length, unsigned LEB128, and its bytes.
export function bundle(p: Program, compiler: u64): string {
	for (const x of p.modules) {
		x.source = 0
		x.decls = x.decls.filter(d => p.decls[d].kind != decl.Test)
	}
	const w = new Writer()
	for (const m of 0 ... p.modules.length - 1) {
		const f = write(p, m, compiler)
		w.uleb(f.length as u64)
		w.raw(f)
	}
	return w.bytes
}

/// The files of bundle s by the path each holds.
export function unbundle(s: string): HashMap[string, string] throws ParseError {
	const files = new HashMap[string, string]()
	const r = new Reader(s)
	while (r.pos < s.length) {
		const f = r.raw(r.uleb() as i32)
		files.set(head(f, root).path, f)
	}
	return files
}

/// The hash of the compiler's ID, made once: of an image's, its entry and version, which name the code it runs
/// (src/launch.c); else of its executable Mach-O's UUID, which signing it keeps, else its first page, with ELF's build
/// ID.
export function compilerId(): u64 throws IoError {
	if (compiler == 0) {
		compiler = idHash()
	}
	return compiler
}

let compiler: u64 = 0

function idHash(): u64 throws IoError {
	const launched = name()
	if (startsWith(launched, "bober.") && indexOf(launched, "@") > 0) {
		return fnv(launched)
	}
	const f = open(executable())
	const page = f.read(4096) ?? ""
	f.close()
	const r = new Reader(page)
	try {
		if (r.fixed(4) == 0xfeedfacf) {
			r.pos = 32 // the load commands, after the header
			while (true) {
				const at = r.pos
				if (r.fixed(4) == 0x1b) {
					// LC_UUID
					return fnv(page.slice(at + 8, at + 24))
				}
				r.pos = at + (r.fixed(4) as i32)
			}
		}
	} catch (e: ParseError) {}
	return fnv(page)
}
