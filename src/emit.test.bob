//! Tests of src/emit.bob: small programs compiled through the whole pipeline, with the run time, and run.

import { emit } from "./emit"
import { LLVM } from "./backend/llvm"
import { CompileError } from "./error"
import { Outlined } from "./bc/decl"
import { lower } from "./lower"
import { mono } from "./mono"
import { endsWith, startsWith } from "../std/algo"
import { appendFile, mkdirAll } from "../std/fs"
import { base } from "../std/fs/path"
import { split } from "../std/string"
import * as process from "../std/process"
import { ld, runtime } from "./bober"

/// Where the running test writes its programs, a directory of its own, by the number of its TMPDIR, that tests running
/// at once do not write in each other's, and as deep in the package as the build directory, that "../../" is its root.
function dir(): string { return `build/emit-test${base(process.env("TMPDIR")!)}` }

/// What the program of main source src prints when compiled and run, then "exit <code>"; it may import "./lib" of
/// source lib. With tests, its tests are run instead of main.
function run(name: string, src: string, lib: string = "", tests: bool = false): string {
	mkdirAll(dir())
	const main = `${dir()}/${name}.bob`
	writeFile(main, src)
	writeFile(`${dir()}/lib.bob`, lib)
	const p = lower([main])
	const m = p.module(main)
	mono(p, m, false, 64) // its small functions copied, as a release build's are
	const files: string[] = []
	for (const i of 0 ... p.modules.length - 1) {
		const b = new LLVM(p.modules[i].path, 0)
		emit(p, i, b, { main: m, tests: tests, dyn: false })
		b.verify()
		const o = `${dir()}/${name}${i}.o`
		b.emit(o, false)
		files.push(o)
	}
	const bin = `${dir()}/${name}`
	const out = `${bin}.out`
	ld([...files, ...runtime(dir())], bin)
	const status = process.run([bin], out)
	appendFile(out, `exit ${status}\n`)
	return readFile(out) ?? ""
}

test "arithmetic, comparisons and wrapping" {
	assert run("arith",
		`function main(): i32 {
	const a: i32 = 7
	const b: i8 = 127
	const c: u8 = 200
	const d: i32 = -8
	const e: f64 = 1.5
	const f: f64 = 3000000000.5
	print(\`\${a / 2} \${-a % 3} \${b + 1} \${a ** 3} \${c >> 3} \${d >> 33} \${e * 0.25}\`)
	print(\`\${d as u32} \${f as i32} \${1 < 2} \${c > 255} \${(d << 28) / -1}\`)
	return a / 0
}
`)
		== `3 -1 -128 343 25 -4 0.375
4294967288 2147483647 true false -2147483648
${dir()}/arith.bob:10:11: trap: division by zero
exit 1
`
}

test "strings and templates" {
	assert run("str",
		`function main(): i32 {
	const s = "ab" + "cd"
	print(\`\${s.length}\${s[1]}\`)
	print(s.slice(1, 3))
	print(\`x=\${0.1} \${true} \${null} \${-5}\`)
	print(\`\${s == "abcd"}\${"ab" < "b"}\${"b" <= "ab"}\`)
	return s[4] as i32
}
`) == `498
bc
x=0.1 true null -5
truetruefalse
${dir()}/str.bob:7:10: trap: index out of range
exit 1
`
}

test "arrays" {
	assert run("arr",
		`function main(): i32 {
	const xs = [1, 2, 3]
	xs.push(4)
	xs[0] = 9
	print(\`\${xs.pop()}\${xs.length}\`)
	print(xs.join(", "))
	print([...xs.slice(1, 3), ...xs].join(""))
	print(\`\${xs.at(2)} \${xs.at(3)} \${xs.map(x => x * 2).join(" ")}\`)
	print(\`\${xs.filter(x => x > 2).join(" ")} \${xs.some(x => x > 8)}\${xs.every(x => x > 8)}\${xs.includes(3)}\`)
	print(\`\${xs.equals([9, 2, 3])} \${xs.equals([9, 2])} \${[xs].equals([xs])} \${[xs].equals([[9, 2, 3]])} \${xs.find(x => x < 9)} \${xs.find(x => x > 9)}\`)
	while (true) {
		xs.pop()
	}
}
`)
		== `43
9, 2, 3
23923
3 null 18 4 6
9 3 truefalsetrue
true false true false 2 null
trap: pop of an empty array
exit 1
`
}

test "a class with a field and a method, across modules" {
	assert run("box",
		`import { Box } from "./lib"

function main(): i32 {
	const b = new Box()
	print(\`\${b.label.length}\${b.x}\${b.held[2]}\`)
	b.x = 10
	return b.get()
}
`, `export class Box {
	x = 5
	label = ""
	held: u8[3]
	static count = 0

	get(): i32 { return this.x + 1 }
}
`) == "050\nexit 11\n"
}

test "embedded fields: copies into them, and new initializing them in place" {
	assert run("embed",
		`class Loc {
	pos = 3
	len = 0

	constructor() { this.len = this.pos + 1 }

	end(): i32 { return this.pos + this.len }
}

class Span {
	from = 3
	to = 0

	constructor() { this.to = this.from + 1 }
}

class Tok {
	kind = 0
	loc: ...Loc
	span: ...Span = { from: 9, to: 1 }
}

function main(): i32 {
	const l = new Loc()
	const t = new Tok()
	t.loc = { ...l }
	l.pos = 7
	print(\`\${t.loc.pos}\${t.loc.len}\${t.span.from}\${t.span.to}\`)
	return t.loc.end()
}
`) == "3491\nexit 7\n"
}

test "a union with instanceof and casts" {
	assert run("union",
		`function f(u: null | i32 | string): i32 {
	print(\`\${u == null} \${u instanceof i32}\${u instanceof string} \${u == "s"}\${u == 7}\`)
	return u as i32
}

function main(): i32 {
	f(7)
	return f("s")
}
`)
		== `false truefalse falsetrue
false falsetrue truefalse
${dir()}/union.bob:3:11: trap: cast to a type that is not the value's
exit 1
`
}

test "a cast to a union of more than a few members is checked by code of O(1), the read of a chain of instanceof too" {
	const classes = ["A", "B", "C", "D", "E", "F"].map(c => `class ${c} { x = 1 }\n`).join("")
	const trap = "trap: cast to a type that is not the value's\nexit 1\n"
	assert run("narrower6",
		`${classes}type N = A | B | D | E | F
function f(u: A | B | C | D | E | F): N { return u as N }

function main(): i32 {
	f(new B())
	f(new C())
	return 0
}
`) == `${dir()}/narrower6.bob:8:52: ${trap}`
	mkdirAll(dir())
	const size = (n: i32) => {
		let src = ""
		let u = "C0"
		let ifs = ""
		for (const i of 0 ... n - 1) {
			src += `class C${i} { x = ${i} }\n`
			u += if (i > 0) ` | C${i}` else ""
			ifs += `\tif (b.u instanceof C${i}) { return b.u.x }\n`
		}
		const main = `${dir()}/box${n}.bob`
		writeFile(main,
			`${src}class Box { u: ${u} = new C0() }\nfunction f(b: Box): i32 {\n${ifs}\treturn -1\n}\n
function main(): i32 { return f(new Box()) }\n`)
		const p = lower([main])
		const m = p.module(main)
		mono(p, m)
		const b = new LLVM(main, 0)
		emit(p, m, b, { main: m, tests: false, dyn: false })
		return split(b.text(), "\n").length
	}
	// Of lines, as a switch on the tag per read was n lines.
	assert size(128) < 5 * size(32)
}

test "a type param's value cast into a class it is not traps" {
	assert run("param",
		`interface HasV { v: i32 }
class P { v = 1 }
class Q { v = 2 }

function p[T extends HasV](x: T): i32 { return (x as P).v }

function main(): i32 {
	print(\`\${p(new P())}\`)
	return p(new Q())
}
`) == `1
${dir()}/param.bob:5:51: trap: cast to a type that is not the value's
exit 1
`
}

