	assert run("object",
		`interface Any {}
class C { v = 1 }

function main(): i32 {
	const x: Any = { v: 2 }
	return (x as C).v
}
`) == `${dir()}/object.bob:6:12: trap: cast to a type that is not the value's
exit 1
`
}

test "a value cast into a function type it does not fit traps" {
	assert run("func",
		`type F = (x: i32) => i32

function main(): i32 {
	const f: string | F = (x: i32): i32 => x + 1
	print(\`\${(f as F)(1)}\`)
	const g: F | ((s: string) => i32) = (s: string): i32 => s.length
	print(\`\${g instanceof F}\`)
	const s: string | F = "s"
	return (s as F)(1)
}
`) == `2
false
${dir()}/func.bob:9:12: trap: cast to a type that is not the value's
exit 1
`
}

test "a string tests as the string literals it spells" {
	assert run("spells", `type K = "if" | "else" | "readonly" | "sixteen bytes ok" | "seventeen bytes!!" | "seventeen bytes.."
	| "seventeen bytes??"
class T { text = "" }

function kind(s: string): K | null {
	const w = s.slice(1, s.length)
	return if (w instanceof K) w else null
}

function main(): i32 {
	const t = new T()
	t.text = "xelse".slice(1, 5)
	const k: K = if (t.text instanceof K) t.text else "if"
	print(\`\${kind("xif") == "if"} \${kind("xiff")} \${k == "else"} \${"e" + "lse" instanceof K}\`)
	print(\`\${kind("xreadonly") == "readonly"} \${kind("xreadonlx")} \${kind("xsixteen bytes ok") == "sixteen bytes ok"}\`)
	print(\`\${kind("xseventeen bytes??") == "seventeen bytes??"} \${kind("xseventeen bytes!!") == "seventeen bytes!!"}\`)
	print(\`\${kind("xseventeen bytes!.")} \${kind("x")}\`)
	print(\`\${fromBytes([101 as u8, 108, 115, 101]) instanceof K}\`)
	return 0
}
`) == "true null true true\ntrue null true\ntrue true\nnull null\ntrue\nexit 0\n"
}

test "a type set's param compares and tests as the union of its set" {
	assert run("set",
		`interface I { n: i32 }
class Sq { n = 4 }
interface S extends string | bool {}
interface N extends string | i32 | I {}
interface L extends "a" | "b" | bool {}

function f[T extends S](v: T): string { return \`\${v == true} \${v instanceof string}\` }

function len[T extends N](v: T): i32 { return if (v instanceof string) v.length else 0 }

function isA[T extends L](v: T): bool { return v instanceof "a" }

function lit[T](): bool {
	switch (T.kind) {
		case "literal": return T.value instanceof string
		default: return false
	}
}

function main(): i32 {
	print(\`\${f(true)} \${f("x")} \${len(7)} \${len("abc")} \${len(new Sq())} \${isA(true)} \${isA["a"]("a")}\`)
	print(\`\${lit["x"]()} \${lit[true]()}\`)
	return 0
}
`) == `true false false true 0 3 0 false true
true false
exit 0
`
}

test "consts name integer literal types, a union of them stored as their base, which as checks" {
	assert run("ops",
		`const End: u8 = 0
const Block: u8 = 2
type Op = End | Block

function name(op: Op): string { return switch (op) { case End: "end"; case Block: "block" } }

function main(): i32 {
	const b: u8 = 2
	const op = b as Op
	print(\`\${name(End)} \${name(op)} \${op + 1} \${op == Block}\`)
	return (b + 1) as Op
}
`) == `end block 3 true
${dir()}/ops.bob:11:17: trap: assert failed
exit 1
`
}

test "closures capture a local by reference, each iteration's its own" {
	assert run("closure",
		`function main(): i32 {
	let n = 1
	const add = (k: i32) => {
		n += k
		return n
	}
	add(2)
	const fs: (() => i32)[] = []
	for (const i of 1 ... 2) {
		let m = i * 10
		fs.push(() => {
			m += 1
			return m
		})
	}
	print(\`\${add(3)} \${fs[0]()} \${fs[1]()} \${fs[0]()}\`)
	return n
}
`) == "6 11 21 12\nexit 6\n"
}

test "a left-out param takes its default, also through a function value" {
	assert run("default",
		`function f(x: i32 = 40): i32 { return x + 2 }

function main(): i32 {
	print(f(1))
	const g: () => i32 = f
	return g()
}
`) == "3\nexit 42\n"
}

test "throw, catch and finally" {
	assert run("try",
		`function fail(n: i32): i32 { throw n }

function f(): i32 {
	try {
		return 1
	} finally {
		print("finally on return")
	}
}

function main(): i32 {
	try {
		try {
			throw "boom"
		} catch (e: i32) {
			print("wrong")
		} finally {
			print("inner finally")
		}
	} catch (e: string) {
		print(e)
	}
	try {
		fail(42)
	} catch (e: i32) {
		print(e)
	}
	print(f())
	while (true) {
		try {
			break
		} finally {
			print("finally on break")
		}
	}
	throw 7 as i64
}
`) == `inner finally
boom
42
finally on return
1
finally on break
${dir()}/try.bob:36:2: trap: uncaught throw: 7
exit 1
`
}

test "tests and traps at their source position, the values in a failed assert, a helper's call in the test" {
	assert startsWith(run("asserts",
		`test "yes" { print("hidden") }

test "no" {
	print("shown")
	assert 1 == 2
}

test "subtests" {
	for (const i of 1 ... 3) {
		test \`\${i}\` {
			test "odd" { assert i % 2 == 1 }
		}
	}
	test "throws" { throw "seven" }
	assert 0 > 1
}

function even(n: i32) { assert n > 0 && n % 2 == 0 }

test "helper" {
	even(2)
	even(3)
}

test "neither" { assert 1 > 2 || 3 < 2 }

test "optional" {
	const xs: i32[] | null = null
	assert xs?.at(0) == 1
}

test "lines" {
	assert \`a
b
c
d
e
f\` == \`a
b
c
d
e
F\`
}

function first(): i32 { throw "first" }

test "rethrown" {
	const f = async first()
	try {
		throw "second"
	} catch (e: string) {
	}
	await f
}

class Oops { n = 1 }

test "valued" { throw new Oops() }

function deep(n: i32): i32 { return n - deep(n + 1) }

test "overflow" { assert deep(0) == 0 }
`, "", true),
		[`{"yes":"ok","no":"shown\\n${dir()}/asserts.bob:5:2: trap: assert failed: 1 == 2"`,
		`"subtests":{"1":"ok","2":{"odd":"${dir()}/asserts.bob:11:17: trap: assert failed: i % 2 == 1\\n  i % 2: 0\\n  i: 2"},"3":"ok"`,
		`"throws":"${dir()}/asserts.bob:14:18: trap: uncaught throw: seven"`,
		`"trap":"${dir()}/asserts.bob:15:2: trap: assert failed: 0 > 1"}`,
		`"helper":"${dir()}/asserts.bob:18:25: trap: assert failed: n % 2 == 0 (called at ${dir()}/asserts.bob:22)\\n  n % 2: 1\\n  n: 3"`,
		`"neither":"${dir()}/asserts.bob:25:18: trap: assert failed: 1 > 2 || 3 < 2"`,
		`"optional":"${dir()}/asserts.bob:29:2: trap: assert failed: xs?.at(0) == 1\\n  xs: null"`,
		`"lines":"${dir()}/asserts.bob:33:2: trap: assert failed: \`a …\\n  …\\n    d\\n    e\\n  - f\\n  + F"`,
		`"rethrown":"${dir()}/asserts.bob:46:25: trap: uncaught throw: first (called at ${dir()}/asserts.bob:54)"`,
		`"valued":"${dir()}/asserts.bob:59:17: trap: uncaught throw: {\\"n\\": 1}"`,
		`"overflow":"trap: stack overflow\\nexit 1"}\n`].join(","))
}

test "a program of tests exits 1 if one failed" {
	assert endsWith(run("failed", `test "fails" { assert 1 == 2 }\n`, "", true), "exit 1\n")
}

test "== and != in an assert compare by value, outside it by identity" {
	assert run("values",
		`class P { x = 0; s = "" }

test "values" {
	const xs: i64[] = [1, 2]
	const t: [i64, string] | null = [1, "a"]
	assert xs == [1, 2] && xs != [1] && t == [1, "a"] && t != null && new P() == new P()
	assert [xs].every(x => x == [1, 2])
}

test "identity" {
	const xs: i64[] = [1]
	const same = xs == [1]
	assert !same
}
`, "", true) == `{"values":"ok","identity":"ok"}
{"values":[],"identity":[]}
[]
exit 0
`
}

test "the tests' report is followed by the regular files each read, null if it may depend on more" {
	mkdirAll(dir())
	writeFile(`${dir()}/read.txt`, "x")
	const src = `import { readFile, writeFile } from "../../std/fs"
import { env } from "../../std/process"
import { bober_self } from "../../src/rt.h"
import { rand } from "stdlib.h"
import { strlen } from "string.h" @Deterministic

test "reads" { assert readFile("${dir()}/read.txt") == "x" && env("HOME") == null }
test "pure" {
	bober_self()
	assert strlen("ab") == 2
}
function traps(): i32 { assert false; return 0 }
`
	assert endsWith(run("reads", src, "", true), `read.txt"],"pure":[]}\n[]\nexit 0\n`)
	for (const [name, body] of [["calls", "rand()"], ["takes", "assert [rand].length == 1"],
		["writes", `writeFile("${dir()}/written.txt", "y")`],
		["catches", "try { await spawn traps() } catch (e: Trap) {}"]]) {
		assert endsWith(run("reads", `${src}test "${name}" { ${body} }`, "", true),
			`"pure":[],"${name}":null}\n[]\nexit 0\n`)
	}
}

test "a type's and its fields' doc comments, by reflection" {
	assert run("doc",
		`/// A point.
/// In 2D.
class P {
	/// Across.
	x = 0
	y = 0 /// Down.
}

function docs[T](): string {
	let s = T.doc
	for (const f of T.fields) {
		s += "|" + f.name + ":" + f.doc
	}
	return s
}

function main(): i32 {
	print(docs[P]())
	return 0
}
`) == `A point.
In 2D.|x:Across.|y:Down.
exit 0
`
}

test "async calls on fibers, taking turns, and await" {
	assert run("async",
		`import { bober_park, bober_self, bober_wake } from "../../src/rt.h"

/// Lets the fibers ready run first.
function pause() {
	bober_wake(bober_self())
	bober_park()
}

function step(name: string, n: i32): i32 {
	const seen: string[] = []
	for (const i of 1 ... n) {
		seen.push(\`\${name} \${i}\`)
		print(seen[seen.length - 1])
		pause()
	}
	return seen.length
}

function fail(): i32 { throw "no" }

function main(): i32 {
	const a = async step("a", 2)
	const b = async step("b", 2)
	print("started")
	print(await a + await b)
	const f = async fail()
	try {
		await f
	} catch (e: string) {
		print(e)
	}
	try {
		await f
	} catch (e: string) {
		print(e + " again")
	}
	return 0
}
`) == `a 1
b 1
started
a 2
b 2
4
no
no again
exit 0
`
}

test "a type nested deep keeps a short key, of a long part's hash, not one growing threefold a level" {
	let src = "interface L0 { a: i32 }\n"
	let lit = "{ a: 1 }"
	for (const i of 1 ... 16) {
		src += `interface L${i} { x: L${i - 1}; y: L${i - 1} | null; z: (p: L${i - 1}) => i32 }\n`
		lit = `{ x: ${lit}, y: null, z: (p: L${i - 1}): i32 => ${i} }`
	}
	src += "function f(v: L16 | i32): i32 { return if (v instanceof i32) v else (v as L16).z(v.x) }\n"
	src += `function main() {
	const l: L16 = ${lit}
	print(f(l))
}
`
	assert run("nested", src) == "16\nexit 0\n"
}

test "a class whose fields nest its type args ever deeper is an error, not endless type descriptors" {
	mkdirAll(dir())
	const main = `${dir()}/deep.bob`
	writeFile(main, "class A[T] {\n\tb: B[T] | null = null\n}\nclass B[T] {\n\ta: A[T[]] | null = null\n}")
	const p = lower([main])
	let deep = "T"
	for (const i of 1 ... 254) {
		deep += "[]"
	}
	const o = { main: -1, tests: false, dyn: true }
	assert emit(p, p.module(main), new LLVM(main, 0),
		o) throws new CompileError(`A[${deep}] | null nests type args ever deeper`)
}

test "a method whose type nests its class's type args ever deeper, or ever wider, is an error, not endless descriptors" {
	mkdirAll(dir())
	const main = `${dir()}/deep.bob`
	writeFile(main, "class P[T] {\n\tmany(): P[T[]] { return new P[T[]]() }\n}")
	let p = lower([main])
	let deep = "T"
	for (const i of 1 ... 254) {
		deep += "[]"
	}
	const o = { main: -1, tests: false, dyn: true }
	assert emit(p, p.module(main), new LLVM(main, 0),
		o) throws new CompileError(`() => P[${deep}] nests type args ever deeper`)
	writeFile(main,
		"interface Seq[T] {\n\tpairs(): Seq[[T, T]] | null\n}\nclass S[T] {\n\tpairs(): Seq[[T, T]] | null { return null }\n}")
	p = lower([main])
	let msg = "" // of either order of the union, as made first
	try {
		emit(p, p.module(main), new LLVM(main, 0), o)
	} catch (e: CompileError) {
		msg = e.msg
	}
	assert msg.length == 1000 + " … nests type args ever deeper".length && endsWith(msg, " … nests type args ever deeper")
}

test "a function another module copies traps at its own source" {
	assert run("copies", `import { at } from "./lib"

function main(): i32 { return at([1], 1) }
`, `

export function at(xs: i32[], i: i32): i32 { return xs[i] }
`) == `${dir()}/lib.bob:3:55: trap: index out of range
exit 1
`
}

test "a long block is run by several functions, but for what leaves it or is named far on" {
	let body = ""
	for (const k of 0 ... 139) {
		body += `\tconst a${k} = s % 7 + ${k}\n\ts += a${k}\n`
		if (k == 69) {
			body += "\tconst near = s\n\tif (stop) {\n\t\treturn near\n\t}\n\ts += near\n"
		}
	}
	assert run("long",
		`function long(stop: bool): i32 {
	let s = 0
	const first = 1
${body}	return s + first
}

function main() { print(\`\${long(false)} \${long(true)}\`) }
`) == "12767 2619\nexit 0\n"
	const p = lower([`${dir()}/long.bob`])
	const m = p.module(`${dir()}/long.bob`)
	assert p.decls.filter(d => d.module == m && (d.mods & Outlined) != 0).length == 4
}

test "top-level consts initialize once while lets initialize per isolate, and spawn before main traps" {
	assert run("iso_init",
		`function initConst(): i32 {
	print("const")
	return 7
}

function initLet(): i32 {
	print("let")
	return 10
}

const c = initConst()
let v = initLet()

function work(d: i32): i32 {
	v += d
	return c + v
}

function main() {
	print(await spawn work(1))
	print(await spawn work(2))
}
`) == `const
let
let
18
let
19
exit 0
`
	assert run("spawn_const",
		`function f(): i32 { return 1 }
const x = await spawn f()
function main() { print(x) }
`) == `${dir()}/spawn_const.bob:2:17: trap: spawn before main
exit 1
`
	assert run("spawn_let",
		`function f(): i32 { return 1 }
let x = await spawn f()
function main() { print(x) }
`) == `${dir()}/spawn_let.bob:2:15: trap: spawn before main
exit 1
`
}

test "a failed assert shows a value met again within itself as [Circular]" {
	assert startsWith(run("cycle", `class L { next: L | null = null }

test "cycle" {
	const a = new L()
	a.next = a
	assert a == new L()
}
`, "", true),
		`{"cycle":"${dir()}/cycle.bob:6:2: trap: assert failed: a == new L()\\n  a: {\\"next\\": [Circular]}\\n  new L(): {\\"next\\": null}"}`)
}
