//! Tests of src/emit.bob: small programs compiled through the whole pipeline, with the run time, and run.

import { emit } from "./emit"
import { LLVM } from "./backend/llvm"
import { lower } from "./lower"
import { mono } from "./mono"
import { appendFile, mkdirAll } from "../std/fs"
import * as process from "../std/process"
import { ld, runtime } from "./bober"

const dir = "build/emit-test"

/// What the program of main source src prints when compiled and run, then "exit <code>"; it may import "./lib" of
/// source lib. With tests, its tests are run instead of main.
function run(name: string, src: string, lib: string = "", tests: bool = false): string {
	mkdirAll(dir)
	const main = `${dir}/${name}.bob`
	writeFile(main, src)
	writeFile(`${dir}/lib.bob`, lib)
	const p = lower([main])
	const m = p.module(main)
	mono(p, m)
	const files: string[] = []
	for (const i of 0 ... p.modules.length - 1) {
		const b = new LLVM(p.modules[i].path, 0)
		emit(p, i, b, { main: m, tests: tests, dyn: false })
		b.verify()
		const o = `${dir}/${name}${i}.o`
		b.emit(o, false)
		files.push(o)
	}
	const bin = `${dir}/${name}`
	const out = `${bin}.out`
	ld([...files, ...runtime(dir)], bin)
	const status = process.run([bin], out)
	appendFile(out, `exit ${status}\n`)
	return readFile(out) ?? ""
}

test "arithmetic, comparisons and wrapping" {
	assert run("arith", `function main(): i32 {
	const a: i32 = 7
	const b: i8 = 127
	const c: u8 = 200
	const d: i32 = -8
	const e: f64 = 1.5
	const f: f64 = 3000000000.5
	print(\`\${a / 2} \${-a % 3} \${b + 1} \${a ** 3} \${c >> 3} \${d >> 33} \${e * 0.25}\`)
	print(\`\${d as u32} \${f as i32} \${1 < 2} \${c > 255} \${(d << 28) / -1}\`)
	return a / 0
}
`) == `3 -1 -128 343 25 -4 0.375
4294967288 2147483647 true false -2147483648
${dir}/arith.bob:10:11: trap: division by zero
exit 1
`
}

test "strings and templates" {
	assert run("str", `function main(): i32 {
	const s = "ab" + "cd"
	print(\`\${s.length}\${s[1]}\`)
	print(s.slice(1, 3))
	print(\`x=\${0.1} \${true} \${null} \${-5}\`)
	print(\`\${s == "abcd"}\${"ab" < "b"}\${"b" <= "ab"}\`)
	return s[4] as i32
}
`) == `498
bc
x=0.1 true null -5
truetruefalse
${dir}/str.bob:7:10: trap: index out of range
exit 1
`
}

test "arrays" {
	assert run("arr", `function main(): i32 {
	const xs = [1, 2, 3]
	xs.push(4)
	xs[0] = 9
	print(\`\${xs.pop()}\${xs.length}\`)
	print(xs.join(", "))
	print([...xs.slice(1, 3), ...xs].join(""))
	print(\`\${xs.at(2)} \${xs.at(3)} \${xs.map(x => x * 2).join(" ")}\`)
	print(\`\${xs.filter(x => x > 2).join(" ")} \${xs.some(x => x > 8)}\${xs.every(x => x > 8)}\${xs.includes(3)}\`)
	print(\`\${xs.equals([9, 2, 3])} \${xs.equals([9, 2])} \${[xs].equals([xs])} \${[xs].equals([[9, 2, 3]])} \${xs.find(x => x < 9)} \${xs.find(x => x > 9)}\`)
	while (true) {
		xs.pop()
	}
}
`) == `43
9, 2, 3
23923
3 null 18 4 6
9 3 truefalsetrue
true false true false 2 null
trap: pop of an empty array
exit 1
`
}

test "a class with a field and a method, across modules" {
	assert run("box", `import { Box } from "./lib"

function main(): i32 {
	const b = new Box()
	print(\`\${b.label.length}\${b.x}\${b.held[2]}\`)
	b.x = 10
	return b.get()
}
`, `export class Box {
	x = 5
	label = ""
	held: u8[3]
	static count = 0

	get(): i32 { return this.x + 1 }
}
`) == "050\nexit 11\n"
}

test "embedded fields: copies into them, and new initializing them in place" {
	assert run("embed", `class Loc {
	pos = 3
	len = 0

	constructor() { this.len = this.pos + 1 }

	end(): i32 { return this.pos + this.len }
}

class Span {
	from = 3
	to = 0

	constructor() { this.to = this.from + 1 }
}

class Tok {
	kind = 0
	loc: ...Loc
	span: ...Span = { from: 9, to: 1 }
}

function main(): i32 {
	const l = new Loc()
	const t = new Tok()
	t.loc = { ...l }
	l.pos = 7
	print(\`\${t.loc.pos}\${t.loc.len}\${t.span.from}\${t.span.to}\`)
	return t.loc.end()
}
`) == "3491\nexit 7\n"
}

test "a union with instanceof and casts" {
	assert run("union", `function f(u: null | i32 | string): i32 {
	print(\`\${u == null} \${u instanceof i32}\${u instanceof string} \${u == "s"}\${u == 7}\`)
	return u as i32
}

function main(): i32 {
	f(7)
	return f("s")
}
`) == `false truefalse falsetrue
false falsetrue truefalse
${dir}/union.bob:3:11: trap: cast to a type that is not the value's
exit 1
`
}

test "a type set's param compares and tests as the union of its set" {
	assert run("set", `interface I { n: i32 }
class Sq { n = 4 }
interface S extends string | bool {}
interface N extends string | i32 | I {}
interface L extends "a" | "b" | bool {}

function f[T extends S](v: T): string { return \`\${v == true} \${v instanceof string}\` }

function len[T extends N](v: T): i32 { return if (v instanceof string) v.length else 0 }

function isA[T extends L](v: T): bool { return v instanceof "a" }

function lit[T](): bool {
	switch (T.kind) {
		case "literal": return T.value instanceof string
		default: return false
	}
}

function main(): i32 {
	print(\`\${f(true)} \${f("x")} \${len(7)} \${len("abc")} \${len(new Sq())} \${isA(true)} \${isA["a"]("a")}\`)
	print(\`\${lit["x"]()} \${lit[true]()}\`)
	return 0
}
`) == `true false false true 0 3 0 false true
true false
exit 0
`
}

test "consts name integer literal types, a union of them stored as their base, which as checks" {
	assert run("ops", `const End: u8 = 0
const Block: u8 = 2
type Op = End | Block

function name(op: Op): string { return switch (op) { case End: "end"; case Block: "block" } }

function main(): i32 {
	const b: u8 = 2
	const op = b as Op
	print(\`\${name(End)} \${name(op)} \${op + 1} \${op == Block}\`)
	return (b + 1) as Op
}
`) == `end block 3 true
${dir}/ops.bob:11:17: trap: assert failed
exit 1
`
}

test "closures capture a local by reference, each iteration's its own" {
	assert run("closure", `function main(): i32 {
	let n = 1
	const add = (k: i32) => {
		n += k
		return n
	}
	add(2)
	const fs: (() => i32)[] = []
	for (const i of 1 ... 2) {
		let m = i * 10
		fs.push(() => {
			m += 1
			return m
		})
	}
	print(\`\${add(3)} \${fs[0]()} \${fs[1]()} \${fs[0]()}\`)
	return n
}
`) == "6 11 21 12\nexit 6\n"
}

test "a left-out param takes its default, also through a function value" {
	assert run("default", `function f(x: i32 = 40): i32 { return x + 2 }

function main(): i32 {
	print(f(1))
	const g: () => i32 = f
	return g()
}
`) == "3\nexit 42\n"
}

test "throw, catch and finally" {
	assert run("try", `function fail(n: i32): i32 { throw n }

function f(): i32 {
	try {
		return 1
	} finally {
		print("finally on return")
	}
}

function main(): i32 {
	try {
		try {
			throw "boom"
		} catch (e: i32) {
			print("wrong")
		} finally {
			print("inner finally")
		}
	} catch (e: string) {
		print(e)
	}
	try {
		fail(42)
	} catch (e: i32) {
		print(e)
	}
	print(f())
	while (true) {
		try {
			break
		} finally {
			print("finally on break")
		}
	}
	throw 7 as i64
}
`) == `inner finally
boom
42
finally on return
1
finally on break
${dir}/try.bob:36:2: trap: uncaught throw: 7
exit 1
`
}

test "tests and traps at their source position, a failed comparison's operands, a helper's call in the test" {
	assert run("asserts", `test "yes" { print("hidden") }

test "no" {
	print("shown")
	assert 1 == 2
}

test "subtests" {
	for (const i of 1 ... 3) {
		test \`\${i}\` {
			test "odd" { assert i % 2 == 1 }
		}
	}
	test "throws" { throw 7 }
	assert 0 > 1
}

function even(n: i32) { assert n > 0 && n % 2 == 0 }

test "helper" {
	even(2)
	even(3)
}

test "neither" { assert 1 > 2 || 3 < 2 }
`, "", true) == [`{"yes":"ok","no":"shown\\n${dir}/asserts.bob:5:2: trap: assert failed: 1 == 2"`,
		`"subtests":{"1":"ok","2":{"odd":"${dir}/asserts.bob:11:17: trap: assert failed: 0 == 1"},"3":"ok"`,
		`"throws":"${dir}/asserts.bob:14:18: trap: uncaught throw: 7"`,
		`"trap":"${dir}/asserts.bob:15:2: trap: assert failed: 0 > 1"}`,
		`"helper":"${dir}/asserts.bob:18:25: trap: assert failed: 1 == 0 (called at ${dir}/asserts.bob:22)"`,
		`"neither":"${dir}/asserts.bob:25:18: trap: assert failed: 3 < 2"}\nexit 1\n`].join(",")
}

test "== and != in an assert compare by value, outside it by identity" {
	assert run("values", `class P { x = 0; s = "" }

test "values" {
	const xs: i64[] = [1, 2]
	const t: [i64, string] | null = [1, "a"]
	assert xs == [1, 2] && xs != [1] && t == [1, "a"] && t != null && new P() == new P()
	assert [xs].every(x => x == [1, 2])
}

test "identity" {
	const xs: i64[] = [1]
	const same = xs == [1]
	assert !same
}
`, "", true) == `{"values":"ok","identity":"ok"}
exit 0
`
}

test "a type's and its fields' doc comments, by reflection" {
	assert run("doc", `/// A point.
/// In 2D.
class P {
	/// Across.
	x = 0
	y = 0
}

function docs[T](): string {
	let s = T.doc
	for (const f of T.fields) {
		s += "|" + f.name + ":" + f.doc
	}
	return s
}

function main(): i32 {
	print(docs[P]())
	return 0
}
`) == `A point.
In 2D.|x:Across.|y:
exit 0
`
}

test "async calls on fibers, taking turns, and await" {
	assert run("async", `import { bober_park, bober_self, bober_wake } from "../../src/rt.h"

/// Lets the fibers ready run first.
function pause() {
	bober_wake(bober_self())
	bober_park()
}

function step(name: string, n: i32): i32 {
	const seen: string[] = []
	for (const i of 1 ... n) {
		seen.push(\`\${name} \${i}\`)
		print(seen[seen.length - 1])
		pause()
	}
	return seen.length
}

function fail(): i32 { throw "no" }

function main(): i32 {
	const a = async step("a", 2)
	const b = async step("b", 2)
	print("started")
	print(await a + await b)
	const f = async fail()
	try {
		await f
	} catch (e: string) {
		print(e)
	}
	try {
		await f
	} catch (e: string) {
		print(e + " again")
	}
	return 0
}
`) == `a 1
b 1
started
a 2
b 2
4
no
no again
exit 0
`
}
