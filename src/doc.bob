//! bober doc: the docs of a module, or of the modules below a directory, as Markdown, from their doc comments. The
//! package, which has no sources, has each module's docs in its bundle (src/lift.bob), rendered when that was made.

import { endsWith, indexOf, sort, startsWith } from "../std/algo"
import { space } from "../std/ascii"
import { exists, glob } from "../std/fs"
import { clean, join, rel } from "../std/fs/path"
import { replace, split, trim } from "../std/string"
import { head } from "./bc/file"
import { CompileError } from "./error"
import { SyntaxError, Tok } from "./lex"
import { stdBundle } from "./lift"
import { lower } from "./lower"
import { Parser, Tree, leads } from "./parse"
import { root } from "./root"

/// The docs of the module at, named as an import names it or by its path, or else the list of the modules below the
/// directory at, each with its doc's first sentence; at is looked up here, then in bober's root, so that `bober doc
/// std` prints the same anywhere.
export function doc(at: string): string throws CompileError | IoError {
	const name = if (endsWith(at, ".bob")) at.slice(0, at.length - 4) else at
	for (const path of [name, join(root, name)]) {
		const docs = module(name, `${path}.bob`)
		if (docs != null) {
			return docs!
		}
		const fs = below(path)
		if (fs.length > 0) {
			return fs.map(f => {
				const m = join(name, rel(path, f)!)
				const s = summary(module(m, f)!)
				return `- \`${m.slice(0, m.length - 4)}\`${if (s == "") "" else ": " + s}\n`
			}).join("")
		}
	}
	throw new CompileError(`${at}: no module or directory here nor in bober's root`)
}

/// The docs of module name, the file at path, else the bundle's module of that path, as it has them; null if neither is.
function module(name: string, path: string): string | null throws CompileError | IoError {
	if (exists(path)) {
		return reference(name, path, read(path))
	}
	const file = clean(path)
	if (!stdBundle().has(file)) {
		return null
	}
	const p = lower([file])
	return p.strings[p.modules[p.module(file)].doc]
}

/// The modules below directory dir but tests: its files, else the bundle's.
function below(dir: string): string[] throws IoError {
	const fs = glob(`${dir}/**/*.bob`).filter(f => !endsWith(f, ".test.bob"))
	if (fs.length == 0) {
		const bundled = stdBundle().values().map(f => head(f, root).path)
		fs.push(...bundled.filter(f => startsWith(f, `${clean(dir)}/`) && endsWith(f, ".bob")))
		sort(fs)
	}
	return fs
}

/// The docs of module name, src: its doc, then each exported declaration as written up to its body, a class's
/// members but private ones within it, and below it its doc; those next to each other without one share a block.
export function reference(name: string, path: string, src: string): string throws CompileError {
	const [p, trees] = parse(path, src)
	let out = `# ${name}\n${paragraph(moduleDoc(p, src))}`
	let bare = false // whether the last export has no doc, so that one without shares its block
	for (const t of trees) {
		const x = t.parts.at(0)
		if (x instanceof Tok && x.kind == "export") {
			let code = signature(src, t)
			const ms = t.parts.at(t.parts.length - 1)
			if (t.kind == "class" && ms instanceof Tree) {
				let body = ""
				for (const m of ms.parts) {
					if (m instanceof Tree
						&& !m.parts.some(y => y instanceof Tok && src.slice(y.loc.pos, y.loc.end()) == "private")) {
						const d = if (leads(src, start(m))) p.doc(start(m), stop(m)) else "" // not the class's
						for (const l of if (d == "") [] else split(d, "\n")) {
							body += `\n\t///${if (l == "") "" else " " + l}`
						}
						body += `\n\t${signature(src, m)}`
					}
				}
				code += if (body == "") " {}" else ` {${body}\n}`
			}
			const d = paragraph(p.doc(start(t), stop(t)))
			out = (if (bare && d == "") out.slice(0, out.length - 4) else out + "\n```bober\n") + code + "\n```\n" + d
			bare = d == ""
		}
	}
	return out
}

/// The source of t up to its body, or of a var spanning lines up to its value.
function signature(src: string, t: Tree): string {
	let end = stop(t)
	for (const x of t.parts) {
		if (x instanceof Tree && (x.kind == "block" || x.kind == "members")
			|| t.kind == "var" && x instanceof Tok && x.kind == "=" && indexOf(src.slice(start(t), end), "\n") >= 0) {
			end = start(x)
		}
	}
	return trim(src.slice(start(t), end))
}

/// The text of the module doc of src, parsed by p.
function moduleDoc(p: Parser, src: string): string {
	return p.comments.map(c => src.slice(c.loc.pos, c.loc.end())).filter(c => startsWith(c, "//!")).map(body).join("\n")
}

/// text after a blank line, if any.
function paragraph(text: string): string { return if (trim(text) == "") "" else `\n${trim(text)}\n` }

/// The first sentence of the module doc in docs as reference makes them, the paragraph after the heading unless it is
/// code.
function summary(docs: string): string {
	const s = replace(split(docs, "\n\n").at(1) ?? "", "\n", " ")
	const i = indexOf(s, ". ")
	return if (startsWith(s, "```")) "" else if (i < 0) s else s.slice(0, i + 1)
}

/// The file at path.
export function read(path: string): string throws CompileError {
	const src = readFile(path)
	if (src == null) {
		throw new CompileError(`${path}: cannot read`)
	}
	return src!
}

/// The top-level constructs of src, the file at path, and the parser, which holds its comments.
export function parse(path: string, src: string): [Parser, Tree[]] throws CompileError {
	const p = new Parser(src, true) // builtin/ has functions without a body
	const trees: Tree[] = []
	try {
		let t = p.parse()
		while (t != null) {
			trees.push(t!)
			t = p.parse()
		}
	} catch (e: SyntaxError) {
		const [line, col] = p.lineCol(e.loc.pos)
		throw new CompileError(`${path}:${line}:${col}: ${e.msg}`)
	}
	return [p, trees]
}

/// Doc comment text without its `///` or `//!` and a space after.
export function body(text: string): string {
	return text.slice(if (text.length > 3 && text[3] == space) 4 else 3, text.length)
}

/// Where p's source starts.
function start(p: Tree | Tok): i32 {
	if (p instanceof Tok) {
		return p.loc.pos
	}
	const first = if (p.parts.length > 0) start(p.parts[0]) else p.t.loc.pos
	return if (first < p.t.loc.pos) first else p.t.loc.pos
}

/// Where p's source ends, after its closing token if it has one.
function stop(p: Tree | Tok): i32 {
	if (p instanceof Tok) {
		return p.loc.end()
	}
	let end = if (p.end > p.t.loc.pos) p.end + 1 else p.t.loc.end()
	for (const q of p.parts) {
		const e = stop(q)
		end = if (e > end) e else end
	}
	return end
}
