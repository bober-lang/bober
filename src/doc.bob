//! bober doc: the docs of a module, or of the modules below a directory, as Markdown, from their doc comments and
//! declarations as the lowered Program holds them, so that a module of the package's bundle (src/lift.bob) has the same
//! as its source.

import { endsWith, indexOf, sort, sortBy, startsWith } from "../std/algo"
import { exists, glob } from "../std/fs"
import { clean, join, rel } from "../std/fs/path"
import { replace, split, trim } from "../std/string"
import * as decl from "./bc/decl"
import { head } from "./bc/file"
import { Program, body } from "./bc/program"
import { signature } from "./bc/source"
import { CompileError } from "./error"
import { format } from "./format"
import { SyntaxError } from "./lex"
import { stdBundle } from "./lift"
import { lower } from "./lower"
import { root } from "./root"

/// The docs of the module at, named as an import names it or by its path, or else the list of the modules below the
/// directory at, each with its doc's first sentence; at is looked up here, then in bober's root, so that `bober doc
/// std` prints the same anywhere.
export function doc(at: string): string throws CompileError | IoError {
	const name = if (endsWith(at, ".bob")) at.slice(0, at.length - 4) else at
	for (const path of [name, join(root, name)]) {
		const file = clean(`${path}.bob`)
		if (exists(file) || stdBundle().has(file)) {
			const p = lower([file])
			return reference(name, p, p.module(file))
		}
		const fs = below(path)
		if (fs.length > 0) {
			const p = lower(fs)
			return fs.map(f => {
				const m = join(name, rel(path, f)!)
				const s = summary(moduleDoc(p, p.module(clean(f))))
				return `- \`${m.slice(0, m.length - 4)}\`${if (s == "") "" else ": " + s}\n`
			}).join("")
		}
	}
	throw new CompileError(`${at}: no module or directory here nor in bober's root`)
}

/// The modules below directory dir but tests and builtin/wasm/'s, which stand in for builtin/'s (src/bober.bob's
/// toWasm) and the bundle leaves out: its files, else the bundle's.
function below(dir: string): string[] throws IoError {
	const fs = glob(`${dir}/**/*.bob`).filter(f => !endsWith(f, ".test.bob") && indexOf(f, "builtin/wasm/") < 0)
	if (fs.length == 0) {
		const bundled = stdBundle().values().map(f => head(f, root).path)
		fs.push(...bundled.filter(f => startsWith(f, `${clean(dir)}/`) && endsWith(f, ".bob")))
		sort(fs)
	}
	return fs
}

/// The docs of module m of p, named name: its doc, then each exported declaration's signature (src/bc/source.bob), a
/// class's members but private ones within it, and below it its doc; those next to each other without one share a
/// block.
export function reference(name: string, p: Program, m: i32): string throws CompileError {
	let out = `# ${name}\n${paragraph(moduleDoc(p, m))}`
	let bare = false // whether the last export has no doc, so that one without shares its block
	const exports = p.modules[m].decls.filter(d => (p.decls[d].mods & decl.Export) != 0)
	sortBy(exports, (a, b) => p.decls[a].pos < p.decls[b].pos) // as lowered, an alias is before the rest
	for (const d of exports) {
		const x = p.decls[d]
		let code = signature(p, d)
		if (x.kind == decl.Class || x.kind == decl.Interface) {
			code += " {"
			for (const y of x.members.filter(y => (p.decls[y].mods & decl.Private) == 0)) {
				for (const l of if (p.decls[y].doc == 0) [] else split(p.strings[p.decls[y].doc], "\n")) {
					code += `\n\t///${if (l == "") "" else " " + l}`
				}
				code += `\n\t${signature(p, y)}`
			}
			code += "\n}"
		}
		code = layout(code)
		if (x.kind == decl.Var && indexOf(code, "\n") >= 0) {
			code = layout(signature(p, d, false))
		}
		const about = paragraph(p.strings[x.doc])
		out = (if (bare && about == "") out.slice(0, out.length - 4) else out + "\n```bober\n") + code + "\n```\n"
			+ about
		bare = about == ""
	}
	return out
}

/// The doc of module m of p, of its `//!` comments.
function moduleDoc(p: Program, m: i32): string {
	return p.modules[m].comments.filter(c => startsWith(c.text, "!")).map(c => body(c.text)).join("\n")
}

/// Code as format lays it out, without blank lines.
function layout(code: string): string throws CompileError {
	try {
		return split(trim(format(code)), "\n").filter(l => l != "").join("\n")
	} catch (e: SyntaxError) {
		throw new CompileError(`${code}: ${e.msg}`)
	}
}

/// text after a blank line, if any.
function paragraph(text: string): string { return if (trim(text) == "") "" else `\n${trim(text)}\n` }

/// The first sentence of doc.
function summary(doc: string): string {
	const s = replace(split(trim(doc), "\n\n")[0], "\n", " ")
	const i = indexOf(s, ". ")
	return if (i < 0) s else s.slice(0, i + 1)
}
