//! Where bober finds its own files: builtin/, std/ with the C it links, the run time's C (src/rt.h) and the C sysroot
//! (build/musl). Those of the repo it runs in, else those beside the bin/ or build/ that holds it: a repo, or the package
//! dist.sh makes, which builds builtin/ and std/ from a bundle, lib/std.bobc (src/lift.bob), with the C they link
//! compiled in lib/, and has their sources but tests only to read.

import { startsWith } from "../std/algo"
import { fromCString } from "../std/c"
import { exists } from "../std/fs"
import { dir, isLocal, join, rel } from "../std/fs/path"
import { executable } from "../std/process"
import { getcwd } from "unistd.h"

/// The directory of bober's files: relative in the repo and below it, so that their paths stay relative, as imports of
/// them by a relative path are.
export let root = find()
let builtins = join(root, "builtin") + "/"

/// Whether the module at path is one of builtin/'s.
export function builtin(path: string): bool { return startsWith(path, builtins) }
/// The path of builtin/'s module name.
export function builtinPath(name: string): string { return `${builtins}${name}.bob` }

function find(): string {
	if (readFile("builtin/array.bob") != null) {
		// the prelude's, which boot has before it binds src/rt.h
		return "."
	}
	try {
		const d = dir(dir(executable()))
		if (readFile(join(d, "builtin/array.bob")) != null || exists(join(d, "lib/std.bobc"))) {
			const cwd = fromCString(getcwd(0, 0))
			return if (isLocal(rel(d, cwd)!)) rel(cwd, d)! else d
		}
	} catch (e: IoError) {}
	print("bober: finds no builtin/ here nor beside the directory holding it")
	return "."
}
