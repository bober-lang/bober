#!/bin/sh
# Runs build/bobcc, built first where a source is newer, with the sysroot of src/backend/llvm/Makefile.
root=$(dirname "$0")/../..
if [ ! -x "$root/build/bobcc" ] || [ -n "$(find "$root/src" "$root/std" -name '*.bob' -newer "$root/build/bobcc")" ]; then
	(cd "$root" && build/bober build src/c/bobcc.bob > /dev/null) || exit 1
fi
exec "$root/build/bobcc" -isysroot "$root/build/musl" "$@"
