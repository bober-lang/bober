//! Tests of src/link/macho: a written dylib read back.

import { indexOf, sort } from "../../std/algo"
import { min } from "../../std/math"
import { CompileError } from "../error"
import { arm64 } from "./arm64"
import { Bytes, big, le, mapped, pad, u, zeros } from "./bytes"
import { Linker } from "./link"
import { macho } from "./macho"
import { Code, Data, Desc, Fixup, Global, Object, Section, Symbol, Thread, Unwind } from "./object"
import { sha256 } from "./sha256"

/// A section named name of kind, of bytes.
function section(name: string, kind: u8, bytes = zeros(8)): Section {
	const s = new Section(name, kind)
	s.align = 4
	s.bytes = bytes
	s.size = bytes.length as u64
	return s
}

/// An arm64 object named name, of sections.
function object(name: string, sections: Section[]): Object {
	const o = new Object(name, "arm64")
	o.sections = sections
	return o
}

/// The file of the image l links.
function file(l: Linker): Bytes throws CompileError {
	const image = l.link()
	macho.write(image)
	return image.bytes
}

/// The dylib of an object of sections, its first exported as each of names.
function dylib(sections: Section[], names: string[]): string throws CompileError {
	const o = object("a.o", sections)
	o.symbols = names.map(n => new Symbol(n, Global, 0))
	const l = new Linker(arm64, macho)
	l.add(o)
	for (const n of names) {
		l.export(n)
	}
	return mapped(file(l))
}

test "a written dylib's export trie holds the names the image exports, of shared prefixes too" {
	const names = ["a", "ab", "abc", "b", "ba"]
	const got = macho.exports("a.dylib", dylib([section("text", Code)], names))
	sort(got)
	assert got.join(" ") == names.join(" ")
}

test "a text stub's exports are those of each of its lists of symbols" {
	const tbd = "--- !tapi-tbd\nexports:\n  - symbols: [ _a, _b ]\nreexports:\n  - symbols: [ _c ]\n...\n"
	const names = macho.exports("a.tbd", tbd)
	assert names.join(" ") == "a b c"
}

test "the Unwind sections are __eh_frame of __TEXT, and the others are named as their segment" {
	const d = dylib([section("text", Code), section(".eh_frame", Unwind), section("data", Data)], ["a"])
	assert indexOf(d, pad("__eh_frame", 16) + "__TEXT") > 0 && indexOf(d, ".eh_frame") < 0
	assert indexOf(d, pad("__text", 16) + "__TEXT") > 0 && indexOf(d, pad("__data", 16) + "__DATA") > 0
}

test "a kept dylib is continued, and where an object's Unwind section was is a CIE, which the unwinder skips" {
	const cie = le(12, 4) + zeros(4) + "12345678"
	const l = new Linker(arm64, macho, new Bytes())
	for (const name of ["a", "b", "c"]) {
		l.add(object(name, [section(".eh_frame", Unwind, cie)]))
	}
	const again = new Linker(arm64, macho, new Bytes(mapped(file(l))))
	assert again.objects().join(" ") == "a b c"
	again.remove("b")
	const d = file(again)
	// The section's header: its name and its segment's, of 16 bytes each, its address, size and offset in the file.
	const head = d.slice(0, 0x1000)
	const header = indexOf(head, pad("__eh_frame", 16) + "__TEXT")
	const frames = u(head, header + 48, 4)
	assert u(head, header + 40, 8) == 48 && d.slice(frames, frames + 48) == cie + le(12, 4) + zeros(12) + cie
}

test "a kept dylib's signature hashes each page, of those a continued one has not written the old hashes" {
	const l = new Linker(arm64, macho, new Bytes())
	l.add(object("a", [section("text", Code), section("data", Data)]))
	const again = new Linker(arm64, macho, new Bytes(mapped(file(l))))
	again.add(object("b", [section("text", Code, "\xc0\x03\x5f\xd6\x00\x00\x00\x00")]))
	const d = file(again)
	// LC_CODE_SIGNATURE, of 16 bytes, is the last command.
	const head = d.slice(0, 0x1000)
	const at = u(head, (32 + u(head, 20, 4) - 16 + 8) as i32, 4)
	const cd = d.slice(at + 24, at + 24 + 40)
	const hashes = d.slice(at + 24 + big(cd, 16, 4), at + 24 + big(cd, 16, 4) + 32 * big(cd, 28, 4))
	const zero = sha256(zeros(4096))
	for (const p of 0 ... hashes.length / 32 - 1) {
		const page = (p as u64) << 12
		const hash = hashes.slice(32 * p, 32 * p + 32)
		assert hash == zero && !d.written(page)
			|| hash == sha256(d.slice(page, min(page + 4096, big(cd, 32, 4))))
	}
}

test "a thread-local's descriptor has its offset in a thread's copy, and dyld knows its section and the copy's" {
	const vars = section("__thread_vars", Data, zeros(48))
	vars.fixups = [new Fixup(16, Desc, 1, 0), new Fixup(40, Desc, 1, 8)]
	const o = object("a.o", [vars, section("__thread_data", Thread, zeros(16))])
	o.symbols = [new Symbol("a", Global, 0), new Symbol("a$tlv$init", Global, 1)]
	const l = new Linker(arm64, macho)
	l.add(o)
	l.export("a")
	const d = mapped(file(l))
	assert (u(d, 24, 4) & 0x800000) != 0 // MH_HAS_TLV_DESCRIPTORS
	// Each section's header, of 80 bytes, past the 64 from its segment's name on, has its size at 40, its offset in
	// the file at 48 and its type at 64.
	const data = indexOf(d, pad("__DATA", 16)) + 64
	assert u(d, data + 64, 4) == 0x13 && u(d, data + 40, 8) == 48 && u(d, data + 80 + 64, 4) == 0x11
	const at = u(d, data + 48, 4) as i32
	assert u(d, at + 16, 8) == 0 && u(d, at + 40, 8) == 8
}
