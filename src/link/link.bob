//! The linker, which makes one image of objects for a Format's writer (elf.bob) to make a file of. It links the objects
//! it is given and those archive members that define what they name; resolves each name to one definition, in the
//! image or in a library the image is loaded with; lays the sections out by kind, so that the image has few segments;
//! and applies each fixup, through slots and stubs it makes for what the image imports, and veneers for what a call
//! does not reach. Every reference within the image binds to the definition there, so that a symbol several objects
//! define weakly, as bober's type descriptors, has one address throughout, which code may reach relative to itself.
//!
//! An image may be kept, its file holding what its linker knows of it (keep.bob), for a later link to continue it: the
//! objects it holds stay where they are, the room of those removed is free, and those added are laid out where there is
//! room, which each segment has after it, as addresses only. What lazy objects and the linker itself link is frozen,
//! linked for good as one unit. Of the objects given, the image keeps the symbols and the fixups a link may set anew,
//! not their bytes. A link the image cannot take is Stale, and who links then links all anew.

import { lastIndexOf, merge, partitionPoint, sort, sortBy, stableSort, startsWith } from "../../std/algo"
import { HashMap } from "../../std/collections/hashmap"
import { bytes as random } from "../../std/crypto/random"
import { Writer, get, put } from "../../std/encoding/binary"
import { combine, fnv } from "../../std/hash"
import { alignUp, max, min } from "../../std/math"
import { Arch } from "../../std/os"
import { CompileError } from "../error"
import { Bytes, relr, unrelr, zeros } from "./bytes"
import { Region, State, head, read, record, rest, write } from "./keep"

import { Abs64, Call, Code, Const, Data, Desc, Fixup, Global, Image32, Image64, Init, Kept, Local, Machine, Object,
	Page, PageOff, Rel32, Rel64, Section, SlotPage, SlotPageOff, SlotRel32, Symbol, Thread, Thread32, Unwind, Weak,
	Zero } from "./object"

/// What a format's writer makes a file of. Its addresses are from where it is loaded, and the file has each segment's
/// bytes at their address; a kept image's segments have room after them, which the file has as a hole.
export class Image {
	arch: Arch
	/// The file, from offset 0, where the writer's headers go, to the end of the last region's bytes; the writer puts
	/// the rest after.
	bytes = new Bytes()
	/// Ascending, each at a multiple of page but the first, which is after the headers.
	segments: Segment[] = []
	page: u64
	/// Per name, the address and size of the sections of it, for debuggers and profilers.
	sections: [string, u64, u64][] = []
	/// The names who loads the image finds, and their addresses.
	exports: [string, u64][] = []
	libraries: string[] = []
	binds: Bind[] = []
	/// The addresses of the pointers the loader adds the image's address to, ascending; of a kept image whose format has
	/// its tables, but those of words, which are as RELR from and to where relr says.
	rebases: u64[] = []
	relr: [u64, u64] = [0, 0]
	/// From and to where the Unwind sections are, ascending, and the Init ones, laid out as one.
	unwinds: [u64, u64][] = []
	/// Of a kept image whose format has its tables: from and to where the unwinder's table may be, the code freed since
	/// the image continued, whose FDEs are gone, and from and to where the Unwind sections laid out now are.
	hdr: [u64, u64] = [0, 0]
	gone: [u64, u64][] = []
	fresh: [u64, u64][] = []
	inits: [u64, u64] = [0, 0]
	/// From and to where the Thread sections are, laid out as one, a thread's copy's template, and the largest of
	/// their alignments.
	thread: [u64, u64, u64] = [0, 0, 1]
	/// The address of each Desc fixup's bytes, and the offset of its S + A in the thread's copy.
	descs: [u64, u64][] = []
	/// Of the units whose entries in the symbol table are new: the symbols with a name each defines, their value their
	/// address and their section 0; where its entries go, of the format's size each; and where each one's name is,
	/// `_<name>` and a NUL. From and to where the table's entries are, the first zeros; and the names, the first a NUL.
	symbols: [Symbol[], u64, u64[]][] = []
	symtab: [u64, u64] = [0, 0]
	strtab: [u64, u64] = [0, 0]

	constructor(arch: Arch, page: u64) {
		this.arch = arch
		this.page = page
	}

	/// The segment the address at is in; if in none, the next one, else the last.
	segment(at: u64): Segment {
		const i = partitionPoint(this.segments, s => s.address + s.size + s.zero > at)
		return this.segments[min(i, (this.segments.length - 1) as u32)]
	}

	/// The stretches of the segments the cuts and their bounds cut them into, as name calls each, in order.
	stretches(cuts: u64[], name: (at: u64) => string): [string, u64, u64][] {
		for (const s of this.segments) {
			cuts.push(...[s.address, s.address + s.size, s.address + s.size + s.zero])
		}
		sort(cuts)
		const all: [string, u64, u64][] = []
		for (const i of 1 ... cuts.length - 1) {
			const [at, end] = [cuts[i - 1], cuts[i]]
			const s = this.segment(at)
			if (end > at && at >= s.address && end <= s.address + s.size + s.zero) {
				all.push([name(at), at, end - at])
			}
		}
		return all
	}
}

/// The index from 1 of the stretch at is in, of the last starting at or before it, or the first: so of a symbol held, one
/// that changes only as a stretch starts elsewhere.
export function stretch(stretches: [string, u64, u64][], at: u64): u64 {
	return max(partitionPoint(stretches, r => r[1] > at) as u64, 1)
}

/// A file format as who links needs it (elf.bob): the room at an image's start the file's headers take; whether who
/// loads an image sets a pointer to an import wherever it is, or its slots only; the name code knows the image's first
/// byte by, which the linker defines where no object does; read, the Object an object file's bytes are; exports, the
/// names a shared library's file defines; and write, which makes the image's bytes its file. Each entry of its symbol
/// table takes symbol bytes, 0 if it has none. Whether its loader reads a kept image's tables where they are (Image.relr).
/// Maps, another name of the image's first byte, which the addresses in section .llvm_stackmaps are then offsets from
/// (Image64), as no loader rebases them (src/gc.c); "" if they are pointers.
export type Format = { headers: u64, symbol: u64, bindsAnywhere: bool, start: string, tables: bool, maps: string,
	read: (name: string, bytes: string) => Object throws CompileError,
	exports: (name: string, bytes: string) => string[] throws CompileError,
	write: (image: Image) => void throws CompileError }

/// Bytes the loader maps, then zero bytes after them.
export type Segment = { address: u64, size: u64, zero: u64, write: bool, exec: bool }
/// A pointer the loader sets to the address of a symbol the library, an index in the image's, defines, plus addend;
/// to 0 if it does not and the bind is weak.
export type Bind = { at: u64, library: i32, name: string, weak: bool, addend: i64 }

/// What link throws when a continued image cannot take what it is asked to, who links then linking all anew.
export class Stale {
	msg: string

	constructor(msg: string) { this.msg = msg }
}

/// The bytes of a name's entry in a kept image, after the table of names: where its name is, and how long; its
/// library, unit and section, each plus 1; its value, address, slot, stub and chain; and whether weak.
const entry: u64 = 72
/// Those of a unit's, after the table of units: of its blocks, then of its two of rebases, where each is and how big,
/// in 12 bytes; none of a unit unlinked or frozen but the first. The size of its record has, past the 2 GiB the file
/// stays below, whether it was supplied, and past 1 GiB, which no unit's record nears, whether it has Kept sections.
const unitEntry: u64 = 72
const supplying: u64 = 1 << 31
const keeping: u64 = 1 << 30
/// Of a link of a chain (Linker.links), whether its symbol defines the name, and whether it does not weakly.
const defining: u64 = 1 << 63
const strong: u64 = 1 << 62
/// The address of a section of a group whose sections another object's are taken of.
const dropped: u64 = 0xffffffff_ffffffff
/// The address of a slot or stub the linker's own unit makes, until it is laid out.
const planned: u64 = 1
/// Whether a fixup of kind is of its symbol's slot.
const slotted = (kind: u8) => kind == SlotPage || kind == SlotPageOff || kind == SlotRel32
/// The kind of the symbol table's region, of no section.
const Symbols: u8 = 8
/// The sections of each segment, by kind, in order; and of a kept image's, where the Zero ones are a segment of their
/// own, as each before the last has room after it: addresses no file holds, for what later links add; and the Unwind
/// ones the first, with the headers, where Mach-O's unwinder reads them one after another. An image with a full region
/// is linked anew. Last, two regions no loader maps: of the symbol table's entries, and of the Kept sections and what a
/// kept image keeps (save), whose room, the most, is past the file's end. A kept image's sections of a bound name are
/// in a run of their region, of a 16th of its room, that they are laid out in as others in theirs, where its holes are
/// zeros.
const regions: u8[][] = [[Code], [Const, Unwind], [Data, Init, Thread, Zero], [Symbols], [Kept]]
const keptRegions: u8[][] = [[Unwind], [Code], [Const], [Data, Init, Thread], [Zero], [Symbols], [Kept]]
/// Of a region's room; of the symbol table's, which has the head too, of some 7 MiB of entries and 1 of head measured;
/// and of the Kept region's. An image's bytes stay below 2 GiB, so a mapped region's room is as much as its content,
/// but no more than room nor less than an 8th of it, two runs: it fills, and the image is linked anew, of its rooms
/// again, only once its content about doubles, and the Kept region has what the mapped ones leave.
const room: u64 = 1 << 28
const tableRoom: u64 = 1 << 26
const keptRoom: u64 = 1 << 30
/// The name of a kept image's run of its Const region of its rebases of words, as RELR, which no section's can be; the
/// holes in it are entries of no rebase.
const rebasing = ".relr"
/// That of its run of the unwinder's table, if its format has its tables.
const unwinding = ".eh_frame_hdr"
/// Of a machine with veneers, the code has an island of them at each multiple of span from its start but the first,
/// which no section is laid out over, so that a call too far for its symbol reaches one, on arm64 128 MiB away.
const span: u64 = 1 << 26
const island: u64 = 1 << 22

/// A name the objects share: the definition taken for it, and its address once laid out.
class Name {
	name: string
	/// The unit, section and offset defining it, unit -1 while none does, and section -1 if it is the format's start,
	/// address 0; and whether weakly.
	unit = -1
	section = -1
	value: u64 = 0
	weak = false
	/// The first unit this link defines that names it without defining it, and not weakly, so that it must be defined; -1
	/// if none does.
	namer = -1
	/// The library it is imported from, -1 if none.
	library = -1
	/// The address of its slot, and of its stub; 0 if it has none.
	slot: u64 = 0
	stub: u64 = 0
	address: u64 = 0
	/// In a kept image, the first link of the chain of the units' symbols of it (Linker.chained), 0 if none; and it as
	/// the continued image has it, null if new.
	chain: u64 = 0
	was: Name | null = null
	/// In a kept image, where its name is, after a `_` and before a NUL, as the symbol table has it; 0 until saved.
	at: u64 = 0

	constructor(name: string) { this.name = name }
}

/// Whether n's definition is another than was's, or if address, its address.
function moved(n: Name, was: Name, address: bool): bool {
	return if (address) n.address != was.address
		else n.unit != was.unit || n.section != was.section || n.value != was.value || n.library != was.library
}

/// An object as linked: per symbol, the index of its Name, -1 if it is local; per section, its address, 0 while it is
/// to be laid out, or dropped; whether it is frozen; the bytes the continued image has its object as, "" once it is
/// not as there; its blocks of the file: of its record, its symbols' links (chained), then their entries in the symbol
/// table and their names, if the format has one, none until saved; and the bytes its symbols' links are in
/// (Linker.links), its block of them in the image's, or until saved, bytes of its own, and where they are in those. In a
/// kept image, its blocks of the run of rebases (rebased): of those its fixups set, and the frozen one's then of those
/// set for good.
class Unit {
	object: Object
	names: i32[] = []
	at: u64[]
	frozen: bool
	encoded = ""
	blocks: [u64, u64][] = []
	relr: [u64, u64][] = []
	links = new Bytes()
	from: u64 = 0
	/// Whether it was supplied (Linker.add).
	supplied = false

	constructor(o: Object, frozen = false) {
		this.object = o
		this.at = new u64[](o.sections.length)
		this.frozen = frozen
	}
}

export class Linker {
	private machine: Machine
	private format: Format
	/// The units: those the continued image holds, the frozen one first, null until read of their entries (held); then
	/// those given and lazy, and last, the linker's own.
	private units: (Unit | null)[] = []
	/// What is given the names wanted and the units gone (supply).
	private supplier: (names: string[], gone: string[]) => void throws CompileError = (names, gone) => {}
	private libraries: string[] = []
	/// Per name a library defines, the first that does.
	private imports = new HashMap[string, i32]()
	private exported: string[] = []
	/// The names: the shared ones, then the local ones a slot needs (unshared), from shared on; of a continued image,
	/// null until read of their entries (entry). Until plan, shared is how many the continued image has. Those not null,
	/// in the order made.
	private names: (Name | null)[] = []
	private shared = 0
	private touched: i32[] = []
	/// The table of the shared names' indices by their hash of seed, slot by slot (slot); in the image's bytes where a
	/// continued image has it, else in bytes of its own; and whether it is not as made, so that the image is linked anew.
	/// A kept image's is made anew, of more slots, once over half full; names no longer named stay until the image is
	/// linked anew. After it, the names' entries.
	private table = new Bytes()
	private at: u64 = 0
	private cap: u64 = 1024
	private entries: u64 = 0
	private seed: u64 = 0
	private broken = false
	/// The names wanted, in the order first wanted, which the supplier is given.
	private wanted: i32[] = []
	/// Per group, the unit whose sections of it are taken; of those the continued image holds, as resolve found them,
	/// but those unlinked since.
	private groups = new HashMap[string, i32]()
	/// The names x of the `__start_x` and `__stop_x` defined.
	private bounded: string[] = []
	private errors: string[] = []
	/// Whether the image is kept; what it keeps of its linker; how many units the continued image holds, the frozen one
	/// first, and of them those removed; and its file.
	private keep: bool
	private regions: u8[][]
	private state = new State()
	private loaded = 0
	private removed: i32[] = []
	/// The names the units unlinked named, of which a supplied unit's may be named no more (orphans), until resolve.
	private lost: i32[] = []
	private bytes = new Bytes()
	/// The links of the units chained (chained) not read of the image, each at its from.
	private chains = new Bytes()
	/// Of the units it holds but the frozen one, those unlinked or fixed, whose entries save writes anew; and how many it
	/// read (held).
	private changes: i32[] = []
	reads = 0
	/// Where the fixups this link sets anew are, or those of the units it unlinks, whose pointers, binds and descs the
	/// continued image keeps no longer; ascending once fixed.
	private redone: u64[] = []
	/// From and to where the code is that it unlinks.
	private gone: [u64, u64][] = []
	/// The veneers, per island and address they jump to, and how much of each island they take; and where the fixups
	/// this link set through one are, which a unit's record keeps.
	private veneers = new HashMap[string, u64]()
	private filled = new HashMap[u64, u64]()
	private veneered = new HashMap[u64, bool]()
	/// The index of the code's region.
	private code: i32

	/// A linker of objects of machine's CPU into an image for format's writer; if kept is not null, into one that is
	/// kept, which continues the image whose file's bytes kept are, if it is one, writing over them.
	constructor(machine: Machine, format: Format, kept: Bytes | null = null) {
		this.machine = machine
		this.format = format
		this.keep = kept != null
		this.regions = if (kept != null) keptRegions else regions
		this.code = this.regions.map(r => r[0]).indexOf(Code)
		const s = if (kept != null) read(kept, format.headers, machine.arch) else null
		// Whether table t, of entries of size each, is in the file, and of half its slots at most, and some.
		const fits = (t: [u64, u64, u64], size: u64) => t[1] > 0 && t[2] <= t[1] / 2 && t[1] & (t[1] - 1) == 0
			&& t[0] <= kept!.length && t[1] <= (kept!.length - t[0]) / (12 + size / 2)
		if (s == null || !fits(s.names, entry) || !fits(s.units, unitEntry) || s.units[2] == 0) {
			return
		}
		this.state = s
		this.bytes = kept!
		this.loaded = s.units[2] as i32
		this.units = new (Unit | null)[](this.loaded)
		for (const [k, v, at] of s.veneers) {
			this.veneers.set(`${k} ${v}`, at)
			this.filled.set(k, max(this.filled.get(k) ?? 0, at + (machine.veneer.length as u64) - this.island(k)))
		}
		const [at, cap, count] = s.names
		this.table = kept!
		this.at = at
		this.cap = cap
		this.entries = at + 12 * cap
		this.seed = s.seed
		this.shared = count as i32
		this.names = new (Name | null)[](count as i32)
	}

	/// Links o, in a continued image after the objects it holds; if supplied, made for names wanted (supply), so that a
	/// continued image unlinks it once the units it holds name none of the names it defines (orphans).
	add(o: Object, supplied = false) {
		if (o.arch != this.machine.arch) {
			this.errors.push(`${o.name} is of ${o.arch}, not ${this.machine.arch}`)
		}
		const u = new Unit(o)
		u.supplied = supplied
		this.units.push(u)
	}

	/// The names of the objects given that the continued image holds, in order.
	objects(): string[] {
		const out: string[] = []
		for (const k of 1 ... this.loaded - 1) {
			const name = this.held(k).object.name
			if (name != "") {
				out.push(name)
			}
		}
		return out
	}

	/// The bytes of the sections of that name of the objects given that the continued image holds; if a key is given, of
	/// those whose key it is (holds).
	sections(name: string, key: string | null = null): string[] {
		const ks = if (key != null) this.keyed(key!) else [] as i32[]
		for (const k of 1 ... if (key == null) this.loaded - 1 else 0) {
			ks.push(k)
		}
		const out: string[] = []
		for (const k of ks) {
			if (!this.keeps(k)) {
				continue // as all such sections are Kept
			}
			const u = this.held(k)
			for (const i of 0 ... u.object.sections.length - 1) {
				const sec = u.object.sections[i]
				if (sec.name == name && u.at[i] != dropped) {
					out.push(this.bytes.slice(u.at[i], u.at[i] + sec.size))
				}
			}
		}
		return out
	}

	/// The names of the objects given that the continued image holds whose key is key: their name up to its last @, or
	/// all of it if it has none.
	holds(key: string): string[] { return this.keyed(key).map(k => this.held(k).object.name) }

	/// Unlinks the object of that name the continued image holds, once it links.
	remove(name: string) {
		const k = this.keyed(key(name)).find(k => this.held(k).object.name == name)
		if (k != null) {
			this.removed.push(k!)
		}
	}

	/// The names starting with of that the objects removed define.
	defined(of: string): string[] throws CompileError {
		const out: string[] = []
		for (const k of this.removed) {
			out.append(this.symbols(k, of))
		}
		return out
	}

	/// The names starting with of that the object of that name the continued image holds defines.
	defines(name: string, of: string): string[] throws CompileError {
		const k = this.keyed(key(name)).find(k => this.held(k).object.name == name)
		return if (k == null) [] else this.symbols(k!, of)
	}

	private symbols(k: i32, of: string): string[] throws CompileError {
		const u = this.read(k)
		const out: string[] = []
		for (const j of 0 ... u.names.length - 1) {
			const name = if (u.names[j] >= 0) this.entry(u.names[j]).name else ""
			if (u.names[j] >= 0 && u.object.symbols[j].section >= 0 && startsWith(name, of)) {
				out.push(name)
			}
		}
		return out
	}

	/// The names of the objects the continued image holds, but those removed, that name name so that it must be defined.
	naming(name: string): string[] throws CompileError {
		const g = this.find(name)
		return if (g < 0) []
			else this.namers(this.entry(g)).filter(k => k > 0 && k < this.loaded
			&& !this.removed.includes(k)).map(k => this.held(k).object.name)
	}

	/// Has f, after those given before, add objects for the names the units want that none defines, but those the
	/// continued image's units name, which a link before looked for; once there are none, f is given by name the units
	/// the continued image held that name what none defines, unlinked now. Again until neither is left; only then are
	/// the supplied units no unit names any more unlinked (add), so that a name of a unit holds gave, but one removed,
	/// is never wanted.
	supply(f: (names: string[], gone: string[]) => void throws CompileError) {
		const before = this.supplier
		this.supplier = (names, gone) => {
			before(names, gone)
			f(names, gone)
		}
	}

	/// Links for good, as an archive's members are, of the objects list gives, each the names it defines and how to read
	/// it, those first to define a name wanted, each once; list is called once a name is wanted.
	lazily(list: () => [string[], () => Object throws CompileError][] throws CompileError) {
		let members: [string[], () => Object throws CompileError][] | null = null
		const first = new HashMap[string, i32]() // -1 once taken
		this.supply((names, gone) => {
			if (members == null && names.length > 0) {
				members = list()
				for (const m of 0 ... members!.length - 1) {
					for (const name of members![m][0].filter(name => !first.has(name))) {
						first.set(name, m)
					}
				}
			}
			for (const name of names) {
				const m = first.get(name) ?? -1
				if (m >= 0) {
					const [defined, read] = members![m]
					for (const n of defined) {
						first.set(n, -1)
					}
					this.units.push(new Unit(read(), this.keep))
				}
			}
		})
	}

	/// A shared library the image is loaded with, and the symbols it defines.
	library(name: string, symbols: string[]) {
		for (const s of symbols) {
			if (!this.imports.has(s)) {
				this.imports.set(s, this.libraries.length)
			}
		}
		this.libraries.push(name)
	}

	/// Lets who loads the image find the symbol by its name.
	export(name: string) { this.exported.push(name) }

	/// Whether what it was asked so far changes the image it continues: an object added or removed, or a name exported
	/// anew.
	changed(): bool {
		return this.units.length != this.loaded || this.removed.length > 0
			|| this.exported.some(e => !this.state.exports.includes(e))
	}

	/// The image; throws a CompileError naming the symbols no one defines or two do, or if it continues one, a Stale
	/// of whatever fails.
	link(): Image throws CompileError | Stale {
		try {
			return this.make()
		} catch (e: CompileError) {
			if (this.loaded > 0) {
				throw new Stale(e.msg)
			}
			throw e
		}
	}

	private make(): Image throws CompileError {
		// Tables made anew are of a seed of their own, drawn here, as a linker only read of (sections, objects) draws none.
		if (this.loaded == 0) {
			try {
				this.seed = fnv(random(8))
			} catch (e: IoError) {}
		}
		if (this.loaded > 0 && this.libraries.join("\n") != this.state.libraries.join("\n")) {
			throw new CompileError("the libraries are others")
		}
		// A kept image's frozen unit is first, which in one linked anew is made of none at first.
		if (this.keep && this.loaded == 0) {
			this.units = [new Unit(new Object("the image", this.machine.arch), true), ...this.units]
		}
		for (const k of this.removed) {
			this.unlink(k)
		}
		// Of the units the continued image holds, the groups taken.
		for (const k of this.state.grouped) {
			const u = this.held(k)
			for (const i of 0 ... u.at.length - 1) {
				const group = u.object.sections[i].group
				if (group != "" && u.at[i] != dropped && !this.groups.has(group)) {
					this.groups.set(group, k)
				}
			}
		}
		this.resolve()
		// The units this link sets the fixups of: those it links anew, and of those the continued image holds, those
		// naming a name defined anew, and once laid out, a name moved.
		const fixed = new HashMap[i32, bool]()
		const ks: i32[] = []
		const dirty = (address: bool) => {
			const fix = (k: i32) => {
				if (!fixed.has(k)) {
					fixed.set(k, true)
					ks.push(k)
				}
			}
			for (const k of this.loaded ... this.units.length - 1) {
				fix(k)
			}
			for (const g of this.touched) {
				const n = this.names[g]!
				if (n.was != null && moved(n, n.was!, address)) {
					for (const l of this.links(n)) {
						fix(this.unit(l))
					}
				}
			}
			sort(ks)
			return ks
		}
		const own = this.plan(dirty(false))
		const defined = (name: string) => {
			const g = this.find(name)
			return g >= 0 && this.entry(g).unit >= 0
		}
		for (const name of this.exported) {
			if (!defined(name)) {
				this.errors.push(`${name} is exported but not defined`)
			}
		}
		if (this.broken) {
			throw new CompileError("the table of names is broken")
		}
		if (this.errors.length > 0) {
			throw new CompileError(this.errors.join("\n"))
		}
		this.units.push(own)
		const image = new Image(this.machine.arch, this.machine.page)
		image.gone = this.gone
		image.libraries = this.libraries
		image.inits = this.state.inits
		image.thread = this.state.thread
		this.layout(this.format.headers + (if (this.keep) 24 else 0), image)
		for (const g of this.touched) {
			const n = this.names[g]!
			// Of a definition held, as it was.
			const held = n.was != null && !moved(n, n.was!, false) && n.unit < this.loaded
			n.address = if (n.section < 0) 0 else if (held) n.address else this.held(n.unit).at[n.section] + n.value
		}
		const bound = (name: string, at: u64) => {
			const g = this.find(name)
			if (g >= 0 && this.entry(g).unit >= 0) {
				this.entry(g).address = at
			}
		}
		for (const [x, run] of this.state.runs) {
			bound(`__start_${x}`, run.start)
			bound(`__stop_${x}`, run.top)
		}
		// The slots and stubs own makes are where it is laid out.
		for (const f of own.object.sections[1].fixups) {
			this.names[own.names[f.symbol]]!.slot = own.at[1] + f.at
		}
		const stub = this.machine.stub.length as u64
		for (const f of own.object.sections[0].fixups) {
			this.names[own.names[f.symbol]]!.stub = own.at[0] + f.at - f.at % stub
		}
		this.fix(image, dirty(true))
		if (this.errors.length > 0) {
			throw new CompileError(this.errors.join("\n"))
		}
		// The pointers, binds and descs the continued image has of the fixups not set anew, and this link's.
		const s = this.state
		sort(this.redone)
		const old = (at: u64) => {
			const i = partitionPoint(this.redone, x => x >= at) as i32
			return i == this.redone.length || this.redone[i] != at
		}
		sort(image.rebases)
		let i = 0
		const rebases = s.rebases.filter(at => {
			while (i < this.redone.length && this.redone[i] < at) {
				i++
			}
			return i == this.redone.length || this.redone[i] != at
		})
		s.rebases = [...rebases, ...image.rebases]
		merge(s.rebases, rebases.length, (a, b) => a < b)
		s.binds = [...s.binds.filter(b => old(b[0])), ...image.binds.map(b => {
			const t: [u64, i32, string, bool, i64] = [b.at, b.library, b.name, b.weak, b.addend]
			return t
		})]
		s.descs = [...s.descs.filter(d => old(d[0])), ...image.descs]
		image.rebases = s.rebases
		image.binds = s.binds.map(b => ({ at: b[0], library: b[1], name: b[2], weak: b[3], addend: b[4] }))
		image.descs = s.descs
		// A continued image's exports are those it had, but the names no longer defined, and those asked for now.
		const exports = [...this.state.exports.filter(e => defined(e) && !this.exported.includes(e)), ...this.exported]
		for (const name of exports) {
			image.exports.push([name, this.entry(this.find(name)).address])
		}
		if (this.keep) {
			this.save(image, exports)
			const run = this.state.runs.find(e => e[0] == rebasing)
			const [from, to] = if (run != null) [run[1].start, run[1].top] else [0, 0]
			if (this.format.tables) {
				image.relr = [from, to]
			} else {
				image.rebases = [...image.rebases, ...unrelr(this.bytes.slice(from, to))]
				sort(image.rebases)
			}
		}
		const [table, kept] = [this.state.regions[this.regions.length - 2], this.state.regions[this.regions.length - 1]]
		image.symtab = [table.start, table.top]
		// The names end at the top, where a link before may have left a byte.
		image.bytes.set(kept.top, "\x00")
		image.strtab = [kept.start, kept.top + 1]
		image.bytes.length = max(image.bytes.length, kept.top + 1)
		if (image.bytes.length >= 1 << 31) {
			throw new CompileError(`the image would be ${image.bytes.length} bytes, 2 GiB or more`)
		}
		return image
	}

	/// Resolves the names of the units, and of those the supplier adds. The units the continued image holds that name
	/// what none defines are unlinked, and the names they defined defined anew; once the supplier adds none, the orphans.
	private resolve() throws CompileError {
		let k = this.loaded
		let w = 0
		while (true) {
			while (k < this.units.length) {
				this.define(k)
				k++
			}
			const names = this.wanted.slice(w, this.wanted.length).map(g => this.names[g]!).filter(n => n.unit < 0
				&& this.first(n, l => l & (defining | strong) == strong && this.unit(l) < this.loaded) == 0)
			w = this.wanted.length
			const gone = if (names.length > 0) [] as i32[] else this.settle()
			if (names.length == 0 && gone.length == 0 && this.lost.length == 0) {
				return
			} else if (names.length == 0 && gone.length == 0) {
				this.orphans()
				continue
			}
			const lost = gone.map(k => this.held(k).object.name)
			for (const k of gone) {
				this.unlink(k)
			}
			this.supplier(names.map(n => n.name), lost)
		}
	}

	/// Unlinks unit k, an object the continued image holds, its room free then, but if it has sections the image has
	/// for good; the names it defines defined by the others that do, if any. It is then of no name.
	private unlink(k: i32) {
		const u = this.read(k)
		for (const i of 0 ... u.object.sections.length - 1) {
			const sec = u.object.sections[i]
			if (u.at[i] != dropped && this.pinned(sec)) {
				this.errors.push(`${u.object.name} has ${sec.name}, which the image has for good`)
			}
			if (sec.group != "" && this.groups.get(sec.group) == k) {
				this.groups.delete(sec.group)
			}
			if (u.at[i] != 0 && u.at[i] != dropped) {
				this.free(u.at[i], sec.size)
				if (sec.kind == Code) {
					this.gone.push([u.at[i], u.at[i] + sec.size])
				}
				for (const f of sec.fixups) {
					this.redone.push(u.at[i] + f.at)
				}
			}
		}
		for (const j of 0 ... u.names.length - 1) {
			if (u.names[j] >= 0) {
				const n = this.entry(u.names[j])
				this.unchain(n, k, j)
				if (n.unit == k) {
					this.redefine(n)
				} else if (u.object.symbols[j].binding == Global) {
					this.lost.push(u.names[j])
				}
			}
		}
		for (const [at, size] of [...u.blocks, ...u.relr]) {
			this.free(at, size)
		}
		this.units[k] = new Unit(new Object("", this.machine.arch))
		this.changes.push(k)
	}

	/// Unlinks each supplied unit the continued image holds that defines a name lost, once no unit names any name it
	/// defines so that it must be defined, nor is it exported; and then those of the names it named. Supplied units that
	/// name each other stay, until a link anew.
	private orphans() {
		while (this.lost.length > 0) {
			const k = this.entry(this.lost.pop()!).unit
			if (k > 0 && k < this.loaded && this.supplied(k) && !this.named(k)) {
				this.unlink(k)
			}
		}
	}

	/// Whether unit k was supplied, of one held not read as its entry says.
	private supplied(k: i32): bool {
		const u = this.units[k]
		return if (u != null) u.supplied else this.field(k, 8, 4) & supplying != 0
	}

	/// Whether unit k has Kept sections, of one held not read as its entry says.
	private keeps(k: i32): bool {
		const u = this.units[k]
		return if (u != null) u.object.sections.some(x => x.kind == Kept) else this.field(k, 8, 4) & keeping != 0
	}

	/// Whether a name unit k defines is named so that it must be defined, or exported.
	private named(k: i32): bool {
		const u = this.read(k)
		for (const j of 0 ... u.names.length - 1) {
			const s = u.object.symbols[j]
			if (u.names[j] < 0 || s.section < 0 || u.at[s.section] == dropped) {
				continue
			}
			const n = this.entry(u.names[j])
			if (this.first(n, l => l & (defining | strong) == strong) != 0 || this.exported.includes(n.name)
				|| this.state.exports.includes(n.name)) {
				return true
			}
		}
		return false
	}

	/// Takes the groups of unit k's sections no unit before has, and its definitions over weak ones, and notes what it
	/// names; one over a definition of the frozen unit is an error, as the fixups to it are set for good, and so is a
	/// unit a continued image does not hold with a section it has for good.
	private define(k: i32) {
		const u = this.held(k)
		const o = u.object
		if (this.loaded > 0 && k >= this.loaded && o.sections.some(s => this.pinned(s))) {
			this.errors.push(`${o.name} has sections the image has for good`)
		}
		for (const i of 0 ... o.sections.length - 1) {
			const sec = o.sections[i]
			if (u.at[i] == dropped) {
				continue // a kept object's, whose group another has
			}
			const group = sec.group
			if (group != "") {
				const owner = this.groups.get(group) ?? k
				this.groups.set(group, owner)
				if (owner != k) {
					u.at[i] = dropped
					continue
				}
			}
			if (sec.name == ".llvm_stackmaps" && this.format.maps != "") {
				for (const f of sec.fixups.filter(f => f.kind == Abs64)) {
					f.kind = Image64
				}
			}
			if (sec.kind == Const && sec.fixups.some(f => f.kind == Abs64) && !this.state.pointed.includes(sec.name)) {
				this.state.pointed.push(sec.name)
			}
		}
		if (this.keep) {
			ordered(o)
		}
		u.names = o.symbols.map(s => if (s.binding == Local) -1 else this.name(s.name))
		this.chained(k)
		for (const j of 0 ... o.symbols.length - 1) {
			const s = o.symbols[j]
			const g = u.names[j]
			if (g < 0) {
				continue
			}
			const n = this.names[g]!
			if (s.section >= 0 && u.at[s.section] != dropped) {
				if (n.unit < 0 || n.weak && s.binding == Global) {
					if (n.unit == 0 && this.loaded > 0) {
						this.errors.push(`${s.name} of ${o.name} is defined for good`)
					}
					n.unit = k
					n.section = s.section
					n.value = s.value
					n.weak = s.binding == Weak
					n.library = -1
				} else if (!n.weak && s.binding == Global) {
					this.errors.push(`${s.name} is defined in ${this.held(n.unit).object.name} and ${o.name}`)
				}
			} else if (s.binding == Global && n.namer < 0) {
				// Also for a definition in a dropped section, which the sections taken for it need not hold.
				n.namer = k
				this.wanted.push(g)
			}
		}
	}

	/// Defines each name no unit defines: the format's start, by its name or by maps, `__start_<x>` and `__stop_<x>`
	/// as the bounds of the sections named x, else as an import; and notes those a unit must have defined that are none of
	/// these, or if the continued image holds those that name them, these. The others are weak, and 0.
	private settle(): i32[] {
		const gone: i32[] = []
		for (const g of this.touched) {
			const n = this.names[g]!
			if (n.unit >= 0) {
				continue
			}
			if (n.name == this.format.start || n.name == this.format.maps) {
				n.unit = 0
				n.section = -1
				continue
			}
			const start = startsWith(n.name, "__start_")
			if (start || startsWith(n.name, "__stop_")) {
				this.bound(n, n.name.slice(if (start) 8 else 7, n.name.length), !start)
			}
			n.library = if (n.unit < 0) this.imports.get(n.name) ?? -1 else -1
			if (n.unit >= 0 || n.library >= 0) {
				continue
			}
			const namers = this.namers(n)
			const k = if (n.namer >= 0) n.namer else namers.find(k => k >= this.loaded || this.frozen(k)) ?? -1
			if (k >= 0) {
				this.errors.push(`${n.name} is not defined, but ${this.held(k).object.name} names it`)
			} else {
				gone.push(...namers.filter(k => !gone.includes(k)))
			}
		}
		return gone
	}

	/// Defines n as the start of the first section named x, or as the stop of the last, if x is a C identifier; they
	/// are of one kind, as only those are laid out together. In a kept image, n is of no section, as the format's start,
	/// but its address the start or top of their run (make), which those laid out before must be in.
	private bound(n: Name, x: string, stop: bool) {
		if (!identifier(x)) {
			return
		}
		if (!this.bounded.includes(x)) {
			this.bounded.push(x)
		}
		let laid = this.state.sections.includes(x)
		for (const k of 0 ... this.units.length - 1) {
			const u = this.held(k)
			for (const i of 0 ... u.object.sections.length - 1) {
				const sec = u.object.sections[i]
				if (sec.name != x || u.at[i] == dropped) {
					continue
				}
				laid = laid || u.at[i] != 0
				if (n.unit >= 0 && this.kind(this.held(n.unit).object.sections[n.section]) != this.kind(sec)) {
					this.errors.push(`${n.name} bounds sections of several kinds, as that of ${u.object.name}`)
				}
				if (stop || n.unit < 0) {
					n.unit = k
					n.section = i
					n.value = if (stop) sec.size else 0
				}
			}
		}
		if (laid && !this.state.runs.some(e => e[0] == x)) {
			this.errors.push(`${n.name} bounds sections the image has laid out`)
		}
		if (this.keep && n.unit >= 0) {
			n.section = -1
		}
	}

	/// The linker's own unit: a slot for each name a fixup reaches through one, and a stub, and its slot, for each
	/// import a call reaches, but those the image has. Their fixups reach a name by a weak symbol, so that the slot of
	/// one a continued image no longer has is 0.
	private plan(ks: i32[]): Unit {
		const stubs = new Section("stubs", Code)
		const slots = new Section("slots", Data)
		stubs.align = 4
		slots.align = 8
		this.shared = this.names.length
		const own = new Unit(new Object("linker", this.machine.arch), this.keep)
		own.object.sections = [stubs, slots]
		own.at = [0, 0]
		for (const k of [...this.state.grouped, ...ks.filter(k => k >= this.loaded)]) {
			const u = this.held(k)
			for (const i of 0 ... u.at.length - 1) {
				if (u.at[i] == dropped && !this.groups.has(u.object.sections[i].group)) {
					// A kept object's, whose bytes are gone, or an added one's, of a group no object has now, as the unit
					// taken is unlinked.
					this.errors.push(`${u.object.name} has ${u.object.sections[i].group}, which no object has now`)
				}
			}
		}
		for (const k of ks) {
			const u = this.read(k)
			const o = u.object
			for (const i of 0 ... o.sections.length - 1) {
				if (u.at[i] == dropped) {
					continue
				}
				for (const f of o.sections[i].fixups) {
					const slot = slotted(f.kind)
					if (u.names[f.symbol] < 0 && slot) {
						this.unshared(k, f.symbol)
					}
					const g = u.names[f.symbol]
					if (g < 0) {
						continue
					}
					const n = this.entry(g)
					const call = this.stubbed(f.kind, n)
					if (!((slot || call) && n.slot == 0 || call && n.stub == 0)) {
						continue
					}
					const j = own.names.length
					own.names.push(g)
					own.object.symbols.push(new Symbol(n.name, Weak))
					if (n.slot == 0) {
						n.slot = planned
						slots.fixups.push(new Fixup(8 * (slots.fixups.length as u64), Abs64, j, 0))
					}
					if (call && n.stub == 0) {
						n.stub = planned
						const at = stubs.bytes.length as u64
						stubs.bytes += this.machine.stub
						for (const [off, kind, addend] of this.machine.stubFixups) {
							stubs.fixups.push(new Fixup(at + off, kind, j, addend))
						}
					}
				}
			}
		}
		slots.bytes = fromBytes(new u8[](8 * slots.fixups.length))
		stubs.size = stubs.bytes.length as u64
		slots.size = slots.bytes.length as u64
		return own
	}

	/// Makes local symbol i of unit k a Name of its own, not shared, as a slot needs one.
	private unshared(k: i32, i: i32) {
		const u = this.held(k)
		const s = u.object.symbols[i]
		if (s.section < 0 || u.at[s.section] == dropped) {
			this.errors.push(`${u.object.name}: a slot of ${s.name} refers to a section that is not linked`)
			return
		}
		const n = new Name(s.name)
		n.unit = k
		n.section = s.section
		n.value = s.value
		u.names[i] = this.names.length
		this.touched.push(this.names.length)
		this.names.push(n)
	}

	/// Whether a fixup of kind reaches n through its stub: a call to an import, and if the loader sets only slots, any
	/// reference to one but through its slot, the stub being the import's address as far as the image can tell.
	private stubbed(kind: u8, n: Name): bool {
		return n.unit < 0 && (kind == Call || !this.format.bindsAnywhere && n.library >= 0 && !slotted(kind))
	}

	/// The kind sec is laid out as: Data for a Const one of a name of which one holds a pointer, which who loads the
	/// image sets, or in a kept image did, so that those of a name stay together.
	private kind(sec: Section): u8 {
		return if (sec.kind == Const && this.state.pointed.includes(sec.name)) Data else sec.kind
	}

	/// Whether sec is laid out for good in a kept image, and the object of it with it: an Init or Thread one, which the
	/// image has as one.
	private pinned(sec: Section): bool { return sec.kind == Init || sec.kind == Thread }

	/// Lays the sections out from base on, each region of kinds a segment: those of a kind and name together, by their
	/// order, after those of the kinds and names before; in a continued image, those of the units not held where there
	/// is room for them as one.
	private layout(base: u64, image: Image) throws CompileError {
		const index = new HashMap[string, i32]()
		const runs: [u8, string, i64[]][] = []
		for (const k of this.loaded ... this.units.length - 1) {
			const u = this.held(k)
			for (const i of 0 ... u.object.sections.length - 1) {
				const sec = u.object.sections[i]
				if (u.at[i] != dropped) {
					const key = sec.name + chr(this.kind(sec))
					const r = index.get(key) ?? runs.length
					if (r == runs.length) {
						index.set(key, r)
						runs.push([this.kind(sec), sec.name, []])
					}
					runs[r][2].push((k as i64) << 32 | (i as i64))
				}
			}
		}
		const sec = (ref: i64) => this.held((ref >> 32) as i32).object.sections[ref & 0xffffffff]
		for (const r of runs) {
			stableSort(r[2], (a: i64, b: i64) => sec(a).order < sec(b).order)
		}
		// Per run laid out now: its name and kind, and from and to where it is.
		const laid: [string, u8, u64, u64][] = []
		const regions = this.regions
		let file = base
		for (const r of 0 ... regions.length - 1) {
			const fresh = this.state.regions.length == r
			if (fresh) {
				this.state.regions.push(new Region(if (r == 0) base else this.state.regions[r - 1].cap))
				// One no loader maps starts with zeros, a symbol table's first entry and a string table's first byte.
				this.state.regions[r].top += if (regions[r][0] >= Kept) this.format.symbol else 0
			}
			const region = this.state.regions[r]
			// Before it, the run of the rebases, of the pointers of the data, and of the unwinder's table, made once there
			// are those.
			if (this.keep && regions[r][0] == Const) {
				const has = (kinds: u8[]) => runs.some(e => kinds.includes(e[0]) && e[2].some(ref => sec(ref).size > 0))
				this.run(region, rebasing, has([Data, Init, Thread]))
				const hdr = if (this.format.tables) this.run(region, unwinding, has([Unwind])) else null
				image.hdr = if (hdr != null) [hdr.start, hdr.cap] else [0, 0]
			}
			let end = if (regions[r][0] == Zero) region.start else region.top
			for (const kind of regions[r]) {
				for (const [rk, name, todo] of runs) {
					if (rk != kind) {
						continue
					}
					const [from, to] = this.place(this.run(region, name) ?? region, todo)
					laid.push([name, kind, from, to])
					if (kind == Unwind) {
						image.fresh.push([from, to])
					}
					if (to > from && kind == Init) {
						image.inits = [if (image.inits[1] == 0) from else image.inits[0], to]
					} else if (to > from && kind == Thread) {
						const [first, _, most] = image.thread
						let align = most
						for (const ref of todo) {
							align = max(align, sec(ref).align)
						}
						image.thread = [if (image.thread[1] == 0) from else first, to, align]
					}
					if (kind != Zero) {
						end = region.top
					}
				}
			}
			if (fresh) {
				const of = if (regions[r][0] == Symbols) tableRoom
					else if (regions[r][0] == Kept) keptRoom
					else min(room, max(region.top - region.start, room / 8))
				region.cap = alignUp(region.top + (if (this.keep) of else 0), image.page)
			}
			if (region.top > region.start) {
				if (regions[r][0] < Kept) {
					image.segments.push({ address: region.start, size: end - region.start, zero: region.top - end,
						write: regions[r][0] == Data || regions[r][0] == Zero, exec: regions[r][0] == Code })
				}
				file = max(file, end)
			}
		}
		// An image nothing of which is mapped, as one of Kept sections alone, has an empty segment, for its writer.
		if (image.segments.length == 0) {
			image.segments.push({ address: base, size: 0, zero: 0, write: false, exec: false })
		}
		const all = merged(laid)
		image.sections = all.filter(e => e[1] != Kept).map(e => [e[0], e[2], e[3] - e[2]])
		for (const i of 0 ... all.length - 1) {
			const [_, kind, from, to] = all[i]
			if (kind == Unwind && i > 0 && all[i - 1][1] == Unwind) {
				image.unwinds[image.unwinds.length - 1] = [image.unwinds[image.unwinds.length - 1][0], to]
			} else if (kind == Unwind) {
				image.unwinds.push([from, to])
			}
		}
		// Those of a kept image are of their region, which those it holds are in too, its holes zeros (free), from the
		// first that is not one.
		const unwinds = this.state.regions[0]
		const hole = unwinds.holes.at(0) ?? [0, 0]
		const first = if (hole[0] == unwinds.start) hole[1] else unwinds.start
		if (this.keep && unwinds.top > first) {
			image.unwinds = [[first, unwinds.top]]
		}
		image.bytes = this.bytes
		image.bytes.length = file
		for (const k of this.loaded ... this.units.length - 1) {
			const u = this.held(k)
			for (const i of 0 ... u.object.sections.length - 1) {
				const b = u.object.sections[i].bytes
				if (u.at[i] != dropped && b != "") {
					image.bytes.set(u.at[i], b)
				}
			}
		}
	}

	/// Lays the sections refs out one after another in region r, where room puts them, around its islands; the bytes
	/// between them zeros, where a hole may have others, as macho.bob's CIEs. From and to where.
	private place(r: Region, refs: i64[]): [u64, u64] throws CompileError {
		const sec = (ref: i64) => this.held((ref >> 32) as i32).object.sections[ref & 0xffffffff]
		const end = (from: u64) => {
			let at = from
			for (const ref of refs) {
				at = this.skip(r, alignUp(at, sec(ref).align), sec(ref).size) + sec(ref).size
			}
			return at
		}
		let at = this.room(r, sec(refs[0]).align, end, sec(refs[0]).name)
		for (const ref of refs) {
			if (sec(ref).size > span - island && this.islands(r)) {
				throw new CompileError(`${this.held((ref >> 32) as i32).object.name}: ${sec(ref).name} is too big for its calls`)
			}
			const to = this.skip(r, alignUp(at, sec(ref).align), sec(ref).size)
			if (sec(ref).kind != Zero) {
				this.bytes.set(at, zeros((to - at) as i32))
			}
			this.held((ref >> 32) as i32).at[ref & 0xffffffff] = to
			at = to + sec(ref).size
		}
		return [this.held((refs[0] >> 32) as i32).at[refs[0] & 0xffffffff], at]
	}

	/// The run of region r the sections of x are laid out in, made at first if x is bound in a kept image, or made is,
	/// else null; a CompileError if it is of another region.
	private run(r: Region, x: string, made = false): Region | null throws CompileError {
		const e = this.state.runs.find(e => e[0] == x)
		if (e != null && (e[1].start < r.start || e[1].start >= r.cap)) {
			throw new CompileError(`${x} is of another kind now`)
		} else if (e != null) {
			return e[1]
		} else if (!this.keep || !made && !this.bounded.includes(x)) {
			return null
		}
		const run = new Region(alignUp(this.room(r, this.machine.page, from => from + room / 16, x), this.machine.page))
		run.cap = run.start + room / 16
		this.state.runs.push([x, run])
		return run
	}

	/// Whether region r has islands: the code, of a machine with veneers.
	private islands(r: Region): bool { return this.machine.veneer != "" && this.state.regions.indexOf(r) == this.code }
	/// Where the code's island k is.
	private island(k: u64): u64 { return this.state.regions[this.code].start + k * span }

	/// Where what takes size bytes from at goes in region r: past the island it would be over, if any.
	private skip(r: Region, at: u64, size: u64): u64 {
		if (!this.islands(r)) {
			return at
		}
		const i = r.start + (at + size - r.start) / span * span
		return if (i > r.start && at < i + island && at + size > i) i + island else at
	}

	/// The address of a veneer to v in the island nearest p, which code at p reaches, made if there is none; 0 if
	/// there is no such island, or no room in it.
	private veneer(v: u64, p: u64, image: Image): u64 {
		const k = max((p - this.state.regions[this.code].start) / span, 1)
		const key = `${k} ${v}`
		const made = this.veneers.get(key)
		if (made != null) {
			return made!
		}
		const i = this.island(k)
		const at = i + (this.filled.get(k) ?? 0)
		const size = this.machine.veneer.length as u64
		if (size == 0 || at + size > min(i + island, this.state.regions[this.code].cap)) {
			return 0
		}
		this.filled.set(k, at + size - i)
		this.veneers.set(key, at)
		this.state.veneers.push([k, v, at])
		image.bytes.set(at, this.machine.veneer)
		const word = new u8[](8)
		for (const [off, kind, addend] of this.machine.veneerFixups) {
			put(word, 0, image.bytes.get(at + off, 8), 8)
			this.machine.apply(word, 0, kind, v + (addend as u64), at + off)
			image.bytes.put(at + off, get(word, 0, 8), 8)
		}
		return at
	}

	/// Where in region r what takes from from to end(from) goes, from aligned to align: the start of the first of its
	/// holes it fits in, else its top, which stays below its cap; a CompileError naming what if neither.
	private room(r: Region, align: u64, end: (from: u64) => u64, what: string): u64 throws CompileError {
		for (const i of 0 ... r.holes.length - 1) {
			const [hole, last] = r.holes[i]
			const from = alignUp(hole, align)
			const to = end(from)
			if (to > from && to <= last) {
				const rest: [u64, u64][] = [[hole, from], [to, last]]
				r.holes = [...r.holes.slice(0, i), ...rest.filter(h => h[1] > h[0]),
					...r.holes.slice(i + 1, r.holes.length)]
				return hole
			}
		}
		const at = r.top
		r.top = end(alignUp(at, align))
		if (r.top >= r.cap) {
			throw new CompileError(`there is no room for ${what}`)
		}
		return at
	}

	/// A block of region r, where room puts it, of b, what's: from where, and its size.
	private block(r: Region, b: string, what: string): [u64, u64] throws CompileError {
		const at = this.room(r, 1, from => from + (b.length as u64), what)
		this.bytes.set(at, b)
		return [at, b.length as u64]
	}

	/// Frees the size bytes at at for what is laid out later. They stay as they are but in what is read entry by entry,
	/// the unwinder's and the symbol table's regions and the runs, which have zeros there until then, and the rebases'
	/// run, entries of no rebase.
	private free(at: u64, size: u64) {
		const k = partitionPoint(this.state.regions, r => r.cap > at) as i32
		const run = this.state.runs.find(e => e[1].start <= at && at < e[1].cap)
		const r = if (run != null) run[1] else this.state.regions[k]
		if (size == 0) {
			return
		} else if (run != null && run[0] == rebasing) {
			const b = new u8[](size as i32)
			for (const i of 0 ... b.length / 8 - 1) {
				b[8 * i] = 1
			}
			this.bytes.set(at, fromBytes(b))
		} else if (run != null && this.regions[k][0] != Zero || this.regions[k][0] == Unwind
			|| this.regions[k][0] == Symbols) {
			this.bytes.set(at, zeros(size as i32))
		}
		let i = partitionPoint(r.holes, h => h[0] > at) as i32
		let [from, to] = [at, at + size]
		if (i < r.holes.length && r.holes[i][0] == to) {
			to = r.holes.remove(i)[1]
		}
		if (i > 0 && r.holes[i - 1][1] == from) {
			i--
			from = r.holes.remove(i)[0]
		}
		if (to == r.top) {
			r.top = from
		} else if (to > from) {
			r.holes.insert(i, [from, to])
		}
	}

	/// Sets the bytes each fixup of units ks is at, noting where (redone), and a pointer to an address in the image as a
	/// rebase, one to an import as a bind, and a Desc as a desc, which the image keeps until it is set again, and a
	/// frozen unit's record not, once set for good; reaching an import relative to the code itself is only possible
	/// through a stub or slot. A kept image keeps a unit's rebases of words in a block of its own.
	private fix(image: Image, ks: i32[]) throws CompileError {
		const word = new u8[](8) // where a fixup is set, of the 8 bytes at its address
		for (const k of ks) {
			const u = this.read(k)
			const o = u.object
			const words: u64[] = []
			for (const i of 0 ... o.sections.length - 1) {
				if (u.at[i] == dropped) {
					continue
				}
				for (const f of o.sections[i].fixups) {
					const p = u.at[i] + f.at
					this.redone.push(p)
					const stays = u.frozen && this.stable(u, f, p)
					const g = u.names[f.symbol]
					let s: u64 = 0
					let inside = true
					if (g < 0) {
						const sym = o.symbols[f.symbol]
						if (sym.section >= 0 && u.at[sym.section] == dropped && o.sections[i].kind == Unwind) {
							continue // the rules of a dropped function, which unwind nothing
						}
						if (sym.section < 0 || u.at[sym.section] == dropped) {
							throw new CompileError(`${place(o, i, f)} refers to a section that is not linked`)
						}
						s = u.at[sym.section] + sym.value
					} else {
						const n = this.entry(g)
						if (slotted(f.kind)) {
							s = n.slot
						} else if (this.stubbed(f.kind, n) && p != n.slot) {
							// a slot holds the import itself
							s = n.stub
						} else if (n.unit >= 0) {
							s = n.address
						} else {
							inside = false
							if (f.kind != Abs64) {
								throw new CompileError(`${place(o, i, f)} reaches ${n.name} relative to itself, but it is not in the image`)
							}
							if (n.library >= 0) {
								image.binds.push({ at: p, library: n.library, name: n.name,
									weak: n.namer < 0 && this.first(n, l => l & (defining | strong) == strong) == 0,
									addend: f.addend })
							}
						}
					}
					const kind = this.kind(o.sections[i])
					if ((f.kind == Abs64 || f.kind == Desc) && kind != Data && kind != Init && kind != Thread) {
						throw new CompileError(`${place(o, i, f)} is a pointer in bytes that are not written`)
					}
					if (f.kind == Desc) {
						if (s < image.thread[0] || s >= image.thread[1]) {
							throw new CompileError(`${place(o, i, f)} describes bytes that are no thread's own`)
						}
						image.descs.push([p, s + (f.addend as u64) - image.thread[0]])
						if (stays) {
							u.encoded = "" // the image no longer keeps the fixup
						}
						continue
					}
					if (inside && f.kind == Abs64 && this.keep && p % 8 == 0) {
						words.push(p)
					} else if (inside && f.kind == Abs64) {
						image.rebases.push(p)
					}
					const v = s + (f.addend as u64) - (if (f.kind == Thread32) image.thread[0] else 0)
					put(word, 0, image.bytes.get(p, 8), 8)
					if (!this.apply(word, 0, f.kind, v, p)) {
						const w = if (f.kind == Call) this.veneer(v, p, image) else 0
						if (w == 0 || !this.apply(word, 0, Call, w, p)) {
							throw new CompileError(`${place(o, i, f)} cannot reach its symbol`)
						}
						this.veneered.set(p, true)
					}
					image.bytes.put(p, get(word, 0, 8), 8)
					if (stays && !this.veneered.has(p)) {
						u.encoded = ""
					}
				}
			}
			if (this.keep) {
				sort(words)
				this.rebased(u, 0, words)
				if (k > 0 && k < this.loaded) {
					this.changes.push(k)
				}
			}
		}
	}

	/// Makes u's block i of the rebases' run the RELR of words, ascending: none if there are none.
	private rebased(u: Unit, i: i32, words: u64[]) throws CompileError {
		while (u.relr.length <= i) {
			u.relr.push([0, 0])
		}
		this.free(u.relr[i][0], u.relr[i][1])
		const b = relr(words)
		u.relr[i] = if (b == "") [0, 0] else this.block(this.state.runs.find(e => e[0] == rebasing)![1], b, "rebases")
	}

	/// Whether fixup f, at p, of a frozen unit is set for good: if it reaches a local symbol or a local's unshared
	/// name, a name a frozen unit's section defines, a slot, or a stub; and not through a veneer.
	private stable(u: Unit, f: Fixup, p: u64): bool {
		if (this.veneered.has(p)) {
			return false
		}
		const g = u.names[f.symbol]
		if (g < 0) {
			return true
		}
		const n = this.entry(g)
		return slotted(f.kind) || this.stubbed(f.kind, n) && p != n.slot
			|| n.unit >= 0 && n.section >= 0 && this.frozen(n.unit) || g >= this.shared
	}

	/// Keeps in the image what a later link continues it from: its units, the frozen ones as one, each with blocks of
	/// its own where no loader maps, made once: of its record, of the fixups a later link sets again, its symbols'
	/// links and their names in the Kept sections' region, and of their entries in the symbol table's, which the format
	/// writes; the names' entries; and exports. The head, of all but the records, is at the end of the symbol table's
	/// region's room, where most of it is as the file has it, and the 16 bytes after the headers say where; 8 more are
	/// left for who stores the image to stamp it (stamped).
	private save(image: Image, exports: string[]) throws CompileError {
		const s = this.state
		this.freeze()
		// Those it writes the entries of: the frozen one, those changed, and those given it did not hold; of the lazy ones,
		// frozen, none are written.
		const ks = [0, ...this.changes]
		for (const k of max(this.loaded, 1) ... this.units.length - 2) {
			if (!this.held(k).frozen) {
				ks.push(k)
			}
		}
		const [table, kept] = [s.regions[s.regions.length - 2], s.regions[s.regions.length - 1]]
		// The names made, in one block, each as the symbol table has it.
		const made = this.touched.filter(g => g < this.shared && this.names[g]!.was == null).map(g => this.names[g]!)
		let name = this.block(kept, made.map(n => `_${n.name}\x00`).join(""), "names")[0]
		for (const n of made) {
			n.at = name + 1
			name += (n.name.length + 2) as u64
		}
		const records = new Writer()
		for (const u of ks.map(k => this.held(k)).filter(u => u.blocks.length == 0 && u.object.name != "")) {
			const what = u.object.name
			// Its fixups a later link sets again: of a shared name, or a pointer or Desc, which the image's lists drop with it,
			// or through a veneer.
			const again = (i: i32, f: Fixup) => u.at[i] != dropped
				&& (u.object.symbols[f.symbol].binding != Local || f.kind == Abs64 || f.kind == Desc
				|| this.veneered.has(u.at[i] + f.at))
			u.encoded = record(records, u.object, u.at, again, u.names.map(g => if (g < this.shared) g else -1), u.frozen)
			u.blocks = [this.block(kept, u.encoded, what),
				this.block(kept, u.links.slice(u.from, u.from + 24 * (leading(u.object) as u64)), what)]
			// Not those whose address a later link may change: of a thread's copy; nor marks, named `~...`, which no debugger
			// or profiler has a use for. Each with the index of its shared name, whose name the symbol table's is, else -1.
			const syms: [Symbol, i32][] = []
			for (const j of 0 ... u.object.symbols.length - 1) {
				const x = u.object.symbols[j]
				const sec = if (x.section >= 0) u.object.sections[x.section] else null
				if (this.format.symbol > 0 && x.name != "" && !startsWith(x.name, "~") && sec != null
					&& u.at[x.section] != dropped && sec.kind < Kept && sec.kind != Thread) {
					syms.push([new Symbol(x.name, x.binding, 0, u.at[x.section] + x.value, x.size),
						if (u.names[j] < this.shared) u.names[j] else -1])
				}
			}
			if (syms.length > 0) {
				const size = this.format.symbol * (syms.length as u64)
				u.blocks.push([this.room(table, 1, from => from + size, what), size])
				u.blocks.push(this.block(kept, syms.filter(e => e[1] < 0).map(e => `_${e[0].name}\x00`).join(""), what))
				const names: u64[] = []
				let at = u.blocks[3][0]
				for (const [x, g] of syms) {
					names.push(if (g >= 0) this.entry(g).at - 1 else at)
					at += if (g >= 0) 0 else (x.name.length + 2) as u64
				}
				image.symbols.push([syms.map(e => e[0]), u.blocks[2][0], names])
			}
		}
		// The table of units, made anew once over half full, of room for 4 times as many: of the slots taken, and the
		// entries as they were.
		const count = (this.units.length - 1) as u64
		const [was, old, had] = s.units
		if (2 * count > old) {
			let cap: u64 = 64
			while (cap < 4 * count) {
				cap *= 2
			}
			const entries = this.bytes.slice(was + 12 * old, was + 12 * old + unitEntry * had)
			const b = zeros((12 * cap) as i32) + entries + zeros((unitEntry * (cap / 2 - had)) as i32)
			s.units = [this.block(kept, b, "units")[0], cap, 0]
			for (const i of 0 ... (old as i32) - 1) {
				const p = was + 12 * (i as u64)
				if (this.bytes.get(p + 8, 4) != 0) {
					const q = this.vacant(this.bytes.get(p, 8), x => false)
					this.bytes.put(q, this.bytes.get(p, 8), 8)
					this.bytes.put(q + 8, this.bytes.get(p + 8, 4), 4)
				}
			}
			this.free(was, 12 * old + unitEntry * old / 2)
		}
		s.units[2] = count
		for (const k of ks) {
			const u = this.held(k)
			if (k >= this.loaded && k > 0) {
				// That of a unit of its key unlinked, if any, as a key's chain is as long as it has units.
				const h = this.hash(key(u.object.name))
				const p = this.vacant(h, p => {
					const j = (this.bytes.get(p + 8, 4) as i32) - 1
					return this.bytes.get(p, 8) == h && j < this.loaded && this.units[j] != null
						&& this.units[j]!.object.name == ""
				})
				this.bytes.put(p, h, 8)
				this.bytes.put(p + 8, (k + 1) as u64, 4)
				if (u.object.sections.some(x => x.group != "")) {
					s.grouped.push(k)
				}
			}
			const flags = (if (u.supplied) supplying else 0)
				| (if (u.object.sections.some(x => x.kind == Kept)) keeping else 0)
			for (const i of 0 ... 5) {
				const [from, size] = (if (i < 4) u.blocks.at(i) else u.relr.at(i - 4)) ?? [0, 0]
				const p = this.entryAt(k) + 12 * (i as u64)
				this.bytes.put(p, from, 8)
				this.bytes.put(p + 8, size | (if (i == 0) flags else 0), 4)
			}
		}
		s.grouped = s.grouped.filter(k => this.held(k).object.name != "")
		// A table not in the image's bytes is one made anew, or grown, its entries with it, those the continued image has
		// as they were.
		if (this.table != this.bytes) {
			if (4 * (this.shared as u64) > this.cap) {
				this.grow()
			}
			const [was, old, had] = s.names
			const entries = this.bytes.slice(was + 12 * old, was + 12 * old + entry * had)
			const b = this.table.slice(this.at, this.at + 12 * this.cap) + entries
				+ zeros((entry * (this.cap / 2 - had)) as i32)
			this.at = this.block(kept, b, "names")[0]
			this.entries = this.at + 12 * this.cap
			this.free(was, 12 * old + entry * old / 2)
		}
		// The entries of the names read or made.
		for (const g of this.touched.filter(g => g < this.shared)) {
			const n = this.names[g]!
			const p = this.entries + entry * (g as u64)
			if (n.was == null) {
				this.bytes.put(p, n.at, 8)
				this.bytes.put(p + 8, n.name.length as u64, 4)
			}
			this.bytes.put(p + 12, (n.library + 1) as u64, 4)
			this.bytes.put(p + 16, (n.unit + 1) as u64, 4)
			this.bytes.put(p + 20, (n.section + 1) as u64, 4)
			this.bytes.put(p + 24, n.value, 8)
			this.bytes.put(p + 32, n.address, 8)
			this.bytes.put(p + 40, n.slot, 8)
			this.bytes.put(p + 48, n.stub, 8)
			this.bytes.put(p + 56, n.chain, 8)
			this.bytes.put(p + 64, if (n.weak) 1 else 0, 1)
		}
		s.names = [this.at, this.cap, this.shared as u64]
		s.libraries = this.libraries
		s.seed = this.seed
		s.exports = exports
		s.inits = image.inits
		s.thread = image.thread
		const head = write(s, this.machine.arch)
		const at = table.cap - alignUp(head.length as u64, image.page)
		if (at <= table.top) {
			throw new CompileError("there is no room for what the image keeps")
		}
		image.bytes.set(at, head)
		image.bytes.put(this.format.headers, at, 8)
		image.bytes.put(this.format.headers + 8, head.length as u64, 8)
	}

	/// The frozen units as one, of a section per region from its start, of no bytes, that their symbols are in: those
	/// with a name, but the weak definitions another unit's took over, which are references, and then the local ones;
	/// and their fixups not set for good. Notes where their sections are. The continued image's is as it is where no
	/// lazy object, slot or stub adds to it.
	private freeze(): Unit {
		// The frozen one, those lazy, given after those the continued image holds, and the linker's own, last.
		const ks = [0]
		for (const k of max(this.loaded, 1) ... this.units.length - 1) {
			if (this.held(k).frozen) {
				ks.push(k)
			}
		}
		const units = ks.map(k => this.held(k))
		if (units.length == 2 && units[0].encoded != "" && units[1].object.symbols.length == 0) {
			return units[0]
		}
		const b = units[0].blocks
		if (b.length > 0) {
			units[0].names = this.rest(units[0], this.bytes.slice(b[0][0], b[0][0] + b[0][1]), false)
		}
		// As no chain has the linker's own, last, nor a local's name, not shared (unshared).
		for (const i of 0 ... ks.length - 2) {
			const u = units[i]
			for (const j of 0 ... u.names.length - 1) {
				if (u.names[j] >= 0 && u.names[j] < this.shared) {
					this.unchain(this.entry(u.names[j]), ks[i], j)
				}
			}
		}
		for (const u of units) {
			for (const [at, size] of u.blocks) {
				this.free(at, size)
			}
		}
		const regions = this.state.regions
		const o = new Object("the image", this.machine.arch)
		o.sections = this.regions.map(r => new Section("", r[0]))
		const region = (at: u64) => partitionPoint(regions, r => r.cap > at) as i32
		// Per name, its symbol in o, which a frozen unit's section defines.
		const symbols = new HashMap[i32, i32]()
		const names: i32[] = []
		const symbol = (g: i32) => {
			const j = symbols.get(g) ?? o.symbols.length
			if (j == o.symbols.length) {
				names.push(if (g < this.shared) g else -1)
				const n = this.entry(g)
				const s = new Symbol(n.name, Weak)
				if (n.section >= 0 && this.frozen(n.unit)) {
					s.binding = if (n.weak) Weak else Global
					s.section = region(n.address)
					s.value = n.address - regions[s.section].start
				}
				symbols.set(g, j)
				o.symbols.push(s)
			}
			return j
		}
		// A local symbol a call reaches through a veneer, as one of no name, which is read with the named ones.
		const nameless = (u: Unit, s: Symbol) => {
			const at = u.at[s.section] + s.value
			o.symbols.push(new Symbol("", Global, region(at), at - regions[region(at)].start))
			names.push(-1)
			return o.symbols.length - 1
		}
		const locals: Symbol[] = []
		for (const u of units) {
			for (const i of 0 ... u.object.symbols.length - 1) {
				const s = u.object.symbols[i]
				if (s.binding != Local && u.names[i] >= 0) {
					const t = o.symbols[symbol(u.names[i])]
					t.binding = if (t.section < 0 && (s.binding == Global || s.section >= 0)) Global else t.binding
				} else if (s.name != "" && s.section >= 0 && u.at[s.section] != dropped) {
					const at = u.at[s.section] + s.value
					locals.push(new Symbol(s.name, Local, region(at), at - regions[region(at)].start, s.size))
				}
			}
			for (const i of 0 ... u.object.sections.length - 1) {
				const sec = u.object.sections[i]
				if (u.at[i] == dropped) {
					continue
				}
				if (!this.state.sections.includes(sec.name)) {
					this.state.sections.push(sec.name)
				}
				for (const f of sec.fixups) {
					const at = u.at[i] + f.at
					if (!this.stable(u, f, at)) {
						const r = region(at)
						const g = u.names[f.symbol]
						o.sections[r].fixups.push(new Fixup(at - regions[r].start, f.kind,
							if (g >= 0) symbol(g) else nameless(u, u.object.symbols[f.symbol]), f.addend))
					}
				}
			}
		}
		o.symbols = [...o.symbols, ...locals]
		const frozen = new Unit(o, true)
		frozen.at = regions.map(r => r.start)
		// The frozen units' rebases, of those of o's fixups, which a link sets anew, and those set for good.
		const fixups = new HashMap[u64, bool]()
		for (const r of 0 ... regions.length - 1) {
			for (const f of o.sections[r].fixups) {
				fixups.set(regions[r].start + f.at, true)
			}
		}
		const words: u64[] = []
		for (const u of units) {
			for (const [at, size] of u.relr) {
				words.push(...unrelr(this.bytes.slice(at, at + size)))
				this.free(at, size)
			}
		}
		sort(words)
		this.rebased(frozen, 0, words.filter(p => fixups.has(p)))
		this.rebased(frozen, 1, words.filter(p => !fixups.has(p)))
		frozen.names = [...names, ...locals.map(_ => -1)]
		// What the frozen units define, this one does, which takes their place.
		for (const n of this.touched.map(g => this.names[g]!).filter(n => n.unit > 0 && this.frozen(n.unit))) {
			n.unit = 0
			n.section = if (n.section >= 0) region(n.address) else -1
			n.value = if (n.section >= 0) n.address - regions[n.section].start else 0
		}
		this.units[0] = frozen
		this.chained(0)
		return frozen
	}

	/// u's symbols and fixups as record has them, if named but its local symbols after the others; the indices of its
	/// symbols' names.
	private rest(u: Unit, record: string, named: bool): i32[] throws CompileError {
		const names = rest(u.object, record, this.shared, named)
		if (names == null) {
			throw new CompileError(`${u.object.name}'s record is not as written`)
		}
		return names
	}

	/// Sets the bytes of b at at by the rule of kind, v being S + A, or G + A for a slot's, and p their address: data
	/// itself, an instruction by the machine. False if v is out of reach.
	private apply(b: u8[], at: i32, kind: u8, v: u64, p: u64): bool {
		const d = (v - p) as i64
		switch (kind) {
			case Abs64, Image64: put(b, at, v, 8)
			case Rel64: put(b, at, d as u64, 8)
			case Image32, Thread32:
				if (v >= 1 << 32) {
					return false
				}
				put(b, at, v, 4)
			case Rel32, SlotRel32:
				if (d < -(1 << 31) || d >= 1 << 31) {
					return false
				}
				put(b, at, d as u64, 4)
			case SlotPage: return this.machine.apply(b, at, Page, v, p)
			case SlotPageOff: return this.machine.apply(b, at, PageOff, v, p)
			default: return this.machine.apply(b, at, kind, v, p)
		}
		return true
	}

	/// Links unit k's symbols with a name into the chains of their names, first, if the image is kept: symbol j's at
	/// 24 * j of its links, as those with a name are the first, leading(o), of an object ordered.
	private chained(k: i32) {
		if (!this.keep) {
			return
		}
		const u = this.held(k)
		const o = u.object
		u.links = this.chains
		u.from = this.chains.length
		this.chains.length += 24 * (leading(o) as u64)
		for (const j of 0 ... o.symbols.length - 1) {
			const s = o.symbols[j]
			if (u.names[j] >= 0) {
				const defines = s.section >= 0 && u.at[s.section] != dropped
				const n = this.entry(u.names[j])
				const l = ((k + 1) as u64) << 32 | (j as u64) | (if (defines) defining else 0)
					| (if (s.binding == Global) strong else 0)
				u.links.put(u.from + 24 * (j as u64), n.chain, 8)
				u.links.put(u.from + 24 * (j as u64) + 16, if (defines) (s.section as u64) << 32 | s.value else 0, 8)
				if (n.chain != 0) {
					const [b, at] = this.linked(n.chain)
					b.put(at + 8, l, 8)
				}
				n.chain = l
			}
		}
	}

	/// The chain of n: per symbol with its name of the units linked, the latest first, (k + 1) << 32 | j of symbol j of
	/// unit k, and whether it defines n, and not weakly, or if it does not, names it so that it must be defined. Where
	/// each is linked (linked) has the next and the one before, 0 if none, the first n.chain.
	private links(n: Name): u64[] {
		const ls: u64[] = []
		this.first(n, l => {
			ls.push(l)
			return false
		})
		return ls
	}

	/// The first link of n's chain f holds of, 0 if none.
	private first(n: Name, f: (l: u64) => bool): u64 {
		let l = n.chain
		while (l != 0 && !f(l)) {
			const [b, at] = this.linked(l)
			l = b.get(at, 8)
		}
		return l
	}

	/// The unit of link l, -1 of none.
	private unit(l: u64): i32 { return ((l >> 32 & 0x3fffffff) as i32) - 1 }

	/// Where the links of link l's unit k have, of l to its symbol j, the next link and the one before, and if j defines
	/// its name, its section << 32 | value; of a unit held not read, as its entry says, which this reads no more of.
	private linked(l: u64): [Bytes, u64] throws CompileError {
		const k = this.unit(l)
		if (k < 0 || k >= this.units.length) {
			throw new CompileError("a chain of names is broken")
		}
		const u = this.units[k]
		const at = 24 * (l & 0xffffffff)
		return if (u != null) [u.links, u.from + at] else [this.bytes, this.field(k, 12, 8) + at]
	}

	/// The units that name n so that it must be defined, but do not.
	private namers(n: Name): i32[] {
		return this.links(n).filter(l => l & (defining | strong) == strong).map(l => this.unit(l))
	}

	/// Unlinks symbol j of unit k from n's chain.
	private unchain(n: Name, k: i32, j: i32) {
		const me = ((k + 1) as u64) << 32 | (j as u64)
		const [b, at] = this.linked(me)
		const [next, prev] = [b.get(at, 8), b.get(at + 8, 8)]
		const before = if (prev != 0) this.linked(prev) else null // where the link to it is, if not n.chain
		if ((if (before != null) before[0].get(before[1], 8) else n.chain) & ~(defining | strong) != me) {
			throw new CompileError("a chain of names is broken")
		}
		if (before == null) {
			n.chain = next
		} else {
			before[0].put(before[1], next, 8)
		}
		if (next != 0) {
			const [c, to] = this.linked(next)
			c.put(to + 8, prev, 8)
		}
	}

	/// Defines n as the first of its chain to define it not weakly, else the first to define it, if one does.
	private redefine(n: Name) {
		const ls = this.links(n).filter(l => l & defining != 0)
		const l = ls.find(l => l & strong != 0) ?? (if (ls.length > 0) ls[0] else 0)
		const at = if (l != 0) this.linked(l)[0].get(this.linked(l)[1] + 16, 8) else 0
		n.unit = this.unit(l)
		n.section = if (l != 0) (at >> 32) as i32 else -1
		n.value = at & 0xffffffff
		n.weak = l & strong == 0 && l != 0
		n.library = -1
	}

	/// Unit k, of which the symbols and fixups of one the continued image holds are read only once a link needs them, as
	/// a link that leaves it as it is does not; and of the frozen one, but its local symbols.
	private read(k: i32): Unit {
		const u = this.held(k)
		if (u.encoded != "" && u.names.length == 0) {
			u.names = this.rest(u, u.encoded, u.frozen)
		}
		return u
	}

	/// Unit k; of those the continued image holds, read of its entry once asked for: its blocks, of its record its
	/// object but the symbols and fixups, and where its sections are.
	private held(k: i32): Unit {
		if (this.units[k] != null) {
			return this.units[k]!
		}
		const u = new Unit(new Object("", this.machine.arch), k == 0)
		const b = this.bytes
		this.reads++
		const blocks: [u64, u64][] = []
		for (const i of 0 ... 5) {
			const at = 12 * (i as u64)
			blocks.push([this.field(k, at, 8), this.field(k, at + 8, 4) & ~(if (i == 0) supplying | keeping else 0)])
		}
		u.blocks = blocks.slice(0, 4).filter(x => x[0] != 0)
		u.relr = blocks.slice(4, 6)
		u.supplied = this.supplied(k)
		if (u.blocks.length > 0) {
			const [from, size] = u.blocks[0]
			u.encoded = if (from > b.length || size > b.length - from) "" else b.slice(from, from + size)
			const h = head(u.encoded, this.machine.arch)
			if (h == null) {
				this.errors.push(`the entry of unit ${k} is broken`)
			} else {
				u.object = h![0]
				u.at = h![1]
				u.links = b
				u.from = if (u.blocks.length > 1) u.blocks[1][0] else 0
			}
		}
		this.units[k] = u
		return u
	}

	/// Where the entry of unit k the continued image holds is.
	private entryAt(k: i32): u64 { return this.state.units[0] + 12 * this.state.units[1] + unitEntry * (k as u64) }
	/// The n bytes at at of the entry of unit k the continued image holds.
	private field(k: i32, at: u64, n: i32): u64 { return this.bytes.get(this.entryAt(k) + at, n) }
	/// Whether unit k is frozen, as of those the continued image holds only the first is.
	private frozen(k: i32): bool { return if (k < this.loaded) k == 0 else this.units[k]!.frozen }

	/// The units the continued image holds whose key is of, but those removed: of the slots of its hash in the table of
	/// units, from the one it starts at up to a free one.
	private keyed(of: string): i32[] {
		const h = this.hash(of)
		const ks: i32[] = []
		if (this.loaded > 0) {
			this.vacant(h, p => {
				const k = (this.bytes.get(p + 8, 4) as i32) - 1
				if (this.bytes.get(p, 8) == h && k > 0 && k < this.loaded && !this.removed.includes(k)) {
					ks.push(k)
				}
				return false
			})
		}
		return ks.filter(k => key(this.held(k).object.name) == of)
	}

	/// The slot of the table of units hash h takes, of 12 bytes, h and the unit's index plus 1: the first from where h
	/// starts that is free or stop takes.
	private vacant(h: u64, stop: (p: u64) => bool): u64 {
		return this.probe(this.bytes, this.state.units[0], this.state.units[1], h, stop)
	}

	/// The Name of index g, read of its entry if it is not yet.
	private entry(g: i32): Name {
		if (this.names[g] == null) {
			this.names[g] = this.load(g)
			this.names[g]!.was = this.load(g)
			this.touched.push(g)
		}
		return this.names[g]!
	}

	/// The Name of index g as its entry in the continued image is.
	private load(g: i32): Name {
		const b = this.bytes
		const p = this.entries + entry * (g as u64)
		const [at, size] = [b.get(p, 8), b.get(p + 8, 4)]
		if (at > b.length || size > b.length - at || b.get(p + 16, 4) > (this.units.length as u64)) {
			throw new CompileError("the names' entries are broken")
		}
		const n = new Name(b.slice(at, at + size))
		n.at = at
		n.library = (b.get(p + 12, 4) as i32) - 1
		n.unit = (b.get(p + 16, 4) as i32) - 1
		n.section = (b.get(p + 20, 4) as i32) - 1
		n.value = b.get(p + 24, 8)
		n.address = b.get(p + 32, 8)
		n.slot = b.get(p + 40, 8)
		n.stub = b.get(p + 48, 8)
		n.chain = b.get(p + 56, 8)
		n.weak = b.get(p + 64, 1) != 0
		return n
	}

	/// The index of the shared Name of name, made if there is none.
	private name(name: string): i32 {
		const h = this.hash(name)
		const g = this.id(this.slot(h))
		if (g >= 0) {
			return g
		}
		if (2 * ((this.names.length as u64) + 1) > this.cap) {
			this.grow()
		}
		const p = this.slot(h)
		this.table.put(p, h, 8)
		this.table.put(p + 8, (this.names.length as u64) + 1, 4)
		this.touched.push(this.names.length)
		this.names.push(new Name(name))
		return this.names.length - 1
	}

	/// The index of the shared Name of name, -1 if there is none.
	private find(name: string): i32 { return this.id(this.slot(this.hash(name))) }

	/// The index of the name of the table's slot at p, -1 if none, or if the table is broken.
	private id(p: u64): i32 {
		const g = (this.table.get(p + 8, 4) as i64) - 1
		this.broken = this.broken || g >= (this.names.length as i64)
		return if (this.broken) -1 else g as i32
	}

	/// The hash of name; that of another name may be the same, which is not noticed, but for the seed of an image linked
	/// anew.
	private hash(name: string): u64 {
		let h = this.seed
		for (const c of name) {
			h = combine(h, c)
		}
		return h
	}

	/// Where the table's slot of hash h is, of 12 bytes: h and the index of its name plus 1; else the free one it takes.
	private slot(h: u64): u64 { return this.probe(this.table, this.at, this.cap, h, p => this.table.get(p, 8) == h) }

	/// The slot of hash h of the table at at in b, of cap slots of 12 bytes, whose last 4 are 0 if it is free: the first
	/// from where h starts that is free or stop takes.
	private probe(b: Bytes, at: u64, cap: u64, h: u64, stop: (p: u64) => bool): u64 {
		let i = (h ^ h >> 32) & (cap - 1)
		for (const _ of 1 ... (cap as i32)) {
			const p = at + 12 * i
			if (b.get(p + 8, 4) == 0 || stop(p)) {
				return p
			}
			i = (i + 1) & (cap - 1)
		}
		this.broken = true
		return at
	}

	/// Makes the table, then in bytes of its own, of twice the slots.
	private grow() {
		const table = this.table
		const at = this.at
		const cap = this.cap
		this.table = new Bytes()
		this.at = 0
		this.cap = 2 * cap
		for (const i of 0 ... (cap as i32) - 1) {
			const p = at + 12 * (i as u64)
			const g = table.get(p + 8, 4)
			if (g != 0) {
				const q = this.slot(table.get(p, 8))
				this.table.put(q, table.get(p, 8), 8)
				this.table.put(q + 8, g, 4)
			}
		}
	}
}

/// The entries, a name and kind, and from and to where, but the empty ones, by address, those of a name and kind next
/// to each other as one.
function merged(entries: [string, u8, u64, u64][]): [string, u8, u64, u64][] {
	const sorted = entries.filter(e => e[3] > e[2])
	sortBy(sorted, (a, b) => a[2] < b[2])
	const out: [string, u8, u64, u64][] = []
	for (const e of sorted) {
		const last = out.length - 1
		if (last >= 0 && out[last][0] == e[0] && out[last][1] == e[1]) {
			out[last] = [e[0], e[1], out[last][2], max(out[last][3], e[3])]
		} else {
			out.push(e)
		}
	}
	return out
}

/// What Linker.holds finds an object named name by.
export function key(name: string): string {
	const at = lastIndexOf(name, "@")
	return if (at >= 0) name.slice(0, at) else name
}

/// Orders o's symbols with a name before the local ones, as a kept image's records and links have them; o is the
/// object as given (Linker.add), which this changes.
function ordered(o: Object) {
	const order: i32[] = []
	for (const local of [false, true]) {
		for (const j of 0 ... o.symbols.length - 1) {
			if ((o.symbols[j].binding == Local) == local) {
				order.push(j)
			}
		}
	}
	const index = new i32[](order.length)
	for (const i of 0 ... order.length - 1) {
		index[order[i]] = i
	}
	o.symbols = order.map(j => o.symbols[j])
	for (const sec of o.sections) {
		for (const f of sec.fixups) {
			f.symbol = index[f.symbol]
		}
	}
}

/// How many of o's symbols are before its first local one.
function leading(o: Object): i32 {
	let n = 0
	while (n < o.symbols.length && o.symbols[n].binding != Local) {
		n++
	}
	return n
}

/// Where fixup f of section i of o is, for messages.
function place(o: Object, i: i32, f: Fixup): string { return `${o.name}: ${o.sections[i].name}+${f.at}` }

/// Whether x is a C identifier.
function identifier(x: string): bool {
	for (const i of 0 ... x.length - 1) {
		const c = x[i]
		if (!(c == 95 || c >= 97 && c <= 122 || c >= 65 && c <= 90 || i > 0 && c >= 48 && c <= 57)) {
			return false
		}
	}
	return x.length > 0
}
