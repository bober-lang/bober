//! Tests of src/link: hand-made Objects linked, and arm64's and x86-64's fixups on known instructions.

import { endsWith, indexOf, sort, startsWith } from "../../std/algo"
import { makeTempDir, open, removeAll } from "../../std/fs"
import { fnv } from "../../std/hash"
import { File } from "../../std/io"
import { split } from "../../std/string"
import { CompileError } from "../error"
import { Bytes, decimal, store } from "./bytes"
import { addend, arm64 } from "./arm64"
import { read, stamp, stamped, write } from "./keep"
import { Image, Linker, Stale } from "./link"

import { Abs64, Call, Code, Const, Data, Desc, Fixup, Global, Init, Kept, Local, Machine, Object, Page, PageOff, Rel32,
	Section, SlotPage, SlotPageOff, SlotRel32, Symbol, Thread, Thread32, Unwind, Weak, Zero } from "./object"

import { x64 } from "./x64"

/// An object named name of one section of kind, of the bytes of words, and of symbols.
function obj(name: string, kind: u8, words: u64[], symbols: Symbol[], fixups: Fixup[] = [], group = ""): Object {
	const b = new u8[](4 * words.length)
	for (const i of 0 ... words.length - 1) {
		for (const j of 0 ... 3) {
			b[4 * i + j] = (words[i] >> 8 * j) as u8
		}
	}
	const sec = new Section(if (kind == Code) "text" else "data", kind)
	sec.align = 8
	sec.bytes = fromBytes(b)
	sec.size = b.length as u64
	sec.fixups = fixups
	sec.group = group
	const o = new Object(name, "arm64")
	o.sections = [sec]
	o.symbols = symbols
	return o
}

/// A linker for machine, for a format of no file, whose loader sets a pointer to an import anywhere, or its slots only,
/// and whose image starts at `__image`, also named `__maps`; of a kept image if kept is not null, as Linker's.
function linker(bindsAnywhere = true, machine: Machine = arm64, kept: Bytes | null = null): Linker {
	return new Linker(machine,
		{ headers: 0x200, symbol: 24, bindsAnywhere: bindsAnywhere, start: "__image", tables: false, maps: "__maps",
		read: (name: string, bytes: string) => new Object(name, "arm64"),
		exports: (name: string, bytes: string) => [name], write: (image: Image) => {} }, kept)
}

/// A linker into a kept image, which continues the one whose file file is, with link's library.
function kept(file = ""): Linker {
	const l = linker(true, arm64, new Bytes(file))
	l.library("libc.so", ["puts", "environ"])
	return l
}

/// The image l links of objects too, with names exported.
function keep(l: Linker, objects: Object[], names: string[] = []): Image throws CompileError | Stale {
	for (const o of objects) {
		l.add(o)
	}
	for (const name of names) {
		l.export(name)
	}
	return l.link()
}

/// The stamp of the file file stored last, and that file, open.
let last: [u64, File | null] = [0, null]

/// The file of image, stored as a build stores it: over a copy of the file it continues, whose holes the copy keeps, if
/// file stored that one last, else anew; and mapped.
function file(image: Image): string {
	const old = if (stamp(new Bytes(image.bytes.file), 0x200) == last[0]) last[1] else null
	stamped(image.bytes, 0x200)
	const dir = makeTempDir("bober-")
	const f = if (old != null) old.copy(`${dir}/image`, image.bytes.length) else open(`${dir}/image`, "w+")
	removeAll(dir)
	last[1]?.close()
	store(f, image.bytes)
	last = [stamp(image.bytes, 0x200), f]
	return f.map()
}

/// The image of objects for machine, with names exported, and lazy ones as an archive's members, listed for the
/// names they define; by linker.
function link(objects: Object[], names: string[], lazy: Object[] = [], bindsAnywhere = true,
	machine: Machine = arm64): Image throws CompileError | Stale {
	const l = linker(bindsAnywhere, machine)
	for (const o of objects) {
		l.add(o)
	}
	l.lazily(() => lazy.map(member))
	l.library("libc.so", ["puts", "environ"])
	for (const name of names) {
		l.export(name)
	}
	return l.link()
}

/// o as an archive's member, listed for the names it defines.
function member(o: Object): [string[], () => Object throws CompileError] {
	return [o.symbols.filter(s => s.binding != Local && s.section >= 0).map(s => s.name), () => o]
}

/// The address the image exports name at.
function at(image: Image, name: string): u64 {
	for (const [n, a] of image.exports) {
		if (n == name) {
			return a
		}
	}
	return 0
}

/// The address of the sections of image named name.
function section(image: Image, name: string): u64 {
	for (const [n, a, _] of image.sections) {
		if (n == name) {
			return a
		}
	}
	return 0
}

/// The n bytes of image at address a, little-endian.
function get(image: Image, a: u64, n: i32 = 4): u64 { return image.bytes.get(a, n) }

/// Where unit k's block i is, of a kept image of arm64: in its entry, after the table of units, of 12 bytes each.
function block(image: Image, k: i32, i: i32): u64 {
	const [at, cap, _] = read(image.bytes, 0x200, "arm64")!.units
	return at + 12 * cap + 72 * (k as u64) + 12 * (i as u64)
}

test "a strong definition is taken over a weak one, and the first weak one over the others" {
	const a = obj("a", Data, [1, 0], [new Symbol("x", Weak, 0), new Symbol("y", Weak, 0, 4)])
	const b = obj("b", Data, [2, 0], [new Symbol("x", Global, 0), new Symbol("y", Weak, 0)])
	const image = link([a, b], ["x", "y"])
	assert get(image, at(image, "x")) == 2 && get(image, at(image, "y")) == 0
}

test "a name defined twice, or wanted and not defined, is an error naming the objects" {
	const a = obj("a", Data, [0], [new Symbol("x", Global, 0), new Symbol("u", Global)])
	const b = obj("b", Data, [0], [new Symbol("x", Global, 0), new Symbol("v", Global)])
	assert link([a, b], []) throws new CompileError("x is defined in a and b\nu is not defined, but a names it\nv is not defined, but b names it")
	assert link([obj("c", Data, [0], [])], ["w"]) throws new CompileError("w is exported but not defined")
}

test "a weak name no one defines is 0" {
	const a = obj("a", Data, [0, 0], [new Symbol("w", Weak), new Symbol("p", Global, 0)], [new Fixup(0, Abs64, 0, 8)])
	const image = link([a], ["p"])
	assert get(image, at(image, "p"), 8) == 8 && image.rebases.length == 0 && image.binds.length == 0
}

test "a lazy object is linked when a linked one wants what it defines, and only then" {
	const main = obj("main", Code, [0x94000000], [new Symbol("f", Global)], [new Fixup(0, Call, 0, 0)])
	const f = obj("f.o", Code, [0x94000000], [new Symbol("f", Global, 0), new Symbol("g", Global)],
		[new Fixup(0, Call, 1, 0)])
	const g = obj("g.o", Code, [0xd65f03c0], [new Symbol("g", Global, 0)])
	const h = obj("h.o", Code, [0xd65f03c0], [new Symbol("h", Global, 0)])
	const l = kept()
	l.lazily(() => [h, g, f].map(member))
	const image = keep(l, [main], ["f", "g"])
	assert image.symbols.map(s => s[0].map(s => s.name).join(" ")).join(" ") == "f g"
	assert get(image, at(image, "f")) == 0x94000000 | (at(image, "g") - at(image, "f")) >> 2
}

test "a lazy object is read only once a linked one wants a name it is listed for" {
	const l = linker()
	l.add(obj("main", Code, [0x94000000], [new Symbol("f", Global)], [new Fixup(0, Call, 0, 0)]))
	const read: string[] = []
	l.lazily(() => ["g", "f"].map(name => [[name], () => {
		read.push(name)
		return obj(name, Code, [0xd65f03c0], [new Symbol(name, Global, 0)])
	}]))
	l.link()
	assert read.join(" ") == "f"
}

test "a continued image lists the lazy objects only once a name is looked for in them that it did not name" {
	const calls = (name: string,
		x: string) => obj(name, Code, [0x94000000], [new Symbol(x, Global)], [new Fixup(0, Call, 0, 0)])
	const first = file(keep(kept(), [calls("a", "puts")]))
	let listed = 0
	const list = (l: Linker) => l.lazily(() => {
		listed++
		return [member(obj("f.o", Code, [0xd65f03c0], [new Symbol("f", Global, 0)]))]
	})
	const l = kept(first)
	list(l)
	keep(l, [calls("b", "puts")])
	assert listed == 0
	const m = kept(first)
	list(m)
	const image = keep(m, [calls("b", "f")], ["f"])
	assert listed == 1 && at(image, "f") != 0
}

test "of the sections of a group, the first object's are taken, and its symbols there" {
	const a = obj("a", Const, [1], [new Symbol("k", Weak, 0)], [], "k")
	const b = obj("b", Const, [2], [new Symbol("k", Weak, 0), new Symbol("only", Weak, 0)], [], "k")
	const c = obj("c", Const, [3], [new Symbol("k", Weak, 0), new Symbol("only", Global, 0)], [], "k")
	assert link([a, b], ["only"]) throws new CompileError("only is exported but not defined")
	assert link([a, c], ["k"]) throws new CompileError("only is not defined, but c names it")
	const image = link([a, b], ["k"])
	assert get(image, at(image, "k")) == 1 && image.sections.length == 1 && image.sections[0][2] == 4
}

test "__start_ and __stop_ are the bounds of the sections of a name, if it is a C identifier" {
	const a = obj("a", Data, [1, 2], [new Symbol("__start_data", Global), new Symbol("__stop_data", Global)])
	const b = obj("b", Data, [3], [new Symbol("__stop_data", Global)])
	const image = link([a, b], ["__start_data", "__stop_data"])
	assert at(image, "__start_data") == section(image, "data")
		&& at(image, "__stop_data") == section(image, "data") + 12
	assert link([obj("c", Data, [0], [new Symbol("__start_.x", Global)])],
		[]) throws new CompileError("__start_.x is not defined, but c names it")
	const kinds = " bounds sections of several kinds, as that of d"
	assert link([a, obj("d", Const, [0], [])], []) throws new CompileError(`__start_data${kinds}\n__stop_data${kinds}`)
}

test "a call to an import goes through a stub, a pointer to it is bound, and one to the image rebased" {
	const code = obj("a", Code, [0x94000000, 0x90000000, 0xf9400000],
		[new Symbol("puts", Global), new Symbol("main", Global, 0), new Symbol("here", Local, 0, 4)],
		[new Fixup(0, Call, 0, 0), new Fixup(4, SlotPage, 2, 0), new Fixup(8, SlotPageOff, 2, 0)])
	const data = obj("b", Data, [0, 0, 0, 0],
		[new Symbol("environ", Global), new Symbol("main", Global), new Symbol("p", Global, 0)],
		[new Fixup(0, Abs64, 0, 16), new Fixup(8, Abs64, 1, 4)])
	const image = link([code, data], ["main", "p"])
	const main = at(image, "main")
	const p = at(image, "p")
	const stubs = section(image, "stubs")
	const slots = section(image, "slots")
	// The stub of puts loads its slot, which the loader binds; the slot of the local holds its address.
	assert get(image, main) == 0x94000000 | (stubs - main) >> 2
	assert get(image, stubs + 8) == 0xd61f0220 && (get(image, stubs + 4) & 0xffc003ff) == 0xf9400211
	assert image.binds.map(b => `${b.name}@${b.at}+${b.addend}`).join(" ") == `environ@${p}+16 puts@${slots}+0`
	assert image.rebases.join(" ") == `${p + 8} ${slots + 8}`
	assert get(image, p + 8, 8) == main + 4 && get(image, slots + 8, 8) == main + 4
	assert get(image, main + 8) == 0xf9400000 | ((slots + 8) & 0xfff) >> 3 << 10
}

test "a call to a weak name no one defines goes through a stub whose slot is 0" {
	const a = obj("a", Code, [0x94000000], [new Symbol("w", Weak), new Symbol("main", Global, 0)],
		[new Fixup(0, Call, 0, 0)])
	const image = link([a], ["main"])
	assert get(image, section(image, "slots"), 8) == 0 && image.binds.length == 0 && image.rebases.length == 0
}

test "the unwind rules of a dropped section are not fixed up" {
	const b = obj("b", Code, [0xd65f03c0], [new Symbol("", Local, 0)], [], "f")
	const eh = new Section(".eh_frame", Unwind)
	eh.bytes = "\0\0\0\0"
	eh.size = 4
	eh.fixups = [new Fixup(0, Rel32, 0, 0)]
	b.sections.push(eh)
	const image = link([obj("a", Code, [0xd65f03c0], [], [], "f"), b], [])
	assert get(image, section(image, ".eh_frame"), 4) == 0
}

test "read-only bytes of a name of which some hold a pointer are laid out as data, and a pointer in code is an error" {
	const c = obj("c", Const, [0, 0], [new Symbol("c", Global, 0)], [new Fixup(0, Abs64, 0, 0)])
	const d = obj("d", Const, [0, 0], [new Symbol("d", Global, 0)])
	const image = link([d, c], ["c", "d"])
	assert image.segment(at(image, "c")).write && at(image, "c") == at(image, "d") + 8 && image.rebases.length == 1
	const t = obj("t", Code, [0, 0], [new Symbol("t", Global, 0)], [new Fixup(0, Abs64, 0, 0)])
	assert link([t], []) throws new CompileError("t: text+0 is a pointer in bytes that are not written")
}

test "a pointer to an import relative to itself is an error" {
	const a = obj("a", Code, [0x90000000], [new Symbol("puts", Global)], [new Fixup(0, Page, 0, 0)])
	assert link([a],
		[]) throws new CompileError("a: text+0 reaches puts relative to itself, but it is not in the image")
}

test "if the loader sets only slots, any reference to an import but through its slot is to its stub" {
	const a = obj("a", Data, [0, 0], [new Symbol("puts", Global), new Symbol("p", Global, 0)],
		[new Fixup(0, Abs64, 0, 0)])
	const image = link([a], ["p"], [], false)
	const slots = section(image, "slots")
	const p = at(image, "p")
	assert get(image, p, 8) == section(image, "stubs") && image.rebases.join(" ") == `${p}`
	assert image.binds.map(b => `${b.name}@${b.at}`).join(" ") == `puts@${slots}`
}

/// The word w with the fixup of kind of m applied at 0x10000 for v, 0 if out of reach.
function fixed(w: u64, kind: u8, v: u64, m: Machine = arm64): u64 {
	const b = new u8[](4)
	for (const j of 0 ... 3) {
		b[j] = (w >> 8 * j) as u8
	}
	if (!m.apply(b, 0, kind, v, 0x10000)) {
		return 0
	}
	return (b[0] as u64) | (b[1] as u64) << 8 | (b[2] as u64) << 16 | (b[3] as u64) << 24
}

test "arm64 fixups set the immediate of known instructions" {
	assert fixed(0x94000000, Call, 0x10010) == 0x94000004 // bl .+16
	assert fixed(0x94000000, Call, 0xfff0) == 0x97fffffc // bl .-16
	assert fixed(0x94000000, Call, 0x10000 + (1 << 27)) == 0
	assert fixed(0x94000000, Call, 0x10002) == 0
	assert fixed(0x90000010, Page, 0x23456) == 0xf0000090 // adrp x16, .+0x13000
	assert fixed(0x90000010, Page, 0x0) == 0x90ffff90 // adrp x16, .-0x10000
	assert fixed(0x91000000, PageOff, 0x12345) == 0x910d1400 // add x0, x0, #0x345
	assert fixed(0xf9400001, PageOff, 0x1238) == 0xf9411c01 // ldr x1, [x0, #0x238]
	assert fixed(0xf9400001, PageOff, 0x1234) == 0
	assert fixed(0xb9400001, PageOff, 0x1234) == 0xb9423401 // ldr w1, [x0, #0x234]
	assert fixed(0x3dc00000, PageOff, 0x1230) == 0x3dc08c00 // ldr q0, [x0, #0x230]
	assert fixed(0x39400000, PageOff, 0x1fff) == 0x397ffc00 // ldrb w0, [x0, #0xfff]
}

test "an arm64 instruction's addend is what its fixup set, from 0x10000" {
	assert addend(0x97fffffc, Call) == -16 && addend(0x94000004, Call) == 16
	assert addend(0xf0000090, Page) == 0x13000 && addend(0x90ffff90, Page) == -0x10000
	assert addend(0xf9411c01, PageOff) == 0x238 && addend(0x3dc08c00, PageOff) == 0x230
}

test "an x86-64 call's displacement is of 32 bits, from the end of the instruction by the addend, -4" {
	assert fixed(0, Call, 0x10010 - 4, x64) == 0xc // call .+16, from its opcode at 0xffff
	assert fixed(0, Call, 0x10000 - (1 << 31), x64) == 0x80000000
	assert fixed(0, Call, 0x10000 + (1 << 31), x64) == 0
	assert fixed(0, Page, 0x23456, x64) == 0
}

test "an x86-64 call to an import jumps through its slot in a stub, and a load of a slot is relative to itself" {
	// call puts; mov here@GOTPCREL(%rip), %rax
	const a = obj("a", Code, [0xe8, 0x058b4800, 0],
		[new Symbol("puts", Global), new Symbol("main", Global, 0), new Symbol("here", Local, 0, 5)],
		[new Fixup(1, Call, 0, -4), new Fixup(8, SlotRel32, 2, -4)])
	a.arch = "x86_64"
	const image = link([a], ["main"], [], true, x64)
	const main = at(image, "main")
	const stubs = section(image, "stubs")
	const slots = section(image, "slots")
	assert get(image, main + 1) == stubs - main - 5 && get(image, main + 8) == slots + 8 - main - 12
	assert get(image, stubs, 2) == 0x25ff && get(image, stubs + 2) == slots - stubs - 6
	assert get(image, slots + 8, 8) == main + 5 && image.binds.map(b => b.name).join(" ") == "puts"
}

test "sections of one name are laid out by their order, then as linked" {
	const a = obj("a", Data, [1], [new Symbol("a", Global, 0)])
	const b = obj("b", Data, [2], [new Symbol("b", Global, 0)])
	const c = obj("c", Data, [3], [new Symbol("c", Global, 0)])
	a.sections[0].order = "z"
	const image = link([a, b, c], ["a", "b", "c"])
	assert at(image, "b") < at(image, "c") && at(image, "c") < at(image, "a")
}

test "the Thread sections are laid out together after the data; a Desc and a Thread32 have S + A's offset there" {
	const t = obj("t", Thread, [1, 2],
		[new Symbol("x", Global, 0, 4), new Symbol("y", Local, 1, 4), new Symbol("p", Global, 2)])
	const tbss = new Section("tbss", Thread)
	tbss.align = 16
	tbss.size = 8
	const descs = new Section("data", Data)
	descs.size = 32
	descs.bytes = fromBytes(new u8[](32))
	descs.fixups = [new Fixup(0, Desc, 0, 2), new Fixup(8, Thread32, 0, 2), new Fixup(16, Desc, 1, 0)]
	t.sections = [t.sections[0], tbss, descs]
	t.sections[0].name = "tdata"
	const image = link([t], ["p"])
	const [from, to, align] = image.thread
	const p = at(image, "p")
	assert from > p && image.segment(from).write && from == section(image, "tdata") && get(image, from) == 1
	assert to == section(image, "tbss") + 8 && align == 16
	assert image.descs.map(e => `${e[0] - p}:${e[1]}`).join(" ") == `0:6 16:${section(image, "tbss") - from + 4}`
	assert get(image, p + 8) == 6
}

test "a Desc reaches only a thread's own bytes" {
	const d = obj("d", Data, [0, 0, 0, 0], [new Symbol("p", Global, 0)], [new Fixup(0, Desc, 0, 0)])
	assert link([d], []) throws new CompileError("d: data+0 describes bytes that are no thread's own")
}

test "the format's start is the image's first byte, where no object defines it, and a pointer to it is rebased" {
	const a = obj("a", Data, [0, 0], [new Symbol("__image", Weak), new Symbol("p", Global, 0)],
		[new Fixup(0, Abs64, 0, 8)])
	const image = link([a], ["p"])
	assert get(image, at(image, "p"), 8) == 8 && image.rebases.join(" ") == `${at(image, "p")}`
}

test "an object of another CPU is an error" {
	assert link([obj("a", Data, [0], []), new Object("x", "x86_64")],
		[]) throws new CompileError("x is of x86_64, not arm64")
}

/// An object as obj's whose section is named name.
function named(name: string, o: Object): Object {
	o.sections[0].name = name
	return o
}

test "an object replaced in a kept image leaves the others' bytes where they are, and who calls it reaches it" {
	const a = obj("a", Code, [0x94000000, 0xd65f03c0], [new Symbol("g", Global), new Symbol("f", Global, 0)],
		[new Fixup(0, Call, 0, 0)])
	const c = obj("c", Code, [7], [new Symbol("h", Global, 0)])
	const first = keep(kept(), [a, obj("b", Code, [0xd65f03c0], [new Symbol("g", Global, 0)]), c], ["f", "g", "h"])
	const l = kept(file(first))
	l.export("f")
	assert l.objects().join(" ") == "a b c" && !l.changed()
	l.remove("b")
	assert l.changed()
	const image = keep(l, [obj("b", Code, [0xd503201f, 0xd503201f, 0xd65f03c0], [new Symbol("g", Global, 0)])])
	const [f, g, h] = [at(image, "f"), at(image, "g"), at(image, "h")]
	assert f == at(first, "f") && h == at(first, "h") && get(image, h) == 7 && g != at(first, "g")
	assert get(image, f + 4) == 0xd65f03c0 && get(image, g + 8) == 0xd65f03c0
	assert addend(get(image, f), Call) == (g as i64) - (f as i64)
	assert kept(file(image)).objects().join(" ") == "a c b"
}

test "a pointer a kept image's frozen unit has set for good is rebased once" {
	const v = named("set", obj("v", Data, [1, 0], [new Symbol("lz", Global)], [new Fixup(0, Abs64, 0, 0)]))
	const z = named("set",
		obj("z", Data, [0, 0], [new Symbol("__start_set", Global), new Symbol("lz", Global, 0)],
		[new Fixup(0, Abs64, 0, 0)]))
	const l = kept()
	l.lazily(() => [member(z)])
	const first = keep(l, [v])
	const second = file(keep(kept(file(first)), []))
	assert first.rebases.length == 2 && keep(kept(second), []).rebases.length == 2
}

test "an object a kept image holds that names what is no longer defined is unlinked, and one added is stale" {
	const a = obj("a", Code, [0x94000000], [new Symbol("g", Global), new Symbol("f", Global, 0)],
		[new Fixup(0, Call, 0, 0)])
	const b = obj("b", Code, [0xd65f03c0], [new Symbol("g", Global, 0)])
	const first = file(keep(kept(), [a, b, obj("c", Data, [7], [new Symbol("h", Global, 0)])], ["f", "h"]))
	const l = kept(first)
	l.remove("b")
	const image = l.link()
	assert at(image, "f") == 0 && at(image, "h") != 0 && kept(file(image)).objects().join(" ") == "c"
	const again = kept(first)
	again.remove("b")
	assert keep(again,
		[obj("d", Data, [0], [new Symbol("g", Global)])]) throws new Stale("g is not defined, but d names it")
}

test "the sections a kept image bounds are in a run, from its start to its top, the holes in it zeros" {
	const x = obj("x", Data, [0, 0], [new Symbol("__start_types", Global), new Symbol("__stop_types", Global)],
		[new Fixup(0, Abs64, 0, 0)])
	// After bytes of an odd size, which the run starts aligned past.
	const odd = obj("odd", Data, [1], [])
	odd.sections[0].size = 3
	odd.sections[0].bytes = "\x01\x02\x03"
	const first = keep(kept(),
		[x, odd, named("types", obj("a", Data, [1], [])), named("types", obj("b", Data, [2], []))],
		["__start_types", "__stop_types"])
	const l = kept(file(first))
	l.remove("a")
	const image = keep(l, [named("types", obj("a", Data, [3, 4, 5], []))])
	const [was, start, stop] = [at(first, "__start_types"), at(image, "__start_types"), at(image, "__stop_types")]
	const [hole, b, a] = [get(image, start), get(image, start + 8), get(image, stop - 12)]
	assert start == was && start % 8 == 0 && stop == start + 28 && hole == 0 && b == 2 && a == 3
}

test "a kept image holds a lazy object for good, and a definition over its weak one is stale" {
	const a = obj("a", Code, [0x94000000], [new Symbol("lz", Global)], [new Fixup(0, Call, 0, 0)])
	const z = obj("z", Code, [0xd65f03c0], [new Symbol("lz", Global, 0), new Symbol("w", Weak, 0)])
	const l = kept()
	l.lazily(() => [member(z)])
	const first = file(keep(l, [a]))
	assert kept(first).objects().join(" ") == "a"
	assert keep(kept(first),
		[obj("d", Code, [0], [new Symbol("w", Global, 0)])]) throws new Stale("w of d is defined for good")
}

test "the sections a kept image has for good are laid out, which a name added bounds only as stale" {
	const wants = (name: string,
		x: string) => obj(name, Data, [0, 0], [new Symbol(x, Global)], [new Fixup(0, Abs64, 0, 0)])
	const has = (name: string, x: string) => named("f", obj(name, Data, [1], [new Symbol(x, Global, 0)]))
	const l = kept()
	l.lazily(() => [member(has("zx", "x"))])
	const first = file(keep(l, [wants("a", "x")]))
	const m = kept(first)
	m.lazily(() => [member(has("zy", "y"))])
	const second = file(keep(m, [wants("b", "y")]))
	const x = obj("x", Data, [0, 0], [new Symbol("__start_f", Global)], [new Fixup(0, Abs64, 0, 0)])
	const stale = "__start_f bounds sections the image has laid out\n__start_f is not defined, but x names it"
	assert keep(kept(second), [x]) throws new Stale(stale)
}

test "a region of a kept image has room its file has a hole for, and one that is full is stale" {
	const d = obj("d", Data, [7], [new Symbol("d", Global, 0)])
	const first = keep(kept(), [obj("a", Code, [0xd65f03c0], []), d], ["d"])
	assert at(first, "d") > 1 << 26 && first.bytes.pages.filter(p => p.length > 0).length < 10
	// What is after a region that grows is where it was, its page not written again.
	const image = keep(kept(file(first)), [obj("c", Code, new u64[](0x8000), [])])
	assert at(image, "d") == at(first, "d") && get(image, at(image, "d")) == 7 && !image.bytes.written(at(image, "d"))
	const b = obj("b", Code, [], [])
	b.sections[0].size = 1 << 29
	assert keep(kept(file(first)), [b]) throws new Stale("there is no room for text")
}

test "a group whose sections a kept object has dropped is taken by an object added, and else is stale" {
	const k = (name: string, word: u64) => obj(name, Const, [word], [new Symbol("k", Weak, 0)], [], "k")
	const first = file(keep(kept(), [k("a", 1), k("b", 2)], ["k"]))
	const l = kept(first)
	l.remove("a")
	const image = keep(l, [k("c", 3)])
	assert get(image, at(image, "k")) == 3
	const again = kept(first)
	again.remove("a")
	assert again.link() throws new Stale("b has k, which no object has now")
}

test "a Kept section is in no segment, and a continued image has its bytes" {
	const first = keep(kept(), [obj("a", Code, [0xd65f03c0], []), obj("b", Kept, [7, 8], [])])
	assert first.segments.length == 1 && first.sections.length == 1
	assert kept(file(first)).sections("data").join("") == "\x07\x00\x00\x00\x08\x00\x00\x00"
}

test "the Zero sections of a kept image are a segment its file has no bytes of, and those it bounds a run" {
	const zero = (name: string, size: u64) => {
		const o = named("roots", obj(name, Zero, [], []))
		o.sections[0].size = size
		return o
	}
	const x = obj("x", Data, [0, 0], [new Symbol("__start_roots", Global), new Symbol("__stop_roots", Global)],
		[new Fixup(0, Abs64, 0, 0)])
	const first = keep(kept(), [zero("a", 8), x, zero("b", 16)], ["__start_roots", "__stop_roots"])
	const last = first.segments[first.segments.length - 1]
	const start = at(first, "__start_roots")
	assert last.size == 0 && last.zero >= 24 && last.address == start
	assert get(first, 0x200, 8) > last.address // where the state is, which the loader takes none of
	const l = kept(file(first))
	l.remove("a")
	const image = keep(l, [zero("a", 32)])
	const [from, to] = [at(image, "__start_roots"), at(image, "__stop_roots")]
	assert from == start && to == start + 56 && image.bytes.length == first.bytes.length
}

test "a kept image's units keep their records and symbols where they are, and only new ones' are written" {
	const first = keep(kept(), [obj("a", Code, [0xd65f03c0], [new Symbol("f", Global, 0)])], ["f"])
	const image = keep(kept(file(first)), [obj("b", Code, [0xd65f03c0], [new Symbol("g", Global, 0)])], ["f", "g"])
	const [g, _, names] = image.symbols[0]
	const name = names[0]
	assert image.symbols.length == 1 && g.length == 1 && g[0].name == "g" && g[0].value == at(image, "g")
	// Of the Kept sections' region, but its last byte, the top a later link adds from, only g's slot in the names' table
	// and its entry, and b's in the units'.
	const [from, to] = [first.strtab[0], first.strtab[1] - 1]
	const [was, now] = [first.bytes.slice(from, to), image.bytes.slice(from, to)]
	let changed = 0
	for (const i of 0 ... was.length - 1) {
		changed += if (now[i] != was[i]) 1 else 0
	}
	// Of each table, a slot of 12 bytes, and an entry, of a name or of a unit, of 72.
	const [slot, entry] = [12, 72]
	assert now.length == was.length && changed <= 2 * (slot + entry)
	assert image.symtab[0] == first.symtab[0] && image.symtab[1] == first.symtab[1] + 24
	assert image.bytes.slice(name, name + 3) == "_g\x00"
}

test "an object a continued image links, a lazy one too, with a section the image has for good is stale" {
	const first = file(keep(kept(), [obj("a", Code, [0xd65f03c0], [])]))
	const l = kept(first)
	l.lazily(() => [member(obj("z", Init, [0, 0], [new Symbol("lz", Global, 0)]))])
	assert keep(l, [obj("b", Data, [0, 0], [new Symbol("lz", Global)], [new Fixup(0, Abs64, 0, 0)])]) throws new Stale("z has sections the image has for good")
}

test "a kept image whose table of names is broken is stale" {
	const first = keep(kept(), [obj("a", Code, [0xd65f03c0], [new Symbol("f", Global, 0)])], ["f"])
	const c = obj("c", Code, [0x94000000], [new Symbol("f", Global)], [new Fixup(0, Call, 0, 0)])
	assert keep(kept(file(first)), [c]).exports.length == 1
	// The table, of 1024 slots, each's index in its last 4 bytes.
	const table = read(first.bytes, 0x200, "arm64")!.names[0]
	for (const i of 0 ... 1023) {
		const p = table + 12 * (i as u64) + 8
		if (first.bytes.get(p, 4) != 0) {
			first.bytes.put(p + 3, 0x80, 1)
		}
	}
	assert keep(kept(file(first)), [c]) throws new Stale("the table of names is broken")
}

test "a kept image whose record of a unit is cut short is stale once it is read" {
	const first = keep(kept(), [obj("a", Code, [0xd65f03c0], [new Symbol("f", Global, 0)])], ["f"])
	// a's entry, of its record's block a byte shorter.
	const p = block(first, 1, 0) + 8
	first.bytes.put(p, first.bytes.get(p, 4) - 1, 4)
	assert keep(kept(file(first)), []).exports.length == 1
	const l = kept(file(first))
	l.remove("a")
	assert keep(l, []) throws new Stale("a's record is not as written")
}

test "a kept image whose frozen unit's record has its tail flipped is stale once its local symbols are read" {
	const l = kept()
	l.lazily(() => [member(obj("z", Code, [0xd65f03c0], [new Symbol("lz", Global, 0), new Symbol("here", Local, 0)]))])
	const first = keep(l, [obj("a", Code, [0x94000000], [new Symbol("lz", Global)], [new Fixup(0, Call, 0, 0)])])
	// The record's last byte, of the local's size, then one that goes on past it.
	const p = block(first, 0, 0)
	const [at, size] = [first.bytes.get(p, 8), first.bytes.get(p + 8, 4)]
	first.bytes.put(at + size - 1, first.bytes.get(at + size - 1, 1) ^ 0x80, 1)
	assert keep(kept(file(first)), []).exports.length == 0
	const b = obj("b", Code, [0x94000000], [new Symbol("puts", Global)], [new Fixup(0, Call, 0, 0)])
	assert keep(kept(file(first)), [b]) throws new Stale("the image's record is not as written")
}

test "the slot of a local symbol stays the local's in a kept image's frozen unit" {
	const a = obj("a", Code, [0x90000000, 0xd65f03c0], [new Symbol("here", Local, 0, 4)],
		[new Fixup(0, SlotPage, 0, 0)])
	const calls = (name: string,
		x: string) => obj(name, Code, [0x94000000], [new Symbol(x, Global)], [new Fixup(0, Call, 0, 0)])
	const first = file(keep(kept(), [a]))
	const second = file(keep(kept(first), [calls("b", "puts")]))
	assert keep(kept(second), [calls("c", "environ")]).binds.length == 2
}

/// Where the call at a in image goes, through the veneer it reaches if it is one: `adrp x16`, `add x16`, `br x16`.
function jumped(image: Image, a: u64): u64 {
	const v = a + (addend(get(image, a), Call) as u64)
	return if (get(image, v + 8) != 0xd61f0200) v
		else (v & ~0xfff) + ((addend(get(image, v), Page) + addend(get(image, v + 4), PageOff)) as u64)
}

/// An object of 50 MiB of code.
function far(name: string): Object {
	const o = obj(name, Code, [], [])
	o.sections[0].size = 50 << 20
	return o
}

test "a call too far for its symbol reaches it through a veneer, which a continued image makes again" {
	const main = obj("main", Code, [0x94000000], [new Symbol("main", Global, 0), new Symbol("f", Global)],
		[new Fixup(0, Call, 1, 0)])
	const f = obj("f", Code, [0xd65f03c0], [new Symbol("f", Global, 0)])
	for (const image of [link([main, far("a"), far("b"), far("c"), f], ["main", "f"]),
		keep(kept(file(keep(kept(), [main, far("a"), far("b"), far("c"), f], ["main", "f"]))), [far("d")])]) {
		const [m, to] = [at(image, "main"), at(image, "f")]
		assert to - m > 1 << 27 && m + (addend(get(image, m), Call) as u64) != to && jumped(image, m) == to
	}
}

test "a frozen unit's call too far for a local symbol reaches it through a veneer, which a continued image makes again" {
	const z = obj("z", Code, [0x94000000],
		[new Symbol("lz", Global, 0), new Symbol("", Local, 1), new Symbol("a", Global), new Symbol("b", Global),
		new Symbol("c", Global)], [new Fixup(0, Call, 1, 0)])
	const helper = new Section("text.z", Code)
	helper.bytes = "\xc0\x03\x5f\xd6"
	helper.size = 4
	z.sections.push(helper)
	const l = kept()
	l.lazily(() => [...["a", "b", "c"].map(name => {
		const o = far(name)
		o.symbols = [new Symbol(name, Global, 0)]
		return member(o)
	}), member(z)])
	const first = keep(l, [obj("main", Code, [0x94000000], [new Symbol("lz", Global)], [new Fixup(0, Call, 0, 0)])],
		["lz"])
	const [from, to] = [at(first, "lz"), section(first, "text.z")]
	for (const image of [first, keep(kept(file(first)), [])]) {
		assert to - from > 1 << 27 && jumped(image, from) == to
	}
}

/// Version v of the differential test's object i, o<i>.<v>, of a section s<i> of code if i is even, else of data.
/// It defines n<i> by a word of its own; if i is below 6, w<i % 3> weakly, by a word of that name's, and if 9, w0
/// strongly, by one of its own; it names three of n0 to n9 and w0 to w2, by calls if code, else by pointers, which a
/// quarter of its names must be defined for, the others weak; and it has a section `listed`, which `bounds` bounds, of
/// a pointer to its own word.
function version(i: u64, v: u64): Object {
	const words: u64[] = [0x10000 + 0x100 * i + v, 0]
	const symbols = [new Symbol(`n${i}`, Global, 0)]
	if (i < 6 || i == 9) {
		words[1] = if (i < 6) 0x20000 + i % 3 else 0x30000 + i
		symbols.push(new Symbol(`w${i % 3}`, if (i < 6) Weak else Global, 0, 4))
	}
	const fixups: Fixup[] = []
	for (const k of 0 ... 2) {
		const n = fnv(`${i}.${v}.${k}`) % 13
		const name = if (n < 10) `n${n}` else `w${n - 10}`
		if (symbols.every(s => s.name != name)) {
			symbols.push(new Symbol(name, if (fnv(`${i}.${v}.${k}.`) % 4 == 0) Global else Weak))
		}
		fixups.push(new Fixup(4 * (words.length as u64), if (i % 2 == 0) Call else Abs64,
			symbols.map(s => s.name).indexOf(name), 0))
		words.push(...[if (i % 2 == 0) 0x94000000 else 0, 0])
	}
	words.push(...new u64[]((fnv(`${i}.${v}`) % 8) as i32))
	return listing(named(`s${i}`, obj(`o${i}.${v}`, if (i % 2 == 0) Code else Data, words, symbols, fixups)))
}

/// o, whose first symbol is its first section's, with a section `listed` of a pointer to it.
function listing(o: Object): Object {
	o.sections.push(named("listed", obj("", Data, [0, 0], [], [new Fixup(0, Abs64, 0, 0)])).sections[0])
	return o
}

/// The object version made that is named name, or `bounds`, which defines it, of 0xb0 and pointers to the start and
/// stop of the `listed` sections, which it lists too.
function made(name: string): Object {
	if (name == "bounds") {
		return listing(named("bounds",
			obj(name, Data, [0xb0, 0, 0, 0, 0, 0],
			[new Symbol("", Local, 0), new Symbol("__start_listed", Global), new Symbol("__stop_listed", Global),
			new Symbol("bounds", Global, 0)], [new Fixup(8, Abs64, 1, 0), new Fixup(16, Abs64, 2, 0)])))
	}
	const iv = split(name.slice(1, name.length), ".")
	return version(decimal(iv[0]) as u64, decimal(iv[1]) as u64)
}

/// The image l links of objects too, or if it is stale, noted in stales, one linked anew of those names names then;
/// null if that is an error.
function relinked(l: Linker, objects: Object[], names: () => string[], stales: string[]): Image | null throws Stale {
	try {
		return keep(l, objects)
	} catch (e: CompileError | Stale) {
		if (e instanceof CompileError) {
			return null
		}
		stales.push(e.msg)
	}
	return anew(names())
}

/// The image linked anew of the objects named; null if it is an error.
function anew(names: string[]): Image | null throws Stale {
	try {
		return keep(kept(), names.map(made), ["bounds"])
	} catch (e: CompileError) {
		return null
	}
}

/// The word that each fixup of objects, which image holds, reaches: 0 for a name no one defines, as a pointer is, or a
/// call reaches a stub, `br x17` its third instruction.
function reached(image: Image, objects: Object[]): u64[] {
	const words: u64[] = []
	const listed = pointed(image)
	for (const o of objects) {
		const at = listed.find(p => get(image, p) == new Bytes(o.sections[0].bytes).get(0, 4)) ?? 0
		for (const f of o.sections[0].fixups) {
			const to = if (f.kind == Call) jumped(image, at + f.at) else get(image, at + f.at, 8)
			words.push(if (to == 0 || get(image, to + 8) == 0xd61f0220) 0 else get(image, to))
		}
	}
	return words
}

/// What the image's `listed` sections point to, the objects' first sections, as held from the start of them to the
/// stop, but zeros.
function pointed(image: Image): u64[] {
	const ps: u64[] = []
	const bounds = at(image, "bounds")
	let p = get(image, bounds + 8, 8)
	while (p < get(image, bounds + 16, 8)) {
		if (get(image, p, 8) != 0) {
			ps.push(get(image, p, 8))
		}
		p += 8
	}
	return ps
}

/// The words of the objects image's `listed` sections point to; ascending.
function listed(image: Image): u64[] {
	const words = pointed(image).map(p => get(image, p))
	sort(words)
	return words
}

test "a kept image continued, by objects added, removed and replaced, reaches what one linked anew of its objects does" {
	let cur = file(keep(kept(), [made("bounds")], ["bounds"]))
	const versions = new u64[](10)
	let linked = 0
	let remade = 0
	let supplied = 0
	const stales: string[] = []
	for (const step of 1 ... 1000) {
		const l = kept(cur)
		let held = l.objects()
		const added: Object[] = []
		for (const k of 0 ... step % 2) {
			const i = (fnv(`${step}`) + 3 * (k as u64)) % 10
			const was = held.find(h => startsWith(h, `o${i}.`))
			if (was != null) {
				l.remove(was!)
				held = held.filter(h => h != was)
			}
			if (was == null || fnv(`${step}.${k}`) % 3 != 0) {
				versions[i]++
				added.push(version(i, versions[i]))
			}
		}
		// A new version of the objects that name what is no longer defined, and of those that define n<i> wanted.
		const next = (i: u64, wanted: bool) => {
			versions[i]++
			added.push(version(i, versions[i]))
			l.add(added[added.length - 1], wanted)
		}
		l.supply((wanted, gone) => {
			for (const name of gone) {
				held = held.filter(h => h != name)
				remade++
				next(decimal(split(name.slice(1, name.length), ".")[0]) as u64, false)
			}
			for (const name of wanted.filter(n => startsWith(n, "n"))) {
				const i = decimal(name.slice(1, name.length)) as u64
				if (![...held, ...added.map(o => o.name)].some(h => startsWith(h, `o${i}.`))) {
					supplied++
					next(i, true)
				}
			}
		})
		const names = () => [...held, ...added.map(o => o.name)]
		const before = stales.length
		const image = relinked(l, added, names, stales)
		if (image == null) {
			// An error of the objects given, which a link anew of them has too.
			assert anew(names()) == null
			continue
		}
		// Stale only of such an error, never linked anew silently.
		assert stales.length == before
		cur = file(image!)
		const objects = kept(cur).objects().map(made)
		const versioned = objects.filter(o => o.name != "bounds")
		const words = objects.map(o => new Bytes(o.sections[0].bytes).get(0, 4))
		sort(words)
		// Not in the assert, which shows what its calls are given: the images, their bytes too.
		const again = keep(kept(), objects, ["bounds"])
		const [was, now] = [reached(image!, versioned), reached(again, versioned)]
		const [first, second] = [listed(image!), listed(again)]
		assert was == now && first == words && second == words
		linked++
	}
	const errors = stales.filter(m => indexOf(m, " is not defined, but ") >= 0).length
	assert linked > 600 && remade > 0 && supplied > 0 && stales.length == 15 && errors == 15
}

test "a kept image's sections a name bounds once laid out are stale, and a run has those added once nothing bounds them" {
	const types = (name: string, word: u64) => named("types", obj(name, Data, [word], []))
	const x = obj("x", Data, [0, 0], [new Symbol("__start_types", Global)], [new Fixup(0, Abs64, 0, 0)])
	assert keep(kept(file(keep(kept(), [types("a", 1)]))),
		[x]) throws new Stale("__start_types bounds sections the image has laid out")
	const first = file(keep(kept(), [types("a", 1), x], ["__start_types"]))
	const l = kept(first)
	l.remove("x")
	const second = keep(l, [types("b", 2)])
	const image = keep(kept(file(second)), [x], ["__start_types"])
	const start = at(image, "__start_types")
	const [a, b] = [get(image, start), get(image, start + 8)]
	assert start != 0 && a == 1 && b == 2
}

test "a kept image whose entry of a name, or link of its chain, is broken is stale" {
	const first = keep(kept(), [obj("a", Code, [0xd65f03c0], [new Symbol("f", Global, 0)])], ["f"])
	// f's entry, after the table of names: its unit plus 1, and of its chain's first link, the unit plus 1 and flags.
	const [table, cap] = read(first.bytes, 0x200, "arm64")!.names
	let p = table + 12 * cap
	while (first.bytes.slice(first.bytes.get(p, 8), first.bytes.get(p, 8) + 1) != "f") {
		p += 72
	}
	const [unit, chain] = [first.bytes.get(p + 16, 4), first.bytes.get(p + 60, 4)]
	first.bytes.put(p + 16, 9, 4)
	assert keep(kept(file(first)), [], ["f"]) throws new Stale("the names' entries are broken")
	first.bytes.put(p + 16, unit, 4)
	first.bytes.put(p + 60, chain & 0xc0000000 | 9, 4)
	const l = kept(file(first))
	l.remove("a")
	assert keep(l, []) throws new Stale("a chain of names is broken")
}

test "the supplier is given the names wanted, then the units that name what is no longer defined, and links what it adds" {
	const calls = (name: string,
		x: string) => obj(name, Code, [0x94000000], [new Symbol(x, Global)], [new Fixup(0, Call, 0, 0)])
	const defines = (name: string, x: string) => obj(name, Code, [0xd65f03c0], [new Symbol(x, Global, 0)])
	const first = file(keep(kept(), [defines("m", "m.1"), calls("a", "m.1"), calls("b", "m.1"), calls("c", "puts")]))
	const l = kept(first)
	l.remove("m")
	const given: string[] = []
	l.supply((names, gone) => {
		given.push(`${names.join(" ")}|${gone.join(" ")}`)
		for (const name of gone) {
			l.add(calls(name, "m.2"))
		}
		for (const name of names) {
			l.add(defines(`${name}.o`, name))
		}
	})
	const image = keep(l, [defines("m", "m.2"), calls("d", "f")], ["m.2"])
	assert given == ["f|", "|b a"] && kept(file(image)).objects().join(" ") == "c m d f.o b a"
}

test "a continued image whose units lose a name they need does not list the lazy objects for it" {
	const a = obj("a", Code, [0x94000000], [new Symbol("x", Global)], [new Fixup(0, Call, 0, 0)])
	const l = kept(file(keep(kept(), [obj("m", Code, [0xd65f03c0], [new Symbol("x", Global, 0)]), a])))
	l.remove("m")
	let listed = 0
	l.lazily(() => {
		listed++
		return []
	})
	const image = keep(l, [])
	assert listed == 0 && kept(file(image)).objects().length == 0
}

test "the stack maps' addresses are of the image's first byte, which the format's name for it is, and not rebased" {
	const maps = obj("m", Const, [0, 0], [new Symbol("f", Global)], [new Fixup(0, Abs64, 0, 4)])
	maps.sections[0].name = ".llvm_stackmaps"
	const f = obj("f", Code, [0xd65f03c0], [new Symbol("f", Global, 0)])
	const d = obj("d", Data, [0, 0], [new Symbol("__maps", Global), new Symbol("p", Global, 0)],
		[new Fixup(0, Abs64, 0, 0)])
	const image = link([maps, f, d], ["f", "p"])
	const m = section(image, ".llvm_stackmaps")
	assert get(image, m, 8) == at(image, "f") + 4 && !image.segment(m).write && get(image, at(image, "p"), 8) == 0
		&& image.rebases.join(" ") == `${at(image, "p")}`
}

test "a lazy object's slot of a local symbol is of no chain of names" {
	const z = obj("z", Code, [0x90000000, 0xd65f03c0], [new Symbol("lz", Global, 0), new Symbol("here", Local, 0, 4)],
		[new Fixup(0, SlotPage, 1, 0)])
	const l = kept()
	l.lazily(() => [member(z)])
	const a = obj("a", Code, [0x94000000], [new Symbol("lz", Global)], [new Fixup(0, Call, 0, 0)])
	assert keep(l, [a]).exports.length == 0
}

test "of a continued image, the names the objects removed define, and the objects held but removed naming a name" {
	const calls = (name: string,
		x: string) => obj(name, Code, [0x94000000], [new Symbol(x, Global)], [new Fixup(0, Call, 0, 0)])
	const m = obj("m", Code, [0xd65f03c0], [new Symbol("m.1", Global, 0), new Symbol("~a", Weak, 0)])
	const l = kept(file(keep(kept(), [m, calls("a", "~a"), calls("b", "~a"), calls("c", "m.1")])))
	l.remove("m")
	l.remove("b")
	const defined = l.defined("~").join(" ")
	const naming = l.naming("~a").join(" ")
	const none = l.naming("~b").length
	assert defined == "~a" && naming == "a" && none == 0
}

test "a continued link of an image of thousands of units reads only those it changes, and reaches what a link anew does" {
	// Unit i of version v: a call to name, and f<i>, a word of i << 8 | v.
	const unit = (i: i32, v: i32, name: string) => obj(`u${i}@${v}`, Code, [0x94000000, (i << 8 | v) as u64],
		[new Symbol(`f${i}`, Global, 0, 4), new Symbol(name, Global)], [new Fixup(0, Call, 1, 0)])
	const next = (i: i32) => `f${(i + 1) % 3000}`
	const z = obj("z", Code, [0xd65f03c0], [new Symbol("lz", Global, 0)])
	const linker = (file: string) => {
		const l = kept(file)
		l.lazily(() => [member(z)])
		return l
	}
	const units: Object[] = []
	for (const i of 0 ... 2999) {
		units.push(unit(i, 0, next(i)))
	}
	let image = keep(linker(""), units)
	// Per link, how many units it read, and the words the calls of the units replaced reach, as continued and anew.
	const reads: i32[] = []
	const names: string[] = []
	const [was, now]: [string[], string[]] = [[], []]
	const reached = (image: Image) => names.map(n => get(image, jumped(image, at(image, n) - 4))).join(" ")
	// u7 replaced 4 times; one added, then removed; one added of a call to puts, through a stub, and to lz, of z,
	// lazy; then others replaced.
	for (const step of 1 ... 12) {
		const l = linker(file(image))
		const added: Object[] = []
		if (step <= 4 || step >= 9) {
			const i = if (step <= 4) 7 else step * 331 % 3000
			l.remove(units[i].name)
			units[i] = unit(i, step, next(i))
			added.push(units[i])
			if (!names.includes(`f${i}`)) {
				names.push(`f${i}`)
			}
		} else if (step == 6) {
			l.remove(units[units.length - 1].name)
			units.pop()
		} else {
			units.push(unit(3000 + step, 0, if (step == 7) "puts" else if (step == 8) "lz" else next(step)))
			added.push(units[units.length - 1])
		}
		image = keep(l, added, names)
		reads.push(l.reads)
		was.push(reached(image))
		now.push(reached(keep(linker(""), units, names)))
	}
	assert reads.every(n => n <= 4) && was == now
}

test "a kept image's symbol table has no marks, the names starting with ~" {
	const image = keep(kept(), [obj("a", Code, [0xd65f03c0], [new Symbol("f", Global, 0), new Symbol("~m", Weak, 0)])])
	const names = image.symbols.map(e => e[0].map(s => s.name).join(" "))
	assert names == ["f"]
}

test "a continued image unlinks the supplied units no unit names any more, and those only they named, but a cycle" {
	// Unit name, defining name, of a call to each of calls.
	const unit = (name: string, calls: string[]) => {
		const words: u64[] = [...calls.map(c => 0x94000000 as u64), 0xd65f03c0]
		const fixups: Fixup[] = []
		for (const i of 0 ... calls.length - 1) {
			fixups.push(new Fixup((4 * i) as u64, Call, i + 1, 0))
		}
		return obj(name, Code, words, [new Symbol(name, Global, 0), ...calls.map(c => new Symbol(c, Global))], fixups)
	}
	// A chain r a b c, a diamond r2 d e1 e2 f, s named by a and by q, which stays, and a cycle r3 x y; of a
	// thousand units more, it reads those it unlinks or looks at.
	const roots = [unit("r", ["a"]), unit("r2", ["d"]), unit("q", ["s"]), unit("r3", ["x"])]
	const supplied = [unit("a", ["b", "s"]), unit("b", ["c"]), unit("c", []), unit("d", ["e1", "e2"]),
		unit("e1", ["f"]), unit("e2", ["f"]), unit("f", []), unit("s", []), unit("x", ["y"]), unit("y", ["x"])]
	const l = kept()
	for (const o of supplied) {
		l.add(o, true)
	}
	for (const i of 0 ... 999) {
		l.add(unit(`u${i}`, []))
	}
	const first = file(keep(l, roots))
	const again = kept(first)
	again.remove("r")
	again.remove("r2")
	again.remove("r3")
	const image = again.link()
	const reads = again.reads
	const held = kept(file(image)).objects().filter(o => !startsWith(o, "u")).join(" ")
	assert held == "s x y q" && reads <= 13
}

/// An object named name, defining it, of a call to each of calls, and of a section of group k, defining k weakly, of
/// word; a call to k is through that symbol.
function grouped(name: string, word: u64, calls: string[]): Object {
	const symbols = [new Symbol(name, Global, 0), new Symbol("k", Weak, 1)]
	const fixups: Fixup[] = []
	for (const i of 0 ... calls.length - 1) {
		if (calls[i] != "k") {
			symbols.push(new Symbol(calls[i], Global))
		}
		fixups.push(new Fixup((4 * i) as u64, Call, if (calls[i] == "k") 1 else symbols.length - 1, 0))
	}
	const o = obj(name, Code, [...calls.map(c => 0x94000000 as u64), 0xd65f03c0], symbols, fixups)
	o.sections.push(named("text.k", obj("", Code, [word], [], [], "k")).sections[0])
	return o
}

test "a continued image whose supplied unit is unlinked of a group whose sections others dropped is stale" {
	const r = obj("r", Code, [0x94000000], [new Symbol("x", Global)], [new Fixup(0, Call, 0, 0)])
	const l = kept()
	l.add(grouped("x", 1, []), true)
	const first = file(keep(l, [grouped("y", 2, ["k"]), r], ["y"]))
	const again = kept(first)
	again.remove("r")
	assert keep(again, [], ["y"]) throws new Stale("y has k, which no object has now")
	const other = kept(first)
	other.remove("r")
	assert keep(other, [grouped("z", 3, ["k"])],
		["y", "z"]) throws new Stale("y has k, which no object has now\nz has k, which no object has now")
}

test "a continued image whose supplied unit is unlinked of a group an added unit dropped is stale" {
	const r = obj("r", Code, [0x94000000], [new Symbol("x", Global)], [new Fixup(0, Call, 0, 0)])
	const l = kept()
	l.add(grouped("x", 1, []), true)
	const again = kept(file(keep(l, [r])))
	again.remove("r")
	assert keep(again, [grouped("z", 3, ["k"])], ["z"]) throws new Stale("z has k, which no object has now")
}

test "a group whose unit is unlinked as it names what is no longer defined is taken by the unit supplied for it" {
	const f = obj("f", Code, [0xd65f03c0], [new Symbol("f", Global, 0)])
	const first = file(keep(kept(), [grouped("g@1", 1, ["f"]), grouped("y", 2, ["k"]), f], ["y"]))
	const l = kept(first)
	l.remove("f")
	const gone: string[] = []
	l.supply((names, lost) => {
		gone.push(...lost)
		if (lost.includes("g@1")) {
			l.add(grouped("g@2", 3, []))
		}
	})
	const image = keep(l, [], ["y"])
	const word = get(image, jumped(image, at(image, "y")))
	assert gone == ["g@1"] && word == 3
}

test "a supplied unit whose namer is replaced by one naming it through a unit supplied now stays" {
	const unit = (name: string, calls: string[]) => grouped(name, 0, calls)
	const l = kept()
	l.add(unit("a", ["c"]), true)
	l.add(unit("c", []), true)
	const again = kept(file(keep(l, [unit("r@1", ["a"])])))
	again.remove("r@1")
	const given: string[] = []
	again.supply((names, gone) => {
		given.push(`${names.join(" ")}|${gone.join(" ")}`)
		if (names.includes("b")) {
			again.add(unit("b", ["a"]), true)
		}
	})
	const image = keep(again, [unit("r@2", ["b"])])
	const held = kept(file(image)).objects().join(" ")
	assert given == ["b|"] && held == "a c r@2 b"
}

test "a supplied unit stays while a name it defines is named so that it must be, by the frozen unit too, or exported" {
	// Unit name, defining defines, of a call to each of calls, strongly or if weak not.
	const unit = (name: string, defines: string[], calls: string[], weak = false) => {
		const words: u64[] = [...calls.map(c => 0x94000000 as u64), 0xd65f03c0]
		const fixups: Fixup[] = []
		for (const i of 0 ... calls.length - 1) {
			fixups.push(new Fixup((4 * i) as u64, Call, defines.length + i, 0))
		}
		return obj(name, Code, words,
			[...defines.map(d => new Symbol(d, Global, 0)),
			...calls.map(c => new Symbol(c, if (weak) Weak else Global))], fixups)
	}
	// s1 is named weakly by w too, s2 exported, s3 named by the lazy z, and s4b of s4 by q.
	const l = kept()
	for (const o of [unit("s1", ["s1"], []), unit("s2", ["s2"], []), unit("s3", ["s3"], []),
		unit("s4", ["s4a", "s4b"], [])]) {
		l.add(o, true)
	}
	l.lazily(() => [member(unit("z", ["z"], ["s3"]))])
	const first = file(keep(l,
		[unit("r", ["r"], ["s1", "s2", "s3", "s4a", "z"]), unit("w", ["w"], ["s1"], true), unit("q", ["q"], ["s4b"])],
		["s2"]))
	const again = kept(first)
	again.remove("r")
	const image = keep(again, [])
	const held = kept(file(image)).objects().join(" ")
	assert held == "s2 s3 s4 w q"
}

test "a kept image whose bytes would be 2 GiB or more is not made" {
	const o = obj("big", Const, [], [new Symbol("big", Global, 0)])
	o.sections[0].size = 1 << 31
	let error = ""
	try {
		keep(kept(), [o])
	} catch (e: CompileError) {
		error = e.msg
	}
	assert startsWith(error, "the image would be ") && endsWith(error, " bytes, 2 GiB or more")
}

test "a continued image that freezes a lazy object each link keeps the frozen unit's record once" {
	// Of many names, and pointers to those the links after it define, so that each of those sets the frozen unit's anew.
	const syms: Symbol[] = []
	const fixups: Fixup[] = []
	for (const i of 0 ... 299) {
		syms.push(new Symbol(`big${i}`, Global, 0))
	}
	for (const i of 1 ... 8) {
		syms.push(new Symbol(`lz${i}`, Weak))
		fixups.push(new Fixup(8 * (i as u64), Abs64, 299 + i, 0))
	}
	const wants = (name: string,
		x: string) => obj(name, Data, [0, 0], [new Symbol(x, Global)], [new Fixup(0, Abs64, 0, 0)])
	const l = kept()
	l.lazily(() => [member(obj("z", Data, new u64[](18), syms, fixups))])
	let image = file(keep(l, [wants("a", "big0")]))
	const top = (file: string) => read(new Bytes(file), 0x200, "arm64")!.regions[6].top
	const first = top(image)
	for (const i of 1 ... 8) {
		const m = kept(image)
		m.lazily(() => [member(obj(`z${i}`, Data, [0], [new Symbol(`lz${i}`, Global, 0)]))])
		image = file(keep(m, [wants(`b${i}`, `lz${i}`)]))
	}
	// Each link adds a name and a unit's record, not another of the frozen unit's, of some 9 KiB.
	const last = top(image)
	assert last - first < 1024
}

test "a continued image of more names than its table of names has room for grows the table, and continues it" {
	const first = file(keep(kept(), [obj("a", Data, [0], [new Symbol("g", Global, 0)])]))
	const syms: Symbol[] = []
	for (const i of 1 ... 600) {
		syms.push(new Symbol(`g${i}`, Global, 0))
	}
	const second = file(keep(kept(first), [obj("b", Data, [0], syms)]))
	const c = obj("c", Data, [0, 0, 0, 0],
		[new Symbol("g", Global), new Symbol("g600", Global), new Symbol("c", Global, 0)],
		[new Fixup(0, Abs64, 0, 0), new Fixup(8, Abs64, 1, 0)])
	const image = keep(kept(second), [c], ["c", "g", "g600"])
	const [p, g, g600] = [at(image, "c"), at(image, "g"), at(image, "g600")]
	const [x, y] = [get(image, p, 8), get(image, p + 8, 8)]
	assert g != 0 && g600 != 0 && g != g600 && x == g && y == g600
}

test "a kept image's mapped region has room as much as its content, of an 8th of a region's at least, and one at most" {
	const [big, mid] = [obj("big", Const, [], []), obj("mid", Data, [7], [])]
	big.sections[0].size = (1 << 29) - (1 << 24)
	mid.sections[0].size = 100 << 20
	const first = keep(kept(), [obj("a", Code, [0xd65f03c0], []), big, mid])
	const rooms = read(first.bytes, 0x200, "arm64")!.regions.slice(0, 5).map(r => (r.cap - r.top) >> 20)
	assert rooms == [32, 32, 256, 100, 32]
}

test "of a continued image, the names starting with of that a unit it holds defines, and none of one it does not" {
	const m = obj("m", Code, [0xd65f03c0], [new Symbol("m.1", Global, 0), new Symbol("~a", Weak, 0),
		new Symbol("~~b", Weak, 0)])
	const l = kept(file(keep(kept(), [m])))
	const marks = l.defines("m", "~").join(" ")
	const none = l.defines("n", "~").length
	assert marks == "~a ~~b" && none == 0
}

test "the sections of the objects of a key are of those alone, which are all it reads" {
	const objects = [obj("a", Code, [0xd65f03c0], [])]
	for (const i of 0 ... 99) {
		objects.push(obj(`u${i}@1`, Kept, [i as u64], []))
	}
	const l = kept(file(keep(kept(), objects)))
	const data = l.sections("data", "u7")
	const reads = l.reads
	assert data.join("") == "\x07\x00\x00\x00" && reads == 1
}
