//! Tests of src/link/elf: a written shared library read back.

import { sort, startsWith } from "../../std/algo"
import { makeTempDir, open, removeAll } from "../../std/fs"
import { CompileError } from "../error"
import { Tpde } from "../backend/tpde"
import { arm64 } from "./arm64"
import { Bytes, le, mapped, store, zeros } from "./bytes"
import { elf } from "./elf"
import { Linker } from "./link"
import { Call, Code, Fixup, Global, Local, Object, Rel32, Section, Symbol, Unwind, Weak } from "./object"

/// The file of the image l links.
function file(l: Linker): Bytes throws CompileError {
	const image = l.link()
	elf.write(image)
	return image.bytes
}

/// An object named name of 8 bytes of code, which defines name there.
function text(name: string): Object {
	const s = new Section("text", Code)
	s.align = 4
	s.bytes = zeros(8)
	s.size = 8
	const o = new Object(name, "arm64")
	o.sections = [s]
	o.symbols = [new Symbol(name, Global, 0)]
	return o
}

/// The index of the section header of d's .symtab.
function table(d: Bytes): u64 {
	let i: u64 = 1
	while (d.get(d.get(40, 8) + 64 * i + 4, 4) != 2) {
		i++
	}
	return i
}

/// The names of the entries of d's .symtab, each with its value if in the section its st_shndx says; and the entries.
function symbols(d: Bytes): [string, string] {
	const header = (i: u64) => d.get(40, 8) + 64 * i
	const symtab = table(d)
	const [entries, size] = [d.get(header(symtab) + 24, 8), d.get(header(symtab) + 32, 8)]
	const strings = d.get(header(d.get(header(symtab) + 40, 4)) + 24, 8)
	const names: string[] = []
	for (const e of 0 ... ((size / 24) as i32) - 1) {
		const at = entries + 24 * (e as u64)
		const [name, value, shndx] = [strings + d.get(at, 4), d.get(at + 8, 8), d.get(at + 6, 2)]
		const from = d.get(header(shndx) + 16, 8)
		if (d.get(at, 4) != 0 && value >= from && value < from + d.get(header(shndx) + 32, 8)) {
			names.push(d.slice(name, name + 1))
		}
	}
	return [names.join(" "), d.slice(entries, entries + size)]
}

test "a kept image's symbol table has each unit's symbols, in their sections, those of one it holds as it had them" {
	const l = new Linker(arm64, elf, new Bytes())
	l.add(text("f"))
	const d = file(l)
	const [first, entries] = symbols(d)
	const again = new Linker(arm64, elf, new Bytes(mapped(d)))
	again.add(text("g"))
	const [second, more] = symbols(file(again))
	assert first == "f" && second == "f g" && more.slice(0, entries.length) == entries
}

test "a symbol's entry is in the section its header says, of a kept image too, where an object cuts it anew" {
	const l = new Linker(arm64, elf, new Bytes())
	l.add(text("f"))
	const again = new Linker(arm64, elf, new Bytes(mapped(file(l))))
	const eh = new Section(".eh_frame", Unwind)
	eh.bytes = le(12, 4) + zeros(12)
	eh.size = 16
	const u = new Object("u", "arm64")
	u.sections = [eh]
	again.add(u)
	const [names, _] = symbols(file(again))
	assert names == "f"
}

test "the unwinder's table leaves out an empty function's FDE, which would hide the next one's at its address" {
	const code = text("g")
	// A CIE of pcs pcrel sdata4, and the FDEs of g, its 8 bytes, and of f, empty, at its address.
	const fde = (at: u64, range: u64) => le(16, 4) + le(at + 4, 4) + zeros(4) + le(range, 4) + zeros(4)
	const eh = new Section(".eh_frame", Unwind)
	eh.bytes = le(16, 4) + zeros(4) + "\x01zR\0\x01\x7c\x1e\x01\x1b\0\0\0" + fde(20, 8) + fde(40, 0)
	eh.size = 60
	eh.fixups = [new Fixup(28, Rel32, 0, 0), new Fixup(48, Rel32, 1, 0)]
	code.sections.push(eh)
	code.symbols.push(new Symbol("f", Global, 0))
	const l = new Linker(arm64, elf, new Bytes())
	l.add(code)
	const d = file(l)
	let ph = d.get(32, 8)
	while (d.get(ph, 4) != 0x6474e550) {
		ph += 56
	}
	const fdes = d.get(d.get(ph + 8, 8) + 8, 4) // in the eh_frame_hdr's table
	assert fdes == 1
}

test "a stack map's fixup names its own function, though another object's definition takes the name" {
	const b = new Tpde("m")
	b.collected()
	const r = b.ref()
	const g = b.function("g", b.fn(b.void(), [r]), false)
	const f = b.function("f", b.fn(r, [r]), false)
	b.at(b.block(f))
	b.call(b.fn(b.void(), [r]), g, [b.param(f, 0)])
	b.ret(b.param(f, 0))
	const o = elf.read("m.o", b.object())
	const maps = o.sections.filter(s => s.name == ".llvm_stackmaps")
	assert maps.length == 1
	const own = o.symbols[maps[0].fixups[0].symbol]
	const def = o.symbols.find(s => s.name == "f")!
	assert own.binding == Local && own.section == def.section && own.value == def.value
}

test "a call's stack map leaves out the refs whose definition does not dominate it" {
	const b = new Tpde("m")
	b.collected()
	const r = b.ref()
	const make = b.function("make", b.fn(r, []), false)
	const f = b.function("f", b.fn(r, [b.int(1)]), false)
	// Made in this order, TPDE lays the blocks out as entry, def, other, use.
	const [entry, other, def, use] = [b.block(f), b.block(f), b.block(f), b.block(f)]
	b.at(entry)
	b.condBr(b.param(f, 0), other, def)
	b.at(def)
	const v = b.call(b.fn(r, []), make, [])
	b.condBr(b.param(f, 0), use, other)
	b.at(other)
	b.ret(b.call(b.fn(r, []), make, []))
	b.at(use)
	b.ret(v)
	assert elf.read("m.o", b.object()).sections.every(s => s.name != ".llvm_stackmaps")
}

/// An object named name of size bytes of code, which defines name there, and of an FDE of it.
function unwound(name: string, size: u64): Object {
	const o = text(name)
	o.sections[0].bytes = zeros(size as i32)
	o.sections[0].size = size
	const eh = new Section(".eh_frame", Unwind)
	eh.bytes = le(16, 4) + zeros(4) + "\x01zR\0\x01\x7c\x1e\x01\x1b\0\0\0" + le(16, 4) + le(24, 4) + zeros(4)
		+ le(size, 4) + zeros(4)
	eh.size = 40
	eh.fixups = [new Fixup(28, Rel32, 0, 0)]
	o.sections.push(eh)
	return o
}

/// The FDE the unwinder finds for the code at pc in d by its eh_frame_hdr's table, the last entry at pc or below, if
/// its function has pc; else 0.
function unwinder(d: Bytes, pc: u64): u64 {
	let ph = d.get(32, 8)
	while (d.get(ph, 4) != 0x6474e550) {
		ph += 56
	}
	const hdr = d.get(ph + 16, 8)
	const signed = (v: u64) => (((v as u32) as i32) as i64) as u64
	const entry = (i: u64, field: u64) => hdr + signed(d.get(hdr + 12 + 8 * i + field, 4))
	let [lo, hi] = [0 as u64, d.get(hdr + 8, 4)]
	while (lo < hi) {
		const mid = (lo + hi) / 2
		if (entry(mid, 0) <= pc) {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	const fde = if (lo > 0) entry(lo - 1, 4) else 0
	const start = fde + 8 + signed(d.get(fde + 8, 4))
	return if (fde > 0 && pc >= start && pc < start + d.get(fde + 12, 4)) fde else 0
}

test "a kept image's unwinder's table, continued, finds each function's FDE, and none of a function it no longer has" {
	let l = new Linker(arm64, elf, new Bytes())
	for (const i of 0 ... 19) {
		l.add(unwound(`f${i}.0`, 8))
		l.export(`f${i}.0`)
	}
	let image = l.link()
	elf.write(image)
	// Each file stored over a copy of the one before, as a build stores it.
	const dir = makeTempDir("bober-")
	let f = open(`${dir}/0`, "w+")
	store(f, image.bytes)
	for (const step of 1 ... 60) {
		const was = image.exports
		l = new Linker(arm64, elf, new Bytes(f.map()))
		const i = step * 7 % 20
		l.remove(l.objects().find(o => startsWith(o, `f${i}.`))!)
		l.add(unwound(`f${i}.${step}`, 8 * (1 + (step as u64) % 7)))
		l.export(`f${i}.${step}`)
		image = l.link()
		elf.write(image)
		const next = f.copy(`${dir}/${step}`, image.bytes.length)
		f.close()
		f = next
		store(f, image.bytes)
		const d = image.bytes
		assert image.exports.every(e => unwinder(d, e[1]) != 0 && unwinder(d, e[1] + 4) == unwinder(d, e[1]))
		assert was.every(e => unwinder(d, e[1]) == 0 || image.exports.some(x => unwinder(d, x[1]) == unwinder(d, e[1])))
	}
	f.close()
	removeAll(dir)
}

test "a kept image's symbol table names the units' symbols, local ones too, but marks, over generations" {
	// Unit name, defining defines, a local symbol and a mark, of a call to calls if not "".
	const unit = (name: string, defines: string, calls: string) => {
		const o = text(name)
		o.sections[0].bytes = if (calls != "") "\x00\x00\x00\x94\xc0\x03\x5f\xd6" else zeros(8)
		o.symbols = [new Symbol(`loc_${name}`, Local, 0, 4), new Symbol(defines, Global, 0),
			new Symbol(`~m${defines}`, Weak, 0)]
		if (calls != "") {
			o.symbols.push(new Symbol(calls, Global))
			o.sections[0].fixups.push(new Fixup(0, Call, 3, 0))
		}
		return o
	}
	// The names of the entries of .symtab, sorted, and how many are past its .strtab.
	const names = (d: Bytes) => {
		const header = (i: u64) => d.get(40, 8) + 64 * i
		let symtab: u64 = 1
		while (d.get(header(symtab) + 4, 4) != 2) {
			symtab++
		}
		const [entries, size] = [d.get(header(symtab) + 24, 8), d.get(header(symtab) + 32, 8)]
		const strtab = header(d.get(header(symtab) + 40, 4))
		const [strings, length] = [d.get(strtab + 24, 8), d.get(strtab + 32, 8)]
		const out: string[] = []
		let outside = 0
		for (const e of 0 ... ((size / 24) as i32) - 1) {
			const x = d.get(entries + 24 * (e as u64), 4)
			if (x != 0) {
				outside += if (x >= length) 1 else 0
				let end = strings + x
				while (d.get(end, 1) != 0) {
					end++
				}
				out.push(d.slice(strings + x, end))
			}
		}
		sort(out)
		return `${out.join(" ")} outside ${outside}`
	}
	const l = new Linker(arm64, elf, new Bytes())
	l.add(unit("f@1", "f", ""))
	l.add(unit("h@1", "h", "f"))
	const d1 = file(l)
	const l2 = new Linker(arm64, elf, new Bytes(mapped(d1)))
	l2.remove("f@1")
	l2.add(unit("f@2", "f", ""))
	l2.add(unit("g@1", "g", "h"))
	const d2 = file(l2)
	const l3 = new Linker(arm64, elf, new Bytes(mapped(d2)))
	l3.remove("h@1")
	l3.add(unit("h@2", "h", "g"))
	const d3 = file(l3)
	const [first, second, third] = [names(d1), names(d2), names(d3)]
	assert first == "f h loc_f@1 loc_h@1 outside 0" && second == "f g h loc_f@2 loc_g@1 loc_h@1 outside 0"
		&& third == "f g h loc_f@2 loc_g@1 loc_h@2 outside 0"
}

test "a link that grows a section but starts none elsewhere leaves the entries of the units held as they are" {
	const l = new Linker(arm64, elf, new Bytes())
	l.add(text("f"))
	const d = file(l)
	// f's entry, the first after the null one, said to be of another section, which only a link reading it rights.
	const f = d.get(d.get(40, 8) + 64 * table(d) + 24, 8) + 24
	const shndx = d.get(f + 6, 2)
	d.put(f + 6, shndx + 1, 2)
	const again = new Linker(arm64, elf, new Bytes(mapped(d)))
	again.add(text("g"))
	const e = file(again)
	const [held, added] = [e.get(f + 6, 2), e.get(f + 24 + 6, 2)]
	assert held == shndx + 1 && added == shndx
}

test "a kept image's unwinder's table, continued without the first function, is as it was but its entry" {
	const l = new Linker(arm64, elf, new Bytes())
	for (const i of 0 ... 15) {
		l.add(unwound(`f${i}`, 8))
		l.export(`f${i}`)
	}
	const again = new Linker(arm64, elf, new Bytes(mapped(file(l))))
	again.remove("f0")
	const image = again.link()
	elf.write(image)
	const d = image.bytes
	let ph = d.get(32, 8)
	while (d.get(ph, 4) != 0x6474e550) {
		ph += 56
	}
	// Made anew, it would be of 15 entries and a copy.
	const entries = d.get(d.get(ph + 16, 8) + 8, 4)
	const found = image.exports.every(e => unwinder(d, e[1]) != 0)
	assert entries == 18 && found
}
