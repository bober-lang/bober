//! SHA-256, which a Mach-O dynamic library's code signature hashes its pages with. The linker has its own, as std's is
//! bound to a C library the compiler does not link.

import { be } from "./bytes"

/// The round constants.
const k: u32[] = [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
	0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1,
	0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d,
	0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc,
	0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
	0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3,
	0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb,
	0xbef9a3f7, 0xc67178f2]

/// The digest of s.
export function sha256(s: string): string {
	const n = s.length
	const b = new u8[]((n + 72) / 64 * 64)
	for (const i of 0 ... n - 1) {
		b[i] = s[i]
	}
	b[n] = 0x80
	for (const i of 0 ... 7) {
		b[b.length - 1 - i] = ((n as u64) * 8 >> 8 * i) as u8
	}
	const h: u32[] = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
	const w = new u32[](64)
	for (const at of 0 ... b.length / 64 - 1) {
		for (const i of 0 ... 63) {
			const p = 64 * at + 4 * i
			w[i] = if (i < 16) (b[p] as u32) << 24 | (b[p + 1] as u32) << 16 | (b[p + 2] as u32) << 8 | b[p + 3]
				else w[i - 16] + (ror(w[i - 15], 7) ^ ror(w[i - 15], 18) ^ w[i - 15] >> 3) + w[i - 7] +
				(ror(w[i - 2], 17) ^ ror(w[i - 2], 19) ^ w[i - 2] >> 10)
		}
		const v = h.slice(0, 8)
		for (const i of 0 ... 63) {
			const t = v[7] + (ror(v[4], 6) ^ ror(v[4], 11) ^ ror(v[4], 25)) + (v[4] & v[5] ^ ~v[4] & v[6]) + k[i] + w[i]
			for (const j of 0 ... 6) {
				v[7 - j] = v[6 - j]
			}
			v[4] += t
			v[0] = t + (ror(v[1], 2) ^ ror(v[1], 13) ^ ror(v[1], 22)) + (v[1] & v[2] ^ v[1] & v[3] ^ v[2] & v[3])
		}
		for (const i of 0 ... 7) {
			h[i] += v[i]
		}
	}
	return h.map(x => be(x as u64, 4)).join("")
}

/// x rotated right by n bits.
function ror(x: u32, n: u32): u32 { return x >> n | x << (32 - n) }
