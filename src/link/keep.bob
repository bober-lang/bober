//! What the file of a kept image (link.bob) holds of its linker, for a later link to continue it: the State, its head
//! where the 16 bytes after the format's headers say; the table of units and their entries (Linker.held); and each
//! unit's record in a block of its own (Linker.save).

import { bytes as random } from "../../std/crypto/random"
import { Reader, Writer } from "../../std/encoding/binary"
import { Arch } from "../../std/os"
import { ParseError } from "../../std/string"
import { Bytes, u } from "./bytes"
import { Fixup, Local, Object, Section, Symbol } from "./object"

/// What the head starts with, and the version of the encoding.
const magic = "bober image 17"

/// Where the sections of one of regions, or of a run, are: from start to top, of which holes, in order, are free; cap,
/// which top stays below, where the next region starts.
export class Region {
	start: u64
	top: u64
	cap: u64 = 0xffffffff_ffffffff
	holes: [u64, u64][] = []

	constructor(start: u64) {
		this.start = start
		this.top = start
	}
}

/// What a link continues a kept image from, beside its bytes.
export class State {
	regions: Region[] = []
	/// The table of units (Linker.held) and their entries, and that of names (Linker.slot) and theirs: each where, of
	/// how many slots, and how many it has; and their hashes' seed.
	units: [u64, u64, u64] = [0, 0, 0]
	names: [u64, u64, u64] = [0, 0, 0]
	seed: u64 = 0
	/// The units with a section of a group; and the names of Const sections laid out as Data (Linker.kind).
	grouped: i32[] = []
	pointed: string[] = []
	/// The names of the frozen units' sections. The pointers the loader adds the image's address to that are not of
	/// words, ascending, and sets to an import's, and the descs, as Image has them; and the veneers, by the island and
	/// the address they jump to.
	sections: string[] = []
	rebases: u64[] = []
	binds: [u64, i32, string, bool, i64][] = []
	descs: [u64, u64][] = []
	veneers: [u64, u64, u64][] = []
	inits: [u64, u64] = [0, 0]
	thread: [u64, u64, u64] = [0, 0, 1]
	/// Per bound name, the run of a region its sections are laid out in.
	runs: [string, Region][] = []
	exports: string[] = []
	libraries: string[] = []
}

/// The head of s, of an image of arch, as bytes.
export function write(s: State, arch: Arch): string {
	const w = new Writer()
	const str = (x: string) => {
		w.uleb(x.length as u64)
		w.raw(x)
	}
	const region = (r: Region) => {
		w.uleb(r.start)
		w.uleb(r.top)
		w.uleb(r.cap)
		list(w, r.holes, h => {
			w.uleb(h[0])
			w.uleb(h[1])
		})
	}
	w.raw(magic)
	str(arch)
	list(w, s.regions, region)
	list(w, s.sections, str)
	// The rebases, each as how far it is past the one before.
	let last: u64 = 0
	list(w, s.rebases, at => {
		w.uleb(at - last)
		last = at
	})
	list(w, s.binds, b => {
		w.uleb(b[0])
		w.uleb(b[1] as u64)
		str(b[2])
		w.u8(if (b[3]) 1 else 0)
		w.sleb(b[4])
	})
	list(w, s.descs, d => {
		w.uleb(d[0])
		w.uleb(d[1])
	})
	list(w, s.veneers, v => {
		w.uleb(v[0])
		w.uleb(v[1])
		w.uleb(v[2])
	})
	for (const v of [s.inits[0], s.inits[1], s.thread[0], s.thread[1], s.thread[2], s.units[0], s.units[1], s.units[2],
		s.names[0], s.names[1], s.names[2], s.seed]) {
		w.uleb(v)
	}
	list(w, s.grouped, k => w.uleb(k as u64))
	list(w, s.pointed, str)
	list(w, s.runs, e => {
		str(e[0])
		region(e[1])
	})
	list(w, s.exports, str)
	list(w, s.libraries, str)
	return w.bytes
}

/// The record of o, a unit's object stripped, its sections at at, of the fixups of section i keeps says, and of the
/// indices of its symbols' names: its head, the sections but their fixups, first. Written after what w has, which it
/// shares.
export function record(w: Writer, o: Object, at: u64[], keeps: (i: i32, f: Fixup) => bool, names: i32[]): string {
	const from = w.bytes.length
	const str = (x: string) => {
		w.uleb(x.length as u64)
		w.raw(x)
	}
	str(o.name)
	let i = 0
	list(w, o.sections, sec => {
		str(sec.name)
		w.u8(sec.kind)
		str(sec.order)
		w.uleb(sec.align)
		w.uleb(sec.size)
		str(sec.group)
		w.uleb(at[i])
		i++
	})
	for (const i of 0 ... o.sections.length - 1) {
		list(w, o.sections[i].fixups.filter(f => keeps(i, f)), f => {
			w.uleb(f.at)
			w.u8(f.kind)
			w.uleb(f.symbol as u64)
			w.sleb(f.addend)
		})
	}
	i = 0
	list(w, o.symbols, sym => {
		str(sym.name)
		w.u8(sym.binding)
		w.sleb(sym.section as i64)
		w.uleb(sym.value)
		w.uleb(sym.size)
		w.uleb((names[i] + 1) as u64)
		i++
	})
	return w.bytes.slice(from, w.bytes.length)
}

/// The stamp of the file of a kept image whose format's headers take headers bytes, after where its head is.
export function stamp(file: Bytes, headers: u64): u64 { return file.get(headers + 16, 8) }
/// Gives file a random stamp, as each store of it does.
export function stamped(file: Bytes, headers: u64) throws IoError { file.put(headers + 16, u(random(8), 0, 8), 8) }

/// The state in the file of a kept image of arch, whose format's headers take headers bytes; null if it holds none.
export function read(file: Bytes, headers: u64, arch: Arch): State | null {
	try {
		// The bytes of the block at at of size, which the file must have.
		const block = (at: u64, size: u64) => {
			if (at > file.length || size > file.length - at) {
				throw new ParseError("range", 0)
			}
			return file.slice(at, at + size)
		}
		const r = new Reader(block(file.get(headers, 8), file.get(headers + 8, 8)))
		const str = () => r.raw(r.uleb() as i32)
		if (r.raw(magic.length) != magic || str() != arch) {
			return null
		}
		const region = () => {
			const region = new Region(r.uleb())
			region.top = r.uleb()
			region.cap = r.uleb()
			region.holes = many(r, () => [r.uleb(), r.uleb()])
			return region
		}
		const s = new State()
		s.regions = many(r, region)
		s.sections = many(r, str)
		let last: u64 = 0
		s.rebases = many(r, () => {
			last += r.uleb()
			return last
		})
		s.binds = many(r, () => [r.uleb(), r.uleb() as i32, str(), r.u8() != 0, r.sleb()])
		s.descs = many(r, () => [r.uleb(), r.uleb()])
		s.veneers = many(r, () => [r.uleb(), r.uleb(), r.uleb()])
		s.inits = [r.uleb(), r.uleb()]
		s.thread = [r.uleb(), r.uleb(), r.uleb()]
		s.units = [r.uleb(), r.uleb(), r.uleb()]
		s.names = [r.uleb(), r.uleb(), r.uleb()]
		s.seed = r.uleb()
		s.grouped = many(r, () => r.uleb() as i32)
		s.pointed = many(r, str)
		s.runs = many(r, () => [str(), region()])
		s.exports = many(r, str)
		s.libraries = many(r, str)
		return s
	} catch (e: ParseError) {
		return null
	}
}

/// The object of a unit's record, of arch, but its symbols and fixups, and where its sections are; null if the record
/// is not as written.
export function head(record: string, arch: Arch): [Object, u64[]] | null {
	try {
		return object(new Reader(record), arch)
	} catch (e: ParseError) {
		return null
	}
}

/// The object whose record r reads, of arch, but its symbols and fixups, and where its sections are.
function object(r: Reader, arch: Arch): [Object, u64[]] throws ParseError {
	const str = () => r.raw(r.uleb() as i32)
	const o = new Object(str(), arch)
	const at: u64[] = []
	o.sections = many(r, () => {
		const sec = new Section(str(), r.u8())
		sec.order = str()
		sec.align = r.uleb()
		sec.size = r.uleb()
		sec.group = str()
		at.push(r.uleb())
		return sec
	})
	return [o, at]
}

/// Reads o's symbols and fixups from its record, of which read read the head, if named but the local symbols after
/// the others; the indices of its symbols' names, of a table of count, null if the record is not as written.
export function rest(o: Object, record: string, count: i32, named = false): i32[] | null {
	const r = new Reader(record)
	const str = () => r.raw(r.uleb() as i32)
	try {
		object(r, o.arch)
		for (const sec of o.sections) {
			sec.fixups = many(r, () => new Fixup(r.uleb(), r.u8(), r.uleb() as i32, r.sleb()))
		}
		o.symbols = []
		const names: i32[] = []
		for (const _ of 1 ... (r.uleb() as i32)) {
			const s = new Symbol(str(), r.u8(), r.sleb() as i32, r.uleb(), r.uleb())
			if (named && s.binding == Local) {
				break
			}
			const g = (r.uleb() as i32) - 1
			if (g < -1 || g >= count) {
				return null
			}
			o.symbols.push(s)
			names.push(g)
		}
		return names
	} catch (e: ParseError) {
		return null
	}
}

/// Writes how many xs there are, then each by f.
function list[T](w: Writer, xs: T[], f: (x: T) => void) {
	w.uleb(xs.length as u64)
	for (const x of xs) {
		f(x)
	}
}

/// What list wrote, each read by f.
function many[T](r: Reader, f: () => T throws ParseError): T[] throws ParseError {
	const xs: T[] = []
	for (const _ of 1 ... (r.uleb() as i32)) {
		xs.push(f())
	}
	return xs
}
