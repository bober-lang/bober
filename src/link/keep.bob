//! What the file of a kept image (link.bob) holds of its linker, for a later link to continue it: the State, its head
//! where the 16 bytes after the format's headers say, and each unit's record in a block of its own (Linker.save).

import { bytes as random } from "../../std/crypto/random"
import { Reader, Writer } from "../../std/encoding/binary"
import { Arch } from "../../std/os"
import { ParseError } from "../../std/string"
import { Bytes, u } from "./bytes"
import { Fixup, Object, Section, Symbol } from "./object"

/// What the head starts with, and the version of the encoding.
const magic = "bober image 8"

/// Where the sections of one of regions are: from start to top, of which holes, in order, are free; cap, which top
/// stays below, where the next region starts.
export class Region {
	start: u64
	top: u64
	cap: u64 = 0xffffffff_ffffffff
	holes: [u64, u64][] = []

	constructor(start: u64) {
		this.start = start
		this.top = start
	}
}

/// What a link continues a kept image from, beside its bytes.
export class State {
	regions: Region[] = []
	/// The objects of the frozen unit, then those given, stripped; where their sections are; the bytes an object was
	/// read from, its record, so that it must be as read: "" if it is not; the blocks of the file it has, from and
	/// to where: its record's, then its symbols' entries in the symbol table and their names, if the format has one;
	/// and per symbol, the index of its name in the table of names, -1 if it is local.
	units: [Object, u64[], string, [u64, u64][], i32[]][] = []
	/// The table of names (Linker.slot): where, of how many slots, and how many names it has; and its hashes' seed.
	names: [u64, u64, u64] = [0, 0, 0]
	seed: u64 = 0
	/// Per name with a slot, its index in the table of names, its address and that of its stub, 0 if none.
	slots: [u64, u64, u64][] = []
	/// Of the frozen units: per name and kind, from and to where their sections are; the pointers the loader adds the
	/// image's address to, ascending, and the descs, as Image has them.
	sections: [string, u8, u64, u64][] = []
	rebases: u64[] = []
	descs: [u64, u64][] = []
	inits: [u64, u64] = [0, 0]
	thread: [u64, u64, u64] = [0, 0, 1]
	/// The bound names whose sections are laid out for good, as a frozen unit has some, and those whose sections are
	/// laid out anew each link.
	pinned: string[] = []
	floating: string[] = []
	exports: string[] = []
}

/// The head of s, of an image of arch, as bytes.
export function write(s: State, arch: Arch): string {
	const w = new Writer()
	const str = (x: string) => {
		w.uleb(x.length as u64)
		w.raw(x)
	}
	w.raw(magic)
	str(arch)
	list(w, s.regions, r => {
		w.uleb(r.start)
		w.uleb(r.top)
		w.uleb(r.cap)
		list(w, r.holes, h => {
			w.uleb(h[0])
			w.uleb(h[1])
		})
	})
	list(w, s.units, u => {
		list(w, u[1], at => w.uleb(at))
		list(w, u[3], b => {
			w.uleb(b[0])
			w.uleb(b[1])
		})
	})
	list(w, s.slots, e => {
		w.uleb(e[0])
		w.uleb(e[1])
		w.uleb(e[2])
	})
	list(w, s.sections, e => {
		str(e[0])
		w.u8(e[1])
		w.uleb(e[2])
		w.uleb(e[3])
	})
	// The rebases, each as how far it is past the one before.
	let last: u64 = 0
	list(w, s.rebases, at => {
		w.uleb(at - last)
		last = at
	})
	list(w, s.descs, d => {
		w.uleb(d[0])
		w.uleb(d[1])
	})
	for (const v of [s.inits[0], s.inits[1], s.thread[0], s.thread[1], s.thread[2],
		s.names[0], s.names[1], s.names[2], s.seed]) {
		w.uleb(v)
	}
	for (const names of [s.pinned, s.floating, s.exports]) {
		list(w, names, str)
	}
	return w.bytes
}

/// The record of o, a unit's object as State has it, and of the indices of its symbols' names.
export function record(o: Object, names: i32[]): string {
	const w = new Writer()
	const str = (x: string) => {
		w.uleb(x.length as u64)
		w.raw(x)
	}
	str(o.name)
	list(w, o.sections, sec => {
		str(sec.name)
		w.u8(sec.kind)
		str(sec.order)
		w.uleb(sec.align)
		w.uleb(sec.size)
		str(sec.group)
		list(w, sec.fixups, f => {
			w.uleb(f.at)
			w.u8(f.kind)
			w.uleb(f.symbol as u64)
			w.sleb(f.addend)
		})
	})
	list(w, o.symbols, sym => {
		str(sym.name)
		w.u8(sym.binding)
		w.sleb(sym.section as i64)
		w.uleb(sym.value)
		w.uleb(sym.size)
	})
	list(w, names, g => w.uleb((g + 1) as u64))
	return w.bytes
}

/// The stamp of the file of a kept image whose format's headers take headers bytes, after where its head is.
export function stamp(file: Bytes, headers: u64): u64 { return file.get(headers + 16, 8) }

/// Gives file a random stamp, as each store of it does.
export function stamped(file: Bytes, headers: u64) throws IoError { file.put(headers + 16, u(random(8), 0, 8), 8) }

/// The state in the file of a kept image of arch, whose format's headers take headers bytes; null if it holds none.
export function read(file: Bytes, headers: u64, arch: Arch): State | null {
	try {
		// The bytes of the block at at of size, which the file must have.
		const block = (at: u64, size: u64) => {
			if (at > file.length || size > file.length - at) {
				throw new ParseError("range", 0)
			}
			return file.slice(at, at + size)
		}
		const r = new Reader(block(file.get(headers, 8), file.get(headers + 8, 8)))
		const str = () => r.raw(r.uleb() as i32)
		if (r.raw(magic.length) != magic || str() != arch) {
			return null
		}
		const s = new State()
		s.regions = many(r, () => {
			const region = new Region(r.uleb())
			region.top = r.uleb()
			region.cap = r.uleb()
			region.holes = many(r, () => [r.uleb(), r.uleb()])
			return region
		})
		s.units = many(r, () => {
			const at = many(r, () => r.uleb())
			const blocks: [u64, u64][] = many(r, () => [r.uleb(), r.uleb()])
			const kept = block(blocks[0][0], blocks[0][1])
			const o = new Reader(kept)
			return [object(o, arch), at, kept, blocks, many(o, () => (o.uleb() as i32) - 1)]
		})
		s.slots = many(r, () => [r.uleb(), r.uleb(), r.uleb()])
		s.sections = many(r, () => [str(), r.u8(), r.uleb(), r.uleb()])
		let last: u64 = 0
		s.rebases = many(r, () => {
			last += r.uleb()
			return last
		})
		s.descs = many(r, () => [r.uleb(), r.uleb()])
		s.inits = [r.uleb(), r.uleb()]
		s.thread = [r.uleb(), r.uleb(), r.uleb()]
		s.names = [r.uleb(), r.uleb(), r.uleb()]
		s.seed = r.uleb()
		s.pinned = many(r, str)
		s.floating = many(r, str)
		s.exports = many(r, str)
		return s
	} catch (e: ParseError) {
		return null
	}
}

/// The object whose record r reads, of arch.
function object(r: Reader, arch: Arch): Object throws ParseError {
	const str = () => r.raw(r.uleb() as i32)
	const o = new Object(str(), arch)
	o.sections = many(r, () => {
		const sec = new Section(str(), r.u8())
		sec.order = str()
		sec.align = r.uleb()
		sec.size = r.uleb()
		sec.group = str()
		sec.fixups = many(r, () => new Fixup(r.uleb(), r.u8(), r.uleb() as i32, r.sleb()))
		return sec
	})
	o.symbols = many(r, () => new Symbol(str(), r.u8(), r.sleb() as i32, r.uleb(), r.uleb()))
	return o
}

/// Writes how many xs there are, then each by f.
function list[T](w: Writer, xs: T[], f: (x: T) => void) {
	w.uleb(xs.length as u64)
	for (const x of xs) {
		f(x)
	}
}

/// What list wrote, each read by f.
function many[T](r: Reader, f: () => T throws ParseError): T[] throws ParseError {
	const xs: T[] = []
	for (const _ of 1 ... (r.uleb() as i32)) {
		xs.push(f())
	}
	return xs
}
