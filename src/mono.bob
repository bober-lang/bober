//! Monomorphization (§8.3): a release build's whole Program in, the same Program out with no generics, interfaces,
//! object types held as unions or Type values left in what its modules list. It runs in three steps. Instantiation
//! (src/resolve.bob) makes each decl reached from the roots an instance per env and copies its code. Then the types
//! converted into each interface and object type are collected program-wide, making it the union of them (§4.7). Last,
//! each instance's types and code are lowered onto those unions, member access on them becoming calls of dispatch
//! functions that switch on the tag, and each module lists its instances; the program whole, its unions' members are
//! numbered for their tags.
//!
//! For a module's unit of its own (src/bober.bob's image), the same in each program that has the module, the Program
//! being of all its package's files, which fixes what each union holds, a module lists only what is its own, and as
//! its copies what else its code reaches, as C++ does templates: the instances, dispatch functions and classes mono
//! makes, each defined in every module that lists it.
//!
//! A dispatch function is a decl of the module using it named `.f[T]` for reading field f of T, `.f=[T]` for writing
//! it and `.f()[T]` for calling method f. An intrinsic, a function of builtin/ without a body, is called as itself with
//! its type args, for emit.

import { stableSort } from "../std/algo"
import { HashMap } from "../std/collections/hashmap"
import { min } from "../std/math"
import * as decl from "./bc/decl"
import * as kind from "./bc/kind"
import * as op from "./bc/op"
import { Imm } from "./bc/op"
import { Code, Module, Program, pair } from "./bc/program"
import { qualified, showType } from "./bc/show"
import { CompileError } from "./error"
import { Instances, bases, embedded, fieldOf, runtime, takesType } from "./resolve"
import { builtin, builtinPath } from "./root"

/// Monomorphizes p, whose module main holds the main function and tests: those, or if units every module's but
/// builtin/type.bob's tests, and functions, classes and their methods that are neither generic nor take a Type, every
/// module's typed vars and builtin/'s plain exported functions are the roots, and only decls they reach are kept.
/// Each module's decls and inits become their instances, its dispatch functions after its decls, and each instance's
/// members those of its members' instances it owns, those of one decl in the order of their hashes, the same however p
/// is read; its ABI hash, which mono changes, forgotten. If units, a module's decls are its roots and vars, and the
/// statics of instances of its classes, which are one per program, its copies the others its code reaches, and its
/// uses the modules of what else it names.
export function mono(p: Program, main: i32, units = false) throws CompileError { new Mono(p, units).run(main) }

class Mono {
	p: Program
	ins: Instances
	/// The interfaces and object types something is converted into, and per one, what: itself for a literal of it, and
	/// of an interface or object type what that holds having its members.
	private abstracts: i32[] = []
	private sources = new HashMap[i32, i32[]]()
	/// The pairs of types convert has seen.
	private converted = new HashMap[i64, bool]()
	/// Per type, as it is at run time.
	private lows = new HashMap[i32, i32]()
	/// Per object type, as conc holds it; 0 while its fields are lowered.
	private structs = new HashMap[i32, i32]()
	private main = 0
	private units: bool
	/// The instances kept, and the dispatch functions and classes made; the decls listed as their module's own, if units.
	private keep = new HashMap[i32, bool]()
	private own = new HashMap[i32, bool]()
	/// Per module, type, member and access, the dispatch function made there.
	private made = new HashMap[[i32, i32, i32, string], i32]()
	/// The dispatch functions and classes made.
	private dispatches: i32[] = []
	/// The types thrown and caught, and the types and names of the members accessed through a union, as collected.
	private thrown: i32[] = []
	private caught: i32[] = []
	private reached = new HashMap[i64, [i32, i32]]()
	/// The values each object spreads and its type, and the methods of classes those bind, which a class holds.
	private binds: [i32, i32][] = []
	private bound = new HashMap[i32, bool]()

	constructor(p: Program, units: bool) {
		this.p = p
		this.ins = new Instances(p)
		this.units = units
	}

	run(main: i32) throws CompileError {
		const p = this.p
		this.main = main
		for (const m of 0 ... p.modules.length - 1) {
			for (const d of p.modules[m].inits) {
				if (!kind.untyped(p.decls[d].type) && p.identity(d).length == 0) {
					this.own.set(this.ins.instance(d, 0), true)
				}
			}
			for (const d of p.modules[m].decls.filter(d => this.root(m, d))) {
				this.own.set(this.ins.instance(d, 0), true)
				// If units, the plain methods of a class of builtin/ too, instanced else only where named.
				for (const k of p.decls[d].members.filter(k => this.units && p.decls[k].kind == decl.Function
					&& this.plain(k))) {
					this.ins.instance(k, 0)
				}
			}
		}
		// Until no instance is made: copying, collecting, and instancing the members dispatch functions reach.
		let from = 0
		while (from < this.ins.order.length) {
			this.ins.copy()
			from = this.collect(from)
		}
		this.write()
		for (const m of p.modules) {
			m.abi = 0
		}
		if (!this.units) {
			this.number()
		}
	}

	/// Numbers the members of the unions values have at run time for their tags, those of the largest first, so that
	/// its are consecutive.
	private number() {
		const p = this.p
		const tags = new HashMap[i32, i32]()
		const us = this.lows.values().filter(t => p.kind(t) == kind.Union)
		stableSort(us, (a, b) => p.members(a).length > p.members(b).length)
		for (const u of us) {
			for (const m of p.members(u).filter(m => !tags.has(m))) {
				tags.set(m, tags.size)
			}
		}
		p.tags = tags
	}

	/// Whether decl d of module m is a root.
	private root(m: i32, d: i32): bool {
		const p = this.p
		const x = p.decls[d]
		const path = p.modules[m].path
		if (m == this.main && (x.kind == decl.Test || x.kind == decl.Function && p.strings[x.name] == "main")) {
			return true
		} else if (builtin(path)) {
			// Emit calls builtin/'s plain exports itself, but type.bob's, of Types as lowered.
			return path != builtinPath("type")
				&& (this.units && this.plain(d)
				|| x.kind == decl.Function && (x.mods & decl.Export) != 0 && x.params.length == 0)
		}
		return this.units && (x.kind == decl.Test || this.plain(d))
	}

	/// Whether decl d is a class or function neither generic nor taking a Type.
	private plain(d: i32): bool {
		const x = this.p.decls[d]
		return x.params.length == 0 && (x.kind == decl.Class || x.kind == decl.Function && !takesType(this.p, d))
	}

	// Interfaces and object types.
	/// Collects what is converted into each interface and object type, or tested against one, a thrown value into each
	/// type caught, from the instances from on, and makes the members dispatch functions reach; returns where the
	/// instances it saw end.
	private collect(from: i32): i32 throws CompileError {
		const p = this.p
		const thrown = this.thrown
		const caught = this.caught
		const end = this.ins.order.length
		for (const k of this.ins.order.slice(from, end)) {
			const i = this.ins.insts.get(k)!
			const c = i.code
			for (const j of 0 ... (if (c == null) 0 else c.ops.length) - 1) {
				const o = c!.ops[j]
				if ((o == op.CallMethod || o == op.Field || o == op.SetField) && i.info[j] >= 0
					&& !this.reached.has(pair(i.info[j], c!.a(j)))) {
					this.reached.set(pair(i.info[j], c!.a(j)), [i.info[j], c!.a(j)])
				}
				if (o == op.Cast || o == op.Is) {
					this.convert(i.info[j], c!.a(j))
				} else if (o == op.Array && i.info[j] >= 0 && p.kind(c!.a(j)) == kind.Array) {
					this.convert(i.info[j], p.a(c!.a(j)))
				} else if (o == op.Object || o == op.New && p.kind(c!.a(j)) == kind.Object) {
					this.source(c!.a(j), c!.a(j))
					if (o == op.Object && i.info[j] >= 0 && p.kind(c!.a(j)) == kind.Object) {
						this.binds.push([i.info[j], c!.a(j)])
					}
				} else if (o == op.Throw && !thrown.includes(i.info[j])) {
					thrown.push(i.info[j])
				} else if (o == op.Catch && c!.a(j) != kind.None && !caught.includes(c!.a(j))) {
					caught.push(c!.a(j))
				}
			}
		}
		for (const t of caught) {
			for (const s of thrown) {
				this.convert(s, t)
			}
		}
		let changed = true
		while (changed) {
			changed = false
			for (const [t, name] of this.reached.values()) {
				this.dispatched(t, name)
			}
			for (const x of this.abstracts) {
				const having = (s: i32) => p.union(this.ins.flat(s).filter(c => fits(p, c, x)))
				const ss = this.sources.get(x)!.map(s => if (s != x && this.ins.abstract(s)) having(s) else s)
				const u = p.union(ss)
				if (u != (this.ins.held.get(x) ?? p.union([]))) {
					this.ins.held.set(x, u)
					changed = true
				}
			}
		}
		for (const [t, name] of this.reached.values()) {
			for (const m of this.ins.flat(t)) {
				this.ins.memberOf(this.ins.owner(m, name), name)
				this.shows(m, name)
			}
		}
		for (const [s, t] of this.binds) {
			for (const m of this.ins.flat(s)) {
				for (const k of 0 ... p.items(t).length - 1) {
					const name = p.names[p.b(t)][2 * k]
					const o = this.ins.owner(m, name)
					const d = this.ins.member(o, name)
					if (d >= 0 && p.decls[d].kind == decl.Function) {
						this.bound.set(this.ins.memberOf(o, name), true)
					}
				}
			}
		}
		return end
	}

	/// Notes what a dispatch function of member name of t converts, of each type a value of t is: the result of the
	/// method it calls or the field it reads into t's, and the args or the field it writes from t's.
	private dispatched(t: i32, name: i32) throws CompileError {
		const p = this.p
		const ins = this.ins
		const f = ins.methodType(t, name)
		for (const m of ins.flat(t)) {
			const g = if (f >= 0) ins.methodType(m, name) else -1
			if (g >= 0) {
				this.convert(p.b(g), p.b(f))
				for (const i of 0 ... min(p.items(f).length, p.items(g).length) - 1) {
					this.convert(p.items(f)[i], p.items(g)[i])
				}
			} else if (f < 0) {
				this.convert(ins.fieldType(m, name), ins.fieldType(t, name))
				this.convert(ins.fieldType(t, name), ins.fieldType(m, name))
			}
		}
	}

	/// Notes the members of src that a Cast into to puts into one of its interfaces or object types: each class having
	/// each of its members, and each interface or object type, unless to holds it as itself; once per src and to.
	private convert(src: i32, to: i32) {
		const p = this.p
		const ins = this.ins
		if (this.converted.has(pair(src, to))) {
			return
		}
		this.converted.set(pair(src, to), true)
		const targets = p.members(to)
		for (const x of targets.filter(x => ins.abstract(x))) {
			for (const s of p.members(src)) {
				if ((ins.abstract(s) || ins.nominal(s) == decl.Class && fits(p, s, x)) && !targets.includes(s)) {
					this.source(x, s)
				}
			}
		}
	}

	private source(x: i32, s: i32) {
		const ss = this.sources.get(x)
		if (ss == null) {
			this.abstracts.push(x)
			this.sources.set(x, [s])
		} else if (!ss.includes(s)) {
			ss.push(s)
		}
	}

	// Writing out.
	/// Lowers each instance kept, a class's to its members and each other's to its type and code, and lists them.
	private write() throws CompileError {
		const p = this.p
		const ins = this.ins
		// Per source decl, its instances kept: not of interfaces, their members, or untyped vars, which are folded.
		const of = new HashMap[i32, i32[]]()
		const kept: i32[] = []
		for (const k of ins.order) {
			const x = p.decls[k]
			const iface = (d: i32) => d >= 0 && p.decls[d].kind == decl.Interface
			if (iface(k) || iface(x.owner) || x.kind == decl.Var && kind.untyped(x.type)) {
				continue
			}
			add(of, if (x.generic < 0) k else x.generic, k)
			kept.push(k)
		}
		// The statics of class instances, one per program.
		const statics = kept.filter(k => p.decls[k].kind == decl.Var && !this.held(k))
		for (const k of statics) {
			this.own.set(k, true)
		}
		// Per instance kept, its members kept, in source order, the generic methods instanced for it included.
		const owned = new HashMap[i32, i32[]]()
		for (const k of kept.filter(k => p.decls[k].owner >= 0 && this.held(k))) {
			add(owned, p.decls[k].owner, k)
		}
		const source = (d: i32) => if (p.decls[d].generic < 0) d else p.decls[d].generic
		const hash = (d: i32) => p.decls[d].hash
		const byHash = (ds: i32[]) => {
			stableSort(ds, (a, b) => hash(a) < hash(b))
			return ds
		}
		for (const k of kept) {
			const i = ins.insts.get(k)!
			const x = p.decls[k]
			ins.where = qualified(p, k)
			x.supers = 0
			x.members = owned.get(k) ?? []
			stableSort(x.members, (a, b) => source(a) < source(b) || source(a) == source(b) && hash(a) < hash(b))
			if (x.kind != decl.Class) {
				x.type = this.low(if (x.kind == decl.Function) runtime(p, x.type) else x.type)
				x.code = if (i.code == null) null else this.lower(x.module, i.code!, i.info)
			}
		}
		const instances = (ds: i32[]) => {
			const out: i32[] = []
			for (const d of ds) {
				out.append(byHash(of.get(d) ?? []))
			}
			return out
		}
		for (const k of [...kept, ...this.dispatches]) {
			this.keep.set(k, true)
		}
		for (const mi of 0 ... p.modules.length - 1) {
			const m = p.modules[mi]
			if (this.units) {
				m.decls = [...m.decls.filter(d => this.own.has(d)),
					...byHash(statics.filter(k => p.decls[k].module == mi))]
				m.copies = this.copies(m)
			} else {
				m.decls = [...instances(m.decls), ...byHash(this.dispatches.filter(d => p.decls[d].module == mi))]
			}
			m.inits = instances(m.inits)
		}
	}

	/// Whether the members of the owner of instance k hold it: if units, of a class, not an instance but a field, or a
	/// method a spread binds by name.
	private held(k: i32): bool {
		const x = this.p.decls[k]
		return !this.units || this.p.classOf(k) < 0 || x.kind == decl.Var && (x.mods & decl.Static) == 0
			|| x.generic < 0 || this.bound.has(k)
	}

	/// The decl that k is listed with: itself, or what holds it.
	private top(k: i32): i32 {
		const o = this.p.decls[k].owner
		return if (o < 0 || !this.held(k)) k else this.top(o)
	}

	/// The decls kept that the code of m's decls, and of what they hold, names, but those modules list as their own,
	/// each in the order reached, with what it holds: a module's copies; the modules of those, m's uses. Of a class,
	/// also its constructor, which emit finds by name.
	private copies(m: Module): i32[] {
		const p = this.p
		const out: i32[] = []
		const todo = m.decls.slice(0, m.decls.length)
		const seen = new HashMap[i32, bool]()
		const types = new HashMap[i32, bool]()
		const reach = (d: i32) => {
			const t = this.top(d)
			if (this.own.has(t) && !m.uses.includes(p.decls[t].module)) {
				m.uses.push(p.decls[t].module)
			} else if (this.keep.has(t) && !this.own.has(t) && !seen.has(t)) {
				seen.set(t, true)
				out.push(t)
				todo.push(t)
			}
		}
		let i = 0
		while (i < todo.length) {
			const x = p.decls[todo[i]]
			const ctor = if (x.kind == decl.Class) p.member(todo[i], p.intern("constructor")) else -1
			if (ctor >= 0) {
				reach(ctor)
			}
			i++
			todo.append(x.members)
			const c = x.code ?? new Code()
			for (const t of [x.type, ...p.lists[x.tags], ...c.locals.map(l => l.type)]) {
				this.named(t, types, reach)
			}
			for (const j of 0 ... c.ops.length - 1) {
				const s = op.shape[c.ops[j]]
				for (const k of 0 ... s.length - 1) {
					const v = c.imm(j, k)
					if (s[k] == op.DeclId) {
						reach(v)
					} else if (s[k] == op.TypeId || s[k] == op.TypeList) {
						for (const t of if (s[k] == op.TypeId) [v] else p.lists[v]) {
							this.named(t, types, reach)
						}
					}
				}
			}
		}
		return out
	}

	/// Calls reach of each decl that type t and its parts name, once per type, as seen says.
	private named(t: i32, seen: HashMap[i32, bool], reach: (d: i32) => void) {
		if (seen.has(t)) {
			return
		}
		seen.set(t, true)
		if (this.p.kind(t) == kind.Named) {
			reach(this.p.a(t))
		}
		for (const x of this.p.parts(t)) {
			this.named(x, seen, reach)
		}
	}

	/// Type t as it is at run time: an interface or object type as the union it holds, a class by its instance.
	private low(t: i32): i32 throws CompileError {
		const p = this.p
		const found = this.lows.get(t)
		if (found != null) {
			return found
		}
		const k = p.kind(t)
		let r = 0
		if (t == kind.Type || k == kind.Param || k == kind.Of || k == kind.Member) {
			throw new CompileError(`${showType(p, t)} at run time (${this.ins.where})`)
		} else if (this.ins.nominal(t) == decl.Class) {
			r = p.type(kind.Named, this.ins.instance(p.a(t), p.b(t)), 0)
		} else if (k == kind.Union || k == kind.Literal || this.ins.abstract(t)) {
			r = p.union(this.ins.flat(t).map(m => this.conc(m)))
		} else if (k == kind.Func && runtime(p, t) != t) {
			r = this.low(runtime(p, t))
		} else {
			r = p.map(t, x => this.low(x))
		}
		this.lows.set(t, r)
		return r
	}

	/// A type a value is held as at run time: an object type as the struct its literals make, but one its fields hold
	/// again as a class of them, made in builtin/type.bob, the same in every program, as a structural type cannot be
	/// cyclic in the type table.
	private conc(t: i32): i32 throws CompileError {
		const p = this.p
		if (p.kind(t) != kind.Object) {
			return this.low(t)
		}
		const found = this.structs.get(t)
		if (found == 0) {
			// a field holds it again: a class, its fields' types set once they are lowered
			const m = p.module(builtinPath("type"))
			const c = p.decl(m, -1, showType(p, t), decl.Class)
			const names = p.names[p.b(t)]
			for (const i of 0 ... p.items(t).length - 1) {
				p.decls[p.decl(m, c, p.strings[names[2 * i]], decl.Var)].mods = names[2 * i + 1]
			}
			this.dispatches.push(c)
			this.structs.set(t, p.type(kind.Named, c, 0))
		}
		if (found != null) {
			return this.structs.get(t)!
		}
		this.structs.set(t, 0)
		const r = p.map(t, x => this.low(x))
		const c = this.structs.get(t)!
		if (c == 0) {
			this.structs.set(t, r)
			return r
		}
		const fs = p.decls[p.a(c)].members
		for (const i of 0 ... fs.length - 1) {
			p.decls[fs[i]].type = p.items(r)[i]
		}
		return c
	}

	/// Code c of module m lowered, info per op as src/resolve.bob's Inst has it.
	private lower(m: i32, c: Code, info: i32[]): Code throws CompileError {
		const p = this.p
		const to = new Code()
		for (const l of c.locals) {
			to.local(l.name, this.low(l.type), l.mods)
		}
		to.captures = c.captures
		for (const j of 0 ... c.ops.length - 1) {
			const o = c.ops[j]
			const r = info[j]
			to.at = c.pos[j]
			if (o == op.CallMethod && r >= 0) {
				to.add(op.Call, this.dispatch(m, r, c.a(j), "()"))
			} else if ((o == op.Field || o == op.SetField) && r >= 0
				&& (p.kind(this.low(r)) == kind.Union || o == op.Field && this.ins.methodType(r, c.a(j)) >= 0)) {
				// A method read too where one class is held, as the dispatch binds it by its decl, which copies reaches.
				to.add(op.Call, this.dispatch(m, r, c.a(j), if (o == op.Field) "" else "="))
			} else {
				const s = op.shape[o]
				const imm = [c.a(j), c.b(j), c.c(j)]
				for (const i of 0 ... s.length - 1) {
					imm[i] = this.imm(s[i], imm[i], c, to)
				}
				const made = o == op.Object || o == op.New && p.kind(c.a(j)) == kind.Object
				if (made || o == op.Init) {
					imm[0] = this.conc(c.a(j))
				}
				to.add(o, imm[0], imm[1], imm[2])
				if (made && imm[0] != this.low(c.a(j))) {
					to.add(op.Cast, this.low(c.a(j)))
				}
			}
		}
		return to
	}

	/// Immediate x of kind k of an op of code c lowered into code to.
	private imm(k: Imm, x: i32, c: Code, to: Code): i32 throws CompileError {
		return switch (k) {
			case op.TypeId: this.low(x)
			case op.TypeList: this.p.list(this.p.lists[x].map(t => this.low(t)))
			case op.LocalList, op.NumList: to.list(c.items(x))
			default: x
		}
	}

	/// The instance of builtin/'s show that a dispatch of toString calls for m, which lacks one (§6.9), else -1.
	private shows(m: i32, name: i32): i32 throws CompileError {
		const p = this.p
		if (p.strings[name] != "toString" || this.ins.methodType(m, name) >= 0) {
			return -1
		}
		return this.ins.instance(p.lang("show"), p.list([m]))
	}

	/// The function of module m that reads (how ""), writes ("=") or calls ("()") member name, a Str, of a value of t by
	/// a switch on its tag; it takes the value, then the value written or the args.
	private dispatch(m: i32, t: i32, name: i32, how: string): i32 throws CompileError {
		const p = this.p
		const ins = this.ins
		const found = this.made.get([m, t, name, how])
		if (found != null) {
			return found
		}
		const tf = if (how == "()") ins.methodType(t, name) else ins.fieldType(t, name)
		const [ps, result] = shape(p, how, tf)
		const c = new Code()
		const types = [this.low(t), ...ps.map(x => this.low(x))]
		for (const i of 0 ... types.length - 1) {
			c.local(if (i == 0) p.intern("this") else 0, types[i])
		}
		const cast = (from: i32, to: i32) => {
			if (this.low(from) != to) {
				c.add(op.Cast, to)
			}
		}
		const ms = ins.flat(t)
		if (ms.length > 1) {
			c.add(op.Local, 0)
			c.add(op.Match, p.list(ms.map(mt => this.conc(mt))))
		}
		for (const mt of ms) {
			const ct = this.conc(mt)
			if (mt != ms[0]) {
				c.add(op.Else)
			}
			// Of the class it is promoted from, which emit reaches in mt's place.
			const o = ins.owner(mt, name)
			const d = ins.memberOf(o, name)
			const method = how == "()" && d >= 0 && p.decls[d].kind == decl.Function
			const shows = if (how == "()") this.shows(mt, name) else -1
			const ft = if (shows >= 0) tf else if (method) p.decls[d].type else ins.fieldType(o, name)
			const [takes, gives] = shape(p, how, ft)
			const recv = () => {
				c.add(op.Local, 0)
				cast(t, ct)
			}
			// The member's params past t's, defaulted, left out as Missing.
			const pass = () => {
				for (const i of 0 ... takes.length - 1) {
					if (i < ps.length) {
						c.add(op.Local, i + 1)
						cast(ps[i], this.low(takes[i]))
					} else {
						c.add(op.Missing, this.low(takes[i]))
					}
				}
			}
			if (shows >= 0) {
				c.add(op.Local, 0)
				cast(t, this.low(mt))
				c.add(op.Call, shows)
			} else if (method) {
				recv()
				pass()
				c.add(op.Call, d)
			} else if (how == "()") {
				recv()
				c.add(op.Field, name)
				pass()
				c.add(op.CallRef, takes.length)
			} else if (how == "" && d >= 0 && p.decls[d].kind == decl.Function) {
				recv()
				c.add(op.Member, d)
			} else {
				recv()
				pass()
				c.add(if (how == "=") op.SetField else op.Field, name)
			}
			if (result != kind.None) {
				cast(gives, this.low(result))
			}
			c.add(op.Return)
		}
		if (ms.length > 1) {
			c.add(op.End)
		}
		if (ms.length != 1) {
			c.add(op.Unreachable)
		}
		c.add(op.End)
		const k = p.decl(m, -1, `.${p.strings[name]}${how}[${showType(p, t)}]`, decl.Function)
		p.decls[k].type = p.type(kind.Func, p.list(types), this.low(result))
		p.decls[k].code = c
		this.made.set([m, t, name, how], k)
		this.dispatches.push(k)
		return k
	}
}

/// Adds v to the list of k in m.
function add(m: HashMap[i32, i32[]], k: i32, v: i32) {
	const vs = m.get(k)
	if (vs == null) {
		m.set(k, [v])
	} else {
		vs.push(v)
	}
}

/// Whether s fits t, as src/type.bob's fit does: a class, interface or object type fits an interface or object type by
/// having each of its members, its bases' counted as its own, of a type that fits; a literal type also by its base, as
/// an object's fields are typed without; a pair in seen, being worked out, is assumed to fit (§4.7). src/type.c's fits
/// is the same at run time.
export function fits(p: Program, s: i32, t: i32, seen: i64[] = []): bool {
	const [k, j] = [p.kind(s), p.kind(t)]
	if (s == t || j == kind.Literal && s == p.a(t) || seen.includes(pair(s, t))) {
		return true
	} else if (k == kind.Union) {
		return p.items(s).every(m => fits(p, m, t, seen))
	} else if (j == kind.Union && p.items(t).some(m => fits(p, s, m, seen))) {
		return true
	} else if (k == kind.Literal) {
		return fits(p, p.a(s), t, seen)
	} else if (j == kind.Optional) {
		return fits(p, if (k == j) p.a(s) else s, p.a(t), seen)
	} else if (k == kind.Func && j == kind.Func) {
		// Its params take t's args, its others are optional.
		const [ss, ts] = [p.items(s), p.items(t)]
		if (ss.length < ts.length || !fits(p, p.b(s), p.b(t), seen)) {
			return false
		}
		for (const i of 0 ... ss.length - 1) {
			if (if (i < ts.length) !fits(p, ts[i], ss[i], seen) else p.kind(ss[i]) != kind.Optional) {
				return false
			}
		}
		return true
	} else if (j != kind.Object && !(j == kind.Named && p.decls[p.a(t)].kind == decl.Interface)
		|| k != kind.Object && k != kind.Named) {
		return kind.widens(s, t)
	}
	const up = [...seen, pair(s, t)]
	const has = (name: i32, x: i32) => fits(p, fieldOf(p, s, name), x, up) // None, a member s lacks, fits nothing
	if (j == kind.Object) {
		for (const i of 0 ... p.items(t).length - 1) {
			if (!has(p.names[p.b(t)][2 * i], p.items(t)[i])) {
				return false
			}
		}
		return true
	}
	return p.decls[p.a(t)].members.every(m => embedded(p, m) || has(p.decls[m].name, p.subst(p.decls[m].type, p.b(t))))
		&& bases(p, p.a(t)).every(b => fits(p, s, p.subst(b, p.b(t)), up))
}

/// What a dispatch function's access how of a member of type ft takes after the receiver, and gives: nothing and the
/// field's value, the value written and nothing, or the args and the result of the method or function field.
function shape(p: Program, how: string, ft: i32): [i32[], i32] {
	return if (how == "") [[], ft] else if (how == "=") [[ft], kind.None] else [p.items(ft), p.b(ft)]
}
