import { markdown, sections } from "./doc"

const src = `//! The module.
//!
//! # Two
//! Of the module.

/// Adds.
///
/// ## Ten
/// Of f.
///
/// #define is no heading
/// ### Nine
function f(a: i32 /// # not a section
) {}

/// # One
// # not a doc comment
/// left out: not next to One's lines
const x = 1
`

test "a doc comment's headings start sections, in the order of their lines" {
	assert markdown(sections("a.bob", src))
		== "# Two\n\nOf the module.\n\n*a.bob:3*\n\n## Ten\n\nOf f.\n\n#define is no heading\n\n*a.bob:8*\n\n### Nine\n\n*a.bob:12*\n\n# One\n\n*a.bob:16*\n\n"
}
