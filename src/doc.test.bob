import { markdown, reference, sections } from "./doc"
import { CompileError } from "./error"

const src = `//! The module.
//!
//! # Two
//! Of the module.

/// Adds.
///
/// ## Ten
/// Of f.
///
/// #define is no heading
/// ### Nine
function f(a: i32 /// # not a section
) {}

/// # One
// # not a doc comment
/// left out: not next to One's lines
const x = 1
`

test "a doc comment's headings start sections, in the order of their lines" {
	assert markdown(sections("a.bob", src))
		== "# Two\n\nOf the module.\n\n*a.bob:3*\n\n## Ten\n\nOf f.\n\n#define is no heading\n\n*a.bob:8*\n\n### Nine\n\n*a.bob:12*\n\n# One\n\n*a.bob:16*\n\n"
}

test "a file that fails to parse is a CompileError at where it fails" {
	let msg = ""
	try {
		sections("a.bob", "const x = 1\nconst y = #")
	} catch (e: CompileError) {
		msg = e.msg
	}
	assert msg == "a.bob:2:11: unexpected character"
}

const lib = `//! Shapes. Of two kinds.

/// The area of s.
export function area(s: Shape): f64 { return s.area() }

function hidden() {}

/// A class that new makes without arguments.
export interface New { constructor() }

export class Square {
	/// Its side.
	side = 1.0
	private cache = 0
	area(): f64 { return this.side * this.side }
}

export const sides: i32[] = [
	1, 2,
]
`

test "a module's docs: each export as written up to its body, a class's members but private ones, and its doc" {
	const f = "```"
	assert reference("lib", "lib.bob", lib)
		== `# lib

Shapes. Of two kinds.

${f}bober
export function area(s: Shape): f64
${f}

The area of s.

${f}bober
export interface New {
	constructor()
}
${f}

A class that new makes without arguments.

${f}bober
export class Square {
	/// Its side.
	side = 1.0
	area(): f64
}
export const sides: i32[]
${f}
`
}
