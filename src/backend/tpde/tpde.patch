diff --git a/tpde-encodegen/CMakeLists.txt b/tpde-encodegen/CMakeLists.txt
index 462987f..be2a374 100644
--- a/tpde-encodegen/CMakeLists.txt
+++ b/tpde-encodegen/CMakeLists.txt
@@ -87,3 +87,21 @@ endif ()
 
 # Install
 install(TARGETS tpde_encodegen RUNTIME)
+
+# The encoders of tpde-llvm's snippets for this host, installed for a back end other than tpde-llvm.
+if (CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
+    set(TEMPLATE ${CMAKE_CURRENT_BINARY_DIR}/encode_template_arm64)
+    set(TEMPLATE_TARGET --target=aarch64 -march=armv8.1-a)
+else ()
+    set(TEMPLATE ${CMAKE_CURRENT_BINARY_DIR}/encode_template_x64)
+    set(TEMPLATE_TARGET --target=x86_64-linux -march=x86-64-v4)
+endif ()
+add_custom_command(
+    OUTPUT ${TEMPLATE}.hpp
+    COMMAND ${CMAKE_C_COMPILER} -c -emit-llvm -ffreestanding -fcf-protection=none -O3 -fomit-frame-pointer
+        -fno-math-errno ${TEMPLATE_TARGET} -o ${TEMPLATE}.bc ${CMAKE_CURRENT_SOURCE_DIR}/../tpde-llvm/src/encode_template.c
+    COMMAND tpde_encodegen -o ${TEMPLATE}.hpp ${TEMPLATE}.bc
+    DEPENDS tpde_encodegen ${CMAKE_CURRENT_SOURCE_DIR}/../tpde-llvm/src/encode_template.c
+)
+add_custom_target(encode_template ALL DEPENDS ${TEMPLATE}.hpp)
+install(FILES ${TEMPLATE}.hpp TYPE INCLUDE)
