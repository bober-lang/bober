//! The bytecode as text, close to bober's syntax, for tests and `bober bc`.

import { fromBits } from "../../builtin/math"
import { quoted } from "../../std/string"
import * as decl from "./decl"
import * as kind from "./kind"
import * as op from "./op"
import { Code, Import, Program } from "./program"

/// Module m of p: each decl of it in the order made.
export function show(p: Program, m: i32): string {
	let s = ""
	for (const i of 0 ... p.decls.length - 1) {
		s += if (p.decls[i].module == m) showDecl(p, i) else ""
	}
	return s
}

/// Decl i of p: its doc, a line of it, and the ops of its code, one per line, indented by block.
export function showDecl(p: Program, i: i32): string {
	const d = p.decls[i]
	let s = if (d.doc != 0) `/// ${p.strings[d.doc]}\n` else ""
	s += `${mods(d.mods)}${decl.names[d.kind]} ${qualified(p, i)}${params(p, i)}`
	if (d.type != 0) {
		s += `${if (d.kind == decl.Interface || d.kind == decl.Alias) " =" else ":"} ${showType(p, d.type)}`
	}
	if (d.supers != 0) {
		s += ` ${if (d.kind == decl.Class) "implements" else "extends"} ${types(p, d.supers, ", ")}`
	}
	if (d.throws != 0) {
		s += ` throws ${types(p, d.throws, " | ")}`
	}
	return s + "\n" + (if (d.code() != null) showCode(p, d.code()!) else "")
}

/// Code c's locals on a line, if any, and its captures, then its ops, one per line, indented by block.
export function showCode(p: Program, c: Code): string {
	let s = ""
	if (c.locals.length > 0) {
		s += `\tlocals ${c.locals.map(l => `${mods(l.mods)}${if (l.name == 0) "_" else p.strings[l.name]}: ${showType(p, l.type)}`).join(", ")}\n`
	}
	if (c.captures.length > 0) {
		s += `\tcaptures ${c.captures.join(", ")}\n`
	}
	let depth = 1
	for (const i of 0 ... c.ops.length - 1) {
		const o = c.ops[i]
		depth -= if (o == op.End) 1 else 0
		let line = op.names[o]
		const sh = op.shape[o]
		for (const j of 0 ... sh.length - 1) {
			const x = c.imm(i, j)
			const imm = switch (sh[j]) {
				case op.TypeId: showType(p, x)
				case op.TypeList: if (x == 0) "" else `[${types(p, x, ", ")}]`
				case op.DeclId: qualified(p, x)
				case op.StrId: quoted(p.strings[x])
				case op.IntId: if (o == op.Float) `${fromBits[f64](p.ints[x] as u64)}` else `${p.ints[x]}`
				case op.LocalList, op.NumList: `[${c.items(x).join(", ")}]`
				case op.LocalId, op.Num: `${x}`
			}
			line += if (imm == "") "" else " " + imm
		}
		for (const _ of 1 ... (if (op.splits[o]) depth - 1 else depth)) {
			s += "\t"
		}
		s += line + "\n"
		depth += if (op.opens[o]) 1 else 0
	}
	return s
}

/// Type t as text, of module at's source if at is one (named).
export function showType(p: Program, t: i32, at = -1): string {
	const a = p.a(t)
	const b = p.b(t)
	return switch (p.kind(t)) {
		case kind.Array: `${inner(p, a, at)}[]`
		case kind.Optional: `optional ${inner(p, a, at)}`
		case kind.Rest, kind.Embed: `...${inner(p, a, at)}` // a Rest is a Func's last param, an Embed an extern one's
		case kind.FixedArray: `${inner(p, a, at)}[${b}]`
		case kind.Tuple: `[${types(p, a, ", ", at)}]`
		case kind.Union: types(p, a, " | ", at)
		case kind.Object: fields(p, a, b, at)
		case kind.Func: `(${types(p, a, ", ", at)}) => ${showType(p, b, at)}`
		case kind.Named, kind.Alias: qualified(p, a, at) + args(p, t, at)
		case kind.Param: if (b < p.decls[a].params.length) p.strings[p.decls[a].params[b].name] else `?${b}`
		case kind.Literal: if (a == kind.String) quoted(p.strings[b])
			else if (a == kind.Bool) `${b == 1}`
			else `${p.ints[b]}`
		case kind.Of: `Of ${a}${if (b == 0) "" else `.${p.strings[b]}`}`
		case kind.Member: `${inner(p, a, at)}.${p.strings[b]}`
		case kind.Sum: p.lists[a].map(u => inner(p, u, at)).join(" | ")
		case kind.Sig: `(${signed(p, t, at)}) => ${showType(p, p.b(a), at)}`
		case kind.Throws: `${showType(p, a, at)} throws ${showType(p, b, at)}`
		default: primitives[t]
	}
}

const primitives = ["none", "null", "bool", "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64",
	"string", "string16", "string32", "Type", "int", "float"]

/// A type in a postfix or prefix position, parenthesized unless it binds tighter.
export function inner(p: Program, t: i32, at: i32): string {
	const k = p.kind(t)
	return if (k == kind.Union || k == kind.Func || k >= kind.Sum) `(${showType(p, t, at)})` else showType(p, t, at)
}

/// The params of Sig t as written.
function signed(p: Program, t: i32, at: i32): string {
	const ts = p.items(p.a(t))
	const out: string[] = []
	for (const i of 0 ... ts.length - 1) {
		out.push(param(p, p.names[p.b(t)][2 * i], ts[i], at))
	}
	return out.join(", ")
}

/// A param of name n, a Str, and type t as written, 0 for none: `...` before a rest one's.
export function param(p: Program, n: i32, t: i32, at = -1): string {
	const rest = p.kind(t) == kind.Rest
	return (if (rest) "..." else "") + p.strings[n]
		+ (if (t == 0) "" else `: ${showType(p, if (rest) p.a(t) else t, at)}`)
}

/// The types of the list, joined by sep.
function types(p: Program, list: i32, sep: string, at = -1): string {
	return p.lists[list].map(t => showType(p, t, at)).join(sep)
}

/// An object type of the list of field types and names entry.
function fields(p: Program, list: i32, names: i32, at: i32): string {
	const ts = p.lists[list]
	const ns = p.names[names]
	const fs: string[] = []
	for (const i of 0 ... ts.length - 1) {
		fs.push(`${mods(ns[2 * i + 1])}${p.strings[ns[2 * i]]}: ${showType(p, ts[i], at)}`)
	}
	return `{ ${fs.join(", ")} }`
}

/// The args of Named or Alias t, of a Named in module at's source if at is one but those its defaults give at its end.
function args(p: Program, t: i32, at: i32): string {
	const ts = p.lists[p.b(t)]
	const ps = p.decls[p.a(t)].params
	const own = ts.length - ps.length // after its owners'
	let n = ts.length
	while (at >= 0 && p.kind(t) == kind.Named && n > own && n > 0 && ps[n - 1 - own].fallback != 0
		&& p.subst(ps[n - 1 - own].fallback, p.b(t)) == ts[n - 1]) {
		n--
	}
	return if (n == 0) "" else `[${ts.slice(0, n).map(u => showType(p, u, at)).join(", ")}]`
}

/// Decl d's name after its owners', an instance's with its own args; of module at's source if at is one (named).
export function qualified(p: Program, d: i32, at = -1): string {
	const x = p.decls[d]
	const args = if (x.generic < 0) [] as i32[] else p.lists[x.env]
	const own = args.slice(args.length - (if (x.generic < 0) 0 else p.decls[x.generic].params.length), args.length)
	return (if (x.owner < 0) named(p, d, at) else `${qualified(p, x.owner, at)}.${p.strings[x.name]}`)
		+ (if (own.length == 0) "" else `[${own.map(t => showType(p, t, at)).join(", ")}]`)
}

/// Top-level decl d's name, in module at's source if at is one as at imports it: by the name it imports it as, else in
/// the namespace it imports its module as, else its own, of at or the prelude.
function named(p: Program, d: i32, at: i32): string {
	const name = p.strings[p.decls[d].name]
	const imports = if (at < 0) [] as Import[] else p.modules[at].imports
	for (const x of imports) {
		for (const [e, n] of x.names) {
			if (e == d) {
				return if (n == 0) name else p.strings[n]
			}
		}
	}
	const ns = imports.find(x => x.ns != 0 && x.module == p.decls[d].module)
	return if (ns == null) name else `${p.strings[ns!.ns]}.${name}`
}

/// Decl d's type params, if any.
function params(p: Program, d: i32): string {
	const ps = p.decls[d].params
	if (ps.length == 0) {
		return ""
	}
	return `[${ps.map(x => p.strings[x.name] + (if (x.constraint == 0) "" else ` extends ${showType(p, x.constraint)}`) + (if (x.fallback == 0) "" else ` = ${showType(p, x.fallback)}`)).join(", ")}]`
}

/// Each of the mods, followed by a space.
function mods(m: i32): string {
	let s = ""
	for (const b of 0 ... decl.modNames.length - 1) {
		if ((m >> b & 1) != 0) {
			s += decl.modNames[b] + " "
		}
	}
	return s
}
