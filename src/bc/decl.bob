//! Decl kinds and mods (§8.1). A decl is what a declaration declares: a class or interface, whose members are decls
//! too, a variable or field, a function or method, a test, or a type alias. Program's Decl holds one.

/// A class: its members, supertypes and type params are its decl's.
export const Class: u8 = 0
/// An interface: its members and the interfaces it extends, or its type set, its decl's type.
export const Interface: u8 = 1
/// A variable or field, a const too: its code is its initializer, which a field's runs with `this` as local 0.
export const Var: u8 = 2
/// A function or method: its type a Func, its code its body, none for an extern or intrinsic one.
export const Function: u8 = 3
/// A test (§5.5): a `() => null` run by the test runner.
export const Test: u8 = 4
/// A type alias: its type the type it stands for, its type params its own. Lower expands its uses.
export const Alias: u8 = 5

export type Kind = Class | Interface | Var | Function | Test | Alias

/// As show shows each kind.
export const names = ["class", "interface", "var", "function", "test", "type"]

/// The mods of a decl, an object field or a local, or-ed.
export const Export: i32 = 1
/// A static member of a class, which its instances do not hold.
export const Static: i32 = 2
export const Private: i32 = 4
/// A `const`, or a field that is not written after its constructor.
export const Readonly: i32 = 8
/// A field held in place; unnamed, a promoted `...T`.
export const Embed: i32 = 16
/// A function of a C header's module, called with the C ABI by its name, without code (§3.1).
export const Extern: i32 = 32

/// As show shows each mod, by bit.
export const modNames = ["export", "static", "private", "readonly", "embed", "extern"]
