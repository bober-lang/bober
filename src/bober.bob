/// What a command line gives bober, spelled as a C compiler's: these options anywhere on it, a command's after the
/// command; their docs are bober's help.
class Flags @optarg.Cc {
	/// print help
	h: bool = false
	/// with help or -h, print all of it
	v: bool = false
	/// The command and its arguments.
	command: Command | null @optarg.Rest = null
}

type Command = Run | Test | Check | Format | Init | Help | Version | Update | Report | Skill | Build | Bundle | Lower
	| Doc | Lsp

/// The options of the commands that read C headers.
class Headers @optarg.Cc {
	/// add a directory of C headers
	I: string[] @optarg.Verbose = []
}

/// The options of the commands that build a program.
export class Compile @optarg.Cc {
	headers: ...Headers
	/// optimize with LLVM
	release: bool = false
	/// monomorphize first, so that it runs fast, each module by TPDE; by default where CI is set
	O1: bool @optarg.Verbose = process.env("CI") != null
	/// as -O1, each module by LLVM: runs fastest but release, slow to compile; with no level given where CI is not set,
	/// a module once a command finds it unchanged
	O2: bool @optarg.Verbose = false
	/// each module as it is, fastest to compile, though CI is set; -O2 counts over it
	O0: bool @optarg.Verbose = false
	/// compile to WebAssembly GC, run by node
	wasm: bool = false
	/// compile to JavaScript, run by node
	js: bool = false
	/// -release for the first x86-64 CPUs, not x86-64-v2, those since about 2009
	baseline: bool @optarg.Verbose = false
	/// pass an option to LLVM, as clang's -mllvm
	mllvm: string[] @optarg.Verbose = []
	/// set a constant of bober's heuristics, as small=32, one of those under tune
	tune: string[] @optarg.Verbose = []
	/// The constants -tune sets.
	tuned: Tune @optarg.Skip = new Tune()
	/// The units the command compiled, which it holds but does not find unchanged.
	compiled: HashMap[string, bool] @optarg.Skip = new HashMap[string, bool]()
}

/// build a program and run it
export class Run @optarg.Cc {
	compile: ...Compile
	args: string[] @optarg.Rest = []
}

/// run a file's tests, or each file's here and below
class Test @optarg.Cc {
	compile: ...Compile
	/// run at most this many tests at once, by default the processors, but one where CI is not set
	j: i32 = 0
	args: string[] @optarg.Rest = []
}

/// report type errors and lint in files, directories or, with none, here and below
class Check @optarg.Cc {
	headers: ...Headers
	args: string[] @optarg.Rest = []
}

/// rewrite files, directories or, with none, here and below in their one layout
class Format @optarg.Cc {
	args: string[] @optarg.Rest = []
}

/// write a bober.pkg here
class Init @optarg.Cc {
	args: string[] @optarg.Rest = []
}

/// print help
class Help {}
/// print the build of bober, for a bug report
class Version {}
/// replace bober's package by the latest edge
class Update {}

/// print an issue for bober's tracker: a bug, a slowness or a wish, and files that show it
class Report {
	args: string[] @optarg.Rest = []
}

/// print the agent skill for writing Bober
class Skill {}

/// link the package's image, or with -o one module's object, or with -wasm or -js the program's WebAssembly or
/// JavaScript; for CI but -wasm and -js
export class Build @optarg.Cc @optarg.Verbose {
	compile: ...Compile
	/// the object, or with -wasm or -js the program, to write
	o: string = ""
	/// with -o, write the file's LLVM IR, as LLVM gets it, instead
	emitLLVM: bool @optarg.Name["emit-llvm"] @optarg.Verbose = false
	args: string[] @optarg.Rest = []
}

/// write builtin/ and std/ as the lib/ of bober's package
class Bundle @optarg.Cc @optarg.Verbose {
	args: string[] @optarg.Rest = []
}

/// print the bytecode of files
class Lower @optarg.Cc @optarg.Verbose {
	headers: ...Headers
	args: string[] @optarg.Rest = []
}

/// print a module's docs, as std/fs, or list a directory's modules, as std
class Doc @optarg.Cc {
	args: string[] @optarg.Rest = []
}

/// serve the language server protocol on stdin and stdout
class Lsp @optarg.Cc @optarg.Verbose {
	headers: ...Headers
}

/// The help of command c, else of all, all of it if verbose.
function usage(c: Command | null, verbose: bool): string {
	const compiles = c instanceof Run || c instanceof Test || c instanceof Build
	const tune = if (verbose && compiles) "tune:\n" + replace(optarg.help[Tune](), "  --", "  ") else ""
	for (const M of Command.members) {
		if (c instanceof M) {
			return [M.doc, optarg.help[M](verbose), tune].filter(l => l != "").join("\n")
		}
	}
	return `usage: bober <command> [args]\n${optarg.help[Command](verbose)}\noptions:\n${optarg.help[Flags](verbose)}`
}

/// The machine and the format of the images src/link writes here; TPDE's objects are ELF everywhere.
export const machine = if (arch == "arm64") arm64 else x64
const mac = os == "macos"
export const format = if (mac) macho else if (os == "windows") pe else elf

/// Links the objects and linker options args into the executable out by bobcc's link, with libc++ for C++ libraries:
/// folding identical code, on ELF with a build ID (compilerId) and each segment at the same distance from its offset in
/// the file, as perf's DWARF unwinder takes it; throws a CompileError if it fails.
export function ld(args: string[], out: string) {
	const flags = if (os == "macos") ["-lc++"]
		else ["--build-id", "-z", "separate-loadable-segments", "-lc++", "-lc++abi"]
	if (link(sysroot, ["--icf=all", ...args, ...flags], out) != 0) {
		throw new CompileError(`cannot link ${out}`)
	}
}

/// p, which is rooted or under cwd, rooted.
const under = (cwd: string, p: string) => if (isAbs(p)) p else join(cwd, p)
/// p rooted, as run runs the command it is in where bober was started.
const rooted = (p: string) => under(fromCString(getcwd(0, 0)), p)

/// The CMake toolchain file of C library c, built in cwd: bober's defaults for the target, its triple, the sysroot and on
/// ELF static executables, with the compilers CMake finds, run by ccache if found with paths under cwd made relative,
/// so that checkouts share hits, and so without precompiled headers, then c's toolchain file, which may override them.
/// Its stamps hold it, but CI's cache key does not (.github/actions/setup): a change here wants one there too.
export const toolchain = (c: CLib, cwd: string) => `set(CMAKE_C_COMPILER_TARGET ${triple})
set(CMAKE_CXX_COMPILER_TARGET ${triple})
set(CMAKE_ASM_COMPILER_TARGET ${triple})
${if (os == "macos") `set(CMAKE_OSX_SYSROOT "${sysroot}")` else `set(CMAKE_SYSROOT "${under(cwd, sysroot)}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")`}
find_program(CCACHE ccache)
if(CCACHE)
	set(CMAKE_C_COMPILER_LAUNCHER \${CCACHE} "base_dir=${cwd}")
	set(CMAKE_CXX_COMPILER_LAUNCHER \${CCACHE} "base_dir=${cwd}")
	set(CMAKE_DISABLE_PRECOMPILE_HEADERS ON)
endif()
${if (c.toolchain == "") "" else `include("${under(cwd, c.toolchain)}")\n`}`

function main(): i32 {
	const argv = args()
	let f = new Flags()
	try {
		f = optarg.decode[Flags](argv)
	} catch (e: ParseError) {
		print(`bad argument ${argv[e.at]}`)
		return 2
	}
	const c = f.command
	if (f.h || c instanceof Help) {
		print(usage(if (c instanceof Help) null else c, f.v))
		return 0
	}
	if (c == null) {
		print(usage(null, false))
		return 2
	}
	const ignores = if (c instanceof Run || c instanceof Test || c instanceof Build) ignored(c) else null
	if (ignores != null) {
		print(ignores)
		return 2
	}
	if (c instanceof Run || c instanceof Test || c instanceof Build) {
		c.compile.headers.I = c.compile.headers.I.map(given)
		try {
			c.compile.tuned = optarg.decode[Tune](c.compile.tune.map(t => `--${t}`))
		} catch (e: ParseError) {
			print(`bad -tune ${c.compile.tune[e.at]}`)
			return 2
		}
		deflation = if (c.compile.release) 9 else 1
	}
	notice()
	try {
		const mllvm = if (c instanceof Run || c instanceof Test || c instanceof Build) c.compile.mllvm else []
		options(mllvm)
		const status = command(c)
		if (mllvm.length > 0) {
			shutdown()
		}
		return status
	} catch (e: CompileError | IoError) {
		print(if (e instanceof IoError) e.message() else e.msg)
		return 1
	}
}

/// Runs command c; returns the exit status or throws a CompileError or IoError.
function command(c: Command): i32 {
	switch (c) {
		case Test:
			const jobs = bober_jobs(c.j)
			const main = given(if (c.args.length == 0) "." else c.args[0])
			if (exists(main) && stat(main).isDirectory) {
				return testAll(main, c.compile, jobs)
			}
			const [status, report] = runTests([main], c.args.slice(1, c.args.length), c.compile)[0]()
			stdout.write(yamlOf(report))
			return status
		case Build:
			if (process.env("CI") == null && !c.compile.wasm && !c.compile.js) {
				stderr.write("warning: build is for CI; run and test build what they need\n")
			}
			if (c.args.length == 0) {
				buildPackage(c.compile.headers.I)
			} else if (c.o == "") {
				throw new CompileError("build <file.bob> takes -o <out>")
			} else if (c.compile.wasm || c.compile.js) {
				toTarget(given(c.args[0]), false, c.compile, given(c.o))
			} else {
				inspect(given(c.args[0]), given(c.o), c.compile, c.emitLLVM)
			}
			return 0
		case Run: if (c.args.length > 0) {
			const argv = build(given(c.args[0]), false, c.compile, true)
			setenv("BOBER_HOME", fromCString(getcwd(0, 0)), 1) // where its traps find their modules
			chdir(here ?? ".") // the program runs where bober was started
			return process.run([...argv, ...c.args.slice(1, c.args.length)])
		}
		case Check: if (c.args.length > 0 || here != null) {
			let status = 0
			for (const e of check(sourcesOf(c.args), c.headers.I.map(given))) {
				print(`${e.path}:${e.line}:${e.col}: ${if (e.warning) "warning: " else ""}${e.msg}`)
				status = if (e.warning) status else 1
			}
			return status
		}
		case Format: if (c.args.length > 0 || here != null) {
			let status = 0
			for (const path of sourcesOf(c.args)) {
				try {
					formatFile(path)
				} catch (e: CompileError) {
					print(e.msg)
					status = 1
				}
			}
			return status
		}
		case Doc: if (c.args.length > 0) {
			stdout.write(c.args.map(doc).join("\n"))
			return 0
		}
		case Skill:
			stdout.write(readFile(join(root, "skills/bober/SKILL.md")))
			return 0
		case Lsp:
			serve(c.headers.I.map(given))
			return 0
		case Init:
			init(if (c.args.length == 0) "" else c.args[0])
			return 0
		case Version:
			print(version())
			return 0
		case Update: return update()
		case Report: if (c.args.length > 0) {
			let r = `${c.args[0]}\n\n${version()}, ${os} ${arch}\n`
			for (const f of c.args.slice(1, c.args.length)) {
				r += `\n${f}:\n\`\`\`bober\n${trim(readFile(given(f)))}\n\`\`\`\n`
			}
			stdout.write(r)
			stderr.write(`bober: file it by piping it into gh issue create -R bober-lang/bober -t "<bug|slow|wish>: <title>" -F -
bober: or paste it at https://github.com/bober-lang/bober/issues/new/choose\n`)
			return 0
		}
		case Bundle: if (c.args.length > 0) {
			pack(given(c.args[0]))
			return 0
		}
		case Lower: if (c.args.length > 0) {
			const paths = c.args.map(given)
			const p = lower(paths, c.headers.I.map(given))
			for (const path of paths) {
				print(show(p, p.module(normal(path))))
			}
			return 0
		}
	}
	print(usage(c, false))
	return 2
}

/// Writes bober.pkg in the directory bober was started in, of the package name, else the one asked for on a terminal,
/// else @local/<the directory's name>.
function init(name: string) {
	if (exists(given("bober.pkg"))) {
		throw new CompileError("bober.pkg exists")
	}
	let n = name
	if (n == "") {
		n = `@local/${base(join(fromCString(getcwd(0, 0)), here ?? "."))}`
		if (isatty(0) != 0) {
			stdout.write(`name (${n}): `)
			let line = ""
			let c = stdin.read(1)
			while (c != null && c != "\n") {
				line += c
				c = stdin.read(1)
			}
			if (trim(line) != "") {
				n = trim(line)
			}
		}
	}
	const parts = split(n, "/")
	if (parts.length != 2 || parts[0].length < 2 || parts[1] == "" || !startsWith(n, "@")) {
		throw new CompileError(`${n} is not @namespace/name`)
	}
	save(given("bober.pkg"), `{\n\t"name": ${quoted(n)}\n}\n`)
}

/// Runs the tests of testFiles(d) as test without main.bob prints them; 0 if all passed. A failed file's YAML starts
/// with a line for each of its directories, of which those the last failed file printed are left out. Each file starts
/// once compiled, at most jobs at once (runTests), their initializations and tests taking turns by the tokens of one
/// pool (bober_jobs), and is reported once all are started.
function testAll(d: string, f: Compile, jobs: i32): i32 {
	const files = testFiles(d)
	clear = if (isatty(1) != 0) "\r\x1b[K" else ""
	if (clear != "") {
		checking = path => stdout.write(`${clear}checking ${split(path, ": ")[0]}`)
	}
	const started = runTests(files, [], f, jobs) // what waits for each file, in order
	let dirs: string[] = [] // of the last failed file
	let failed = 0
	for (const i of 0 ... files.length - 1) {
		if (clear != "") {
			stdout.write(`${clear}[${i + 1}/${files.length}] ${files[i]}`)
		}
		const [s, r] = started[i]()
		if (s != 0) {
			const parts = split(files[i], "/")
			const lines = split(yamlOf(parts.map(p => `{${quoted(p)}:`).join("") + r + parts.map(p => "}").join("")),
				"\n")
			let k = 0
			while (k < dirs.length && k < parts.length - 1 && dirs[k] == parts[k]) {
				k++
			}
			stdout.write(clear + lines.slice(k, lines.length).join("\n"))
			dirs = parts.slice(0, parts.length - 1)
			failed++
		}
	}
	stdout.write(`${clear}# ${files.length - failed} of ${files.length} files passed\n`)
	return if (failed == 0) 0 else 1
}

/// On a terminal, what takes the line of testAll, and of checking and compiling the modules, back to its start, erased;
/// else "".
let clear = ""

/// The files that have tests in d and below, but in build/, hidden directories and builtin/, which no program tests.
function testFiles(d: string): string[] {
	const files: string[] = []
	const es = readDir(d)
	sortBy(es, (a, b) => a.name < b.name)
	for (const e of es) {
		const p = join(d, e.name)
		if (e.isDirectory && e.name != "build" && !startsWith(e.name, ".")) {
			files.push(...testFiles(p))
		} else if (endsWith(e.name, ".bob") && !builtin(p) && hasTests(p)) {
			files.push(p)
		}
	}
	return files
}

/// The report, JSON, as YAML, each byte of it not UTF-8, which YAML cannot hold, as U+FFFD.
function yamlOf(report: string): string {
	let s = ""
	let i = 0
	while (i < report.length) {
		const [c, end] = codePoint(report, i)
		s += if (c == 0xfffd) utf8(c) else report.slice(i, end)
		i = end
	}
	try {
		return yaml.emit(yaml.documents(s))
	} catch (e: ParseError | yaml.EncodeError) {
		return s + "\n" // not a report
	}
}

/// The report of a program's tests kept (runTests), by the compiler, the include directories and their args: whole
/// while the files their build and they read are as they were, else of each test that passed, while the code it runs
/// (Reached) and the files it read are, and those of the build that are not bober's sources or are builtin/'s, which
/// the compiler calls by name.
class TestCache {
	code = ""
	/// The report, if every test passed, else "".
	report = ""
	/// Each file's path, time and size (stampOf), and hash (hashOf).
	files: [string, string, string][] = []
	/// Each test that passed: its name, the hash of the code it runs, and the files it read.
	passed: [string, string, string[]][] = []
	/// The files the module's initialization read, which each test depends on too.
	init: string[] = []
}

/// Starts the tests of each of mains, built as f says, with args, unless their report is kept and f builds natively,
/// each once the one started jobs before it exited, if jobs > 0: what waits for each, giving its exit status and its
/// report, the JSON object src/rt.c prints, ended by the exit status if a crash cut it off, or else what failed as a
/// JSON string.
export function runTests(mains: string[], args: string[], f: Compile, jobs = 0): (() => [i32, string])[] {
	const code = if (f.wasm || f.js) "" else [`${compilerId()}`, ...f.headers.I, "--", ...args].map(quoted).join(" ")
	const held = mains.map(main => hold(main, code))
	const command = together(held.filter(h => h instanceof Held).map(h => (h as Held).main), f)
	const started: (() => [i32, string])[] = []
	return held.map(x => {
		if (!(x instanceof Held)) {
			return x
		}
		const h = x
		try {
			const cmd = [...command(h.main), ...args]
			const files = built
			const tests = hashes
			const passed = passing(h.kept, files, tests)
			if (tests.length > 0 && passed.length == tests.length) {
				return () => tested(null, h, code, files, tests, passed)
			}
			if (jobs > 0 && started.length >= jobs) {
				started[started.length - jobs]()
			}
			setenv("BOBER_TMP", `${dir}/tmp/${flat(h.main)}`, 1)
			setenv("BOBER_PASSED", passed.map(t => `${t[0]}\n`).join(""), 1)
			const p = process.start(cmd, `${dir}/tmp/${flat(h.main)}.log`)
			let r: [i32, string] | null = null
			const wait = () => {
				r ??= tested(p, h, code, files, tests, passed)
				return r!
			}
			started.push(wait)
			return wait
		} catch (e: CompileError | IoError) {
			h.lock.close()
			return () => failure(e)
		}
	})
}

/// The name of main's files in build/tmp and build/kept, which no other path has.
function flat(main: string): string { return replace(replace(normal(main), "%", "%25"), "/", "%2F") }

/// The tests of main to run: the lock of their log, held till their report is kept, which a bober test running them at
/// once waits for, when, by the files' clock, before their build reads any, and what is kept of them by the same code.
class Held {
	main: string
	lock: File
	since: i64
	kept: TestCache | null

	constructor(main: string, lock: File, since: i64, kept: TestCache | null) {
		this.main = main
		this.lock = lock
		this.since = since
		this.kept = kept
	}
}

/// main's tests, made to run, with their directory made anew, unless their report is kept by code, which is then what
/// gives it, or what could not be done.
function hold(main: string, code: string): Held | (() => [i32, string]) {
	let lock: File | null = null
	try {
		const tmp = `${dir}/tmp/${flat(main)}`
		mkdirAll(`${dir}/tmp`)
		const l = open(`${tmp}.log`, "a")
		lock = l
		l.lock(false, true)
		let kept: TestCache | null = null
		try {
			const k = decodeJson[TestCache](readFile(`${dir}/kept/${flat(main)}`))
			if (code != "" && k.code == code && k.report != "" && k.files.every(unchanged)) {
				l.close()
				return () => [0, k.report]
			}
			kept = if (code != "" && k.code == code) k else null
		} catch (e: IoError | ParseError) {}
		if (exists(tmp)) {
			removeAll(tmp)
		}
		mkdirAll(tmp)
		return new Held(main, l, stat(tmp).modified, kept)
	} catch (e: IoError) {
		lock?.close()
		return () => failure(e)
	}
}

/// What builds the tests of each of mains as f says: natively of a package's at once, one program, but those of one
/// that fails to compile, each alone.
function together(mains: string[], f: Compile): (main: string) => string[] {
	const commands = new HashMap[string, (main: string) => string[]]()
	return main => {
		if (!commands.has(main)) {
			const w = world(main)
			const g = if (f.wasm || f.js || f.release) [main] else mains.filter(x => x == main || w.includes(normal(x)))
			let c = (x: string) => build(x, true, f, true)
			if (g.length > 1) {
				try {
					c = programs(g, true, f, true)
				} catch (e: CompileError) {}
			}
			for (const x of g) {
				commands.set(x, c)
			}
		}
		return commands.get(main)!(main)
	}
}

/// The tests of kept k that pass still, by tests, each the name of one and the hash of the code it runs: of the same
/// hash, while the files it read are as they were, and those the initialization read, and those of the build's files
/// that are not bober's sources or are builtin/'s.
function passing(k: TestCache | null, built: string[], tests: [string, string][]): [string, string, string[]][] {
	const files = byPath(k)
	const same = (x: string) => files.has(x) && unchanged(files.get(x)!)
	const other = built.filter(x => !endsWith(x, ".bob") || builtin(x))
	return if (k == null || ![...other, ...k.init].every(same)) []
		else k.passed.filter(t => tests.some(x => x[0] == t[0] && x[1] == t[1]) && t[2].every(same))
}

/// Kept k's files by path.
function byPath(k: TestCache | null): HashMap[string, [string, string, string]] {
	const files = new HashMap[string, [string, string, string]]()
	for (const f of k?.files ?? []) {
		files.set(f[0], f)
	}
	return files
}

/// What runTests gives of the tests p runs, held as h, built of files, kept by code unless code is "": of tests, each
/// its name and the hash of the code it runs, all but those passed, which pass still, or none if p is null.
function tested(p: process.Process | null, h: Held, code: string, files: string[], tests: [string, string][],
	passed: [string, string, string[]][]): [i32, string] {
	const out = `${dir}/tmp/${flat(h.main)}.log`
	try {
		const status = p?.wait() ?? 0
		// The report, which a crash cuts off after the key of the test it was in, then the files each test read, and
		// those the initialization read.
		const text = if (p == null) `{${tests.map(t => `${quoted(t[0])}:"ok"`).join(",")}}\n{}\n${encode(h.kept!.init)}`
			else trim(readFile(out))
		const nl = indexOf(text, "\n")
		const report = if (nl < 0) text else text.slice(0, nl)
		for (const r of [report, `${report}${quoted(`exit ${status}`)}}`]) {
			try {
				const entries = decodeJson[Keys](r).all
				if (code != "" && nl >= 0) {
					const k = new TestCache()
					k.code = code
					k.passed = passed
					const lines = split(text.slice(nl + 1, text.length), "\n")
					k.init = decodeJson[string[]](lines[lines.length - 1])
					for (const [name, reads] of decodeJson[Keys](lines[0]).all) {
						const t = tests.find(x => x[0] == name)
						const ok = entries.some(e => e[0] == name && e[1].text == `"ok"`)
						if (t != null && reads.text != "null" && ok && indexOf(name, "\n") < 0) {
							// as BOBER_PASSED lists them
							k.passed.push([name, t[1], decodeJson[string[]](reads.text)])
						}
					}
					k.report = if (status == 0 && k.passed.length == tests.length) r else ""
					const all = [...files, ...k.init]
					for (const t of k.passed) {
						all.push(...t[2])
					}
					sortBy(all, (a, b) => a < b)
					const kept = byPath(h.kept)
					k.files = unique(all).map(x => {
						const stamp = stampOf(x)
						const f = kept.get(x)
						return [x, stamp,
							if (f != null && f[1] == stamp && f[2] != "changed") f[2] else hashOf(x, h.since)]
					})
					mkdirAll(`${dir}/kept`)
					save(`${dir}/kept/${flat(h.main)}`, encode(k))
				}
				return [status, r]
			} catch (e: ParseError) {}
		}
		return [if (status == 0) 1 else status, quoted(trim(`${text}\nexit ${status}`))]
	} catch (e: IoError) {
		return failure(e)
	} finally {
		h.lock.close()
	}
}

/// What runTests gives of tests that could not run for e.
function failure(e: CompileError | IoError): [i32, string] {
	return [1, quoted(if (e instanceof IoError) e.message() else e.msg)]
}

/// The hash of the bytes of the file at path, "" if there is none, "changed" if it changed at since or after, as read
/// before.
function hashOf(path: string, since: i64 = 0): string {
	try {
		const bytes = readFile(path)
		return if (since > 0 && stat(path).modified >= since) "changed" else `${fnv(bytes)}`
	} catch (e: IoError) {
		return ""
	}
}

/// The time and size of the file at path, "" if there is none.
function stampOf(path: string): string {
	try {
		const s = stat(path)
		return `${s.modified} ${s.size}`
	} catch (e: IoError) {
		return ""
	}
}

/// The hash of each file hashed by unchanged, by its path, time and size.
let seen = new HashMap[string, string]()

/// Whether the file of a kept report is as it was: of the time and size it had, else of its hash, as after a checkout;
/// not if it changed while the tests ran.
function unchanged(f: [string, string, string]): bool {
	const stamp = stampOf(f[0])
	if (stamp == f[1]) {
		return f[2] != "changed"
	}
	const k = `${f[0]} ${stamp}`
	if (!seen.has(k)) {
		seen.set(k, hashOf(f[0]))
	}
	return seen.get(k) == f[2]
}

/// Whether the file at path declares a test, or does not parse, which its test run then reports.
function hasTests(path: string): bool {
	const p = new Parser(readFile(path))
	try {
		let t = p.parse()
		while (t != null && t.kind != "test") {
			t = p.parse()
		}
		return t != null
	} catch (e: SyntaxError) {
		return true
	}
}

/// Compiles the program of main into the image, each module as lowered at -O0 by TPDE, else monomorphized of its
/// package, by TPDE at -O1, by LLVM at -O2, and with no level given by TPDE, by LLVM once unchanged (image); -O2 counts
/// over -O0, -O0 over -O1. If release, each so by LLVM, optimized, and of the objects of these the executable
/// build/<name>, or with tests build/<name>.test, is linked (executable). Returns the command that runs it, or its
/// tests: the executable, or the launcher on the image's entry, named with the program's version, run by the C
/// library's loader where it is the sysroot's, the image as image has it if pin. Throws the errors, or what failed, as
/// a CompileError or IoError.
export function build(main: string, tests: bool, f: Compile, pin: bool): string[] {
	return if (f.wasm || f.js) toTarget(main, tests, f) else programs([main], tests, f, pin)(main)
}

/// The files the program build built last, natively, is built of (inputs), by which its tests' results are kept
/// (runTests), and its tests, each its name and the hash of the code it runs (Reached).
let built: string[] = []
let hashes: [string, string][] = []
/// The sources of the C the builds compiled or found current (newer, cmake).
let made: string[] = []

/// The files the program of p's module main is built of, as any -O builds it: the sources of main, of the modules it
/// imports and of builtin/'s every program holds, however many more -O lowers, the files read to bind or locate the C
/// headers they import, the bober.pkg of their packages, and the C made.
function inputs(p: Program, main: i32): string[] {
	const files = [...made]
	for (const path of imported(p, main).map(m => p.modules[m].path)) {
		const source = split(path, ": ")[0]
		const d = nearest(source)
		const reads = (bound.get(path)?.reads ?? []).map(r => r[0])
		files.push(...[source, ...(if (d == null) [] else [join(d, "bober.pkg")]), ...reads])
	}
	return files
}

/// The modules of the program of p's module main: it, those of builtin/ every program holds, and those they import.
function imported(p: Program, main: i32): i32[] {
	const ms = [main, ...always.map(b => p.module(b))]
	let i = 0
	while (i < ms.length) {
		ms.push(...p.modules[ms[i]].deps.filter(d => !ms.includes(d)))
		i++
	}
	return ms
}

/// Of each of p's modules mains, each test: its name and the hash of the code it runs (Reached), with the inits of its
/// program.
function testHashes(p: Program, mains: i32[]): [string, string][][] {
	const r = new Reached(p)
	return mains.map(main => {
		const inits: i32[] = []
		for (const m of imported(p, main)) {
			inits.push(...p.modules[m].inits)
		}
		const tests = p.modules[main].decls.filter(d => p.decls[d].kind == decl.Test)
		return tests.map(d => [p.strings[p.decls[d].name], `${r.of([d, ...inits])}`])
	})
}

/// Compiles the programs of mains into the image as build does, monomorphized as one of their package (ofWorld), but at
/// -O0, and if release of themselves alone; returns what gives the command of one of them, linking the image again only
/// where another build wrote it (done), and once it failed, what it threw.
function programs(mains: string[], tests: bool, f: Compile, pin: bool): (main: string) => string[] {
	const dyn = !f.release && !f.O2 && f.O0
	const p = if (dyn || f.release) lowered(mains, f.headers.I) else ofWorld(mains, f.headers.I)
	const ms = mains.map(m => p.module(normal(m)))
	const hashed = if (tests) testHashes(p, ms) else [] // before mono changes the code
	const o = { main: -1, tests: false, dyn: dyn, tune: f.tuned }
	if (!o.dyn) {
		if (clear != "") {
			stdout.write(`${clear}compiling ${p.modules.length} modules`)
		}
		for (const x of 0 ... p.modules.length - 1) {
			p.modules[x].bc = if (p.modules[x].bc != "") p.modules[x].bc else write(p, x, compilerId())
		}
		mono(p, ms[0], true, if (f.release) f.tuned.small else 0)
	}
	const [files, cxx] = linked(p, program(p, ms, dyn), tests, f.headers.I)
	let failed: CompileError | null = null
	return main => {
		if (failed != null) {
			throw failed!
		}
		let made: [string, u64] = ["", 0]
		try {
			made = image(p, ms, files, cxx, pin || f.release, o, f)
		} catch (e: CompileError) {
			failed = e
			throw e
		}
		const [at, version] = made
		const command = if (f.release) [rooted(executable(p, ms, files, at, main, tests))]
			else [...(if (mac) [] else [rooted(`${sysroot}/usr/lib/libc.so`)]),
			rooted(if (packaged()) join(root, "lib/launch.c.exe") else launcher(dir)), rooted(at),
			`${exported(p, p.module(normal(main)), o.dyn, tests)}@${version}`]
		built = if (tests) inputs(p, p.module(normal(main))) else []
		hashes = if (tests) hashed[mains.indexOf(main)] else []
		return command
	}
}

/// Compiles the program of main into file, by default build/<name>.wasm, or .mjs if f.js, with tests
/// build/<name>.test.wasm or .mjs, monomorphized, of builtin/'s modules those of the target (targetSource), or in the
/// package those of lib/wasm.bobc or lib/js.bobc; returns the command that runs it.
function toTarget(main: string, tests: bool, f: Compile,
	file = `${dir}/${name(main)}${if (tests) ".test" else ""}${if (f.js) ".mjs" else ".wasm"}`): string[] {
	bundleName = if (f.js) "js" else "wasm"
	const p = lower([main], f.headers.I, [], targetSource(f.js))
	const m = p.module(normal(main))
	mono(p, m)
	mkdirAll(parent(file))
	const host = rooted(join(root, if (packaged()) "lib/host.mjs" else "builtin/wasm/host.mjs"))
	if (f.js) {
		js(p, m, tests, file)
		return ["node", host, rooted(file)]
	}
	wasm(p, m, tests, file)
	return ["node", "--experimental-wasm-jspi", host, rooted(file)]
}

/// The source of the module at path for WebAssembly, or JavaScript if toJs: of builtin/'s, builtin/js/'s where it has
/// one if toJs, else builtin/wasm/'s where it has one.
function targetSource(toJs: bool): (path: string) => string | null {
	const dirs = if (toJs) ["builtin/js", "builtin/wasm"] else ["builtin/wasm"]
	return (path: string) => {
		for (const d of if (builtin(path)) dirs else []) {
			const v = join(root, d, base(path))
			if (exists(v)) {
				return readFile(v)
			}
		}
		return if (exists(path)) readFile(path) else null
	}
}

/// An option given to c that its build would ignore, which is an error rather than ignored, as "-wasm ignores -O2";
/// else null. -O1 is given where it is not its default, as CI sets it.
export function ignored(c: Run | Test | Build): string | null {
	const f = c.compile
	const build = c instanceof Build
	const ir = c instanceof Build && c.emitLLVM
	const levels: [string, bool][] = [["-O0", f.O0], ["-O1", f.O1 != new Compile().O1], ["-O2", f.O2]]
	const mllvm: [string, bool] = ["-mllvm", f.mllvm.length > 0]
	if (c instanceof Build && c.args.length == 0) {
		return first("build of the package",
			[["-o", c.o != ""], ["-emit-llvm", ir], ["-wasm", f.wasm], ["-js", f.js], ["-release", f.release],
			["-baseline", f.baseline], ...levels, mllvm])
	}
	if (f.wasm || f.js) {
		return first(if (f.js) "-js" else "-wasm",
			[["-wasm", f.js && f.wasm], ["-release", f.release], ["-baseline", f.baseline], ["-emit-llvm", ir],
			...levels, mllvm])
	}
	const llvm = f.release || ir || !build && (f.O2 || !f.O0)
	return first(if (build) "build" else "-release", if (build || f.release) levels else [])
		?? first("-emit-llvm", [["-release", ir && f.release]])
		?? first("a build but -release or -emit-llvm", [["-baseline", f.baseline && !f.release && !ir]])
		?? first("a build by TPDE alone", [["-mllvm", mllvm[1] && !llvm]])
}

/// That by ignores the first of options given, else null.
function first(by: string, options: [string, bool][]): string | null {
	const o = options.find(o => o[1])
	return if (o == null) null else `${by} ignores ${o![0]}`
}

/// The build command on no file: links the modules of home and below, but those of build/, hidden directories, builtin/
/// and other packages, into the image, with their tests' network, exporting their entries; so that run and test of one
/// there link little.
function buildPackage(includes: string[]) {
	if (here == null) {
		throw new CompileError("no bober.pkg here or above")
	}
	const mains = sources(".")
	const p = lowered(mains, includes)
	const [files, cxx] = linked(p, program(p, [], true), true, includes)
	image(p, mains.map(m => p.module(normal(m))), files, cxx, false, debug)
}

/// The files the program of main is monomorphized with, which make it the same in each: those buildPackage links of
/// main's package, if main is one, else main alone.
function world(main: string): string[] {
	const d = nearest(main)
	const all = if (d == null) [] else sources(d)
	return if (all.includes(normal(main))) all else [main]
}

/// The Program of mains lowered with the files of the first's world, or of mains alone where another of those does not
/// compile, as one being edited.
function ofWorld(mains: string[], includes: string[]): Program {
	try {
		return lowered(world(mains[0]), includes)
	} catch (e: CompileError) {
		return lowered(mains, includes)
	}
}

/// The modules the program of p's modules mains links: all, as lowered, where a type may name any; else, monomorphized,
/// mains, builtin/'s, and the deps and uses of each.
function program(p: Program, mains: i32[], all: bool): i32[] {
	const ms = [...mains]
	for (const m of 0 ... p.modules.length - 1) {
		if ((all || builtin(p.modules[m].path)) && !ms.includes(m)) {
			ms.push(m)
		}
	}
	let i = 0
	while (i < ms.length) {
		const m = p.modules[ms[i]]
		i++
		for (const d of [...m.deps, ...m.uses]) {
			if (!ms.includes(d)) {
				ms.push(d)
			}
		}
	}
	return ms
}

/// The .bob files of d and below that buildPackage links, by name.
function sources(d: string): string[] {
	const files: string[] = []
	const es = readDir(d)
	sortBy(es, (a, b) => a.name < b.name)
	for (const e of es) {
		const p = join(d, e.name)
		if (!e.isDirectory) {
			if (endsWith(e.name, ".bob") && !builtin(p)) {
				files.push(p)
			}
		} else if (e.name != "build" && !startsWith(e.name, ".") && !exists(join(p, "bober.pkg"))) {
			files.push(...sources(p))
		}
	}
	return files
}

/// The .bob files that check and format take of args, files and directories, a directory's its sources; of none, those
/// where bober was started.
function sourcesOf(args: string[]): string[] {
	const files: string[] = []
	for (const a of (if (args.length == 0) ["."] else args).map(given)) {
		files.push(...if (exists(a) && stat(a).isDirectory) sources(a) else [a])
	}
	return files
}

/// The build command on a file: compiles the module of path alone into the object out, to inspect: by TPDE as lowered,
/// or if release by LLVM at -O2, monomorphized as for its unit (image), without what a whole program's emission learns
/// (learn), and with its bytecode as lowered (src/bc/file.bob), which has its generics, in section bober_bc; or if ir,
/// LLVM's module of it, as LLVM gets it, unoptimized, as text.
function inspect(path: string, out: string, f: Compile, ir: bool) {
	const p = lowered([path], f.headers.I)
	const m = p.module(normal(path))
	if (!f.release && !ir) {
		const b = new Tpde(path)
		emit(p, m, b, debug)
		b.emit(out, false)
		return
	}
	const b = new LLVM(path, 2, !f.baseline)
	b.data(write(p, m, compilerId()), "bober_bc")
	mono(p, m, true, if (f.release) f.tuned.small else 0)
	emit(p, m, b, { main: -1, tests: false, dyn: false, tune: f.tuned })
	b.verify()
	if (ir) {
		save(out, b.text())
	} else {
		b.emit(out, false)
	}
}

/// Program p of mains, lowered after the CMake projects of main's package are built, but the modules linked from the
/// bytecode build/image.so holds, of the Bound each holds if any (unit), of files hashed as build/hashes keeps them
/// (hashing), with the build directory made; its linker kept for relink.
function lowered(mains: string[], includes: string[]): Program {
	const h = nearest(mains[0])
	if (h != null) {
		cmake(h)
	}
	const image = `${dir}/image.so`
	// Mapped of one descriptor, lest another build replace it, and read shared, lest one write it in place, which it may
	// once this is done: what is taken of it, copied; the mapping, by relink only while the file has the same stamp.
	const f = if (exists(image)) open(image) else null
	f?.lock(true, true)
	const kept = if (f == null) null else new Bytes(f.map())
	const l = new Linker(machine, format, kept)
	const cache = l.sections("bober_bc").map(s => s.copy())
	Bound.keep(l.sections("bober_bind").map(s => s.copy()))
	decoded = if (kept == null) null else [stamp(kept, format.headers), l, kept]
	f?.close()
	mkdirAll(dir)
	return hashing(`${dir}/hashes`, () => lower(mains, includes, cache))
}

/// Whether bober runs from its package, whose lib/ has the run time, the C of the bundle's modules and the launcher,
/// compiled by pack.
function packaged(): bool { return exists(join(root, "lib/std.bobc")) }

/// What p links besides its modules ms, compiled where not yet: the C of these (cObjects), and the run time, with
/// tests their network; and whether one is C++.
function linked(p: Program, ms: i32[], tests: bool, includes: string[]): [string[], bool] {
	const [cs, cxx] = cObjects(p, ms, includes)
	return [[...cs, ...(if (packaged()) glob(join(root, "lib/*.[ao]")) else runtime(dir)),
		...(if (!tests) [] else if (packaged()) glob(join(root, "lib/net/*.o")) else network(dir))], cxx]
}

/// How the image's modules are emitted: as lowered.
const debug = { main: -1, tests: false, dyn: true, tune: new Tune() }

/// Of build/image.so as lowered read it, the stamp, its linker and bytes; each store of it has a new random stamp, so
/// a file of the same stamp is the one decoded, which relink then continues.
let decoded: [u64, Linker, Bytes] | null = null
/// The Program relink last linked, the stamp of the image it left, and the program's version: a file of that stamp
/// holds all of it, which linking it again only pins.
let done: [Program, u64, u64] | null = null

/// Links p's modules, each compiled as o says, the objects and archives files, if cxx the sysroot's libc++,
/// and the C library's libunwind and compiler builtins into build/image.so, the one image of all that is built there,
/// which loads the C library, on macOS the system's with those and libc++ in it, and exports the entries of p's modules
/// mains. The image is kept (src/link/link.bob), and a build links only what it does not hold: each object is named
/// by what it is made of, `<what>@<version>`, a module by its bytecode, which has the ABIs of the modules it imports,
/// and its Bound, and monomorphized, `<path>^<abi>^O1@`, by its bytecode as such too, beside the one as lowered, its
/// symbols its own (unit), what it instances its local copies, so that programs share it, -tune specs of those per
/// module; a file by its bytes; an archive, which is linked for good, by its size and when it was written. A
/// monomorphized module is compiled by TPDE, or by LLVM as `<path>^<abi>^O2@` of the same version, which any build
/// keeps, at -O2, and with no level given where the image holds TPDE's, a build finding it unchanged. A release
/// build's is the object LLVM makes of it, `<path>^R@`, held as it is for executable, not linked, nor any file:
/// compiled as its program whole learns (learn), on x86-64 for x86-64-v2 unless baseline, and against builtin/ as it
/// is, its version of those too. An image that holds all and exports the entries is left as it is. Where the image
/// cannot take the link, or an archive it holds changed, all is linked anew, fresh. The image is written in place where
/// no other process has it, else under a name of its own, then renamed, as a running program may have the old one
/// mapped, or another build be reading it.
/// Of p's modules, those of the program of mains are linked (program); another is held as its bytecode alone,
/// `<path>^bc@<version>`, that no build checks it again.
/// Returns its path, or if pin that of a link to it of this process's, which the launcher removes, by which what the
/// process runs loads this build's image though another build replaces it; and the version of p's program, the hash of
/// the names of what it is linked from, TPDE's for LLVM's.
function image(p: Program, mains: i32[], files: string[], cxx: bool, pin: bool, o: Options, c = new Compile(),
	fresh = false): [string, u64] {
	const out = `${dir}/image.so`
	// What a process gone left, a copy <out>.<pid> or a pin <out>.<pid>.<n>.run, which keeps the image from being
	// written in place, is removed, unless another build was first; another name is of pid 0, kept.
	for (const f of glob(`${out}.*`)) {
		const pid = base(f).slice(base(out).length + 1, base(f).length)
		if (kill(atoi(pid), 0) != 0) {
			unlink(f)
		}
	}
	// The image continued, which is mapped and written of one descriptor, lest another build replace it in between:
	// in place if this build has it alone, which no run maps or is about to, by a pin, nor another build reads, but on
	// macOS, whose kernel kills who maps a signed file changed in place; else a copy, the image shared meanwhile.
	const old = if (fresh || !exists(out)) null else open(out, "r+")
	try {
		const alone = !mac && old != null && old.lock(false, false) && glob(`${out}.*.run`).length == 0
		if (old != null && !alone) {
			old.lock(true, true)
		}
		return relink(p, mains, files, cxx, pin, o, c, out, old, alone)
	} finally {
		old?.close()
	}
}

/// The image out, which image links of old, the image continued if not null, written in place if alone.
function relink(p: Program, mains: i32[], files: string[], cxx: bool, pin: bool, o: Options, c: Compile, out: string,
	old: File | null, alone: bool): [string, u64] {
	const lib = `${sysroot}/usr/lib`
	const d = decoded
	decoded = null
	const mapped = new Bytes(if (old != null) old.map() else "")
	let left = if (old != null) stamp(mapped, format.headers) else 0 as u64 // the stamp of the image as this leaves it
	const tmp = `${out}.${getpid()}`
	if (old != null && done != null && done![0] == p && done![1] == left) {
		return [if (pin) pinned(out, tmp) else out, done![2]]
	}
	const unchanged = old != null && d != null && left == d[0]
	const kept = if (unchanged) d![2] else mapped
	const l = if (unchanged) d![1] else new Linker(machine, format, kept)
	// The image's objects by the path they are of (home), of which evict looks for those of other ABIs.
	const held = new HashMap[string, string[]]()
	for (const h of l.objects()) {
		if (!held.has(home(h))) {
			held.set(home(h), [])
		}
		held.get(home(h))!.push(h)
	}
	const of = (name: string) => held.get(home(name)) ?? []
	const has = (name: string) => l.holds(key(name)).includes(name)
	// Whether the image lacks the object name; the others of keys, by default another version of it, are unlinked.
	const lacks = (name: string, keys = [key(name)]) => {
		for (const k of keys) {
			for (const h of l.holds(k).filter(h => h != name)) {
				l.remove(h)
			}
		}
		return !has(name)
	}
	// Of the other monomorphizations of the module at path than spec, the units of the oldest past -tune specs, unlinked.
	const evict = (path: string, spec: string) => {
		const others: string[] = []
		for (const h of of(`${path}^`)) {
			const at = indexOf(h, "^O", path.length)
			if (startsWith(h, `${path}^`) && at > 0 && h.slice(0, at) != spec && !others.includes(h.slice(0, at))) {
				others.push(h.slice(0, at))
			}
		}
		for (const i of 0 ... others.length - c.tuned.specs) {
			lacks("", [`${others[i]}^O1`, `${others[i]}^O2`])
		}
	}
	const compiler = compilerId()
	// Of each module's unit, <path>@<source>.<version>, or monomorphized <path>^<abi>^O1@<source>.<version>, which names
	// LLVM's of its code too, <path>^<abi>^O2@...; and the unit the program is linked from.
	const ms = program(p, mains, o.dyn)
	// Monomorphized, it is compiled as tuned; a release build's, <path>^R@..., as its program whole learns, as LLVM is
	// told, and against builtin/ as it is: of those too.
	const facts = if (c.release) learn(p, o, m => new LLVM(p.modules[m].path)) else new Facts()
	const learned = encode(c.tuned)
		+ (if (c.release) `${facts.names}${c.baseline}${c.mllvm}${ms.filter(m => builtin(p.modules[m].path)).map(m => abi(p, m))}`
		else "")
	const parts: string[] = []
	const bodies = new Bodies(p)
	for (const m of 0 ... p.modules.length - 1) {
		const path = p.modules[m].path
		const bc = if (p.modules[m].bc != "") p.modules[m].bc else write(p, m, compiler)
		const b = bound.get(path)?.bytes(path) ?? ""
		if (!ms.includes(m)) {
			// Not the program's: what a build links it from alone, <path>^bc@<version>, rather than check it again.
			const name = `${path}^bc@${fnv(bc + b)}`
			if (lacks(name)) {
				l.add(cached(new Object(name, machine.arch), bc, b))
			}
			continue
		}
		// Monomorphized, its code as mono made it and what it names, which the ABIs its bytecode has do not cover.
		const version = `@${p.modules[m].source}.${fnv(bc + b + (if (o.dyn) "" else `${signatures(p, m, bodies)}${learned}${facts.nounwind.get(m) ?? ""}`))}`
		const spec = symbolPath(p, m, o.dyn)
		const [fast, opt] = [`${spec}^O1${version}`, if (c.release) `${path}^R${version}` else `${spec}^O2${version}`]
		// LLVM's at -O2, or if the image holds it, or with no level given if it holds TPDE's of a command before, which
		// this finds unchanged; else TPDE's, as after an edit.
		const llvm = !o.dyn && (c.release || c.O2 || has(opt) || !c.O1 && has(fast) && !c.compiled.has(fast))
		parts.push(if (o.dyn) `${path}${version}` else fast)
		const wanted = if (llvm) opt else parts[parts.length - 1]
		// Monomorphized, the others of either backend, which define the same symbols.
		if (lacks(wanted, if (o.dyn) [path] else if (c.release) [`${path}^R`] else [`${spec}^O1`, `${spec}^O2`])) {
			if (!o.dyn && !c.release) {
				evict(path, spec)
			}
			if (clear != "") {
				stdout.write(`${clear}[${m + 1}/${p.modules.length}] compiling ${split(path, ": ")[0]}`)
			}
			l.add(unit(p, m, wanted, o, bc, b, llvm, c, facts))
			c.compiled.set(wanted, true)
		}
	}
	const cxxs: string[] = if (cxx) [`${lib}/libc++.a`, `${lib}/libc++abi.a`] else []
	const archives: string[] = []
	for (const f of if (c.release) []
		else [...files, ...(if (mac) [] else [...cxxs, `${lib}/libunwind.a`, `${lib}/libclang_rt.builtins.a`])]) {
		if (!endsWith(f, ".a")) {
			const bytes = readFile(f)
			const name = `${f}@${fnv(bytes)}`
			parts.push(name)
			if (lacks(name)) {
				l.add(format.read(name, bytes))
			}
			continue
		}
		// An object stands for the archive, whose members are linked as what they define is named.
		const info = stat(f)
		const name = `${f}@${info.modified}.${info.size}`
		parts.push(name)
		if (!has(name)) {
			if (old != null) {
				return image(p, mains, files, cxx, pin, o, c, true) // the continued image did not look in it
			}
			l.add(new Object(name, machine.arch))
		}
		archives.push(f)
	}
	// Each library as the loader finds it, and the file that has its exports: on macOS a text stub of the SDK's.
	const system = ["libSystem.B", "libc++.1", "libc++abi"]
	const libraries = if (mac) system.map(n => [`/usr/lib/${n}.dylib`, `${lib}/${n}.tbd`])
		else [["libc.so", `${lib}/libc.so`]]
	for (const [name, file] of libraries) {
		l.library(name, format.exports(file, readFile(file)))
	}
	for (const m of if (c.release) [] else mains) {
		l.export(exported(p, m, o.dyn, false))
		l.export(exported(p, m, o.dyn, true))
	}
	const changed = l.changed()
	let at = out // where the image is written
	if (changed) {
		// The archives' members, listed once a name is looked for in them that the image did not look for.
		l.lazily(() => {
			const all: [string[], () => Object throws CompileError][] = []
			for (const f of archives) {
				for (const [member, b, names] of members(f, mapFile(f))) {
					all.push([if (mac) names.map(named) else names, () => format.read(member, b)])
				}
			}
			return all
		})
		try {
			const linked = l.link()
			stamped(linked.bytes, format.headers)
			left = stamp(linked.bytes, format.headers)
			format.write(linked)
			const continued = linked.bytes == kept
			at = if (continued && alone) out else tmp
			const f = if (at == out) old! else if (continued) old!.copy(tmp, linked.bytes.length) else open(tmp, "w")
			store(f, linked.bytes)
			if (f != old) {
				f.close() // old once the pin is made, which a build sees
			}
		} catch (e: Stale) {
			return image(p, mains, files, cxx, pin, o, c, true)
		}
	}
	const own = if (pin) pinned(at, tmp) else out
	if (at != out) {
		rename(tmp, out)
	}
	sortBy(parts, (a, b) => a < b) // as a set, p's modules being in the order they were lowered in, another build's other
	done = [p, left, fnv(parts.join(" "))]
	return [own, done![2]]
}

/// What of an object's name relink finds the image's objects by: the path of the module or file it is of, up to a ^, or
/// to the @ before its version.
function home(name: string): string {
	const at = indexOf(name, "^")
	return name.slice(0, if (at >= 0) at else lastIndexOf(name, "@"))
}

let pins = 0 // made by pinned

/// A link to the image at, tmp.<n>.run, a run's own, which the launcher removes, each of this process its own, as runs
/// of it may be starting at once.
function pinned(at: string, tmp: string): string {
	pins++
	const own = `${tmp}.${pins}.run`
	if (exists(own)) {
		remove(own) // which a process of this ID left, whose launcher never ran
	}
	if (hardLink(at, own) != 0) {
		throw new CompileError(`cannot link ${own}`)
	}
	return own
}

/// Module m of p, compiled by TPDE, or if llvm by LLVM, as o says, as the object name. It defines a symbol named by
/// its ABI, and names those of the modules it imports and of builtin/'s, whose functions the compiler calls unasked,
/// so that a kept image unlinks it once one of them has another: an object another program left there, or after a
/// change of builtin/, which no bytecode names. It holds bc, its bytecode as lowered, in section bober_bc,
/// which a build links rather than checks the module of (lowered), and its Bound, if any (src/lift.bob), in bober_bind.
/// Monomorphized, its names but local ones end in monoSuffix, as the module as lowered has the same ones of other
/// layouts and calling conventions: bober's, which have a . or :, unlike C's. A release build's, compiled as facts
/// say, holds but those two and the object file LLVM made, in bober_obj, which executable links.
function unit(p: Program, m: i32, name: string, o: Options, bc: string, bound: string, llvm: bool, f: Compile,
	facts: Facts): Object {
	const path = p.modules[m].path
	const b: Backend = if (llvm) new LLVM(path, 2, f.release && !f.baseline) else new Tpde(path)
	emit(p, m, b, o, facts)
	if (llvm) {
		b.verify() // TPDE's object does
	}
	const bytes = b.object()
	b.dispose()
	if (f.release) {
		return cached(new Object(name, machine.arch), bc, bound, bytes)
	}
	const x = if (llvm) format.read(name, bytes) else elf.read(name, bytes)
	for (const s of x.sections) {
		s.group = "" // LLVM's of the personality's pointer, each object's own, as a kept image cannot move it
	}
	cached(x, bc, bound)
	x.sections.push(new Section(".rodata", Const))
	x.symbols.push(new Symbol(abiSymbol(p, m), Global, x.sections.length - 1))
	for (const d of 0 ... p.modules.length - 1) {
		if (d != m && (builtin(p.modules[d].path) || p.modules[m].deps.includes(d))) {
			x.symbols.push(new Symbol(abiSymbol(p, d), Global, -1))
		}
	}
	for (const s of x.symbols.filter(s => !o.dyn && s.binding != Local
		&& (indexOf(s.name, ".") >= 0 || indexOf(s.name, ":") >= 0))) {
		s.name += monoSuffix
	}
	return x
}

/// x, holding a module's bytecode as lowered bc in section bober_bc, its Bound, if any, in bober_bind, and the object
/// file made of it, if any, in bober_obj.
function cached(x: Object, bc: string, bound: string, made = ""): Object {
	for (const [n, bytes] of [["bober_bc", bc], ["bober_bind", bound], ["bober_obj", made]]) {
		if (bytes != "") {
			const s = new Section(n, Kept)
			s.bytes = bytes
			s.size = bytes.length as u64
			x.sections.push(s)
		}
	}
	return x
}

/// The executable of main, or of its tests, of p's program of mains, a release build's, build/<name> or
/// build/<name>.test: linked, as ld does, of the object file that the image at, this build's own link to it, removed
/// once read, holds of each of its modules, of files, and of a C main calling the entry.
function executable(p: Program, mains: i32[], files: string[], at: string, main: string, tests: bool): string {
	const exe = `${dir}/${name(main)}${if (tests) ".test" else ""}`
	const b = new LLVM(exe)
	const t = b.fn(b.int(32), [b.int(32), b.ptr()])
	const f = b.function("main", t, false)
	b.at(b.block(f))
	b.ret(b.call(t, b.function(entry(p, p.module(normal(main)), false, tests), t, false),
		[b.param(f, 0), b.param(f, 1)]))
	const objects = [`${exe}.o`]
	b.emit(objects[0], false)
	const l = new Linker(machine, format, new Bytes(mapFile(at)))
	for (const m of program(p, mains, false)) {
		objects.push(`${exe}.${m}.o`)
		save(objects[objects.length - 1], l.sections("bober_obj", `${p.modules[m].path}^R@`)[0])
	}
	remove(at)
	ld([...objects, ...files], exe)
	return exe
}

/// What the names of a monomorphized unit end in (unit).
const monoSuffix = "^mono"

/// The name the image exports the entry of p's module m as (entry).
function exported(p: Program, m: i32, dyn: bool, tests: bool): string {
	return entry(p, m, dyn, tests) + (if (dyn) "" else monoSuffix)
}

/// The symbol named by the ABI of p's module m.
function abiSymbol(p: Program, m: i32): string { return `bober.abi.${p.modules[m].path}.${abi(p, m)}` }

/// The objects of the glue of p's modules ms of C headers but the bundle's, of source hash 0, compiled with includes
/// and those of the packages of these modules, and all C libraries of each package one of whose headers it imports,
/// which lld takes in any order, and of which it links what it uses; and whether one is CMake's, and so C++.
function cObjects(p: Program, ms: i32[], includes: string[]): [string[], bool] {
	const packages: [string, string[]][] = []
	const headers: string[] = []
	const cIncludes = includes.slice(0, includes.length)
	for (const m of ms.map(m => p.modules[m]).filter(m => m.source != 0)) {
		const path = split(m.path, ": ")[0]
		if (startsWith(path, `${sysroot}/`)) {
			continue
		}
		if (path != m.path) {
			headers.push(path)
		}
		const d = nearest(path)
		if (d != null && !packages.some(e => e[0] == d)) {
			packages.push([d, includesOf(path, [])])
			cIncludes.push(...packages[packages.length - 1][1])
		}
	}
	const libs: string[] = []
	let cxx = false
	for (const m of ms) {
		const c = if (p.modules[m].source == 0) null else glued(p, m, cIncludes)
		if (c != null) {
			libs.push(c)
		}
	}
	for (const [d, dirs] of packages) {
		if (!headers.some(h => dirs.some(i => startsWith(h, `${i}/`)))) {
			continue
		}
		const p = load(d)
		for (const [name, c] of p.c) {
			if (c.cmake.version > 0) {
				cxx = true
				const listed = split(readFile(`${out(p.name, name)}/libs`), "\n").filter(l => l != "")
				libs.push(...listed)
			} else if (c.sources.length > 0) {
				libs.push(archive(c, out(p.name, name), join(d, "bober.pkg"), dirs))
			}
		}
	}
	return [libs, cxx]
}

/// The bundle command, which dist.sh runs in the repo: writes the bundle of builtin/'s and std/'s modules, lowered
/// from source, to lib/std.bobc (src/lift.bob), and so for WebAssembly to lib/wasm.bobc and for JavaScript to
/// lib/js.bobc, which all must check for, with their host, lib/host.mjs; and compiles the C they link into lib: the run
/// time's objects, the archive std.a of their glue, and their C libraries' archives.
function pack(lib: string) {
	const paths = [...glob("std/**/*.bob"), ...glob("builtin/*.bob")].filter(f => !endsWith(f, ".test.bob"))
	const p = lower(paths)
	mkdirAll(lib)
	runtime(lib)
	network(lib)
	launcher(lib)
	const cs = cObjects(p, program(p, [], true), [])[0]
	run(["ar", "rcs", join(lib, "std.a"), ...cs.filter(c => endsWith(c, ".o"))])
	for (const a of cs.filter(c => endsWith(c, ".a"))) {
		save(join(lib, base(a)), readFile(a))
	}
	save(join(lib, "std.bobc"), bundle(p, compilerId()))
	save(join(lib, "wasm.bobc"), bundle(lower(paths, [], [], targetSource(false)), compilerId()))
	save(join(lib, "js.bobc"), bundle(lower(paths, [], [], targetSource(true)), compilerId()))
	save(join(lib, "host.mjs"), readFile("builtin/wasm/host.mjs"))
}

/// The run time's objects, src/rt.c's, src/gc.c's, src/fiber.c's, src/io.c's and src/type.c's of bober's root, compiled
/// by bobcc into out where older than their source or src/rt.h.
export function runtime(out: string): string[] {
	const objects: string[] = []
	for (const c of ["rt", "gc", "fiber", "io", "type"]) {
		const o = `${out}/${c}.c.o` // not a program's, out/<name>.o
		const src = join(root, `src/${c}.c`)
		if (!newer(o, [src, join(root, "src/rt.h")])) {
			object(sysroot, src, o, [])
		}
		objects.push(o)
	}
	return objects
}

/// The network of tests, src/net.c of bober's root on vendor/lwip, compiled by bobcc into out/net where older than their
/// source or headers of src/.
function network(out: string): string[] {
	const lwip = join(root, "vendor/lwip/src")
	const headers = ["src/rt.h", "src/net.h", "src/net/lwipopts.h", "src/net/arch/cc.h"].map(h => join(root, h))
	mkdirAll(`${out}/net`)
	return [join(root, "src/net.c"), ...glob(`${lwip}/core/**/*.c`)].map(src => {
		const o = `${out}/net/${base(src)}.o`
		if (!newer(o, [src, ...headers])) {
			object(sysroot, src, o, [join(root, "src"), join(root, "src/net"), `${lwip}/include`])
		}
		return o
	})
}

/// The launcher of images, src/launch.c of bober's root, compiled by bobcc into out/launch.c.exe where older than its
/// source.
function launcher(out: string): string {
	const exe = `${out}/launch.c.exe`
	const src = join(root, "src/launch.c")
	if (!newer(exe, [src])) {
		object(sysroot, src, `${exe}.o`, [])
		if (link(sysroot, [`${exe}.o`], exe, "pie") != 0) {
			throw new CompileError(`cannot link ${exe}`)
		}
		remove(`${exe}.o`) // which a package's programs would link, as the rest of lib/
	}
	return exe
}

/// The archive out.a of c's sources, each compiled into out, with c's private headers and those of includes, where
/// older than it, or all where pkg, its bober.pkg, or a header of c's is newer than the archive, by bobcc.
function archive(c: CLib, out: string, pkg: string, includes: string[]): string {
	const a = `${out}.a`
	const skip = globs(c.exclude)
	const all = !newer(a, [pkg, ...globs([...c.include, ...c.private].map(d => `${d}/**/*.h`))])
	const dirs = [...c.private, ...includes]
	const objects: string[] = []
	for (const s of globs(c.sources).filter(s => !skip.includes(s))) {
		const o = `${out}/${rel(c.src as string, s)!}.o`
		// newer first, that made has s though all be compiled
		if (!newer(o, [s]) || all) {
			mkdirAll(parent(o))
			object(sysroot, s, o, dirs, c.defines)
		}
		objects.push(o)
	}
	if (!newer(a, objects)) {
		if (exists(a)) {
			remove(a)
		}
		run(["ar", "rcs", a, ...objects])
	}
	return a
}

/// Builds and installs each CMake project of the package p in h into its out in home's build/, listing the static
/// libraries it installs in out/libs, unless its stamp is what it was last: its entry in p, its patches and toolchain
/// files, the stamps of those of p before it and the files of its src if a directory, by their contents, not times,
/// which a checkout or a cache resets; a file's hash taken from o/hashes where its time and size are as recorded there
/// and older than it, as git's index. Its src, copied or fetched with its hash checked to out/src, patched, and
/// configured afresh with its preset "bober" and toolchain file, finding those of p before it, in out/build, which is
/// kept, as the archive fetched.
function cmake(h: string) {
	const [at, cwd] = [dir, fromCString(getcwd(0, 0))]
	dir = "build" // though a test builds elsewhere
	const p = load(h)
	const before: string[] = []
	for (const [name, c] of p.c) {
		if (c.cmake.version == 0) {
			continue
		}
		const o = out(p.name, name)
		const tools = toolchain(c, cwd)
		const src = c.src
		const files = if (src instanceof string) glob(`${src}/**/*`).filter(f => !stat(f).isDirectory) else []
		const sides = `${o}/hashes`
		const t = if (exists(sides)) stat(sides).modified else 0
		const last = new HashMap[string, string]()
		for (const l of split(if (t > 0) readFile(sides) else "", "\n")) {
			const i = lastIndexOf(l, " ")
			if (i >= 0) {
				last.set(l.slice(0, i), l.slice(i + 1, l.length))
			}
		}
		// Per file, its path, its time and size, and its hash.
		const hashed = files.map(f => {
			const s = stat(f)
			const k = `${s.modified} ${s.size}`
			return [f, k, (if (s.modified < t) last.get(`${f} ${k}`) else null) ?? `${fnv(mapFile(f))}`]
		})
		made.push(...[...files, ...c.patches, c.toolchain].filter(f => f != "").map(f => under(cwd, f)))
		mkdirAll(o)
		const tmp = `${sides}.${getpid()}` // its own, as another bober may be at it too
		save(tmp, hashed.map(h => `${h[0]} ${h[1]} ${h[2]}\n`).join(""))
		rename(tmp, sides) // whole, if at all
		const entry = encode(src) + encode(c.cmake) + c.patches.map(x => readFile(x)).join("")
			+ (if (c.toolchain == "") "" else readFile(c.toolchain)) + tools
			+ before.map(b => `${b} ${fnv(readFile(`${b}/stamp`))}\n`).join("")
			+ hashed.map(h => `${h[0]} ${h[2]}\n`).join("")
		const prefixes = before.map(b => `${cwd}/${b}`).join(";")
		before.push(o)
		if (exists(`${o}/stamp`) && readFile(`${o}/stamp`) == entry) {
			continue
		}
		// Gone while it builds, so that the stamps of a build cut short tell, as CI keys its cache by them.
		if (exists(`${o}/stamp`)) {
			remove(`${o}/stamp`)
		}
		let root = `${o}/src`
		if (exists(root)) {
			removeAll(root)
		}
		if (src instanceof string) {
			run(["cmake", "-E", "copy_directory", src, root])
		} else {
			// Its one directory as out/src, the same for any URL.
			const url = split(src[0], "#")
			save(`${o}/fetch.cmake`,
				`file(DOWNLOAD "${url[0]}" "${o}/src.tar" EXPECTED_HASH SHA256=${src[1]})
file(ARCHIVE_EXTRACT INPUT "${o}/src.tar" DESTINATION "${o}/fetch")`)
			run(["cmake", "-P", `${o}/fetch.cmake`])
			rename(glob(`${o}/fetch/*`)[0], root)
			if (url.length > 1) {
				root = join(root, url[1])
			}
		}
		for (const x of c.patches) {
			run(["patch", "-s", "-p1", "-d", root, "-i", under(cwd, x)])
		}
		const preset = [...c.cmake.fields.map(e => `${quoted(e[0])}:${e[1].text}`), `"name":"bober"`,
			`"generator":"Ninja"`]
		save(`${root}/CMakeUserPresets.json`,
			`{"version":${c.cmake.version},"configurePresets":[{${preset.join(",")}}]}`)
		save(`${o}/toolchain.cmake`, tools)
		mkdirAll(`${o}/build/.cmake/api/v1/query`)
		save(`${o}/build/.cmake/api/v1/query/codemodel-v2`, "")
		run(["cmake", "-S", root, "-B", `${o}/build`, "--fresh", "--preset", "bober", "--toolchain",
			`${cwd}/${o}/toolchain.cmake`, `-DCMAKE_PREFIX_PATH=${prefixes}`])
		run(["cmake", "--build", `${o}/build`])
		run(["cmake", "--install", `${o}/build`, "--prefix", o])
		save(`${o}/libs`, installed(o).join("\n"))
		save(`${o}/stamp`, entry)
	}
	dir = at
}

/// A target of a CMake project, as its file API describes it.
class Target {
	type: string = ""
	artifacts: Artifact[] = []
	install: Install = new Install()
	rest: Unknown[] @Rest = []
}

class Install {
	destinations: Artifact[] = []
	rest: Unknown[] @Rest = []
}

class Artifact {
	path: string = ""
	rest: Unknown[] @Rest = []
}

/// The static libraries the CMake project built in o/build installs into o, as its file API tells.
function installed(o: string): string[] {
	const libs: string[] = []
	for (const f of glob(`${o}/build/.cmake/api/v1/reply/target-*.json`)) {
		let t = new Target()
		try {
			t = decodeJson[Target](readFile(f))
		} catch (e: ParseError) {
			throw new CompileError(`${f}: ${e.kind} error at byte ${e.at}`)
		}
		if (t.type == "STATIC_LIBRARY") {
			libs.push(...t.install.destinations.map(d => join(o, d.path, base(t.artifacts[0].path))))
		}
	}
	return libs
}

/// The paths that match any of patterns.
function globs(patterns: string[]): string[] {
	const out: string[] = []
	for (const p of patterns) {
		out.push(...glob(p))
	}
	return out
}

/// Whether the file at path exists and is newer than each of sources and the compiler, which may make it otherwise, so
/// that it need not be made again.
function newer(path: string, sources: string[]): bool {
	made.push(...sources.filter(s => !startsWith(s, `${dir}/`))) // not what builds made
	if (!exists(path)) {
		return false
	}
	const t = stat(path).modified
	for (const s of [process.executable(), ...sources]) {
		if (stat(s).modified >= t) {
			return false
		}
	}
	return true
}

/// The object of the C that defines the static functions of module m of p, if a C header's module, whose path is the header's and
/// the names imported (src/check.bob, Modules.header), or null. Its files are named by the header's name and a hash of the
/// module's path, as the names would make too long a file name, and a hash of its C, which names the compiler and the
/// headers as bound, that it is compiled again only once that changed.
function glued(p: Program, m: i32, includes: string[]): string | null {
	const path = p.modules[m].path
	const at = indexOf(path, ": ")
	if (at < 0) {
		return null
	}
	const header = path.slice(0, at)
	const c = glue(header, p.modules[m].decls.map(d => p.strings[p.decls[d].name]))
	if (c == "") {
		return null
	}
	const f = `${dir}/${base(header)}.${fnv(path)}`
	const text = `// ${compilerId()} ${fnv(bound.get(path)?.bytes(path) ?? "")} ${includes.join(" ")}\n${c}`
	const o = `${f}.${fnv(text)}.o`
	if (!exists(o)) {
		const tmp = `${o}.${getpid()}` // its own, as another bober may be at it too
		save(`${tmp}.c`, text)
		object(sysroot, `${tmp}.c`, tmp, [".", ...includes])
		remove(`${tmp}.c`)
		rename(tmp, o)
	}
	return o
}

/// The executable's name for main: its file's, without .bob or .test.bob.
function name(main: string): string {
	let n = main
	for (const suffix of [".bob", ".test"]) {
		if (endsWith(n, suffix)) {
			n = n.slice(0, n.length - suffix.length)
		}
	}
	let i = n.length
	while (i > 0 && n[i - 1] != 0x2f) {
		i--
	}
	return n.slice(i, n.length)
}

function save(path: string, s: string) {
	if (!writeFile(path, s)) {
		throw new CompileError(`cannot write ${path}`)
	}
}

/// Runs argv; throws if it fails.
function run(argv: string[]) {
	if (process.run(argv) != 0) {
		throw new CompileError(`failed: ${argv.join(" ")}`)
	}
}
