//! bober, the compiler's driver. Paths are relative to the directory it runs in; its own files are in its root
//! (src/root.bob). It runs as build/bober, built by itself or bootstrapped by build/boot (boot/README.md), or as the
//! bin/bober of the package dist.sh makes.
//!
//! # Introduction
//!
//! Bober is a statically typed, compiled language with the surface of TypeScript and the object layout of C. This spec
//! defines its syntax and semantics; the standard library, which defines `Trap` (§7.7) and `process`, is specified
//! elsewhere. Grammar is given in `grammar` blocks, examples in plain ones.
//!
//! An implementation shall reject a program that violates a rule stated with *shall* with a diagnostic, except noted
//! otherwise. A *trap* stops the isolate that hits it (§7.7); it cannot be caught. A *throw* is an exception a `try`
//! can catch. *implementation-defined* behavior is chosen by the implementation; a program shall not depend on
//! implementation-defined behavior.

import { endsWith, indexOf, lastIndexOf, sortBy, startsWith } from "../std/algo"
import { fromCString } from "../std/c"
import { Keys, Rest, Unknown, decode as decodeJson, encode, quoted } from "../std/encoding/json"
import * as yaml from "../std/encoding/yaml"
import * as optarg from "../std/encoding/optarg"
import { exists, glob, mapFile, mkdirAll, open, readDir, readFile, remove, removeAll, rename, stat } from "../std/fs"
import { base, dir as parent, isAbs, join, rel } from "../std/fs/path"
import { HashMap } from "../std/collections/hashmap"
import { combine, fnv } from "../std/hash"
import { File, stderr, stdin, stdout } from "../std/io"
import { arch, os } from "../std/os"
import { ParseError, codePoint, split, trim, utf8 } from "../std/string"
import { abi, version, write } from "./bc/file"
import * as decl from "./bc/decl"
import * as kind from "./bc/kind"
import { Program } from "./bc/program"
import { show } from "./bc/show"
import { glue, includesOf, sysroot } from "./c/bind"
import { link, object } from "./c/bobcc"
import { doc } from "./doc"
import { Facts, Options, emit, entry, learn, listed } from "./emit"
import { check, normal } from "./check"
import { CompileError } from "./error"
import { formatFile } from "./format"
import { LLVM, triple } from "./backend/llvm"
import { Tpde } from "./backend/tpde"
import { Bound, bound, bundle, compilerId } from "./lift"
import { members } from "./link/ar"
import { arm64 } from "./link/arm64"
import { elf } from "./link/elf"
import { macho, named } from "./link/macho"
import { pe } from "./link/pe"
import { x64 } from "./link/x64"
import { Bytes, store } from "./link/bytes"
import { stamp, stamped } from "./link/keep"
import { Linker, Stale } from "./link/link"
import { Code, Const, Global, Kept, Object, Over, Section, Symbol } from "./link/object"
import { SyntaxError } from "./lex"
import { lower } from "./lower"
import { serve } from "./lsp"
import { mono, specialize } from "./mono"
import { Parser } from "./parse"
import { builtin, root } from "./root"
import { CLib, Package, load, nearest, out } from "./pkg"
import * as process from "../std/process"
import { chdir, getcwd, getpid, isatty, link as hardLink } from "unistd.h"

/// What a command line gives bober, spelled as a C compiler's: these options anywhere on it, a command's after the
/// command; their docs are bober's help.
class Flags @optarg.Cc {
	/// print help
	h: bool = false
	/// with help or -h, print all of it
	v: bool = false
	/// The command and its arguments.
	command: Command | null @optarg.Rest = null
}

type Command = Run | Test | Check | Format | Init | Help | Build | Bundle | Lower | Doc | Lsp

/// The options of the commands that read C headers.
class Headers @optarg.Cc {
	/// add a directory of C headers
	I: string[] @optarg.Verbose = []
}

/// The options of the commands that build a program.
export class Compile @optarg.Cc {
	headers: ...Headers
	/// optimize with LLVM
	release: bool = false
	/// monomorphize first, so that it runs fast; by default where CI is set
	O1: bool @optarg.Verbose = process.env("CI") != null
	/// LLVM compiles the instances of generics and each module's functions over their code: runs fast, slow to compile
	O2: bool @optarg.Verbose = false
	/// each module as it is, fastest to compile, though CI is set; -O2 counts over it
	O0: bool @optarg.Verbose = false
}

/// build a program and run it
class Run @optarg.Cc {
	compile: ...Compile
	args: string[] @optarg.Rest = []
}

/// run a file's tests, or each file's here and below
class Test @optarg.Cc {
	compile: ...Compile
	args: string[] @optarg.Rest = []
}

/// report type errors and lint
class Check @optarg.Cc {
	headers: ...Headers
	args: string[] @optarg.Rest = []
}

/// rewrite files in their one layout
class Format @optarg.Cc {
	args: string[] @optarg.Rest = []
}

/// write a bober.pkg here
class Init @optarg.Cc {
	args: string[] @optarg.Rest = []
}

/// print help
class Help {}

/// link the package's image, or with -o one module's object; for CI
class Build @optarg.Cc @optarg.Verbose {
	compile: ...Compile
	/// the object to write
	o: string = ""
	args: string[] @optarg.Rest = []
}

/// write builtin/ and std/ as the lib/ of bober's package
class Bundle @optarg.Cc @optarg.Verbose {
	args: string[] @optarg.Rest = []
}

/// print the bytecode of files
class Lower @optarg.Cc @optarg.Verbose {
	headers: ...Headers
	args: string[] @optarg.Rest = []
}

/// print the spec in files' doc comments as Markdown
class Doc @optarg.Cc @optarg.Verbose {
	args: string[] @optarg.Rest = []
}

/// serve the language server protocol on stdin and stdout
class Lsp @optarg.Cc @optarg.Verbose {
	headers: ...Headers
}

/// The help of command c, else of all, all of it if verbose.
function usage(c: Command | null, verbose: bool): string {
	for (const M of Command.members) {
		if (c instanceof M) {
			return [M.doc, optarg.help[M](verbose)].filter(l => l != "").join("\n")
		}
	}
	return `usage: bober <command> [args]\n${optarg.help[Command](verbose)}\noptions:\n${optarg.help[Flags](verbose)}`
}

export let dir = "build"
/// The machine and the format of the images src/link writes here; TPDE's objects are ELF everywhere.
export const machine = if (arch == "arm64") arm64 else x64
const mac = os == "macos"
export const format = if (mac) macho else if (os == "windows") pe else elf

/// Links the objects and linker options args into the executable out by bobcc's link, with libc++ for C++ libraries:
/// folding identical code, with a build ID on ELF (compilerId); throws a CompileError if it fails.
export function ld(args: string[], out: string) {
	const flags = if (os == "macos") ["-lc++"] else ["--build-id", "-lc++", "-lc++abi"]
	if (link(sysroot, ["--icf=all", ...args, ...flags], out) != 0) {
		throw new CompileError(`cannot link ${out}`)
	}
}

/// The CMake toolchain file of C library c, built in cwd: bober's defaults for the target, its triple, the sysroot and on
/// ELF static executables, with the compilers CMake finds, run by ccache if found with paths under cwd made relative,
/// so that checkouts share hits, and so without precompiled headers, then c's toolchain file, which may override them.
const toolchain = (c: CLib, cwd: string) => `set(CMAKE_C_COMPILER_TARGET ${triple})
set(CMAKE_CXX_COMPILER_TARGET ${triple})
set(CMAKE_ASM_COMPILER_TARGET ${triple})
${if (os == "macos") `set(CMAKE_OSX_SYSROOT "${sysroot}")` else `set(CMAKE_SYSROOT "${if (isAbs(sysroot)) "" else cwd + "/"}${sysroot}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")`}
find_program(CCACHE ccache)
if(CCACHE)
	set(CMAKE_C_COMPILER_LAUNCHER \${CCACHE} "base_dir=${cwd}")
	set(CMAKE_CXX_COMPILER_LAUNCHER \${CCACHE} "base_dir=${cwd}")
	set(CMAKE_DISABLE_PRECOMPILE_HEADERS ON)
endif()
${if (c.toolchain == "") "" else `include("${cwd}/${c.toolchain}")\n`}`

function main(): i32 {
	const argv = args()
	let f = new Flags()
	try {
		f = optarg.decode[Flags](argv)
	} catch (e: ParseError) {
		print(`bad argument ${argv[e.at]}`)
		return 2
	}
	const c = f.command
	if (f.h || c instanceof Help) {
		print(usage(if (c instanceof Help) null else c, f.v))
		return 0
	}
	if (c == null) {
		print(usage(null, false))
		return 2
	}
	try {
		return command(c)
	} catch (e: CompileError | IoError) {
		print(if (e instanceof IoError) e.message() else e.msg)
		return 1
	}
}

/// Runs command c; returns the exit status or throws a CompileError or IoError.
function command(c: Command): i32 {
	switch (c) {
		case Test:
			if (c.args.length == 0) {
				return testAll(c.compile)
			}
			const [status, report] = runTests(c.args[0], c.args.slice(1, c.args.length), c.compile)
			stdout.write(yamlOf(report))
			return status
		case Build:
			if (process.env("CI") == null) {
				stderr.write("warning: build is for CI; run and test build what they need\n")
			}
			if (c.args.length == 0) {
				buildPackage(c.compile.headers.I)
			} else if (c.o == "") {
				throw new CompileError("build <file.bob> takes -o <out>")
			} else {
				inspect(c.args[0], c.o, c.compile.headers.I, c.compile.release)
			}
			return 0
		case Run: if (c.args.length > 0) {
			return process.run([...build(c.args[0], false, c.compile, true), ...c.args.slice(1, c.args.length)])
		}
		case Check: if (c.args.length > 0) {
			let status = 0
			for (const e of check(c.args, c.headers.I)) {
				print(`${e.path}:${e.line}:${e.col}: ${if (e.warning) "warning: " else ""}${e.msg}`)
				status = if (e.warning) status else 1
			}
			return status
		}
		case Format: if (c.args.length > 0) {
			let status = 0
			for (const path of c.args) {
				try {
					formatFile(path)
				} catch (e: CompileError) {
					print(e.msg)
					status = 1
				}
			}
			return status
		}
		case Doc: if (c.args.length > 0) {
			print(doc(c.args))
			return 0
		}
		case Lsp:
			serve(c.headers.I)
			return 0
		case Init:
			init(if (c.args.length == 0) "" else c.args[0])
			return 0
		case Bundle: if (c.args.length > 0) {
			pack(c.args[0])
			return 0
		}
		case Lower: if (c.args.length > 0) {
			const p = lower(c.args, c.headers.I)
			for (const path of c.args) {
				print(show(p, p.module(normal(path))))
			}
			return 0
		}
	}
	print(usage(c, false))
	return 2
}

/// Writes bober.pkg in the directory it runs in, of the package name, else the one asked for on a terminal, else
/// @local/<the directory's name>.
function init(name: string) {
	if (exists("bober.pkg")) {
		throw new CompileError("bober.pkg exists")
	}
	let n = name
	if (n == "") {
		n = `@local/${base(fromCString(getcwd(0, 0)))}`
		if (isatty(0) != 0) {
			stdout.write(`name (${n}): `)
			let line = ""
			let c = stdin.read(1)
			while (c != null && c != "\n") {
				line += c
				c = stdin.read(1)
			}
			if (trim(line) != "") {
				n = trim(line)
			}
		}
	}
	const parts = split(n, "/")
	if (parts.length != 2 || parts[0].length < 2 || parts[1] == "" || !startsWith(n, "@")) {
		throw new CompileError(`${n} is not @namespace/name`)
	}
	save("bober.pkg", `{\n\t"name": ${quoted(n)}\n}\n`)
}

/// Runs the tests of testFiles(".") as test without main.bob prints them; 0 if all passed. A failed file's YAML starts
/// with a line for each of its directories, of which those the last failed file printed are left out.
function testAll(f: Compile): i32 {
	const files = testFiles(".")
	const clear = if (isatty(1) != 0) "\r\x1b[K" else ""
	let dirs: string[] = [] // of the last failed file
	let failed = 0
	for (const i of 0 ... files.length - 1) {
		if (clear != "") {
			stdout.write(`${clear}[${i + 1}/${files.length}] ${files[i]}`)
		}
		const [s, report] = runTests(files[i], [], f)
		if (s != 0) {
			const parts = split(files[i], "/")
			const lines = split(yamlOf(parts.map(p => `{${quoted(p)}:`).join("") + report
				+ parts.map(p => "}").join("")), "\n")
			let k = 0
			while (k < dirs.length && k < parts.length - 1 && dirs[k] == parts[k]) {
				k++
			}
			stdout.write(clear + lines.slice(k, lines.length).join("\n"))
			dirs = parts.slice(0, parts.length - 1)
			failed++
		}
	}
	stdout.write(`${clear}# ${files.length - failed} of ${files.length} files passed\n`)
	return if (failed == 0) 0 else 1
}

/// The files that have tests in d and below, but in build/, hidden directories and builtin/, which no program tests.
function testFiles(d: string): string[] {
	const files: string[] = []
	const es = readDir(d)
	sortBy(es, (a, b) => a.name < b.name)
	for (const e of es) {
		const p = join(d, e.name)
		if (e.isDirectory && e.name != "build" && !startsWith(e.name, ".")) {
			files.push(...testFiles(p))
		} else if (endsWith(e.name, ".bob") && !builtin(p) && hasTests(p)) {
			files.push(p)
		}
	}
	return files
}

/// The report, JSON, as YAML, each byte of it not UTF-8, which YAML cannot hold, as U+FFFD.
function yamlOf(report: string): string {
	let s = ""
	let i = 0
	while (i < report.length) {
		const [c, end] = codePoint(report, i)
		s += if (c == 0xfffd) utf8(c) else report.slice(i, end)
		i = end
	}
	try {
		return yaml.emit(yaml.documents(s))
	} catch (e: ParseError | yaml.EncodeError) {
		return s + "\n" // not a report
	}
}

/// Builds the program of main with its tests and runs them with args: its exit status, and its report, the JSON object
/// src/rt.c prints, ended by the exit status if a crash cut it off, or else what failed as a JSON string.
function runTests(main: string, args: string[], f: Compile): [i32, string] {
	try {
		const out = `${dir}/${name(main)}.test.log`
		const status = process.run([...build(main, true, f, true), ...args], out)
		const report = trim(readFile(out))
		// A crash cuts the report off after the key of the test it was in.
		for (const r of [report, `${report}${quoted(`exit ${status}`)}}`]) {
			try {
				decodeJson[Keys](r)
				return [status, r]
			} catch (e: ParseError) {}
		}
		return [if (status == 0) 1 else status, quoted(trim(`${report}\nexit ${status}`))]
	} catch (e: CompileError | IoError) {
		return [1, quoted(if (e instanceof IoError) e.message() else e.msg)]
	}
}

/// Whether the file at path declares a test, or does not parse, which its test run then reports.
function hasTests(path: string): bool {
	const p = new Parser(readFile(path))
	try {
		let t = p.parse()
		while (t != null && t.kind != "test") {
			t = p.parse()
		}
		return t != null
	} catch (e: SyntaxError) {
		return true
	}
}

/// Compiles the program of main into the executable build/<name>, or with tests build/<name>.test, all as one,
/// monomorphized, by LLVM, optimized, if release, else into the image, each module by TPDE, fast to compile: as
/// lowered, or at -O1 monomorphized for the program; -O2 counts over -O0, -O0 over -O1. Returns the command that runs
/// it, or its tests: the executable, or the launcher on the image's entry, run by the C library's loader where it is
/// the sysroot's, the image as image has it if pin. Throws the errors, or what failed, as a CompileError or IoError.
export function build(main: string, tests: bool, f: Compile, pin: bool): string[] {
	const p = lowered([main], f.headers.I)
	const m = p.module(normal(main))
	const [files, cxx] = linked(p, tests, f.headers.I)
	if (!f.release) {
		const o = { main: -1, tests: false, dyn: !f.O1 || f.O2 || f.O0 }
		if (!o.dyn) {
			mono(p, m)
		}
		return [...(if (mac) [] else [`${sysroot}/usr/lib/libc.so`]),
			if (packaged()) join(root, "lib/launch.c.exe") else launcher(dir),
			image(p, [m], files, cxx, pin, o, if (f.O2) specialize(p) else null),
			entry(p.modules[m].path, tests)]
	}
	const exe = `${dir}/${name(main)}${if (tests) ".test" else ""}`
	const o = { main: m, tests: tests, dyn: false }
	mono(p, m)
	const whole = new LLVM(main)
	const facts = learn(p, o, m => new LLVM(p.modules[m].path))
	for (const m of 0 ... p.modules.length - 1) {
		const b = new LLVM(p.modules[m].path)
		emit(p, m, b, o, facts)
		b.verify() // which also finishes it, before it is linked
		whole.link(b)
	}
	whole.emit(`${exe}.o`, false)
	ld([`${exe}.o`, ...files], exe)
	return [exe]
}

/// The build command on no file: in the nearest bober.pkg's directory, links the modules of it and below, but those of
/// build/, hidden directories, builtin/ and other packages, into the image, with their tests' network, exporting their
/// entries; so that run and test of one there link little.
function buildPackage(includes: string[]) {
	const home = nearest(join(fromCString(getcwd(0, 0)), "bober.pkg"))
	if (home == null || chdir(home!) != 0) {
		throw new CompileError("no bober.pkg here or above")
	}
	const mains = sources(".")
	const p = lowered(mains, includes)
	const [files, cxx] = linked(p, true, includes)
	image(p, mains.map(m => p.module(normal(m))), files, cxx, false, debug)
}

/// The .bob files of d and below that buildPackage links.
function sources(d: string): string[] {
	const files: string[] = []
	for (const e of readDir(d)) {
		const p = join(d, e.name)
		if (!e.isDirectory) {
			if (endsWith(e.name, ".bob") && !builtin(p)) {
				files.push(p)
			}
		} else if (e.name != "build" && !startsWith(e.name, ".") && !exists(join(p, "bober.pkg"))) {
			files.push(...sources(p))
		}
	}
	return files
}

/// The build command on a file: compiles the module of path alone into the object out, to inspect: by TPDE as lowered,
/// or if release by LLVM at -O2, monomorphized from what is not generic in it, without what a whole program's emission
/// learns (learn), and without the generics, but with its bytecode as lowered (src/bc/file.bob), which has them, in
/// section bober_bc.
function inspect(path: string, out: string, includes: string[], release: bool) {
	const p = lowered([path], includes)
	const m = p.module(normal(path))
	if (!release) {
		const b = new Tpde(path)
		emit(p, m, b, debug)
		b.verify()
		b.emit(out, false)
		return
	}
	const b = new LLVM(path)
	b.data(write(p, m, compilerId()), "bober_bc")
	mono(p, m, true)
	emit(p, m, b, { main: -1, tests: false, dyn: false })
	b.verify()
	b.emit(out, false)
}

/// Program p of mains, lowered after the CMake projects of main's package are built, but the modules linked from the
/// bytecode build/image.so holds, of the Bound each holds if any (unit), with the build directory made; its linker kept
/// for relink.
function lowered(mains: string[], includes: string[]): Program {
	const home = nearest(mains[0])
	if (home != null) {
		cmake(load(home))
	}
	const image = `${dir}/image.so`
	// Mapped of one descriptor, lest another build replace it, and read shared, lest one write it in place, which it may
	// once this is done: what is taken of it, copied; the mapping, by relink only while the file has the same stamp.
	const f = if (exists(image)) open(image) else null
	f?.lock(true, true)
	const kept = if (f == null) null else new Bytes(f.map())
	const l = new Linker(machine, format, kept)
	const cache = l.sections("bober_bc").map(s => s.copy())
	Bound.keep(l.sections("bober_bind").map(s => s.copy()))
	decoded = if (kept == null) null else [stamp(kept, format.headers), l, kept]
	f?.close()
	const p = lower(mains, includes, cache)
	mkdirAll(dir)
	return p
}

/// Whether bober runs from its package, whose lib/ has the run time, the C of the bundle's modules and the launcher,
/// compiled by pack.
function packaged(): bool { return exists(join(root, "lib/std.bobc")) }

/// What p links besides its modules, compiled where not yet: the C of p's modules (cObjects), and the run time, with
/// tests their network; and whether one is C++.
function linked(p: Program, tests: bool, includes: string[]): [string[], bool] {
	const [cs, cxx] = cObjects(p, includes)
	return [[...cs, ...(if (packaged()) glob(join(root, "lib/*.[ao]")) else runtime(dir)),
		...(if (!tests) [] else if (packaged()) glob(join(root, "lib/net/*.o")) else network(dir))], cxx]
}

/// How the image's modules are emitted: as lowered.
const debug = { main: -1, tests: false, dyn: true }

/// Of build/image.so as lowered read it, the stamp, its linker and bytes; each store of it has a new random stamp, so
/// a file of the same stamp is the one decoded, which relink then continues.
let decoded: [u64, Linker, Bytes] | null = null

/// Links p's modules, each compiled by TPDE as o says, the objects and archives files, if cxx the sysroot's libc++,
/// and the C library's libunwind and compiler builtins into build/image.so, the one image of all that is built there,
/// which loads the C library, on macOS the system's with those and libc++ in it, and exports the entries of p's modules
/// mains; a monomorphized program's is build/image.mono.so. The image is kept
/// (src/link/link.bob), and a build links only what it does not hold: each object is named by what it is made of,
/// `<what>@<version>`, a module by its bytecode, which has the ABIs of the modules it imports, and its Bound; a file by
/// its bytes; an archive, which is linked for good, by its size and when it was written. An image that holds all and
/// exports the entries is left as it is. Where the image cannot take the link, or an archive it holds changed, all is
/// linked anew, fresh. The image is written in place where no other process has it, else under a name of its own, then
/// renamed, as a running program may have the old one mapped, or another build be reading it. Returns its path, or if
/// pin that of a link to it of this process's, which the launcher removes, by which what the process runs loads this
/// build's image though another build replaces it.
function image(p: Program, mains: i32[], files: string[], cxx: bool, pin: bool, o: Options, o2: i32[][][] | null = null,
	fresh = false): string {
	const out = `${dir}/image${if (o.dyn) "" else ".mono"}.so`
	// The image continued, which is mapped and written of one descriptor, lest another build replace it in between:
	// in place if this build has it alone, which no run maps or is about to, by a pin, nor another build reads, but on
	// macOS, whose kernel kills who maps a signed file changed in place; else a copy, the image shared meanwhile.
	const old = if (fresh || !exists(out)) null else open(out, "r+")
	try {
		const alone = !mac && old != null && old.lock(false, false) && glob(`${out}.*.run`).length == 0
		if (old != null && !alone) {
			old.lock(true, true)
		}
		return relink(p, mains, files, cxx, pin, o, o2, out, old, alone)
	} finally {
		old?.close()
	}
}

/// The image out, which image links of old, the image continued if not null, written in place if alone.
function relink(p: Program, mains: i32[], files: string[], cxx: bool, pin: bool, o: Options, o2: i32[][][] | null,
	out: string, old: File | null, alone: bool): string {
	const lib = `${sysroot}/usr/lib`
	const d = decoded
	decoded = null
	const mapped = new Bytes(if (old != null) old.map() else "")
	const unchanged = old != null && d != null && stamp(mapped, format.headers) == d[0]
	const kept = if (unchanged) d![2] else mapped
	const l = if (unchanged) d![1] else new Linker(machine, format, kept)
	const held = l.objects()
	// Whether the image lacks the object name; another version of it is unlinked.
	const lacks = (name: string) => {
		const what = name.slice(0, lastIndexOf(name, "@") + 1)
		for (const h of held.filter(h => h != name && startsWith(h, what))) {
			l.remove(h)
		}
		return !held.includes(name)
	}
	const compiler = compilerId()
	const names: string[] = [] // of each module's unit, <path>@<source>.<version>: by source a build knows it edited
	// Of each module, the symbol its unit defines of its version (src/bc/file.bob's), which -O2's overlay of its code
	// names, and the other modules of the decls not exported it names; made when unit or -O2 wants them.
	const versions: [string, i32[]][] = []
	const signatures = new HashMap[i32, [u64, i32[]]]()
	const edited: bool[] = [] // whether the image held the module's unit of another source
	for (const m of 0 ... p.modules.length - 1) {
		const bc = if (p.modules[m].bc != "") p.modules[m].bc else write(p, m, compiler)
		const b = bound.get(p.modules[m].path)?.bytes(p.modules[m].path) ?? ""
		const own = `${p.modules[m].path}@${p.modules[m].source}.`
		const was = held.find(h => startsWith(h, `${p.modules[m].path}@`))
		edited.push(was != null && !startsWith(was!, own))
		names.push(`${own}${fnv(bc + b)}`)
		const rebuilt = lacks(names[m])
		const [v, others] = if (o2 != null || rebuilt) version(p, m, bc, signatures) else [0 as u64, []]
		versions.push([`bober.o2.${p.modules[m].path}@${combine(v, fnv(b))}`, others])
		if (rebuilt) {
			l.add(unit(p, m, names[m], o, bc, b, versions[m][0]))
		}
	}
	// -O2's instances, o2 (src/mono.bob's specialize), an object per bucket of each module's, named
	// `<path>~<bucket>^O2@<version>`, and its overlays of the code of each group's, `<path>^O2@<version>`, but those
	// held; and of those held, but these. A build without keeps them all, but those that name what no longer is
	// (compiled).
	if (o2 != null) {
		const wanted: string[] = []
		const part = (m: i32, ds: i32[], what: string, refs: string[], over: bool) => {
			const version = fnv(`${refs.join(" ")} ${ds.map(d => p.decls[d].hash).join(" ")}`)
			const name = `${what}^O2@${version}`
			wanted.push(name)
			if (ds.length > 0 && !held.includes(name)) {
				l.add(compiled(p, m, ds, name, refs, over))
			}
		}
		for (const m of 0 ... p.modules.length - 1) {
			for (const i of 0 ... o2[m].length - 1) {
				const ds = o2[m][i]
				part(m, ds, `${p.modules[m].path}~${i}`, [`bober.code.${names[m]}`, ...abis(p, m, ds, names)], false)
			}
		}
		// An edited module runs on its base code; the first build that finds it unchanged optimises it again.
		for (const ds of groups(p).filter(ds => !edited[p.decls[ds[0]].module])) {
			const m = p.decls[ds[0]].module
			const [symbol, others] = versions[m]
			const refs = [symbol, ...abis(p, m, [], names), ...others.map(x => `bober.code.${names[x]}`)]
			part(m, ds, p.modules[m].path, refs, true)
		}
		const ours = (h: string) => p.modules.some(x => startsWith(h, `${x.path}~`) || startsWith(h, `${x.path}^`))
		for (const h of held.filter(h => ours(h) && !wanted.includes(h))) {
			l.remove(h)
		}
	}
	const cxxs: string[] = if (cxx) [`${lib}/libc++.a`, `${lib}/libc++abi.a`] else []
	const archives: string[] = []
	let added = false // an archive the image did not look in
	for (const f of [...files,
		...(if (mac) [] else [...cxxs, `${lib}/libunwind.a`, `${lib}/libclang_rt.builtins.a`])]) {
		if (!endsWith(f, ".a")) {
			const bytes = readFile(f)
			const name = `${f}@${fnv(bytes)}`
			if (lacks(name)) {
				l.add(format.read(name, bytes))
			}
			continue
		}
		// An object stands for the archive, whose members are linked as what they define is named.
		const info = stat(f)
		const name = `${f}@${info.modified}.${info.size}`
		if (held.some(h => h != name && startsWith(h, `${f}@`))) {
			return image(p, mains, files, cxx, pin, o, o2, true)
		}
		if (!held.includes(name)) {
			l.add(new Object(name, machine.arch))
			added = true
		}
		archives.push(f)
	}
	// Each library as the loader finds it, and the file that has its exports: on macOS a text stub of the SDK's.
	const system = ["libSystem.B", "libc++.1", "libc++abi"]
	const libraries = if (mac) system.map(n => [`/usr/lib/${n}.dylib`, `${lib}/${n}.tbd`])
		else [["libc.so", `${lib}/libc.so`]]
	for (const [name, file] of libraries) {
		l.library(name, format.exports(file, readFile(file)))
	}
	for (const m of mains) {
		l.export(entry(p.modules[m].path, false))
		l.export(entry(p.modules[m].path, true))
	}
	const changed = l.changed()
	const tmp = `${out}.${getpid()}`
	let at = out // where the image is written
	if (changed) {
		// The archives' members, listed once a name is looked for in them that the image did not look for; at once if an
		// archive is new to it.
		const list = () => {
			for (const f of archives) {
				const bytes = mapFile(f)
				for (const [member, b, names] of members(f, bytes)) {
					l.lazy(if (mac) names.map(named) else names, () => format.read(member, b))
				}
			}
		}
		if (added) {
			list()
		} else {
			l.lazily(list)
		}
		try {
			const linked = l.link()
			stamped(linked.bytes, format.headers)
			format.write(linked)
			const continued = linked.bytes == kept
			at = if (continued && alone) out else tmp
			const f = if (at == out) old! else if (continued) old!.copy(tmp, linked.bytes.length) else open(tmp, "w")
			store(f, linked.bytes)
			if (f != old) {
				f.close() // old once the pin is made, which a build sees
			}
		} catch (e: Stale) {
			return image(p, mains, files, cxx, pin, o, o2, true)
		}
	}
	const own = `${tmp}.run`
	if (pin) {
		if (exists(own)) {
			remove(own) // which a process of this ID left, whose launcher never ran
		}
		if (hardLink(at, own) != 0) {
			throw new CompileError(`cannot link ${own}`)
		}
	}
	if (at != out) {
		rename(tmp, out)
	}
	return if (pin) own else out
}

/// Module m of p, compiled by TPDE as o says, as the object name. It defines a symbol named by its ABI, one by name,
/// bober.code.<name>, which -O2's instances of its generics name, and one versioned, which its overlay of its code
/// names (relink), and names those of the modules it imports and of builtin/'s, whose functions the compiler calls
/// unasked, so that a kept image unlinks it once one of them has another: an object another program left there, or
/// after a change of builtin/, which no bytecode names. As lowered, it holds bc, its bytecode, in section bober_bc,
/// which a build links rather than checks the module of (lowered), and its Bound, if any (src/lift.bob), in bober_bind.
function unit(p: Program, m: i32, name: string, o: Options, bc: string, bound: string, versioned: string): Object {
	const b = new Tpde(p.modules[m].path)
	emit(p, m, b, o)
	b.verify()
	const x = elf.read(name, b.object())
	for (const [n, bytes] of [["bober_bc", bc], ["bober_bind", bound]]) {
		if (o.dyn && bytes != "") {
			const s = new Section(n, Kept)
			s.bytes = bytes
			s.size = bytes.length as u64
			x.sections.push(s)
		}
	}
	x.sections.push(new Section(".rodata", Const))
	x.symbols.append([new Symbol(abiSymbol(p, m), Global, x.sections.length - 1),
		new Symbol(`bober.code.${name}`, Global, x.sections.length - 1),
		new Symbol(versioned, Global, x.sections.length - 1)])
	for (const d of 0 ... p.modules.length - 1) {
		if (d != m && (builtin(p.modules[d].path) || p.modules[m].deps.includes(d))) {
			x.symbols.push(new Symbol(abiSymbol(p, d), Global, -1))
		}
	}
	return x
}

/// The symbol named by the ABI of p's module m.
function abiSymbol(p: Program, m: i32): string { return `bober.abi.${p.modules[m].path}.${abi(p, m)}` }

/// Module m's decls ds, compiled by LLVM as the object name, which names refs, so that a kept image unlinks it once
/// one of them is not: that of m's code (unit), and abis'; or of m's version (relink's versions). ds are -O2's
/// instances of m's generics (src/mono.bob's specialize), or if over, its group of m's functions, whose definitions of
/// code are taken over the unit's; the group defines no other, which would be a second of what the unit defines.
function compiled(p: Program, m: i32, ds: i32[], name: string, refs: string[], over: bool): Object {
	const b = new LLVM(p.modules[m].path)
	emit(p, m, b, debug, new Facts(), ds)
	b.verify()
	const x = format.read(name, b.object())
	for (const s of x.symbols) {
		if (over && s.binding == Global && s.section >= 0 && x.sections[s.section].kind == Code) {
			s.binding = Over
		}
	}
	for (const s of x.sections) {
		s.group = "" // LLVM's of the personality's pointer, each object's own, as a kept image cannot move it
	}
	x.symbols.append(refs.map(r => new Symbol(r, Global, -1)))
	return x
}

/// -O2's groups of p's decls, each compiled by LLVM over the code of its module: of each module, its functions.
function groups(p: Program): i32[][] {
	return p.modules.map(m => listed(p, p.module(m.path)).filter(d => p.decls[d].kind == decl.Function
		&& p.decls[d].code != null && p.decls[d].generic < 0)).filter(ds => ds.length > 0)
}

/// The ABI symbols of builtin/'s modules and of those of the types instances ds of module m's generics are of, but m's;
/// of a type its module has not exported, which its ABI may not cover, the code's of its module, as names has its unit.
function abis(p: Program, m: i32, ds: i32[], names: string[]): string[] {
	const refs = p.modules.filter(x => builtin(x.path)
		&& x.path != p.modules[m].path).map(x => abiSymbol(p, p.module(x.path)))
	const ts: i32[] = []
	for (const d of ds) {
		ts.append(p.lists[p.decls[d].env])
	}
	while (ts.length > 0) {
		const t = ts.pop()
		const x = if (p.kind(t) == kind.Named) p.decls[p.a(t)] else null
		const r = if (x == null || x.module == m) ""
			else if (x.owner < 0 && (x.mods & decl.Export) != 0) abiSymbol(p, x.module)
			else `bober.code.${names[x.module]}`
		if (r != "" && !refs.includes(r)) {
			refs.push(r)
		}
		ts.append(p.parts(t))
	}
	return refs
}

/// The objects of the glue of p's modules of C headers but the bundle's, of source hash 0, compiled with includes and
/// those of the packages of its modules, and all C libraries of each package one of whose headers it imports,
/// which lld takes in any order, and of which it links what it uses; and whether one is CMake's, and so C++.
function cObjects(p: Program, includes: string[]): [string[], bool] {
	const packages: [string, string[]][] = []
	const headers: string[] = []
	const cIncludes = includes.slice(0, includes.length)
	for (const m of p.modules.filter(m => m.source != 0)) {
		const path = split(m.path, ": ")[0]
		if (startsWith(path, `${sysroot}/`)) {
			continue
		}
		if (path != m.path) {
			headers.push(path)
		}
		const d = nearest(path)
		if (d != null && !packages.some(e => e[0] == d)) {
			packages.push([d, includesOf(path, [])])
			cIncludes.push(...packages[packages.length - 1][1])
		}
	}
	const libs: string[] = []
	let cxx = false
	for (const m of 0 ... p.modules.length - 1) {
		const c = if (p.modules[m].source == 0) null else glued(p, m, cIncludes)
		if (c != null) {
			libs.push(c)
		}
	}
	for (const [d, dirs] of packages) {
		if (!headers.some(h => dirs.some(i => startsWith(h, `${i}/`)))) {
			continue
		}
		const p = load(d)
		for (const [name, c] of p.c) {
			if (c.cmake.version > 0) {
				cxx = true
				libs.push(...split(readFile(`${out(p.name, name)}/libs`), "\n").filter(l => l != ""))
			} else if (c.sources.length > 0) {
				libs.push(archive(c, out(p.name, name), join(d, "bober.pkg"), dirs))
			}
		}
	}
	return [libs, cxx]
}

/// The bundle command, which dist.sh runs in the repo: writes the bundle of builtin/'s and std/'s modules, lowered
/// from source, to lib/std.bobc (src/lift.bob), and compiles the C they link into lib: the run time's objects, the
/// archive std.a of their glue, and their C libraries' archives.
function pack(lib: string) {
	const p = lower([...glob("std/**/*.bob"), ...glob("builtin/*.bob")].filter(f => !endsWith(f, ".test.bob")))
	mkdirAll(lib)
	runtime(lib)
	network(lib)
	launcher(lib)
	const cs = cObjects(p, [])[0]
	run(["ar", "rcs", join(lib, "std.a"), ...cs.filter(c => endsWith(c, ".o"))])
	for (const a of cs.filter(c => endsWith(c, ".a"))) {
		save(join(lib, base(a)), readFile(a))
	}
	save(join(lib, "std.bobc"), bundle(p, compilerId()))
}

/// The run time's objects, src/rt.c's, src/gc.c's, src/fiber.c's, src/io.c's and src/type.c's of bober's root, compiled
/// by bobcc into out where older than their source or src/rt.h.
export function runtime(out: string): string[] {
	const objects: string[] = []
	for (const c of ["rt", "gc", "fiber", "io", "type"]) {
		const o = `${out}/${c}.c.o` // not a program's, out/<name>.o
		const src = join(root, `src/${c}.c`)
		if (!newer(o, [src, join(root, "src/rt.h")])) {
			object(sysroot, src, o, [])
		}
		objects.push(o)
	}
	return objects
}

/// The network of tests, src/net.c of bober's root on vendor/lwip, compiled by bobcc into out/net where older than their
/// source or headers of src/.
function network(out: string): string[] {
	const lwip = join(root, "vendor/lwip/src")
	const headers = ["src/rt.h", "src/net.h", "src/net/lwipopts.h", "src/net/arch/cc.h"].map(h => join(root, h))
	mkdirAll(`${out}/net`)
	return [join(root, "src/net.c"), ...glob(`${lwip}/core/**/*.c`)].map(src => {
		const o = `${out}/net/${base(src)}.o`
		if (!newer(o, [src, ...headers])) {
			object(sysroot, src, o, [join(root, "src"), join(root, "src/net"), `${lwip}/include`])
		}
		return o
	})
}

/// The launcher of images, src/launch.c of bober's root, compiled by bobcc into out/launch.c.exe where older than its
/// source.
function launcher(out: string): string {
	const exe = `${out}/launch.c.exe`
	const src = join(root, "src/launch.c")
	if (!newer(exe, [src])) {
		object(sysroot, src, `${exe}.o`, [])
		if (link(sysroot, [`${exe}.o`], exe, "pie") != 0) {
			throw new CompileError(`cannot link ${exe}`)
		}
		remove(`${exe}.o`) // which a package's programs would link, as the rest of lib/
	}
	return exe
}

/// The archive out.a of c's sources, each compiled into out, with c's private headers and those of includes, where
/// older than it, or all where pkg, its bober.pkg, or a header of c's is newer than the archive, by bobcc.
function archive(c: CLib, out: string, pkg: string, includes: string[]): string {
	const a = `${out}.a`
	const skip = globs(c.exclude)
	const all = !newer(a, [pkg, ...globs([...c.include, ...c.private].map(d => `${d}/**/*.h`))])
	const dirs = [...c.private, ...includes]
	const objects: string[] = []
	for (const s of globs(c.sources).filter(s => !skip.includes(s))) {
		const o = `${out}/${rel(c.src as string, s)!}.o`
		if (all || !newer(o, [s])) {
			mkdirAll(parent(o))
			object(sysroot, s, o, dirs, c.defines)
		}
		objects.push(o)
	}
	if (!newer(a, objects)) {
		if (exists(a)) {
			remove(a)
		}
		run(["ar", "rcs", a, ...objects])
	}
	return a
}

/// Builds and installs each CMake project of p into its out, listing the static libraries it installs in out/libs,
/// unless its stamp is what it was last: its entry in p, its patches and toolchain files, the stamps of those of p
/// before it and the files of its src if a directory, by their contents, not times, which a checkout or a cache resets;
/// a file's hash taken from o/hashes where its time and size are as recorded there and older than it, as git's index.
/// Its src, copied or fetched with its hash checked to out/src, patched, and configured afresh with its preset "bober"
/// and toolchain file, finding those of p before it, in out/build, which is kept, as the archive fetched.
function cmake(p: Package) {
	const cwd = fromCString(getcwd(0, 0))
	const before: string[] = []
	for (const [name, c] of p.c) {
		if (c.cmake.version == 0) {
			continue
		}
		const o = out(p.name, name)
		const tools = toolchain(c, cwd)
		const src = c.src
		const files = if (src instanceof string) glob(`${src}/**/*`).filter(f => !stat(f).isDirectory) else []
		const sides = `${o}/hashes`
		const t = if (exists(sides)) stat(sides).modified else 0
		const last = new HashMap[string, string]()
		for (const l of split(if (t > 0) readFile(sides) else "", "\n")) {
			const i = lastIndexOf(l, " ")
			if (i >= 0) {
				last.set(l.slice(0, i), l.slice(i + 1, l.length))
			}
		}
		// Per file, its path, its time and size, and its hash.
		const hashed = files.map(f => {
			const s = stat(f)
			const k = `${s.modified} ${s.size}`
			return [f, k, (if (s.modified < t) last.get(`${f} ${k}`) else null) ?? `${fnv(mapFile(f))}`]
		})
		mkdirAll(o)
		save(`${sides}.tmp`, hashed.map(h => `${h[0]} ${h[1]} ${h[2]}\n`).join(""))
		rename(`${sides}.tmp`, sides) // whole, if at all
		const entry = encode(src) + encode(c.cmake) + c.patches.map(x => readFile(x)).join("")
			+ (if (c.toolchain == "") "" else readFile(c.toolchain)) + tools
			+ before.map(b => `${b} ${fnv(readFile(`${b}/stamp`))}\n`).join("")
			+ hashed.map(h => `${h[0]} ${h[2]}\n`).join("")
		const prefixes = before.map(b => `${cwd}/${b}`).join(";")
		before.push(o)
		if (exists(`${o}/stamp`) && readFile(`${o}/stamp`) == entry) {
			continue
		}
		// Gone while it builds, so that the stamps of a build cut short tell, as CI keys its cache by them.
		if (exists(`${o}/stamp`)) {
			remove(`${o}/stamp`)
		}
		let root = `${o}/src`
		if (exists(root)) {
			removeAll(root)
		}
		if (src instanceof string) {
			run(["cmake", "-E", "copy_directory", src, root])
		} else {
			// Its one directory as out/src, the same for any URL.
			const url = split(src[0], "#")
			save(`${o}/fetch.cmake`,
				`file(DOWNLOAD "${url[0]}" "${o}/src.tar" EXPECTED_HASH SHA256=${src[1]})
file(ARCHIVE_EXTRACT INPUT "${o}/src.tar" DESTINATION "${o}/fetch")`)
			run(["cmake", "-P", `${o}/fetch.cmake`])
			rename(glob(`${o}/fetch/*`)[0], root)
			if (url.length > 1) {
				root = join(root, url[1])
			}
		}
		for (const x of c.patches) {
			run(["patch", "-s", "-p1", "-d", root, "-i", `${cwd}/${x}`])
		}
		const preset = [...c.cmake.fields.map(e => `${quoted(e[0])}:${e[1]}`), `"name":"bober"`, `"generator":"Ninja"`]
		save(`${root}/CMakeUserPresets.json`,
			`{"version":${c.cmake.version},"configurePresets":[{${preset.join(",")}}]}`)
		save(`${o}/toolchain.cmake`, tools)
		mkdirAll(`${o}/build/.cmake/api/v1/query`)
		save(`${o}/build/.cmake/api/v1/query/codemodel-v2`, "")
		run(["cmake", "-S", root, "-B", `${o}/build`, "--fresh", "--preset", "bober", "--toolchain",
			`${cwd}/${o}/toolchain.cmake`, `-DCMAKE_PREFIX_PATH=${prefixes}`])
		run(["cmake", "--build", `${o}/build`])
		run(["cmake", "--install", `${o}/build`, "--prefix", o])
		save(`${o}/libs`, installed(o).join("\n"))
		save(`${o}/stamp`, entry)
	}
}

/// A target of a CMake project, as its file API describes it.
class Target {
	type: string = ""
	artifacts: Artifact[] = []
	install: Install = new Install()
	rest: Unknown[] @Rest = []
}

class Install {
	destinations: Artifact[] = []
	rest: Unknown[] @Rest = []
}

class Artifact {
	path: string = ""
	rest: Unknown[] @Rest = []
}

/// The static libraries the CMake project built in o/build installs into o, as its file API tells.
function installed(o: string): string[] {
	const libs: string[] = []
	for (const f of glob(`${o}/build/.cmake/api/v1/reply/target-*.json`)) {
		let t = new Target()
		try {
			t = decodeJson[Target](readFile(f))
		} catch (e: ParseError) {
			throw new CompileError(`${f}: ${e.kind} error at byte ${e.at}`)
		}
		if (t.type == "STATIC_LIBRARY") {
			libs.push(...t.install.destinations.map(d => join(o, d.path, base(t.artifacts[0].path))))
		}
	}
	return libs
}

/// The paths that match any of patterns.
function globs(patterns: string[]): string[] {
	const out: string[] = []
	for (const p of patterns) {
		out.push(...glob(p))
	}
	return out
}

/// Whether the file at path exists and is newer than each of sources, so that it need not be made again.
function newer(path: string, sources: string[]): bool {
	if (!exists(path)) {
		return false
	}
	const t = stat(path).modified
	for (const s of sources) {
		if (stat(s).modified >= t) {
			return false
		}
	}
	return true
}

/// The object of the C that defines the static functions of module m of p, if a C header's module, whose path is the header's and
/// the names imported (src/check.bob, Modules.header), or null.
function glued(p: Program, m: i32, includes: string[]): string | null {
	const path = p.modules[m].path
	const at = indexOf(path, ": ")
	if (at < 0) {
		return null
	}
	const c = glue(path.slice(0, at), p.modules[m].decls.map(d => p.strings[p.decls[d].name]))
	if (c == "") {
		return null
	}
	const f = file(path)
	save(`${f}.c`, c)
	object(sysroot, `${f}.c`, `${f}.c.o`, [".", ...includes])
	return `${f}.c.o`
}

/// The executable's name for main: its file's, without .bob or .test.bob.
function name(main: string): string {
	let n = main
	for (const suffix of [".bob", ".test"]) {
		if (endsWith(n, suffix)) {
			n = n.slice(0, n.length - suffix.length)
		}
	}
	let i = n.length
	while (i > 0 && n[i - 1] != 0x2f) {
		i--
	}
	return n.slice(i, n.length)
}

/// Where the files of the module at path go, without extension: its path in the build directory, each / a _, relative to
/// bober's root if in it. A C header's module is named by its path and the names imported from it, which would be too
/// long a file name, so they are hashed instead.
function file(path: string): string {
	const space = indexOf(path, " ")
	let s = ""
	for (const c of rel(root, if (space < 0) path else path.slice(0, space)) ?? path) {
		s += if (c == 0x2f) "_" else chr(c)
	}
	if (space >= 0) {
		s += `.${fnv(path)}`
	}
	return `${dir}/${s}`
}

function save(path: string, s: string) {
	if (!writeFile(path, s)) {
		throw new CompileError(`cannot write ${path}`)
	}
}

/// Runs argv; throws if it fails.
function run(argv: string[]) {
	if (process.run(argv) != 0) {
		throw new CompileError(`failed: ${argv.join(" ")}`)
	}
}
