//! bober, the compiler's driver. Paths are relative to the directory it runs in; its own files are in its root
//! (src/root.bob). It runs as build/bober, built by itself or bootstrapped by build/boot (boot/README.md), or as the
//! bin/bober of the package dist.sh makes.
//!
//! # Introduction
//!
//! Bober is a statically typed, compiled language with the surface of TypeScript and the object layout of C. This spec
//! defines its syntax and semantics; the standard library, which defines `Trap` (§7.7) and `process`, is specified
//! elsewhere. Grammar is given in `grammar` blocks, examples in plain ones.
//!
//! An implementation shall reject a program that violates a rule stated with *shall* with a diagnostic, except noted
//! otherwise. A *trap* stops the isolate that hits it (§7.7); it cannot be caught. A *throw* is an exception a `try`
//! can catch. *implementation-defined* behavior is chosen by the implementation; a program shall not depend on
//! implementation-defined behavior.

import { endsWith, indexOf, lastIndexOf, sortBy, startsWith } from "../std/algo"
import { fromCString } from "../std/c"
import { Keys, Rest, Unknown, decode as decodeJson, encode, quoted } from "../std/encoding/json"
import * as yaml from "../std/encoding/yaml"
import { decode } from "../std/encoding/optarg"
import { exists, glob, mapFile, mkdirAll, readDir, readFile, remove, removeAll, rename, stat } from "../std/fs"
import { base, dir as parent, isAbs, join, rel } from "../std/fs/path"
import { fnv } from "../std/hash"
import { stdin, stdout } from "../std/io"
import { arch, os } from "../std/os"
import { ParseError, split, trim } from "../std/string"
import { abi, write } from "./bc/file"
import { Program } from "./bc/program"
import { show } from "./bc/show"
import { glue, includesOf, sysroot } from "./c/bind"
import { link, object } from "./c/bobcc"
import { doc } from "./doc"
import { emit, entry, learn } from "./emit"
import { Flags, check, normal } from "./check"
import { CompileError } from "./error"
import { formatFile } from "./format"
import { LLVM, triple } from "./backend/llvm"
import { Tpde } from "./backend/tpde"
import { bundle, compilerId } from "./lift"
import { members } from "./link/ar"
import { arm64 } from "./link/arm64"
import { elf } from "./link/elf"
import { macho, named } from "./link/macho"
import { pe } from "./link/pe"
import { x64 } from "./link/x64"
import { Linker, Stale } from "./link/link"
import { Const, Global, Object, Section, Symbol } from "./link/object"
import { SyntaxError } from "./lex"
import { lower } from "./lower"
import { serve } from "./lsp"
import { mono } from "./mono"
import { Parser } from "./parse"
import { builtin, root } from "./root"
import { CLib, Package, load, nearest, out } from "./pkg"
import * as process from "../std/process"
import { chdir, getcwd, getpid, isatty, link as hardLink } from "unistd.h"

const usage = `usage: bober <command> [-I dir]... args
  build                          link the modules of the nearest bober.pkg's directory and below into build/image.so
  build <file.bob> -o <out>      compile the file's module alone into the object out, to inspect
  run <main.bob> [args]          build the program and run it with args
  test [<main.bob> [args]]       build it and run its main module's tests, or each file's here and below
  check <file>...                report the type errors of the files and the modules they import; also lint
  format <file>...               rewrite each file in place in the one layout of its syntax tree
  lower <file>...                print the bytecode of each file
  doc <file>...                  print the spec in the files' doc comments as Markdown
  init [@namespace/name]         write a bober.pkg here, asking for its name on a terminal
  lsp                            serve the language server protocol on stdin and stdout
  help                           print this
Its options are taken anywhere on the line, as a C compiler's, up to a --; the arguments after go to the program.
-I adds a directory C headers are found in, as a C compiler takes it, before those of the nearest bober.pkg's C libraries.
-release builds with LLVM, the whole program at -O2 into build/<name>; a module alone keeps its generics as bytecode, in
section bober_bc. Else each module is built with TPDE, to debug, once as lowered: a generic's code takes its type args'
descriptors; into one shared library of all that is built there, build/image.so, which run and test load, and which a
build links only what changed into.
test prints a YAML mapping of the tests, or of the files and directories with tests: each ok if all in it passed, else
what failed in it, a test's trap after what it printed.`

const dir = "build"

/// The machine and the format of the images src/link writes here; TPDE's objects are ELF everywhere.
const machine = if (arch == "arm64") arm64 else x64
const mac = os == "macos"
const format = if (mac) macho else if (os == "windows") pe else elf

/// Links the objects and linker options args into the executable out by bobcc's link, with libc++ for C++ libraries:
/// folding identical code, with a build ID on ELF (compilerId); throws a CompileError if it fails.
export function ld(args: string[], out: string) {
	const flags = if (os == "macos") ["-lc++"] else ["--build-id", "-lc++", "-lc++abi"]
	if (link(sysroot, ["--icf=all", ...args, ...flags], out) != 0) {
		throw new CompileError(`cannot link ${out}`)
	}
}

/// The CMake toolchain file of C library c, built in cwd: bober's defaults for the target, its triple, the sysroot and on
/// ELF static executables, with the compilers CMake finds, then c's toolchain file, which may override them.
const toolchain = (c: CLib, cwd: string) => `set(CMAKE_C_COMPILER_TARGET ${triple})
set(CMAKE_CXX_COMPILER_TARGET ${triple})
set(CMAKE_ASM_COMPILER_TARGET ${triple})
${if (os == "macos") `set(CMAKE_OSX_SYSROOT "${sysroot}")` else `set(CMAKE_SYSROOT "${if (isAbs(sysroot)) "" else cwd + "/"}${sysroot}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")`}
${if (c.toolchain == "") "" else `include("${cwd}/${c.toolchain}")\n`}`

function main(): i32 {
	const argv = args()
	if (argv.length == 0) {
		print(usage)
		return 2
	}
	let f = new Flags()
	try {
		f = decode[Flags](argv.slice(1, argv.length))
	} catch (e: ParseError) {
		print(`bad option ${argv[e.at + 1]}`)
		return 2
	}
	if (f.args.length == 0 && !["lsp", "init", "test", "build", "help"].includes(argv[0])) {
		print(usage)
		return 2
	}
	try {
		return command(argv[0], f)
	} catch (e: CompileError | IoError) {
		print(if (e instanceof IoError) e.message() else e.msg)
		return 1
	}
}

/// Runs the command cmd with the options and arguments f; returns the exit status or throws a CompileError or IoError.
function command(cmd: string, f: Flags): i32 {
	const argv = f.args
	const dirs = f.I
	switch (cmd) {
		case "test":
			const [status, report] = if (argv.length == 0) testAll(".", dirs, f.release)
				else runTests(argv[0], argv.slice(1, argv.length), dirs, f.release)
			try {
				stdout.write(yaml.emit(yaml.documents(report)))
			} catch (e: ParseError | yaml.EncodeError) {
				print(report)  // not UTF-8
			}
			return status
		case "build":
			if (argv.length == 0) {
				buildPackage(dirs)
			} else if (f.o == "") {
				throw new CompileError("build <file.bob> takes -o <out>")
			} else {
				inspect(argv[0], f.o, dirs, f.release)
			}
			return 0
		case "run":
			return process.run([...build(argv[0], false, dirs, f.release, true), ...argv.slice(1, argv.length)])
		case "check", "lint":
			let status = 0
			for (const e of check(argv, dirs)) {
				print(`${e.path}:${e.line}:${e.col}: ${if (e.warning) "warning: " else ""}${e.msg}`)
				status = if (e.warning) status else 1
			}
			return status
		case "format":
			let status = 0
			for (const path of argv) {
				try {
					formatFile(path)
				} catch (e: CompileError) {
					print(e.msg)
					status = 1
				}
			}
			return status
		case "doc":
			print(doc(argv))
			return 0
		case "lsp":
			serve(dirs)
			return 0
		case "init":
			init(if (argv.length == 0) "" else argv[0])
			return 0
		case "bundle":
			pack(argv[0])
			return 0
		case "help":
			print(usage)
			return 0
		case "lower":
			const p = lower(argv, dirs)
			for (const path of argv) {
				print(show(p, p.module(normal(path))))
			}
			return 0
	}
	print(usage)
	return 2
}

/// Writes bober.pkg in the directory it runs in, of the package name, else the one asked for on a terminal, else
/// @local/<the directory's name>.
function init(name: string) {
	if (exists("bober.pkg")) {
		throw new CompileError("bober.pkg exists")
	}
	let n = name
	if (n == "") {
		n = `@local/${base(fromCString(getcwd(0, 0)))}`
		if (isatty(0) != 0) {
			stdout.write(`name (${n}): `)
			let line = ""
			let c = stdin.read(1)
			while (c != null && c != "\n") {
				line += c
				c = stdin.read(1)
			}
			if (trim(line) != "") {
				n = trim(line)
			}
		}
	}
	const parts = split(n, "/")
	if (parts.length != 2 || parts[0].length < 2 || parts[1] == "" || !startsWith(n, "@")) {
		throw new CompileError(`${n} is not @namespace/name`)
	}
	save("bober.pkg", `{\n\t"name": ${quoted(n)}\n}\n`)
}

/// The tests of each file that has some in d and below, but in build/, hidden directories and builtin/, which no
/// program tests: 0 if all passed, and their report, a JSON object of d's files and directories with tests, each "ok"
/// if all of its passed, else a file's report as runTests gives it, or a directory's as this.
function testAll(d: string, includes: string[], release: bool): [i32, string] {
	let status = 0
	const entries: string[] = []
	const es = readDir(d)
	sortBy(es, (a, b) => a.name < b.name)
	for (const e of es) {
		const p = join(d, e.name)
		const sub = e.isDirectory && e.name != "build" && !startsWith(e.name, ".")
		if (sub || endsWith(e.name, ".bob") && !builtin(p) && hasTests(p)) {
			const [s, report] = if (sub) testAll(p, includes, release) else runTests(p, [], includes, release)
			if (report != "{}") {
				entries.push(`${quoted(e.name)}:${if (s == 0) `"ok"` else report}`)
				if (s != 0) {
					status = 1
				}
			}
		}
	}
	return [status, `{${entries.join(",")}}`]
}

/// Builds the program of main with its tests and runs them with args: its exit status, and its report, the JSON object
/// src/rt.c prints, ended by the exit status if a crash cut it off, or else what failed as a JSON string.
function runTests(main: string, args: string[], includes: string[], release: bool): [i32, string] {
	try {
		const out = `${dir}/${name(main)}.test.log`
		const status = process.run([...build(main, true, includes, release, true), ...args], out)
		const report = trim(readFile(out))
		// A crash cuts the report off after the key of the test it was in.
		for (const r of [report, `${report}${quoted(`exit ${status}`)}}`]) {
			try {
				decodeJson[Keys](r)
				return [status, r]
			} catch (e: ParseError) {}
		}
		return [if (status == 0) 1 else status, quoted(trim(`${report}\nexit ${status}`))]
	} catch (e: CompileError | IoError) {
		return [1, quoted(if (e instanceof IoError) e.message() else e.msg)]
	}
}

/// Whether the file at path declares a test, or does not parse, which its test run then reports.
function hasTests(path: string): bool {
	const p = new Parser(readFile(path))
	try {
		let t = p.parse()
		while (t != null && t.kind != "test") {
			t = p.parse()
		}
		return t != null
	} catch (e: SyntaxError) {
		return true
	}
}

/// Compiles the program of main into the executable build/<name>, or with tests build/<name>.test, all as one,
/// monomorphized, by LLVM at -O2 if release, else into the image, each module once by TPDE, fast to compile. Returns
/// the command that runs it, or its tests: the executable, or the launcher on the image's entry, run by the C library's
/// loader where it is the sysroot's, the image as image has it if pin. Throws the errors, or what failed, as a
/// CompileError or IoError.
function build(main: string, tests: bool, includes: string[], release: bool, pin: bool): string[] {
	const p = lowered([main], includes)
	const m = p.module(normal(main))
	const [files, cxx] = linked(p, tests, includes)
	if (!release) {
		return [...(if (mac) [] else [`${sysroot}/usr/lib/libc.so`]),
			if (packaged()) join(root, "lib/launch.c.exe") else launcher(dir), image(p, [m], files, cxx, pin),
			entry(p.modules[m].path, tests)]
	}
	const exe = `${dir}/${name(main)}${if (tests) ".test" else ""}`
	const o = { main: m, tests: tests, dyn: false }
	mono(p, m)
	const whole = new LLVM(main)
	const facts = learn(p, o, m => new LLVM(p.modules[m].path))
	for (const m of 0 ... p.modules.length - 1) {
		const b = new LLVM(p.modules[m].path)
		emit(p, m, b, o, facts)
		b.verify() // which also finishes it, before it is linked
		whole.link(b)
	}
	whole.emit(`${exe}.o`, false)
	ld([`${exe}.o`, ...files], exe)
	return [exe]
}

/// The build command on no file: in the nearest bober.pkg's directory, links the modules of it and below, but those of
/// build/, hidden directories, builtin/ and other packages, into the image, with their tests' network, exporting their
/// entries; so that run and test of one there link little.
function buildPackage(includes: string[]) {
	const home = nearest(join(fromCString(getcwd(0, 0)), "bober.pkg"))
	if (home == null || chdir(home!) != 0) {
		throw new CompileError("no bober.pkg here or above")
	}
	const mains = sources(".")
	const p = lowered(mains, includes)
	const [files, cxx] = linked(p, true, includes)
	image(p, mains.map(m => p.module(normal(m))), files, cxx, false)
}

/// The .bob files of d and below that buildPackage links.
function sources(d: string): string[] {
	const files: string[] = []
	for (const e of readDir(d)) {
		const p = join(d, e.name)
		if (!e.isDirectory) {
			if (endsWith(e.name, ".bob") && !builtin(p)) {
				files.push(p)
			}
		} else if (e.name != "build" && !startsWith(e.name, ".") && !exists(join(p, "bober.pkg"))) {
			files.push(...sources(p))
		}
	}
	return files
}

/// The build command on a file: compiles the module of path alone into the object out, to inspect: by TPDE as lowered,
/// or if release by LLVM at -O2, monomorphized from what is not generic in it, without what a whole program's emission
/// learns (learn), and without the generics, but with its bytecode as lowered (src/bc/file.bob), which has them, in
/// section bober_bc.
function inspect(path: string, out: string, includes: string[], release: bool) {
	const p = lowered([path], includes)
	const m = p.module(normal(path))
	if (!release) {
		const b = new Tpde(path)
		emit(p, m, b, debug)
		b.verify()
		b.emit(out, false)
		return
	}
	const b = new LLVM(path)
	b.data(write(p, m, compilerId()), "bober_bc")
	mono(p, m, true)
	emit(p, m, b, { main: -1, tests: false, dyn: false })
	b.verify()
	b.emit(out, false)
}

/// Program p of mains, lowered after the CMake projects of main's package are built, with the build directory made.
function lowered(mains: string[], includes: string[]): Program {
	const home = nearest(mains[0])
	if (home != null) {
		cmake(load(home))
	}
	const p = lower(mains, includes)
	mkdirAll(dir)
	return p
}

/// Whether bober runs from its package, whose lib/ has the run time, the C of the bundle's modules and the launcher,
/// compiled by pack.
function packaged(): bool { return exists(join(root, "lib/std.bobc")) }

/// What p links besides its modules, compiled where not yet: the C of p's modules (cObjects), and the run time, with
/// tests their network; and whether one is C++.
function linked(p: Program, tests: bool, includes: string[]): [string[], bool] {
	const [cs, cxx] = cObjects(p, includes)
	return [[...cs, ...(if (packaged()) glob(join(root, "lib/*.[ao]")) else runtime(dir)),
		...(if (!tests) [] else if (packaged()) glob(join(root, "lib/net/*.o")) else network(dir))], cxx]
}

/// How the image's modules are emitted: as lowered.
const debug = { main: -1, tests: false, dyn: true }

/// Links p's modules, each compiled by TPDE as lowered, the objects and archives files, if cxx the sysroot's libc++,
/// and the C library's libunwind and compiler builtins into build/image.so, the one image of all that is built there,
/// which loads the C library, on macOS the system's with those and libc++ in it, and exports the entries of p's modules
/// mains. The image is kept
/// (src/link/link.bob), and a build links only what it does not hold: each object is named by what it is made of,
/// `<what>@<version>`, a module by its bytecode, which has the ABIs of the modules it imports; a file by its bytes; an
/// archive, which is linked for good, by its size and when it was written. Where the image cannot take the link, or
/// an archive it holds changed, all is linked anew, fresh. The image is written under a name of its own, then renamed,
/// as a running program may have the old one mapped, or another build be writing it. Returns its path, or if pin that
/// of a link to it of this process's, which the launcher removes, by which what the process runs loads this build's
/// image though another build replaces it.
function image(p: Program, mains: i32[], files: string[], cxx: bool, pin: bool, fresh = false): string {
	const out = `${dir}/image.so`
	const lib = `${sysroot}/usr/lib`
	const l = new Linker(machine, format, if (fresh || !exists(out)) "" else mapFile(out))
	const held = l.objects()
	// Whether the image lacks the object name; another version of it is unlinked.
	const lacks = (name: string) => {
		const what = name.slice(0, lastIndexOf(name, "@") + 1)
		for (const h of held.filter(h => h != name && startsWith(h, what))) {
			l.remove(h)
		}
		return !held.includes(name)
	}
	const compiler = compilerId()
	for (const m of 0 ... p.modules.length - 1) {
		const name = `${p.modules[m].path}@${fnv(write(p, m, compiler))}`
		if (lacks(name)) {
			l.add(unit(p, m, name))
		}
	}
	const cxxs: string[] = if (cxx) [`${lib}/libc++.a`, `${lib}/libc++abi.a`] else []
	for (const f of [...files, ...(if (mac) [] else [...cxxs, `${lib}/libunwind.a`, `${lib}/libclang_rt.builtins.a`])]) {
		if (!endsWith(f, ".a")) {
			const bytes = readFile(f)
			const name = `${f}@${fnv(bytes)}`
			if (lacks(name)) {
				l.add(format.read(name, bytes))
			}
			continue
		}
		// An object stands for the archive, whose members are linked as what they define is named.
		const info = stat(f)
		const name = `${f}@${info.modified}.${info.size}`
		if (held.some(h => h != name && startsWith(h, `${f}@`))) {
			return image(p, mains, files, cxx, pin, true)
		}
		if (!held.includes(name)) {
			l.add(new Object(name, machine.arch))
		}
		const bytes = mapFile(f)
		for (const [member, b, names] of members(f, bytes)) {
			l.lazy(if (mac) names.map(named) else names, () => format.read(member, b))
		}
	}
	// Each library as the loader finds it, and the file that has its exports: on macOS a text stub of the SDK's.
	const system = ["libSystem.B", "libc++.1", "libc++abi"]
	const libraries = if (mac) system.map(n => [`/usr/lib/${n}.dylib`, `${lib}/${n}.tbd`])
		else [["libc.so", `${lib}/libc.so`]]
	for (const [name, file] of libraries) {
		l.library(name, format.exports(file, readFile(file)))
	}
	for (const m of mains) {
		l.export(entry(p.modules[m].path, false))
		l.export(entry(p.modules[m].path, true))
	}
	const tmp = `${out}.${getpid()}`
	try {
		save(tmp, format.write(l.link()))
	} catch (e: Stale) {
		return image(p, mains, files, cxx, pin, true)
	}
	const own = `${tmp}.run`
	if (pin) {
		if (exists(own)) {
			remove(own) // which a process of this ID left, whose launcher never ran
		}
		if (hardLink(tmp, own) != 0) {
			throw new CompileError(`cannot link ${own}`)
		}
	}
	rename(tmp, out)
	return if (pin) own else out
}

/// Module m of p, compiled by TPDE as lowered, as the object name. It defines a symbol named by its ABI, and names
/// those of the modules it imports and of builtin/'s, whose functions the compiler calls unasked, so that a kept image
/// unlinks it once one of them has another: an object another program left there, or after a change of builtin/, which
/// no bytecode names.
function unit(p: Program, m: i32, name: string): Object {
	const b = new Tpde(p.modules[m].path)
	emit(p, m, b, debug)
	b.verify()
	const x = elf.read(name, b.object())
	const symbol = (m: i32, section: i32) => new Symbol(`bober.abi.${p.modules[m].path}.${abi(p, m)}`, Global, section)
	x.sections.push(new Section(".rodata", Const))
	x.symbols.push(symbol(m, x.sections.length - 1))
	for (const d of 0 ... p.modules.length - 1) {
		if (d != m && (builtin(p.modules[d].path) || p.modules[m].deps.includes(d))) {
			x.symbols.push(symbol(d, -1))
		}
	}
	return x
}

/// The objects of the glue of p's modules of C headers but the bundle's, of source hash 0, compiled with includes and
/// those of the packages of its modules, and all C libraries of each package one of whose headers it imports,
/// which lld takes in any order, and of which it links what it uses; and whether one is CMake's, and so C++.
function cObjects(p: Program, includes: string[]): [string[], bool] {
	const packages: [string, string[]][] = []
	const headers: string[] = []
	const cIncludes = includes.slice(0, includes.length)
	for (const m of p.modules.filter(m => m.source != 0)) {
		const path = split(m.path, ": ")[0]
		if (startsWith(path, `${sysroot}/`)) {
			continue
		}
		if (path != m.path) {
			headers.push(path)
		}
		const d = nearest(path)
		if (d != null && !packages.some(e => e[0] == d)) {
			packages.push([d, includesOf(path, [])])
			cIncludes.push(...packages[packages.length - 1][1])
		}
	}
	const libs: string[] = []
	let cxx = false
	for (const m of 0 ... p.modules.length - 1) {
		const c = if (p.modules[m].source == 0) null else glued(p, m, cIncludes)
		if (c != null) {
			libs.push(c)
		}
	}
	for (const [d, dirs] of packages) {
		if (!headers.some(h => dirs.some(i => startsWith(h, `${i}/`)))) {
			continue
		}
		const p = load(d)
		for (const [name, c] of p.c) {
			if (c.cmake.version > 0) {
				cxx = true
				libs.push(...split(readFile(`${out(p.name, name)}/libs`), "\n").filter(l => l != ""))
			} else if (c.sources.length > 0) {
				libs.push(archive(c, out(p.name, name), join(d, "bober.pkg"), dirs))
			}
		}
	}
	return [libs, cxx]
}

/// The bundle command, which dist.sh runs in the repo: writes the bundle of builtin/'s and std/'s modules, lowered
/// from source, to lib/std.bobc (src/lift.bob), and compiles the C they link into lib: the run time's objects, the
/// archive std.a of their glue, and their C libraries' archives.
function pack(lib: string) {
	const p = lower([...glob("std/**/*.bob"), ...glob("builtin/*.bob")].filter(f => !endsWith(f, ".test.bob")))
	mkdirAll(lib)
	runtime(lib)
	network(lib)
	launcher(lib)
	const cs = cObjects(p, [])[0]
	run(["ar", "rcs", join(lib, "std.a"), ...cs.filter(c => endsWith(c, ".o"))])
	for (const a of cs.filter(c => endsWith(c, ".a"))) {
		save(join(lib, base(a)), readFile(a))
	}
	save(join(lib, "std.bobc"), bundle(p, compilerId()))
}

/// The run time's objects, src/rt.c's, src/gc.c's, src/fiber.c's, src/io.c's and src/type.c's of bober's root, compiled
/// by bobcc into out where older than their source or src/rt.h.
export function runtime(out: string): string[] {
	const objects: string[] = []
	for (const c of ["rt", "gc", "fiber", "io", "type"]) {
		const o = `${out}/${c}.c.o` // not a program's, out/<name>.o
		const src = join(root, `src/${c}.c`)
		if (!newer(o, [src, join(root, "src/rt.h")])) {
			object(sysroot, src, o, [])
		}
		objects.push(o)
	}
	return objects
}

/// The network of tests, src/net.c of bober's root on vendor/lwip, compiled by bobcc into out/net where older than their
/// source or headers of src/.
function network(out: string): string[] {
	const lwip = join(root, "vendor/lwip/src")
	const headers = ["src/rt.h", "src/net.h", "src/net/lwipopts.h", "src/net/arch/cc.h"].map(h => join(root, h))
	mkdirAll(`${out}/net`)
	return [join(root, "src/net.c"), ...glob(`${lwip}/core/**/*.c`)].map(src => {
		const o = `${out}/net/${base(src)}.o`
		if (!newer(o, [src, ...headers])) {
			object(sysroot, src, o, [join(root, "src"), join(root, "src/net"), `${lwip}/include`])
		}
		return o
	})
}

/// The launcher of images, src/launch.c of bober's root, compiled by bobcc into out/launch.c.exe where older than its
/// source.
function launcher(out: string): string {
	const exe = `${out}/launch.c.exe`
	const src = join(root, "src/launch.c")
	if (!newer(exe, [src])) {
		object(sysroot, src, `${exe}.o`, [])
		if (link(sysroot, [`${exe}.o`], exe, "pie") != 0) {
			throw new CompileError(`cannot link ${exe}`)
		}
		remove(`${exe}.o`) // which a package's programs would link, as the rest of lib/
	}
	return exe
}

/// The archive out.a of c's sources, each compiled into out, with c's private headers and those of includes, where
/// older than it, or all where pkg, its bober.pkg, or a header of c's is newer than the archive, by bobcc.
function archive(c: CLib, out: string, pkg: string, includes: string[]): string {
	const a = `${out}.a`
	const skip = globs(c.exclude)
	const all = !newer(a, [pkg, ...globs([...c.include, ...c.private].map(d => `${d}/**/*.h`))])
	const dirs = [...c.private, ...includes]
	const objects: string[] = []
	for (const s of globs(c.sources).filter(s => !skip.includes(s))) {
		const o = `${out}/${rel(c.src as string, s)!}.o`
		if (all || !newer(o, [s])) {
			mkdirAll(parent(o))
			object(sysroot, s, o, dirs, c.defines)
		}
		objects.push(o)
	}
	if (!newer(a, objects)) {
		if (exists(a)) {
			remove(a)
		}
		run(["ar", "rcs", a, ...objects])
	}
	return a
}

/// Builds and installs each CMake project of p into its out, listing the static libraries it installs in out/libs,
/// unless its entry in p, its patches and toolchain files are what they were last, and it was built after those of p
/// before it and the files of its src if a directory: its src, copied or fetched with its hash checked to out/src,
/// patched, and configured afresh with its preset "bober" and toolchain file, finding those of p before it, in
/// out/build, which is kept, as the archive fetched.
function cmake(p: Package) {
	const cwd = fromCString(getcwd(0, 0))
	const before: string[] = []
	for (const [name, c] of p.c) {
		if (c.cmake.version == 0) {
			continue
		}
		const o = out(p.name, name)
		const tools = toolchain(c, cwd)
		const entry = encode(c.src) + encode(c.cmake) + c.patches.map(x => readFile(x)).join("")
			+ (if (c.toolchain == "") "" else readFile(c.toolchain)) + tools
		const src = c.src
		const inputs = [...before.map(b => `${b}/stamp`), ...(if (src instanceof string) glob(`${src}/**/*`) else [])]
		const prefixes = before.map(b => `${cwd}/${b}`).join(";")
		before.push(o)
		if (newer(`${o}/stamp`, inputs) && readFile(`${o}/stamp`) == entry) {
			continue
		}
		let root = `${o}/src`
		if (exists(root)) {
			removeAll(root)
		}
		mkdirAll(o)
		if (src instanceof string) {
			run(["cmake", "-E", "copy_directory", src, root])
		} else {
			// Its one directory as out/src, the same for any URL.
			const url = split(src[0], "#")
			save(`${o}/fetch.cmake`, `file(DOWNLOAD "${url[0]}" "${o}/src.tar" EXPECTED_HASH SHA256=${src[1]})
file(ARCHIVE_EXTRACT INPUT "${o}/src.tar" DESTINATION "${o}/fetch")`)
			run(["cmake", "-P", `${o}/fetch.cmake`])
			rename(glob(`${o}/fetch/*`)[0], root)
			if (url.length > 1) {
				root = join(root, url[1])
			}
		}
		for (const x of c.patches) {
			run(["patch", "-s", "-p1", "-d", root, "-i", `${cwd}/${x}`])
		}
		const preset = [...c.cmake.fields.map(e => `${quoted(e[0])}:${e[1]}`), `"name":"bober"`, `"generator":"Ninja"`]
		save(`${root}/CMakeUserPresets.json`,
			`{"version":${c.cmake.version},"configurePresets":[{${preset.join(",")}}]}`)
		save(`${o}/toolchain.cmake`, tools)
		mkdirAll(`${o}/build/.cmake/api/v1/query`)
		save(`${o}/build/.cmake/api/v1/query/codemodel-v2`, "")
		run(["cmake", "-S", root, "-B", `${o}/build`, "--fresh", "--preset", "bober", "--toolchain",
			`${cwd}/${o}/toolchain.cmake`, `-DCMAKE_PREFIX_PATH=${prefixes}`])
		run(["cmake", "--build", `${o}/build`])
		run(["cmake", "--install", `${o}/build`, "--prefix", o])
		save(`${o}/libs`, installed(`${o}/build`).join("\n"))
		save(`${o}/stamp`, entry)
	}
}

/// A target of a CMake project, as its file API describes it.
class Target {
	type: string = ""
	artifacts: Artifact[] = []
	install: Keys = new Keys()
	rest: Unknown[] @Rest = []
}

class Artifact {
	path: string = ""
}

/// The static libraries the CMake project built in build installs, as its file API tells.
function installed(build: string): string[] {
	const libs: string[] = []
	for (const f of glob(`${build}/.cmake/api/v1/reply/target-*.json`)) {
		let t = new Target()
		try {
			t = decodeJson[Target](readFile(f))
		} catch (e: ParseError) {
			throw new CompileError(`${f}: ${e.kind} error at byte ${e.at}`)
		}
		if (t.type == "STATIC_LIBRARY" && t.install.all.length > 0) {
			libs.push(...t.artifacts.map(a => join(build, a.path)))
		}
	}
	return libs
}

/// The paths that match any of patterns.
function globs(patterns: string[]): string[] {
	const out: string[] = []
	for (const p of patterns) {
		out.push(...glob(p))
	}
	return out
}

/// Whether the file at path exists and is newer than each of sources, so that it need not be made again.
function newer(path: string, sources: string[]): bool {
	if (!exists(path)) {
		return false
	}
	const t = stat(path).modified
	for (const s of sources) {
		if (stat(s).modified >= t) {
			return false
		}
	}
	return true
}

/// The object of the C that defines the static functions of module m of p, if a C header's module, whose path is the header's and
/// the names imported (src/check.bob, Modules.header), or null.
function glued(p: Program, m: i32, includes: string[]): string | null {
	const path = p.modules[m].path
	const at = indexOf(path, ": ")
	if (at < 0) {
		return null
	}
	const c = glue(path.slice(0, at), p.modules[m].decls.map(d => p.strings[p.decls[d].name]))
	if (c == "") {
		return null
	}
	const f = file(path)
	save(`${f}.c`, c)
	object(sysroot, `${f}.c`, `${f}.c.o`, [".", ...includes])
	return `${f}.c.o`
}

/// The executable's name for main: its file's, without .bob or .test.bob.
function name(main: string): string {
	let n = main
	for (const suffix of [".bob", ".test"]) {
		if (endsWith(n, suffix)) {
			n = n.slice(0, n.length - suffix.length)
		}
	}
	let i = n.length
	while (i > 0 && n[i - 1] != 0x2f) {
		i--
	}
	return n.slice(i, n.length)
}

/// Where the files of the module at path go, without extension: its path in the build directory, each / a _, relative to
/// bober's root if in it. A C header's module is named by its path and the names imported from it, which would be too
/// long a file name, so they are hashed instead.
function file(path: string): string {
	const space = indexOf(path, " ")
	let s = ""
	for (const c of rel(root, if (space < 0) path else path.slice(0, space)) ?? path) {
		s += if (c == 0x2f) "_" else chr(c)
	}
	if (space >= 0) {
		s += `.${fnv(path)}`
	}
	return `${dir}/${s}`
}

function save(path: string, s: string) {
	if (!writeFile(path, s)) {
		throw new CompileError(`cannot write ${path}`)
	}
}

/// Runs argv; throws if it fails.
function run(argv: string[]) {
	if (process.run(argv) != 0) {
		throw new CompileError(`failed: ${argv.join(" ")}`)
	}
}
