//! Tests of src/bober.bob's builds into the image, which keeps what it holds across them.

import { endsWith, indexOf, startsWith } from "../std/algo"
import { exists, glob, mkdirAll, open, remove } from "../std/fs"
import { base } from "../std/fs/path"
import * as process from "../std/process"
import { replace } from "../std/string"
import { Compile, build, format, machine, runTests, toolchain } from "./bober"
import { Bytes } from "./link/bytes"
import { Linker } from "./link/link"
import { CLib, dir } from "./pkg"

/// Where the running test builds, a directory of its own, by the number of its TMPDIR, that tests running at once do not
/// build in each other's, and as deep in the package as the build directory, that "../../" is its root.
function home(): string { return `build/image-test${base(process.env("TMPDIR")!)}` }

/// The files of the program, main.bob's calling size of n types.
function files(n: i32): [string, string][] {
	return [["types.bob", types], ["own.bob", own], ["lib.bob", lib], ["main.bob", program(n)]]
}

/// What main prints, built in home at level, as lowered if "", with the files written first.
function built(files: [string, string][], level = "", main = "main.bob"): string {
	mkdirAll(home())
	for (const [name, src] of files) {
		writeFile(`${home()}/${name}`, src)
	}
	const f = new Compile()
	f.O1 = level == "-O1"
	f.O2 = level == "-O2"
	f.release = level == "-release"
	dir = `${home()}/build`
	try {
		process.run(build(`${home()}/${main}`, false, f, false), `${home()}/out`)
	} finally {
		dir = "build"
	}
	return readFile(`${home()}/out`)!
}

/// The objects home's image holds.
function held(): string[] {
	const image = open(`${home()}/build/image.so`)
	const names = new Linker(machine, format, new Bytes(image.map())).objects().map(o => o.copy()) // not the image's, which a later build may write in place
	image.close()
	return names
}

/// Removes home's image, that the next build starts anew rather than as an edit of the last run's.
function anew() {
	if (exists(`${home()}/build/image.so`)) {
		remove(`${home()}/build/image.so`)
	}
}

const types = `
export class P {
	x = 1

	name(): string { return \`p\${this.x}\` }
}

export type Which = "a" | "b"
export const which: Which = "a"
`

/// A module with a class of its own that it instances lib.bob's Box of.
const own = `
import { Box } from "./lib"

class Q { v = 1 }

export function boxed(): i32 { return new Box[Q](new Q()).get().v }
`

const lib = `
export class Box[T] {
	static made = 0
	v: T

	constructor(v: T) {
		this.v = v
		Box[T].made++
	}

	get(): T { return this.v }
}

export interface Named { name(): string }

export function show[T extends Named](xs: T[]): string { return xs.map(x => x.name()).join(",") }
export class Applied[T] {
	v: T

	constructor(f: (x: T) => T, x: T) { this.v = f(x) }
}

export function twice[T](f: (x: T) => T, x: T): T { return new Applied[T](y => f(f(y)), x).v }
export function check[T](x: T, bad: T): T {
	if (x == bad) {
		throw "bad"
	}
	return x
}
interface AB extends "a" | "b" {}

export function isA[T extends AB](v: T): bool { return v == "a" }
export function described[T](): string { return named(t => \`\${t}\`) }
export function size[T](): i32 { return 1 }

function named(f: (t: Type) => string): string { return f(i32) }
`

/// main.bob, which calls size of n types and prints what the rest of lib.bob gives it.
function program(n: i32): string {
	let sizes = ""
	let t = "i32"
	for (const _ of 1 ... n) {
		t += "[]"
		sizes += `	k += size[${t}]()\n`
	}
	return `import { Box, check, described, isA, show, size, twice } from "./lib"
import { P, Which, which } from "./types"
import { boxed } from "./own"

function main() {
	let k = 0
${sizes}	const b = new Box[i32](2)
	new Box[string]("s").get()
	let thrown = ""
	try {
		check("x", "x")
	} catch (e: string) {
		thrown = e
	}
	print(\`\${k} \${b.get()} \${Box[i32].made} \${Box[string].made} \${show([new P(), new P()])} \${twice(x => x * 3, 2)} \${boxed()}\`)
	print(\`\${thrown} \${isA([which].join("") as Which)} \${described[f64]()}\`)
}
`
}

/// What main.bob prints, size summed to k.
function printed(k: i32): string { return `${k} 2 1 1 p1,p1 18 1\nbad true i32\n` }

test "a trap in -O2's code shows its line, after an edit above it" {
	const lib = "export function at(xs: i32[]): i32 { return xs[1] }\n"
	const main = `import { at } from "./lib"\nfunction main() { at([]) }\n`
	anew()
	const out = built([["lib.bob", lib], ["main.bob", main]], "-O2")
	built([["lib.bob", `\n${lib}`]], "-O2") // by TPDE
	const again = built([], "-O2")
	assert indexOf(out, "lib.bob:1:47: trap") >= 0 && indexOf(again, "lib.bob:2:47: trap") >= 0
}

test "a class at -O0 embeds one laid out first, though one it refers to completes it" {
	anew()
	const main = `class Strand {
	next: Bead | null = null
}
class Bead {
	...Strand
	k = 0
}
class Rope {
	...Strand
	last: ...Bead
}
function main() {
	const r = new Rope()
	const b = new Bead()
	b.k = 5
	r.last = { ...b }
	print(\`\${r.last.k}\`)
}
`
	assert built([["main.bob", main]]) == "5\n"
}

test "a union cast to an interface or a type param at -O0 traps if the value does not fit" {
	anew()
	const main = "interface HasSide { side: f64 }\nfunction side(n: HasSide | null): f64 { return n!.side }\nfunction main() { side(null) }\n"
	assert built([["main.bob", main]]) == `${home()}/main.bob:2:49: trap: cast to a type that is not the value's\n`
	const zero = "class C {}\nfunction zero[T](): [T] {\n\tconst z: T | null = null\n\treturn [z as T]\n}\nfunction main() {\n\tzero[C | null]()\n\tprint(\"n\")\n\tzero[C]()\n}\n"
	assert built([["main.bob", zero]]) == `n\n${home()}/main.bob:4:12: trap: cast to a type that is not the value's\n`
}

test "a generic class formed at run time at -O0 is laid out once its fields are" {
	anew()
	const main = `class Link[T] {
	next: Bead[T] | null = null
}
class Bead[T] {
	...Link[T]
	v: T | null = null
	w: i16 = 0
}
function bead[T](v: T): Bead[T] {
	const b = new Bead[T]()
	b.v = v
	b.w = 2
	return b
}
function main() {
	const b = bead[bool](true)
	print(\`\${b.v!} \${b.w}\`)
}
`
	assert built([["main.bob", main]]) == "true 2\n"
}

test "a union of more than 256 classes, which a tag byte does not tell apart, holds each at every level" {
	let classes = ""
	const names: string[] = []
	for (const i of 0 ... 256) {
		classes += `class C${i} { n(): i32 { return ${i} } }\n`
		names.push(`C${i}`)
	}
	const big = names.join(" | ")
	const main = `${classes}\ninterface N { n(): i32 }\n
class Held[T] {\n\tv: T\n\n\tconstructor(v: T) { this.v = v }\n}\n
function main() {
	const xs: (${big})[] = [${names.map(c => `new ${c}()`).join(", ")}]
	let wrong = 0
	for (const i of 0 ... 256) {
		const x: N = new Held[${big}](xs[i]).v
		wrong += if (x.n() == i) 0 else 1
	}
	print(\`\${wrong}\`)
}\n`
	for (const level of ["", "-O1", "-O2", "-release"]) {
		assert built([["main.bob", main]], level) == "0\n"
	}
}

test "-O2 keeps the refs of a function holding many over many calls in an object, which collections between move" {
	let made = ""
	let pushed = ""
	for (const i of 0 ... 199) {
		made += `\tconst p${i} = new P()\n\tp${i}.x = ${i}\n\tchurn()\n`
		pushed += `\tps.push(p${i})\n`
	}
	const main = `class P {\n\tx: i64 = 0\n}\n
let last: P[] = []\n\nfunction churn() {\n\tconst ps: P[] = []\n\tfor (const i of 0 ... 16383) {\n\t\tps.push(new P())\n\t}
\tlast = ps\n}\n\nfunction made(): P[] {\n${made}\tconst ps: P[] = []\n${pushed}\treturn ps\n}\n
function main() {\n\tlet sum: i64 = 0\n\tfor (const p of made()) {\n\t\tsum += p.x\n\t}\n\tprint(\`\${sum}\`)\n}\n`
	assert built([["main.bob", main]], "-O2") == "19900\n"
}

test "-O2 has LLVM compile each monomorphized module, an edited one TPDE until it is unchanged, which -O1 keeps" {
	const units = () => held().filter(o => indexOf(o, "^O") >= 0)
	anew()
	const out = built(files(1), "-O2")
	const fresh = units()
	assert out == printed(1) && fresh.length > 0 && fresh.every(o => indexOf(o, "^O2@") >= 0)
	const edited = built([["lib.bob", replace(lib, "return f(i32)", "return f(i64)")]], "-O2")
	assert edited == replace(out, "true i32", "true i64") && units().some(o => startsWith(o, `${home()}/lib.bob^O1@`))
	const again = built([], "-O2")
	const opt = units()
	assert again == edited && opt.every(o => indexOf(o, "^O2@") >= 0) && built([], "-O1") == edited && units() == opt
}

test "a program is launched as its entry and the version of what it is linked from, which an edit of a module changes" {
	const main = `import { name } from "../../std/process"\nimport { one } from "./dep"\n
function main() { print(\`\${name()} \${one()}\`) }\n`
	const run = (one: string) => built([["dep.bob", `export function one(): i32 { return ${one} }\n`],
		["main.bob", main]])
	const [out, again, edited] = [run("1"), run("1"), run("2")]
	assert startsWith(out, `bober.main.${home()}/main.bob@`) && again == out
	assert edited != replace(out, " 1", " 2") && endsWith(edited, " 2\n")
}

test "a test file whose report is kept leaves no pin of the image, which its launcher would remove" {
	const kept = `${home()}/kept.bob`
	mkdirAll(home())
	writeFile(kept, `test "t" { assert true }\n`)
	const pins = () => glob(`${home()}/build/image.so.*.run`)
	const before = pins()
	const run = () => runTests(kept, [], () => build(kept, true, new Compile(), true))()[0]
	dir = `${home()}/build`
	try {
		assert run() == 0 && run() == 0
	} finally {
		dir = "build"
	}
	assert pins() == before
}

test "a module's unit as lowered and monomorphized are held side by side, each build linking its own" {
	anew()
	const [out, mono] = [built(files(1)), built([], "-O1")]
	const both = held()
	assert out == printed(1) && mono == out && built([]) == out && held() == both
	assert both.some(o => startsWith(o, `${home()}/lib.bob@`)) && both.some(o => startsWith(o, `${home()}/lib.bob^O1@`))
}

test "programs that share a module, each of other instances of its generic and classes of its interface, built -O1" {
	const lib = `export class Box[T] {\n\tv: T\n\n\tconstructor(v: T) { this.v = v }\n}\n
export interface Named { name(): string }\n\nexport function named(x: Named): string { return x.name() }\n`
	const main = (c: string, t: string, v: string) => `import { Box, named } from "./lib"\n
class ${c} { name(): string { return "${c}" } }\n
function main() { print(\`\${new Box[${t}](${v}).v} \${named(new ${c}())}\`) }\n`
	anew()
	const a = built([["lib.bob", lib], ["a.bob", main("A", "i32", "1")], ["b.bob", main("B", "string", `"s"`)]], "-O1",
		"a.bob")
	assert a == "1 A\n" && built([], "-O1", "b.bob") == "s B\n" && built([], "-O1", "a.bob") == a
}

test "programs that share a module keep its unit, one for both, though each instances its generic of its own" {
	const lib = `export class Box[T] {\n\tv: T\n\n\tconstructor(v: T) { this.v = v }\n}\n
export class Made[T] {\n\tstatic made = 0\n\n\tconstructor() { Made[T].made++ }\n
	count(): i32 { return Made[T].made }\n}\n
export function made(): i32 { return new Box[Made[i32]](new Made[i32]()).v.count() }\n
export interface Rose { v: i32; kids: Rose[] }\n
export function sum(r: Rose): i32 { return r.v + (if (r.kids.length == 0) 0 else sum(r.kids[0])) }\n`
	const main = (t: string, v: string) => `import { Box, Made, made, sum } from "./lib"\n
function main() {
	new Made[i32]()
	print(\`\${new Box[${t}](${v}).v} \${made()} \${Made[i32].made} \${sum({ v: 1, kids: [{ v: 2, kids: [] }] })}\`)
}\n`
	anew()
	const a = built([["lib.bob", lib], ["a.bob", main("i32", "1")], ["b.bob", main("string", `"s"`)]], "-O1", "a.bob")
	const units = held()
	assert a == "1 2 2 3\n" && built([], "-O1", "b.bob") == "s 2 2 3\n"
	const both = held()
	assert units.filter(o => both.indexOf(o) < 0) == [] && built([], "-O1", "a.bob") == a && held() == both
}

test "programs of a package, each with a class of a module's interface, link the same units, its one for both" {
	const lib = `export interface Named { name(): string }\n\nexport function named(x: Named): string { return x.name() }\n`
	const main = (c: string) => `import { named } from "./lib"\n\nclass ${c} { name(): string { return "${c}" } }\n
function main() { print(named(new ${c}())) }\n`
	anew()
	mkdirAll(`${home()}/pkg`)
	const a = built([["pkg/bober.pkg", `{ "name": "@test/pkg" }\n`], ["pkg/lib.bob", lib], ["pkg/a.bob", main("A")],
		["pkg/b.bob", main("B")]], "-O1", "pkg/a.bob")
	const units = held()
	assert a == "A\n" && built([], "-O1", "pkg/b.bob") == "B\n" && held() == units
}

test "a class changed, a generic of another module instanced of it is compiled anew, monomorphized" {
	const lib = `export interface HasV { v: i32 }\n\nexport function v[T extends HasV](x: T): i32 { return x.v }\n`
	const main = (q: string) => `import { v } from "./lib"\n\nclass Q {${q}\n\tv = 1\n}\n
function main() { print(\`\${v(new Q())}\`) }\n`
	anew()
	assert built([["lib.bob", lib], ["main.bob", main("")]], "-O1") == "1\n"
	assert built([["main.bob", main("\n\ty = 5")]], "-O1") == "1\n"
}

test "a C library's toolchain file includes its own, of a package found by a rooted path or not" {
	const c = new CLib()
	c.toolchain = "/p/tc.cmake"
	assert indexOf(toolchain(c, "/w"), `include("/p/tc.cmake")`) >= 0
	c.toolchain = "tc.cmake"
	assert indexOf(toolchain(c, "/w"), `include("/w/tc.cmake")`) >= 0
}
