//! Tests of src/bober.bob's builds into the image, which keeps what it holds across them.

import { indexOf } from "../std/algo"
import { exists, mkdirAll, open, remove } from "../std/fs"
import * as process from "../std/process"
import { replace } from "../std/string"
import { Compile, build, dir, format, machine } from "./bober"
import { Bytes } from "./link/bytes"
import { Linker } from "./link/link"

const home = "build/image-test"

/// The files of the program, main.bob's calling size of n types.
function files(n: i32): [string, string][] {
	return [["types.bob", types], ["own.bob", own], ["lib.bob", lib], ["main.bob", program(n)]]
}

/// What main.bob prints, built in home with the files written first, -O2 if o2; and the objects of lib.bob's
/// instances and overlays its image holds.
function built(files: [string, string][], o2: bool): [string, string[]] {
	mkdirAll(home)
	for (const [name, src] of files) {
		writeFile(`${home}/${name}`, src)
	}
	const f = new Compile()
	f.O1 = false
	f.O2 = o2
	dir = `${home}/build`
	try {
		process.run(build(`${home}/main.bob`, false, f, false), `${home}/out`)
	} finally {
		dir = "build"
	}
	const image = open(`${home}/build/image.so`)
	const held = new Linker(machine, format, new Bytes(image.map())).objects().filter(o => indexOf(o, "lib.bob~") >= 0 || indexOf(o, "lib.bob^") >= 0)
		.map(o => o.copy()) // not the image's, which a later build may write in place
	image.close()
	return [readFile(`${home}/out`)!, held]
}

/// Removes home's image, that the next build starts anew rather than as an edit of the last test's.
function anew() {
	if (exists(`${home}/build/image.so`)) {
		remove(`${home}/build/image.so`)
	}
}

const types = `
export class P {
	x = 1

	name(): string { return \`p\${this.x}\` }
}

export type Which = "a" | "b"
export const which: Which = "a"
`

/// A module with a class of its own that it instances lib.bob's Box of.
const own = `
import { Box } from "./lib"

class Q { v = 1 }

export function boxed(): i32 { return new Box[Q](new Q()).get().v }
`

const lib = `
export class Box[T] {
	static made = 0
	v: T

	constructor(v: T) {
		this.v = v
		Box[T].made++
	}

	get(): T { return this.v }
}

export interface Named { name(): string }

export function show[T extends Named](xs: T[]): string { return xs.map(x => x.name()).join(",") }
export class Applied[T] {
	v: T

	constructor(f: (x: T) => T, x: T) { this.v = f(x) }
}

export function twice[T](f: (x: T) => T, x: T): T { return new Applied[T](y => f(f(y)), x).v }
export function check[T](x: T, bad: T): T {
	if (x == bad) {
		throw "bad"
	}
	return x
}
interface AB extends "a" | "b" {}

export function isA[T extends AB](v: T): bool { return v == "a" }
export function described[T](): string { return named(t => \`\${t}\`) }
export function size[T](): i32 { return 1 }

function named(f: (t: Type) => string): string { return f(i32) }
`

/// main.bob, which calls size of n types and prints what the rest of lib.bob gives it.
function program(n: i32): string {
	let sizes = ""
	let t = "i32"
	for (const _ of 1 ... n) {
		t += "[]"
		sizes += `	k += size[${t}]()\n`
	}
	return `import { Box, check, described, isA, show, size, twice } from "./lib"
import { P, Which, which } from "./types"
import { boxed } from "./own"

function main() {
	let k = 0
${sizes}	const b = new Box[i32](2)
	new Box[string]("s").get()
	let thrown = ""
	try {
		check("x", "x")
	} catch (e: string) {
		thrown = e
	}
	print(\`\${k} \${b.get()} \${Box[i32].made} \${Box[string].made} \${show([new P(), new P()])} \${twice(x => x * 3, 2)} \${boxed()}\`)
	print(\`\${thrown} \${isA([which].join("") as Which)} \${described[f64]()}\`)
}
`
}

/// What main.bob prints, size summed to k.
function printed(k: i32): string { return `${k} 2 1 1 p1,p1 18 1\nbad true i32\n` }

/// Those of held, built's, of lib.bob's instances.
function instances(held: string[]): string[] { return held.filter(o => indexOf(o, "lib.bob~") >= 0) }

test "an edit of a generic's body unlinks its instances, the build running the new body" {
	built(files(1), true)
	const [out, held] = built([["lib.bob", replace(lib, "return 1", "return 2")]], false)
	assert out == printed(2) && held.length == 0
}

test "a change of the layout of a type arg's class unlinks the instances of it, its module's export or not" {
	for (const [file, src, from] of [["types.bob", types, "x = 1"], ["own.bob", own, "v = 1"]]) {
		built(files(1), true)
		const [out, held] = built([[file, replace(src, from, `y = 5\n\t${from}`)]], false)
		assert out == printed(1) && instances(held).length == 0
	}
}

test "a new instance compiles one bucket anew" {
	const before = instances(built(files(150), true)[1])
	const [out, held] = built([["main.bob", program(151)]], true)
	const after = instances(held)
	assert before.length == 4 && after.length == 4 && after.filter(o => !before.includes(o)).length == 1
	assert out == printed(151)
}

test "-O2 compiles by LLVM the instances and each module's functions over their code, which a build without keeps" {
	const [out, held] = built(files(1), true)
	assert out == printed(1) && held.some(o => indexOf(o, "lib.bob^O2@") >= 0) && held.every(o => indexOf(o, "^O2@") >= 0)
	const [again, kept] = built([["main.bob", replace(program(1), "let k = 0", "let k = 1")]], false)
	assert again == printed(2) && kept == held
	assert built([], true) == [printed(2), held]
}

test "an edit of a module unlinks its overlay, the build running the new code" {
	built(files(1), true)
	const [out, held] = built([["lib.bob", replace(lib, "return f(i32)", "return f(i64)")]], false)
	assert out == `1 2 1 1 p1,p1 18 1\nbad true i64\n` && held.length == 0
}

test "an edited module runs on its base code, the first -O2 build that finds it unchanged optimises it again" {
	const overlays = (held: string[]) => held.filter(o => indexOf(o, "lib.bob^O2@") >= 0).length
	anew()
	const [_, held] = built(files(1), true)
	const [out, kept] = built([["main.bob", replace(program(1), "let k = 0", "let k = 1")]], true)
	assert overlays(held) == 1 && out == printed(2) && kept == held
	for (const t of ["i64", "i16"]) {
		const [edited, base] = built([["lib.bob", replace(lib, "return f(i32)", `return f(${t})`)]], true)
		assert edited == `2 2 1 1 p1,p1 18 1\nbad true ${t}\n` && overlays(base) == 0
	}
	const [again, back] = built([], true)
	assert again == `2 2 1 1 p1,p1 18 1\nbad true i16\n` && overlays(back) == 1
}

test "a trap in -O2's code shows its line, after an edit above it" {
	const lib = "export function at(xs: i32[]): i32 { return xs[1] }\n"
	const main = `import { at } from "./lib"\nfunction main() { at([]) }\n`
	anew()
	const out = built([["lib.bob", lib], ["main.bob", main]], true)[0]
	built([["lib.bob", `\n${lib}`]], true) // its base code
	const again = built([], true)[0]
	assert indexOf(out, "lib.bob:1:47: trap") >= 0 && indexOf(again, "lib.bob:2:47: trap") >= 0
}

test "an export added to a module keeps the code of one that imports it, a change of what it names does not" {
	const dep = "export function one(): i32 { return 1 }\n"
	const lib = `import { one } from "./dep"\nexport function two(): i32 { return one() + 1 }\n`
	const main = `import { two } from "./lib"\nfunction main() { print(\`\${two()}\`) }\n`
	anew()
	const [out, held] = built([["dep.bob", dep], ["lib.bob", lib], ["main.bob", main]], true)
	const [again, kept] = built([["dep.bob", `${dep}export function three(): i32 { return 3 }\n`]], true)
	assert out == "2\n" && again == out && held.length > 0 && kept == held
	const [changed, anew] = built([["dep.bob", "export function one(x = 2): i32 { return x }\n"]], true)
	assert changed == "3\n" && anew.length > 0 && !anew.some(o => held.includes(o))
}
