//! Values as a template converts them (spec 6.9), which a template's pieces are lowered to, and as a failed assert shows
//! them.

import { formatFloat } from "../std/float"
import { quoted, split } from "../std/string"
import { addr } from "./mem"
import { copy } from "./string"

/// x as a template converts it when its type has no toString of its own: by its structure, as JSON writes it.
///
/// ## Templates
///
/// Each `${v}` is converted by `v.toString()`. Every type has `toString(): string`; one it does not declare shows a
/// string as is, an integer in decimal, a float in the shortest decimal that round-trips, a bool as `true`/`false`,
/// `null` as `null`, a `Type` by its name, an array, fixed array or tuple as `[a, b]`, and an object or class as `{"k": v}`, its
/// elements and fields each by their own `toString`, strings among them quoted.
///
/// ```
/// class P { x = 0; toString(): string { return `P(${this.x})` } }
/// `${new P()}` == "P(0)"
/// `${[{ a: "x", p: new P() }]}` == `[{"a": "x", "p": P(0)}]`
/// ```
export function show[T](x: T): string {
	switch (T.kind) {
		case "null": return "null"
		case "bool": return if (x) "true" else "false"
		case "int": return if (x < 0) "-" + showUint((0 - (x as i64)) as u64) else showUint(x as u64)
		case "float": return formatFloat(x)
		case "string": return x
		case "literal": return show[string | bool | i64 | null](T.value)
		case "type": return x.name
		case "array", "fixed":
			const es: string[] = []
			for (const e of x) {
				es.push(item(e))
			}
			return `[${es.join(", ")}]`
		case "tuple":
			const es: string[] = []
			for (const f of T.fields) {
				es.push(item(x[f.name]))
			}
			return `[${es.join(", ")}]`
		case "object", "class":
			const fs: string[] = []
			for (const f of T.fields) {
				if (f.type.kind != "function") {
					fs.push(`${quoted(f.name)}: ${item(x[f.name])}`)
				}
			}
			return `{${fs.join(", ")}}`
		case "union":
			for (const M of T.members) {
				if (x instanceof M) {
					return `${x}`
				}
			}
	}
	return T.kind
}

/// x as an element or field of what show shows, or a value a failed assert shows: a string quoted, else by its
/// toString.
export function item[T](x: T): string {
	if (T.kind == "string") {
		return quoted(x)
	}
	return `${x}`
}

/// a and b, which an assert failed to find equal, as it shows them: on a line each after two spaces, the lines only in a
/// after -, those only in b after +, and those of both after a space, all but the two next to a change left out as ….
export function diff(a: string, b: string): string {
	const xs = split(a, "\n")
	const ys = split(b, "\n")
	let lo = 0
	while (lo < xs.length && lo < ys.length && xs[lo] == ys[lo]) {
		lo++
	}
	let n = xs.length
	let m = ys.length
	while (n > lo && m > lo && xs[n - 1] == ys[m - 1]) {
		n--
		m--
	}
	// common[(i - lo) * w + j - lo]: how many of xs[i:n] are among ys[j:m] in order, at most
	const w = m - lo + 1
	const common = new i32[]((n - lo + 1) * w)
	for (const i of 1 ... n - lo) {
		for (const j of 1 ... m - lo) {
			const k = (n - lo - i) * w + m - lo - j
			common[k] = if (xs[n - i] == ys[m - j]) common[k + w + 1] + 1
				else if (common[k + w] > common[k + 1]) common[k + w] else common[k + 1]
		}
	}
	const lines = xs.slice(0, lo).map(x => `  ${x}`)
	let i = lo
	let j = lo
	while (i < n || j < m) {
		const k = (i - lo) * w + j - lo
		if (i < n && j < m && xs[i] == ys[j]) {
			lines.push(`  ${xs[i]}`)
			i++
			j++
		} else if (j == m || i < n && common[k + w] >= common[k + 1]) {
			lines.push(`- ${xs[i]}`)
			i++
		} else {
			lines.push(`+ ${ys[j]}`)
			j++
		}
	}
	lines.append(xs.slice(n, xs.length).map(x => `  ${x}`))
	const changed = (k: i32) => k >= 0 && k < lines.length && lines[k][0] != 0x20
	const near = (k: i32) => changed(k - 2) || changed(k - 1) || changed(k) || changed(k + 1) || changed(k + 2)
	let out = ""
	for (const k of 0 ... lines.length - 1) {
		if (near(k)) {
			out = `${out}\n  ${lines[k]}`
		} else if (k == 0 || near(k - 1)) {
			out = `${out}\n  …`
		}
	}
	return out
}

function showUint(n: u64): string {
	let digits: u8[20]
	let i = 20
	let v = n
	while (i == 20 || v > 0) {
		i -= 1
		digits[i] = ((v % 10) as u8) + 0x30
		v /= 10
	}
	return copy(addr(digits) + (i as u64), (20 - i) as i64)
}
