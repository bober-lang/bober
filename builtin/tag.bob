//! The tags (§5.3) the checker knows.

/// Marks a declaration or member as deprecated: a use from another module is a warning. R says why, a string, or names
/// what to use instead, `{ use: T }` or `{ use: T, why: "…" }`, with `typeof f` for a function or value `f`.
export class Deprecated[R = ""] {}
/// Marks a declaration or member as experimental, apt to change or go: a use from another module is a warning.
export class Experimental {}
/// Marks a C import as deterministic: what its functions give depends on their arguments alone, so a test that calls
/// them is cached still (src/check.bob, Tests and assertions).
export class Deterministic {}
/// Marks a function as one C calls by the name Name, with C's ABI (§3.1).
export class C[Name extends string] {}
/// Marks an import as of TypeScript typings, an npm package's or a .d.ts file's (src/dts.bob).
export class TypeScript {}
/// Marks an import as of a file's bytes, `import x from "p" @Embed`, x a string of them, mapped from the program as
/// they are read; Codec "deflate" holds them deflated in the program, inflated as it starts: a smaller program, for the
/// time that takes.
export class Embed[Codec extends string = ""] {}
/// Marks a function imported of TypeScript typings as giving a Promise, which a program compiled to JavaScript awaits
/// at each call.
export class Promise {}
