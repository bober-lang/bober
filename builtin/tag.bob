//! The tags (§5.3) the checker knows.

/// Marks a declaration or member as deprecated: a use from another module is a warning. R says why, a string, or names
/// what to use instead, `{ use: T }` or `{ use: T, why: "…" }`, with `typeof f` for a function or value `f`.
export class Deprecated[R = ""] {}

/// Marks a declaration or member as experimental, apt to change or go: a use from another module is a warning.
export class Experimental {}
