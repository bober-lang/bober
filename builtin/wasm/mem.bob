//! builtin/mem.bob for WebAssembly GC (src/wasm.bob), which has no addresses: the intrinsics it emits, the rest, and
//! what traps or runs a test, imports of the JS host it writes, which trap with their name if it has none.

/// A ref, a pointer the collector knows (src/rt.h), to what it does not know the type of.
export class Ref {}

export function alloc[T](n: i64): Ref
export function array[T](n: i64): T[]
export function deref(r: Ref): u64
export function sizeOf[T](): i64
export function load[T](p: u64): T
export function store[T](p: u64, x: T)
export function addr[T](x: T): u64
export function zero[T](): T
export function memcpy(to: u64, from: u64, n: u64)
export function memcmp(a: u64, b: u64, n: u64): i32
export function trap(what: string)
export function subtest(name: string, f: () => null)
export function mark(at: i32)
/// A new string of n zero bytes, which setByte and copyBytes fill before anything else sees it.
export function newString(n: i32): string
export function setByte(s: string, i: i32, b: u8)
/// Copies the n bytes of from at start to to at at.
export function copyBytes(to: string, at: i32, from: string, start: i32, n: i32)
/// How many of s's bytes are free after it if it is the string that ends where they are used, else -1.
export function room(s: string): i32
/// A string of the first n of s's bytes, which then ends where they are used instead of s.
export function extend(s: string, n: i32): string
