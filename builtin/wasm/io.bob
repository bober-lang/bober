//! builtin/io.bob for WebAssembly GC (src/wasm.bob): the JS host's, which it imports.

import { bits } from "./math"

export function print[T](x: T) { put(1, `${x}\n`) }
/// Writes s to fd; whether all of it was.
function put(fd: i32, s: string): bool
export function readFile(path: string): string | null
export function writeFile(path: string, s: string): bool

export function args(): string[] {
	const r: string[] = []
	for (const i of 1 ... argc() - 1) {
		r.push(arg(i))
	}
	return r
}

function argc(): i32
function arg(i: i32): string
export function targetOs(): string { return "wasm" }
export function targetArch(): string { return "wasm" }
export function now(): i64
export function random(): u64
export function env(name: string): string | null

/// Of a union, that of the value it holds; of a float, its bits, as BigInt takes no fraction.
export function idOf[T](x: T): u64 {
	switch (T.kind) {
		case "union": for (const M of T.members) {
			if (x instanceof M) {
				return idOf(x)
			}
		}
		case "float": return bits(x)
	}
	return id(x)
}

/// The host's number of a ref while it lives, else of its value.
function id[T](x: T): u64
