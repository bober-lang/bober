//! What ** of integers is lowered to.

import { Integral } from "../std/types"
import { trap } from "./mem"

/// a ** b, wrapped; traps on a negative b.
export function pow[T extends Integral](a: T, b: T): T {
	if (b < 0) {
		trap("negative exponent")
	}
	let r: T = 1
	let x = a
	let e = b
	while (e > 0) {
		if ((e & 1) != 0) {
			r *= x
		}
		x *= x
		e >>= 1
	}
	return r
}
