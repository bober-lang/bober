//! Equality by value, which == and != in an assert are lowered to (§5.5), and the string literal a string spells.

import { idOf } from "./io"
import { trap, zero } from "./mem"

/// The ids of the pairs of class instances equal is in, a's then b's, the outermost first: a cycle passes through one,
/// as a type refers to itself only through a class.
let comparing: u64[] = []

/// Whether a and b hold the same value: as == compares them, or else arrays and tuples element by element, objects and
/// classes field by field, and a union's members by tag and then value; a pair met again within itself is equal.
export function equal[T](a: T, b: T): bool {
	if (a == b) {
		return true
	}
	const t = typeof a
	switch (t.kind) {
		case "union":
			for (const M of t.members) {
				if (a instanceof M) {
					return b instanceof M && equal(a, b)
				}
			}
			return false
		case "array":
			if (a.length != b.length) {
				return false
			}
			for (const i of 0 ... a.length - 1) {
				if (!equal(a[i], b[i])) {
					return false
				}
			}
			return true
		case "tuple", "object": return fields(a, b)
		case "class", "interface":
			const ia = idOf(a)
			const ib = idOf(b)
			for (const i of 0 ... comparing.length / 2 - 1) {
				if (comparing[2 * i] == ia && comparing[2 * i + 1] == ib) {
					return true
				}
			}
			comparing.push(ia)
			comparing.push(ib)
			const e = fields(a, b)
			comparing.pop()
			comparing.pop()
			return e
		default: return false
	}
}

/// Whether a and b, tuples, objects, class instances or interfaces, hold equal fields.
function fields[T](a: T, b: T): bool {
	for (const f of T.fields) {
		if (!equal(a[f.name], b[f.name])) {
			return false
		}
	}
	return true
}

/// The literal of T, a string literal type or a union of them, that s spells: the program's one value of it (§4.2),
/// which s as T is; traps if there is none.
export function literal[T](s: string): T {
	for (const M of T.members) {
		if (M.kind == "literal") {
			if (s == M.value) {
				return M.value
			}
		}
	}
	trap("not a literal of the type")
	return zero[T]()
}
