{
	"name": "@bober/bober",
	"c": {
		"llvm": {
			"src": ["https://github.com/llvm/llvm-project/archive/6989f0e555cb9ba5bf85858934063b1a08b8324a.tar.gz#llvm",
				"665221cd5e459450d86dee65a6ff2a029a877536f080c3bce20bb86428a80b47"],
			"cmake": {
				"version": 6,
				"cacheVariables": {
					"CMAKE_BUILD_TYPE": "Release",
					"LLVM_ENABLE_PROJECTS": "lld",
					"LLVM_TARGETS_TO_BUILD": "X86;AArch64;WebAssembly",
					"LLVM_BUILD_TOOLS": "OFF",
					"LLD_BUILD_TOOLS": "OFF",
					"LLVM_TOOL_LTO_BUILD": "OFF",
					"LLVM_TOOL_REMARKS_SHLIB_BUILD": "OFF",
					"LLVM_INCLUDE_TESTS": "OFF",
					"LLVM_INCLUDE_EXAMPLES": "OFF",
					"LLVM_INCLUDE_BENCHMARKS": "OFF",
					"LLVM_ENABLE_ZLIB": "OFF",
					"LLVM_ENABLE_ZSTD": "OFF",
					"LLVM_ENABLE_LIBXML2": "OFF",
					"LLVM_ENABLE_LIBEDIT": "OFF",
					"LLVM_ENABLE_LIBPFM": "OFF"
				}
			},
			"toolchain": "src/backend/clang.cmake",
			"include": ["include"]
		},
		"tpde": {
			"src": "vendor/tpde",
			"patches": ["src/backend/tpde/tpde.patch"],
			"cmake": {
				"version": 6,
				"cacheVariables": {
					"CMAKE_BUILD_TYPE": "Release",
					"TPDE_ENABLE_LLVM": "OFF",
					"TPDE_INCLUDE_TESTS": "OFF",
					"TPDE_LOGGING": "OFF",
					"TPDE_LINK_LLVM_STATIC": "ON"
				}
			},
			"toolchain": "src/backend/clang.cmake"
		},
		"tpde-c": {
			"src": "src/backend/tpde",
			"cmake": { "version": 6, "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
			"toolchain": "src/backend/clang.cmake",
			"include": ["."]
		},
		"lld-c": {
			"src": "src/backend/llvm",
			"cmake": { "version": 6, "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
			"toolchain": "src/backend/clang.cmake",
			"include": ["."]
		}
	}
}
