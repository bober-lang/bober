function main() {
	print(42)
	const small: i8 = -128
	print(small)
	let big: u64 = 0
	big -= 1
	print(big)
	let low: i64 = -9223372036854775807
	print(low - 1)
	print(2.5)
	print(-0.25)
	const half: f32 = 0.5
	print(half)
	let a = 0.1
	let b = 0.2
	print(a + b)
	print(true)
	print(null)
	print("")
	print("tab\there")
}
