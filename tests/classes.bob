import { New } from "../std/types"

class Counter {
	n = 0
	step: i32
	label: string
	done: bool
	byte: u8
	static created = 0

	constructor(step: i32) {
		this.step = step
		Counter.created += 1
	}

	inc() { this.n += this.step }
	value(): i32 { return this.n }
	twice(): i32 { return this.value() * 2 }
	static make(): Counter { return new Counter(1) }
}

class Chain {
	a = 1
	b = this.a + 1
	c: i32

	constructor() { this.c = this.b * 10 }
}

interface Shape {
	area(): f64
}

class Sq implements Shape {
	private readonly side = 1.0

	constructor(side: f64) { this.side = side }
	area(): f64 { return this.side * this.side }
}

interface Named {
	name(): string
}

/// Embeds Shape and Named: has their methods too.
interface Labeled {
	...Shape
	...Named
}

/// Extends Shape: has its method too.
interface Sized extends Shape {
	size(): i32
}

class Tile implements Labeled {
	area(): f64 { return 1.0 }
	name(): string { return "tile" }
}

/// Labeled by its members alone.
class Plate {
	area(): f64 { return 2.0 }
	name(): string { return "plate" }
	size(): i32 { return 3 }
}

interface Holds[T] {
	item: T | null
}

class Box[T] implements Holds[T] {
	item: T | null = null

	constructor(item: T) { this.item = item }
}

test "fields start at zero values and keep their kind" {
	const c = new Counter(2)
	assert c.n == 0 && c.step == 2
	assert c.label == "" && !c.done && c.byte == 0
	c.byte = 255
	c.byte += 1
	assert c.byte == 0
}

test "methods see this; instances are references" {
	const c = new Counter(2)
	const d = c
	c.inc()
	d.inc()
	assert c.twice() == 8
	const same = c == d && c != new Counter(2) // by identity, as outside an assert
	assert same
}

test "initializers run in order, then the constructor" {
	const ch = new Chain()
	assert ch.a == 1 && ch.b == 2 && ch.c == 20
}

test "statics" {
	const before = Counter.created
	assert Counter.make().step == 1
	assert Counter.created == before + 1
}

let tallied = 0

/// Statics of a generic class: one per instantiation, each initialized when first read or written.
class Tally[T] {
	static count = Tally.start()
	static twice = Tally[T].count * 2
	static seen: T[] = []
	static step: (x: T) => T = x => x

	constructor(x: T) {
		Tally[T].count += 1
		Tally.seen.push(x)
	}

	static start(): i32 {
		tallied += 1
		return 10
	}

	static size(): i32 { return Tally.seen.length }
	static stepped(x: T): T { return Tally[T].step(x) }
}

test "a generic class's statics are one per instantiation, each initialized on first use" {
	assert tallied == 0
	assert Tally[i32].twice == 20 && tallied == 1
	new Tally[i32](1)
	new Tally[i32](2)
	new Tally[string]("a")
	assert tallied == 2
	assert Tally[i32].count == 12 && Tally[string].count == 11
	assert Tally[i32].size() == 2 && Tally[string].seen[0] == "a"
	assert Tally[i32].step(1) == 1 && Tally[i32].stepped(2) == 2 && Tally[string].stepped("a") == "a"
}

test "a generic class's static keeps what it holds across collections" {
	Tally[u8[]].seen.push([1, 2, 3])
	let held: u8[][] = []
	for (const i of 1 ... 64) {
		held = [new u8[](1 << 20)]
	}
	assert Tally[u8[]].seen[0][2] == 3 && held.length == 1
}

class Slot[T] {
	static held: T | null = null
}

test "a generic class's statics written from code not generic" {
	Slot[i32].held = 7
	Slot[() => i32].held = () => 8
	const f = Slot[() => i32].held
	assert Slot[i32].held == 7 && f != null && f() == 8
}

function areaOf[T extends Shape](t: T): () => f64 { return t.area }

interface Stepper {
	step(a: i32): i32
}

/// Of a type param, so that each program copies its methods as it names them.
class Stepped[T] {
	by: T

	constructor(by: T) { this.by = by }
	step(a: i32): i32 { return a + 5 }
}

test "methods are values bound to their object, through an interface or a type param too" {
	const c = new Counter(3)
	const f = c.inc
	f()
	f()
	function call(h: () => i32): i32 { return h() }
	assert call(c.value) == 6
	const s: Shape = new Sq(2.0)
	const area = s.area
	const m = new Mixed()
	m.v = ["s"]
	const f2: First = m
	const first = f2.first
	assert area() == 4.0 && areaOf(new Sq(3.0))() == 9.0 && first() == "s"
	const st: Stepper = new Stepped[i32 | null](null)
	const step = st.step
	assert step(1) == 6
}

test "interfaces" {
	const s: Shape = new Sq(2.0)
	assert s.area() == 4.0
	const l: Labeled = new Tile()
	const n: Named = l
	const both = l.name() + n.name() // their results as typed outside an assert too
	assert l.area() == 1.0 && l.name() == "tile" && n.name() == "tile" && both == "tiletile"
	const o: Labeled | null = new Plate()
	assert o!.area() == 2.0
	const z: Sized = new Plate()
	assert z.area() == 2.0 && z.size() == 3
}

interface Anything {}

interface HasN {
	n: i32
}

class N5 {
	n = 5
}

class N6 {
	k = 0
	n = 6
}

test "a cast from an interface into one it lacks a member of reaches what it holds" {
	const a: Anything = new N5()
	const l: Anything = { n: 7 }
	const b: HasN = new N6()
	assert (a as HasN).n == 5 && (l as HasN).n == 7 && b.n == 6 && a instanceof HasN
}

interface HasKey {
	has(k: string): bool
}

interface Linked {
	next(): Linked | null
}

interface Tagged {
	tag: "t"
}

class Keys {
	has(k: string, n: i32 = 0): bool { return k == "a" }
	next(): Keys | null { return null }
}

class Nodes {
	has(k: N5): bool { return k.n == 5 }
	next(): N5 | null { return null }
}

/// Whether x has key "a", if it has keys by string.
function hasA(x: Anything): bool { return x instanceof HasKey && x.has("a") }

test "a value is an interface's if its members' types fit the interface's, not by their names alone" {
	const t: Tagged = { tag: "t" }
	const xs: Anything[] = [new Keys(), new Nodes(), { n: "7" }, t]
	assert hasA(xs[0]) && !hasA(xs[1]) && !hasA(xs[2])
	assert xs[0] instanceof Linked && !(xs[1] instanceof Linked) && !(xs[2] instanceof HasN) && xs[3] instanceof Tagged
}

interface Adds {
	add(a: i32): i32
}

class Adder {
	k = 100

	add(a: i32, b: i32 = this.k): i32 { return a + b }
}

function added[T extends Adds](x: T): i32 { return x.add(2) }

test "a method called as a type of fewer params takes its own defaults" {
	const a: Adds = new Adder()
	const o: { add: (a: i32, b: i32 = 1) => i32 } = new Adder()
	assert a.add(1) == 101 && o.add(1) == 101 && o.add(1, 2) == 3 && added(new Adder()) == 102
}

interface Listed {
	xs: i32[]
}

class Lister {
	xs: i32[] = []
}

function listed[T extends Listed](l: T): i32 {
	l.xs.push(1)
	return l.xs.length
}

test "a field read through a type param is of the type its constraint gives it" {
	assert listed(new Lister()) == 1
}

test "generic classes take type arguments, else infer them from the constructor" {
	assert new Box[i32](5).item == 5
	assert new Box("s").item == "s"
	const h: Holds[i32] = new Box[i32](5)
	assert h.item == 5
}

interface Held[T] {
	held: T
}

class Holder[T] implements Held[T] {
	held: T

	constructor(held: T) { this.held = held }
}

test "a field read through a union of instances of a generic interface is of each one's type" {
	const hs: (Held[i32] | Held[string])[] = [new Holder(3), new Holder("s")]
	assert `${hs[0].held}` == "3" && `${hs[1].held}` == "s"
}

class Defaulted {
	v: f64

	constructor(v = 2.5) { this.v = v }
}

function made[T extends New](): T { return new T() }

test "new T() runs the constructor of T with its params' defaults" {
	assert made[Defaulted]().v == 2.5
}

function one(): i32 {
	class L {
		v = 1
	}
	return new L().v
}

function either(b: bool): i32 {
	if (b) {
		class L {
			v = 1
		}
		return new L().v
	}
	class L {
		v = 2
	}
	return new L().v
}

function kept[T](x: T): T {
	class L {
		v: T

		constructor(v: T) { this.v = v }
		get(): T { return this.v }
	}
	return new L(x).get()
}

test "local classes" {
	function make(v: i32): bool {
		class L {
			v = 0

			get(): i32 { return this.v }
		}
		class M {}
		const l = new L()
		l.v = v
		return l instanceof (L | M) && l.get() == v
	}
	assert make(1) && make(2) && one() == 1 && kept(2) == 2 && kept("s") == "s"
	assert either(true) == 1 && either(false) == 2
}

class Pt {
	x = 0
	y = 0
}

class Seg {
	a: ...Pt
	b: ...Pt = { x: 1, y: 2 }
}

test "embedded fields copy, never alias" {
	const p = new Pt()
	const s = new Seg()
	s.a = { ...p }
	p.x = 5
	assert s.a.x == 0 && s.b.y == 2
	s.b = { ...p }
	assert s.b.x == 5 && s.b instanceof Pt
	s.b = { ...new Pt(), y: 3 }
	assert s.b.x == 0 && s.b.y == 3
	[s.a] = [{ ...p }]
	p.x = 6
	assert s.a.x == 5
	const r = new Ray()
	r.seg = { ...s }
	r.ends = { ...s, b: p }
	s.a.x = 7
	p.x = 8
	assert r.seg.a.x == 5 && r.ends.a.x == 5 && r.ends.b.x == 6
	s.a = { ...s.b }
	s.b.x = 9
	s.a = { ...s.a }
	assert s.a.x == 0 && s.a.y == 3
}

class Ray {
	seg: ...Seg
	ends: ...Seg
}

class Seen[T] {
	v: T[] = []

	first(): T { return this.v[0] }
}

class Mixed {
	...Seen[string]
}

interface First {
	v: string[]

	first(): string
}

function firstThrough[T extends First](t: T): string { return t.first() }

test "members promoted from an embedded class are reached through an interface, a union or a type param" {
	const m = new Mixed()
	const f: First = m
	f.v = ["s"]
	assert f.first() == "s" && f.v == m.v
	const u: Mixed | Seen[string] = m
	assert u.first() == "s" && u.v == m.v && firstThrough(m) == "s"
}

class Placed {
	seen: ...Seen[string]
}

test "a field holding a class in place does not promote its members, as a mixin does" {
	const ps: (Placed | Mixed)[] = [new Placed(), new Mixed()]
	assert ps.map(p => p instanceof First) == [false, true]
}

class Both {
	placed: ...Seen[string]

	...Seen[string]
}

/// Of a type argument, as mono reads it.
function firstOf[T extends First](x: T): string {
	const first = x.first
	return first()
}

test "a promoted method read as a value is the mixin's, not the field's" {
	const b = new Both()
	b.v = ["mixed"]
	b.placed.v = ["placed"]
	assert firstOf(b) == "mixed"
}

class Trio {
	a: string
	b: string
	c: string

	constructor(a: string) {
		this.a = a
		this.b = a + a
		this.c = this.b + a
	}
}

class Kept {
	trio = trio(1)
}

let finals = 0

function trio(n: i32): Trio {
	try {
		return if (n == 0) new Trio("x") else trio(n - 1)
	} finally {
		finals += 1
	}
}

test "a class instance wider than the registers that return: a function value's, a finally's and an initializer's" {
	const fs = [() => new Trio("a"), () => trio(2)]
	assert fs.map(f => f().c) == ["aaa", "xxx"]
	assert new Kept().trio.b == "xx" && finals == 5
}
