test "length and indexing count bytes" {
	const s = "héllo"
	assert s.length == 6
	assert s[0] == ("h" as u8)
	assert s[1] == 0xC3
	assert s[5] == ("o" as u8)
	assert s[1] + 0x40 == 3
}

test "concatenation and equality" {
	let t = "ab" + "c"
	t += "d"
	assert t == "abcd"
	assert t != "abce"
	assert "a" != "A"
}

test "a chain of + is one string, shared parts unchanged" {
	const long = "this one is rather long"
	let s = ""
	for (const x of ["a", long, ""]) {
		s += "," + x
		s = s + "[" + x + "]" + ("<" + x + ">")
	}
	assert s == ",a[a]<a>,this one is rather long[this one is rather long]<this one is rather long>,[]<>"
	const u = s + "!" + long
	const v = s + "?"
	assert u.slice(s.length, u.length) == "!" + long && v.slice(s.length, v.length) == "?"
	assert `${""}${long}${""}` == long && "" + long + "" == long
}

test "ordering compares bytes" {
	assert "ab" < "abc"
	assert "B" < "a"
	assert "b" > "abc"
	assert "\xff" > "a"
}

test "slice" {
	const s = "hello"
	assert s.slice(1, 3) == "el"
	assert s.slice(0, 0) == ""
	assert s.slice(0, 5) == s
}

test "at" {
	const s = "hi"
	assert s.at(1) == 105 && s.at(2) == null && s.at(-1) == null
	assert (s.at(5) ?? 0) == 0
}

test "chr" {
	assert chr(65) == "A"
	assert chr(0).length == 1
	assert chr(200)[0] == 200
	let r = ""
	for (const i of 0 ... 2) {
		r = chr("abc"[i]) + r
	}
	assert r == "cba"
}

test "a template shows a union's value" {
	const xs: (i32 | null)[] = [3, null]
	assert `${xs[0]} ${xs[1]}` == "3 null"
	const ys: (string | null)[] = ["a", null]
	assert `${ys}` == `["a", null]`
}

function str[T](x: T): string { return `${x}` }

test "a template shows a literal's value" {
	const m: "fast" | "safe" = "fast"
	assert str(m) == "fast" && str([m]) == `["fast"]`
}

interface HasX {
	x: i32
}

class Named {
	x = 1

	toString(): string { return "Named" }
}

class Plain {
	x = 2
	y = 3
}

test "a template shows an interface's value as what it holds" {
	const xs: HasX[] = [new Named(), new Plain(), { x: 4 }]
	assert `${xs[0]} ${xs}` == `Named [Named, {"x": 2, "y": 3}, {"x": 4}]`
}

/// The sum of the bytes of s, read in place across calls that allocate enough for a collection, which moves s.
function sumAcross(s: string): i64 {
	let sum: i64 = 0
	let held: u8[][] = []
	for (const i of 0 ... s.length - 1) {
		sum += s[i]
		held = [new u8[](1 << 20)]
	}
	return sum + held.length - 1
}

test "a string read in place survives a collection moving it" {
	let s = ""
	let want: i64 = 0
	for (const i of 0 ... 99) {
		s += chr((97 + i % 26) as u8)
		want += 97 + i % 26
	}
	assert sumAcross(s) == want
}

test "appending to a string of bytes leaves other strings be" {
	// Bytes that concat would read as a buffer's capacity, 2^63 - 1, and use, 8, with room to append in place.
	const b = new u8[](24)
	const zeros = new u8[](24)
	for (const i of 0 ... 6) {
		b[i] = 0xff
	}
	b[7] = 0x7f
	b[8] = 8
	const s = fromBytes(b)
	const other = fromBytes(zeros)
	const more = "0123456789abcdef0123456789abcdef"
	const t = s + more
	assert t.slice(0, 24) == s && t.slice(24, 56) == more
	for (const i of 0 ... 23) {
		assert other[i] == 0
	}
}

test "a string grown by += leaves the others of its buffer be, and they it" {
	let q = ""
	let mid = ""
	for (const i of 0 ... 199) {
		q += chr((97 + i % 26) as u8)
		if (i == 99) {
			mid = q
		}
	}
	assert q.length == 200 && mid == q.slice(0, 100)
	for (const i of 0 ... 199) {
		assert q[i] == ((97 + i % 26) as u8)
	}
	// Appended to past q in q's buffer, by one that ends where q does and by q's own +, then q again.
	let p = q
	p += "<>"
	const t = q + "!"
	q += "?"
	q += `${p.length}` + "#"
	assert t == q.slice(0, 200) + "!" && p == q.slice(0, 200) + "<>" && q.slice(200, 205) == "?202#"
	// Itself, and more than one piece, appended.
	q = mid
	for (const i of 0 ... 2) {
		q += q
		q += "-" + chr((48 + i) as u8) + "-"
	}
	assert q.length == 821 && q.slice(0, 100) == mid && q.slice(200, 203) == "-0-" && q.slice(818, 821) == "-2-"
	assert q.slice(203, 303) == mid && mid.length == 100
	// Pieces of all the 15 bytes that the room is checked for.
	let r = ""
	for (const i of 0 ... 99) {
		r += "0123456789abcde"
	}
	assert r.length == 1500 && r.slice(735, 750) == "0123456789abcde" && r.slice(1485, 1500) == "0123456789abcde"
}

test "a string stored to a local grown by += has its own room" {
	let q = ""
	for (const i of 0 ... 299) {
		q += "x"
	}
	// One whose buffer is full, with another's after it.
	const full = fromBytes(new u8[](48))
	const next = fromBytes(new u8[](48))
	q = full
	for (const i of 0 ... 63) {
		q += "y"
	}
	assert q.length == 112 && q.slice(0, 48) == full && q[48] == 121 && q[111] == 121
	for (const i of 0 ... 47) {
		assert next[i] == 0
	}
}
