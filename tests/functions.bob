class Node[K] {
	k: K
	next: Node[K] | null = null

	constructor(k: K) { this.k = k }
}

class Holder[T] {
	f: (x: T) => T

	constructor(f: (x: T) => T) { this.f = f }
	run(x: T): T { return this.f(x) }
}

function sum(...xs: i32[]): i32 {
	let s = 0
	for (const x of xs) {
		s += x
	}
	return s
}

function add(a: i32, b: i32 = 5): i32 { return a + b }
function orFive(x: i32 | null = 5): i32 | null { return x }
function fact(n: i64): i64 { return if (n == 0) 1 else n * fact(n - 1) }

const factorial: (n: i64) => i64 = n => if (n == 0) 1 else n * factorial(n - 1)

function isEven(n: i32): bool { return n == 0 || isOdd(n - 1) }
function isOdd(n: i32): bool { return n != 0 && isEven(n - 1) }
function id[T](x: T): T { return x }
function first[T](xs: T[], ys: T[]): T { return (if (xs.length > 0) xs else ys)[0] }
function depth[K](n: Node[K] | null): i32 { return if (n == null) 0 else depth[K](n.next) + 1 }
function low(x: u8): u8 { return x }
function called[A](f: () => A): A[] { return [f()] }
function pair[T](x: T): [T, T][] { return called((): [T, T] => [x, x]) }

function wide(): i64 {
	const x: i32 = 2147483647
	return x
}

function helper(): i32 { return 1 }
function apply(f: (x: i32) => i32, x: i32): i32 { return f(x) }
function norm([x, y]: i32[]): i32 { return x * x + y * y }

function makeCounter() {
	let c = 0
	return { inc: () => {
		c += 1
	}, get: () => c }
}

test "defaults fill left-out arguments, not null" {
	assert add(1) == 6
	assert add(1, 2) == 3
	assert orFive() == 5
	assert orFive(null) == null
}

test "defaults are evaluated per call, only when left out" {
	let calls = 0
	function next(): i32 {
		calls += 1
		return calls
	}
	function f(x: i32 = next()): i32 { return x }
	assert f() == 1
	assert f() == 2
	assert f(10) == 10
	assert calls == 2
}

test "rest and spread" {
	assert sum() == 0
	assert sum(1, ...[2, 3]) == 6
	const xs = [4, 5]
	assert sum(...xs, 1, ...xs) == 19
}

test "parameter and result kinds convert" {
	assert low(255) + 1 == 0
	assert wide() + 1 == 2147483648
}

test "pattern parameters" {
	assert norm([3, 4]) == 25
}

test "closures share enclosing locals" {
	let n = 0
	const inc = () => {
		n += 1
	}
	function incTwice() {
		inc()
		inc()
	}
	incTwice()
	assert n == 2
	n = 10
	inc()
	assert n == 11
}

test "a closure narrows what it captures afresh" {
	const f = (y: string | null) => () => if (y == null) "" else "a" + y
	assert f("b")() == "ab" && f(null)() == ""
}

test "closures outlive their frame" {
	const a = makeCounter()
	const b = makeCounter()
	a.inc()
	a.inc()
	b.inc()
	assert a.get() == 2
	assert b.get() == 1
}

test "recursion" {
	assert fact(20) == 2432902008176640000
	assert isEven(10) && isOdd(7) && !isEven(7)
}

test "a closure may use the variable it initializes" {
	const fib: (n: i32) => i32 = n => if (n < 2) n else fib(n - 1) + fib(n - 2)
	assert factorial(20) == 2432902008176640000
	assert fib(10) == 55
}

test "arrows" {
	const adder = (a: i32) => (b: i32) => a + b
	const wrap = (x: i32) => ({ v: x })
	assert adder(2)(3) == 5
	assert wrap(3).v == 3
	assert apply(x => x * 3, 2) == 6
}

test "functions are values" {
	const fs = [(x: i32) => x + 1, (x: i32) => x * 10]
	let r = 1
	for (const f of fs) {
		r = f(r)
	}
	assert r == 20
	const g = add
	assert g(1) == 6
}

test "generic functions take type arguments, else infer them" {
	assert id[i32](5) == 5
	assert id("a") == "a"
	const x: i64 = 1
	assert typeof first([], [x]) == typeof x && typeof first([1], [x]) == typeof x && typeof first([x], [1]) == typeof x
	const n: Node[i32] | null = new Node[i32](1)
	n!.next = new Node(2)
	assert depth(n) == 2 && depth(n!.next) == 1 && depth[i32](null) == 0
	assert pair("a")[0][1] == "a"
}

function pick[T](a: T, b: T, first: bool): T { return if (first) a else b }

class Cell[T] {
	v: T

	constructor(v: T) { this.v = v }

	get(): T { return this.v }
	with[U](u: U): [T, U] { return [this.v, u] }
}

test "a generic's instance takes and gives each kind of value as its type args have it" {
	assert pick[i8](-2, 1, true) == -2 && pick[f32](1.5, 2.5, true) == 1.5 && pick("a", "b", false) == "b"
	assert pick[i32 | null](null, 3, true) == null && pick([1], [2], false)[0] == 2
	const c = new Cell[u16](7)
	assert c.get() == 7 && c.with("x")[1] == "x" && c.with[i8](-1)[1] == -1
}

test "a generic class's function field is called as its instance types it" {
	const h = new Holder[i32](x => x + 1)
	const f = h.f
	h.f = x => x * f(x)
	assert f(1) == 2 && h.f(2) == 6 && h.run(3) == 12
}

class Box[T] {
	f: ((x: T) => T) | null = null
	pair: [(x: T) => T, i32] | null = null
	obj: { g: (x: T) => T } | null = null
}

function keep[T](fs: ((x: T) => T)[], f: (x: T) => T) { fs.push(f) }
function push[T](xs: T[], x: T) { xs.push(x) }
function callFirst[T](fs: ((x: T) => T)[], x: T): T { return fs[0](x) }
function viaView[T](o: { f: (x: T) => T }, x: T): T { return o.f(x) }

function fill[T](b: Box[T], f: (x: T) => T) {
	b.f = f
	b.pair = [f, 1]
	b.obj = { g: f }
}

function attempt[T](f: (x: T) => T, x: T): T {
	try {
		return f(x)
	} catch (e: i32) {
		return x
	}
}

function same[T](f: () => T, x: T): bool { return f() == x }
function collect[T](f: () => T, xs: T[]) { xs.push(f()) }
function applyTo[T](f: (x: T) => i32, x: T): i32 { return f(x) }
function sum3(xs: i32[3]): i32 { return xs[0] + xs[1] + xs[2] }
function quarter(): f32 { return 0.25 }
function half(x: f64): f64 { return x / 2.0 }
function neg(x: i64): i32 { return -(x as i32) }

test "function values pass between generic and closed code in arrays, views, unions and fields" {
	const fs: ((x: f64) => f64)[] = []
	keep(fs, x => x * 2.0)
	const ss: ((s: string) => string)[] = [s => s + "!"]
	assert fs[0](1.5) == 3.0 && callFirst([(x: i32) => x + 1], 4) == 5 && callFirst(ss, "hi") == "hi!"
	const view: { f: (x: i32) => i32 } = new Holder[i32](x => x + 1)
	assert view.f(1) == 2 && viaView({ f: (x: i32) => x * 3 }, 2) == 6
	const b = new Box[i32]()
	fill(b, x => x + 10)
	assert b.f!(1) == 11 && b.pair![0](2) == 12 && b.obj!.g(3) == 13
	const limit = 5
	const capped = (x: i32): i32 => {
		if (x > limit) {
			throw x
		}
		return x + limit
	}
	assert attempt(capped, 1) == 6 && attempt(capped, 9) == 9
	const triple: i32[3] = [1, 2, 3]
	const sums: ((xs: i32[3]) => i32)[] = [sum3]
	sums.push(xs => xs[2] * limit)
	assert sums[0](triple) == 6 && applyTo(sum3, triple) == 6 && sums[1](triple) == 15
}

test "a function value is called as a wider type it fits" {
	const f: (x: f32) => f64 = half
	const g: (x: i32) => i64 | null = neg
	const gs: ((x: i32) => i64 | null)[] = []
	push(gs, neg)
	const r = gs[0](5)
	assert f(3.0) == 1.5 && g(4) == -4 && r instanceof i64 && r == -5
	const xs: f64[] = []
	collect[f64](quarter, xs)
	assert same[f64](quarter, 0.25) && xs[0] == 0.25
}

test "nested functions are visible from their declaration on" {
	function helper(): i32 { return 2 }
	function a(): i32 { return helper() }
	function even(n: i32): bool { return n == 0 || !even(n - 1) }
	assert a() == 2 && even(4) && !even(3)
}

/// Closures kept past their frame, where a collection finds them.
const kept: (() => i32[])[] = []

test "a closure made in a closure takes what that one copied in, or shares its cell" {
	const k = [1, 2]
	const f = () => () => k
	let n = 0
	const g = () => () => {
		n++
	}
	kept.push(f())
	g()()
	for (const i of 0 ... 39) {
		n += new u8[](1 << 20)[i]
	}
	g()()
	assert kept[0]()[1] == 2 && n == 2
}

test "a closure made in a closure sees what is assigned after it is made" {
	let got = 0
	const f = () => () => got
	const g = f()
	got = 1
	assert g() == 1
}
