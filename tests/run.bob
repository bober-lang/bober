//! Every test passes.

let calls = 0

function tick(n: i32): i32 {
  calls += 1
  return n
}

function apply(f: (x: i32) => i32, x: i32): i32 {
  return f(x)
}

function sum(...xs: i32[]): i32 {
  let s = 0
  for (const x of xs) {
    s += x
  }
  return s
}

function id[T](x: T): T {
  return x
}

function grade(n: i32): string {
  return switch (n) {
    case 90 ... 100: "A"
    case 80 ... 89, 79: "B"
    case 0: "zero"; case -1: "neg"
    default: "F"
  }
}

function kind(c: i32): string {
  return switch (c) {
    case ('a' as i32) ... ('z' as i32), ('A' as i32) ... ('Z' as i32), '_' as i32: "ident"
    case ('0' as i32) ... ('9' as i32): "digit"
    default: "other"
  }
}

test "newlines" {
  let b: i32 = 5
  -1
  assert b == 4

  let c = tick(2)
    // trivia
    * 3
  assert c == 6

  let e: i32 = 1 +
    2
  let f =
    3
  assert e == f

  const deep = { a: { b: 7 } }
  const g = deep
    .a
    .b
  assert g == 7

  const h = (x: i32)
    => x * 2
  assert h(2) == 4

  let i = 0
  if (i == 0) {
    i = 1
  }
  else {
    i = 2
  }
  assert i == 1

  let x = 1
  let y = 2
  [x, y] = [y, x]
  assert x == 2 && y == 1

  let k = 1; let l = 2; assert k + l == 3
}

test "precedence" {
  const xs: i32[] = [1 + 2 * 3, 7 - 2 - 1, 2 ** 3 ** 2, 2 * 3 ** 2, (-2) ** 2, -2 * 3, 1 << 2 + 1, 6 & 3, 1 | 2 ^ 3 & 1]
  assert xs == [7, 4, 512, 18, 4, -6, 8, 2, 3]
  assert - -1 == 1
  assert !false == true
  assert true || false && false
  assert 1 < 2 < 3
  assert 3 >= 3 > 2
  assert 1 == 1 == 1
  assert !(1 < 3 <= 2)
  const before = calls
  assert 0 < tick(1) < 2
  assert calls == before + 1
  const n: i32 | null = null
  assert (n ?? 2) == 2
}

test "if expressions" {
  const a: i32 = if (true) 1 else 2 + 3
  const b: i32 = if (false) 1 else 2 + 3
  const c = if (false) 1 else if (false) 2 else 3
  assert a == 1 && b == 5 && c == 3
  assert apply((x: i32) => if (x > 0) x else -x, -4) == 4
}

test "arrows" {
  const k = () => 7
  const double = (x: i32) => x * 2 + 1
  const block = (x: i32) => {
    return x - 1
  }
  const wrap = (x: i32) => ({ v: x })
  const add = (a: i32) => (b: i32) => a + b
  const dflt = (x: i32 = 4) => x
  assert k() == 7 && double(2) == 5 && block(1) == 0 && wrap(3).v == 3
  assert add(1)(2) == 3 && dflt() == 4
  assert (() => 5)() == 5
  assert apply((x: i32) => x * 3, 2) == 6
  assert sum() == 0
  assert sum(1, ...[2, 3],) == 6
  assert id[i32](5) == 5
}

test "patterns" {
  const [a, b] = [1, 2]
  const { c, d: e } = { c: 3, d: 4 }
  const [f, ...rest] = [5, 6, 7]
  const { g: [h, i] } = { g: [8, 9] }
  assert a + b + c + e + f + rest[1] + h + i == 39
}

test "objects" {
  const p = {
    x: 1
    y: 2,
  }
  const q = { ...p, y: 5 }
  const r = { y: 5, ...p }
  const x = 3
  const s = { x }
  assert p.x + p.y == 3 && q.y == 5 && r.y == 2 && s.x == 3
}

test "optional" {
  const v: i32 | null = 3
  const o: { k: i32 } | null = { k: 1 }
  assert v! + 1 == 4
  assert (o?.k ?? 0) == 1
  let m: i32 | null = null
  m ??= 5
  assert m! == 5
}

test "loops" {
  let s = 0
  for (const i of 1 ... 4) {
    s += i
  }
  for (const _ of 4 ... 1) {
    s += 100
  }
  for (const i of 1...2) {
    s += i
  }
  for (const [a, b] of [[1, 2], [3, 4]]) {
    s += a * b
  }
  assert s == 27
  let i = 0
  while (true) {
    i += 1
    if (i < 3) {
      continue
    }
    break
  }
  assert i == 3
  const fs: (() => i32)[] = []
  for (const k of 0 ... 2) {
    const sq = k * k
    fs.push(() => k + sq)
  }
  assert fs[0]() == 0 && fs[2]() == 6
  let hits = 0
  while (fs.length < 5) {
    let v = fs.length
    fs.push(() => {
      hits += 1
      return v
    })
  }
  assert fs[3]() == 3 && fs[4]() == 4 && hits == 2
}

test "switch" {
  assert grade(95) == "A" && grade(79) == "B" && grade(-1) == "neg" && grade(5) == "F"
  assert kind('q' as i32) == "ident" && kind('7' as i32) == "digit" && kind(' ' as i32) == "other"
  let s = 0
  switch (2) {
    case 1:
      s = 10
    case 2, 3:
      s += 1
      s += 1
    default: s = -1
  }
  assert s == 2
}

test "try" {
  let hit = 0
  try {
    hit += 1
  }
  finally {
    hit += 10
  }
  assert hit == 11
}

test "assignment operators" {
  let x = 3
  x **= 2
  x <<= 2
  x >>= 1
  x %= 7
  x |= 3
  x &= 5
  x ^= 1
  x -= 1
  x *= 6
  x /= 2
  x += 1
  assert x == 10
  let xs = [1, 2]
  xs[0]++
  xs[1]--
  assert xs[0] == 2 && xs[1] == 1
  const bump = () => {
    x = 100
    return 2
  }
  x += bump()
  assert x == 12
  const ys = [0]
  const grow = () => {
    ys.push(1)
    return 5
  }
  ys[0] = grow()
  assert ys[0] == 5
}

test "numbers" {
  assert 1_000 == 1000
  assert 0xff == 255 && 0xF_F == 255
  assert 0o17 == 15 && 0b1010 == 10 && 0x0 == 0
  assert 1e3 == 1000.0 && 1.5e1 == 15.0 && 2.5E-1 == 0.25
  assert 1_0.2_5 == 10.25
  const half: i32 = 8 / 2 //2
  assert half == 4
}

test "chars" {
  assert 'a' == "a" && '\n' == "\n" && '\'' == "'" && '"' == "\"" && '\\' == "\\"
  assert ('a' as i32) == 97 && ('\0' as i32) == 0 && ('\x41' as i32) == 65 && ('é' as i32) == 233
  assert ('\u{1F600}' as u32) == 0x1F600 && ('😀' as u32) == 0x1F600
}

test "strings" {
  assert "\x41\u{42}" == "AB"
  assert "\u{e9}" == "é"
  assert "'" == "\'" && "\"" == `"` && "\`" == "`"
  assert "$" == "\$" && "${x}" == `\${x}`
  assert "// not a comment" != ""
}

test "templates" {
  const b = "b"
  assert `` == ""
  assert `a${b}c` == "abc"
  assert `${b}${b}` == "bb"
  assert `${`<${b}>`}` == "<b>"
  assert `${ { k: b }.k }` == "b"
  assert `${"}"}` == "}"
  assert `$b \` $` == "$b ` $"
}

test "subtests" {
  test "inner" {
    assert true
  }
}
