//! Calls of TypeScript typings (src/dts.bob) of greet.js, beside, which src/js.test.bob runs by node.

import { HELLO, Mood, Person, feel, greet, last, later, people, shout } from "./greet.d.ts" @TypeScript

function main() {
	assert last() == null
	assert greet({ name: "Zoë", title: null, age: 30.0 }) == "Zoë (30)!"
	assert greet({ name: "Zoë", title: "Dr.", age: 2.0 }, "?") == "Dr. Zoë (2)?"
	assert feel(Mood.Sad) == "sad" && feel(Mood.Glad) == "glad"
	const ps = people(["ä", "b"])
	assert ps.length == 2 && ps[0].name == "ä" && ps[1].age == 1.0 && ps[1].title == null
	shout(HELLO)
	assert last() == "HÉLLO"
	assert later(1.0, "done") == "done" && later(1.0, "") == null
	print("ok")
}
