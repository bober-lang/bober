import { Vec, dot as dotProduct, answer } from "./mod/geom"
import * as geom from "./mod/geom.bob"
import { box } from "./mod/shared"
import * as user from "./mod/user"
import { Box, one } from "./mod/inity"
import * as inity from "./mod/inity"
import { Z } from "./mod/initz"

test "named imports" {
	const v = new Vec(1, 2).plus(new Vec(3, 4))
	assert v.x == 4 && v.y == 6
	assert answer == 42
}

test "renamed import" {
	assert dotProduct(new Vec(1, 2), new Vec(3, 4)) == 11
}

test "namespace import" {
	assert geom.dot(geom.unit, new geom.Vec(2, 3)) == 5
	const b: inity.Box[i32] = new inity.Box[i32]()
	assert b.v == null
}

test "a module is loaded once" {
	assert user.sharedBox() == box
	const v: Vec | null = new geom.Vec(0, 0)
	assert v instanceof Vec
}

test "a module's init runs after those it imports, not those its instances refer to" {
	assert one == 1
	const b = new Box[Z]()
	b.v = new Z()
	assert b.v.n == 2
}
