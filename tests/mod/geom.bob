export class Vec {
	x: i32
	y: i32

	constructor(x: i32, y: i32) {
		this.x = x
		this.y = y
	}

	plus(o: Vec): Vec { return new Vec(this.x + o.x, this.y + o.y) }
}

export function dot(a: Vec, b: Vec): i32 { return a.x * b.x + a.y * b.y }

export const unit = new Vec(1, 1)
export const answer: i32 = secret() + 2

function secret(): i32 { return 40 }
