//! Top-level declarations in any order (§3), each checked and initialized.

const total = double(base) + 1
const base = 20

function double(x: i32): i32 { return x * 2 }

const inc = (x: i32) => x + 1
const twice = (x: i32) => inc(inc(x))

function even(n: u32): bool { return if (n == 0) true else odd(n - 1) }
function odd(n: u32): bool { return if (n == 0) false else even(n - 1) }

const half = halve(base)

function halve(x: i32) { return x / 2 }

const narrow: u8 = base
const ratio: f32 = 1.5

type Num = i64

const big: Num = 1 << 40

const callback = takes(() => {
	return 1
})

function takes(f = () => {
	return 2
}): i32 { return f() }

interface Shape {
	name: string

	area(): f64
}

class Square implements Shape {
	area(): f64 { return this.side * this.side }

	name = "square"
	side: f64 = 1.0
}

const shapes: Shape[] = [new Square()]
const firstArea: f64 = shapes[0].area()

function label(s: Shape | null): string { return s?.name ?? "none" }

const head = new Chain().next

class Chain {
	next: Chain | null = null
	value = 0
}

type Mode = "fast" | "safe"

const mode: Mode = "fast"
const modes: Mode[] = ["fast", "safe"]
const level = if (mode == "fast") 1 else 2
const maybe = if (level > 1) level else null
const sure: i32 = maybe ?? 0
const origin = { x: 0, y: 0 }
const moved: typeof origin = { x: origin.x + 1, y: origin.y }
const job = async double(1)
const done: i32 = await job
const pending: async i32 = async double(2)
const nested: { b: { c: i32 } } | null = null
const nestedC: i32 | null = nested?.b.c
const fresh = if (level > 1) [1] else null
const freshFirst: i32 | null = fresh?.[0]

test "each is initialized after its dependencies" {
	assert total == 41 && half == 10 && narrow == 20 && twice(1) == 3 && even(4) && !odd(4)
	assert ratio == 1.5 && big == 1 << 40
	assert callback == 1 && takes() == 2 && firstArea == 1.0 && label(null) == "none" && head == null
	assert level == 1 && maybe == null && sure == 0 && modes.length == 2 && moved == { x: 1, y: 0 }
	assert done == 2 && await pending == 4 && nestedC == null && freshFirst == null
}
