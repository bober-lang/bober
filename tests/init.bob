const total = double(base) + 1
const base = 20

function double(x: i32): i32 { return x * 2 }

const a: i32 = b * 2
const b: i32 = c + 1
const c: i32 = 4
const viaFn: i32 = triple()

function triple(): i32 { return later * 3 }

const later: i32 = 7
const doubled: i32 = Cfg.size * 2

class Cfg {
	static readonly size: i32 = base - 12
}

const origin = new Point(1, 2)

class Point {
	x: i32
	y: i32

	constructor(x: i32, y: i32) {
		this.x = x
		this.y = y
	}
}

let names: string[] = [first, second]

const first = "a"
const second = first + "b"

test "a variable is initialized after the ones it reads" {
	assert total == 41
	assert a == 10
}

test "dependencies through functions" {
	assert viaFn == 21
}

test "dependencies through statics and classes" {
	assert doubled == 16
	assert origin.y == 2
}

test "a let may depend on later consts" {
	assert names[1] == "ab"
}
